 1:	ldq_l	a0, lck+MTX_LOCK;		\
 	cmpeq	a0, MTX_UNOWNED, a1;		\
 	beq	a1, 1b;				\
@@ -553,9 +553,7 @@
 	stq_c	a0, lck+MTX_LOCK;		\
 	beq	a0, 1b;				\
 	mb;					\
-	stl	v0, lck+MTX_SAVEIPL;		\
-	ldq	a0, ALPHA_PSL_IPL_HIGH;		\
-	call_pal PSL_OSF1_swpipl
+	stl	v0, lck+MTX_SAVEIPL
 
 #define MTX_EXIT(lck)				\
