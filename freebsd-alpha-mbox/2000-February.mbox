@@ -142,8 +145,13 @@
 #include "memory.h"
 #endif
 #endif
+#if defined(__FreeBSD__)
+#define mutex_lock(x)
+#define mutex_unlock(x)
+#else
 #include "extern.h"
 #include "reentrant.h"
+#endif
 
 #ifdef MALLOC
 #ifdef KR_headers
@@ -283,8 +291,13 @@
 #define LSB 1
 #define Sign_bit 0x80000000
 #define Log2P 1
+#if defined(__FreeBSD__) && defined(__alpha__)
+#define Tiny0 0x100000
+#define Tiny1 0
+#else  /* !FreeBSD/alpha */
 #define Tiny0 0
 #define Tiny1 1
+#endif /* FreeBSD/alpha */
 #define Quick_max 14
