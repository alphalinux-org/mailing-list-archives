 				 */
 #ifdef DEBUG_CLUSTER
-				printf("Loading cluster %d: 0x%lx / 0x%lx\n", i,
-				       pfn0, pfn1);
+				printf("Loading chunk after kernel: "
+				       "0x%lx / 0x%lx\n", kernendpfn, pfn1);
 #endif
-				phys_avail[phys_avail_cnt] = alpha_ptob(pfn0);
