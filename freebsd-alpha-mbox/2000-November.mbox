+	call_pal PAL_cserve
+	.long	0x66100118	/* hw_mfpr a0, icsr */
+	ldah	a1, 0x0020	/* IMSK1 */
+	or	a0, a1, a0
+	.long	0x76100118	/* hw_mtpr a0, icsr */
+	ldiq	a0, 0x09	/* Disable PALRES */
+	call_pal PAL_cserve
