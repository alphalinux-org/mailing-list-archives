+	or	a0, a1, a0
+	xor	a0, a1, a0
+	.long	0x76100118	/* hw_mtpr a0, icsr */
+	ldiq	a0, 0x09	/* Disable PALRES */
+	call_pal PAL_cserve
+	RET
+	END(eb164_intr_enable_icsr)
