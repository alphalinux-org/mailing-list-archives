>      trap entry     = 0x4 (unaligned access fault)
>      faulting va    = 0xfffffc001847a02e
>      opcode         = 0x28
>      register       = 0x1
>      pc             = 0xfffffc00004cd0f8
>      ra             = 0xfffffc00004cce24
