@@ -50,7 +50,7 @@
 static __inline register_t
 intr_disable(void)
 {
-	return (alpha_pal_swpipl(ALPHA_PSL_IPL_MCES));
+	return (alpha_pal_swpipl(ALPHA_PSL_IPL_HIGH));
 }
 
