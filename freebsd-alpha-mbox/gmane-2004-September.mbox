RCS file: /home/ncvs/src/gnu/usr.bin/cc/cc1plus/Makefile,v
retrieving revision 1.35
diff -u -r1.35 Makefile
--- Makefile	28 Jul 2004 05:27:19 -0000	1.35
+++ Makefile	1 Sep 2004 08:58:54 -0000
@@ -23,6 +23,7 @@
