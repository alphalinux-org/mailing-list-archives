+++ usr.sbin/tcpdump/tcpdump/config.h	2001/04/24 16:33:50
@@ -210,3 +210,9 @@
 /* define if your compiler has __attribute__ */
 #define HAVE___ATTRIBUTE__ 1
 
+#ifdef __alpha__
