ewa0_ginetaddr          0.0.0.0         
ewa0_inet_init          bootp           
ewa0_inetaddr           0.0.0.0         
ewa0_inetfile                           
ewa0_loop_count         3e8
ewa0_loop_inc           a
ewa0_loop_patt          ffffffff
ewa0_loop_size          2e
ewa0_lp_msg_node        1
ewa0_mode               Twisted-Pair    
ewa0_protocols          BOOTP           
ewa0_sinetaddr          0.0.0.0         
ewa0_tftp_tries         3

