FreeBSD/alpha:

#include <float.h>
#include <stdio.h>

main() {
  double d = DBL_MIN;

  printf (" = %.17g;\n", d);
  printf (" = %.17g;\n", d/10);
  printf (" = %.17g;\n", (DBL_MIN/10)*10);
  printf (" = %.17g;\n", (DBL_MIN/10));
}

