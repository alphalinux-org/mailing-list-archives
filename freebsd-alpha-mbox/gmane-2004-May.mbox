@@ -101,15 +101,6 @@
 }
 
 static __inline int
-feraiseexcept(int __excepts)
-{
-/* XXX */
-	fexcept_t __ex = __excepts;
-	fesetexceptflag(&__ex, __excepts);
-	return (0);
-}
-
-static __inline int
 fesetexceptflag(const fexcept_t *__flagp, int __excepts)
 {
 	union __fpcr __r;
@@ -123,6 +114,15 @@
 	__r.__bits |= __xflag & __xexcepts;
 	__mt_fpcr(__r.__d);
 	__excb();
+	return (0);
+}
+
+static __inline int
+feraiseexcept(int __excepts)
+{
+/* XXX */
+	fexcept_t __ex = __excepts;
+	fesetexceptflag(&__ex, __excepts);
 	return (0);
 }
 

