Yes, t0 and t1 are #define's, so they don't work in inline asm.
Also, you should clobber them if you use them directly, i.e.

        __asm("   ldq     $1, %1\n"  (suggested by Peter I think)
              "1: ldq_l   $1, %1\n"
              "   mov     %2, $2\n"
              "   stq_c   $2, %1\n"
              "   beq     $2, 1b\n"
              "   stq     $1, %0\n"
                : "+m" (*res) : "m" (*dst), "r" (val) : "memory", "$1", "$2");

-- 

