Grr, I just remembered.  t0, t1, etc are our names for
them.  They should probably be $1 and $2.

static __inline void
atomic_swap_long(volatile long *dst, long val, long *res)
{
        long temp1, temp2;

        __asm ( "1: ldq_l   %3, %1\n"
                "   mov     %2, %4\n"
                "   stq_c   %4, %1\n"
                "   beq     %4, 1b\n"
                "   stq     %3, %0\n"
            : "=m"(*res) : "m"(*dst), "r"(val), "r"(temp1), "r"(temp2) : "memory");    
}

