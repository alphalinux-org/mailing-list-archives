  2607  #ifdef PMAP_REMOVE_PAGES_CURPROC_ONLY
  2608                  pte = vtopte(pv->pv_va);
  2609  #else
  2610                  pte = pmap_pte_quick(pv->pv_pmap, pv->pv_va);
  2611  #endif
  2612                  if (!pmap_pte_v(pte))
  2613                          panic("pmap_remove_pages: page on pm_pvlist has no pte\n");
  2614                  tpte = *pte;


