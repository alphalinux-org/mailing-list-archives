> static __inline=20
> void atomic_swap_long(volatile long *dst, long val, long *res)
> {
> 	u_int64_t result;
>=20
> 	__asm __volatile (
> 		"1:\tldq_l %0,%1\n\t"
			"mov %2,r1\n\t"		/* Hide under the load latency */
			"cmpeq %0,%2,r0\n\t"
			"bne r0,3f\n\t"		/* Branches out are ok, but not to targets within =
ld_l/st_c */
> 		"stq_c r1,%1\n\t"
> 		"beq r1,1b\n\t"
> 		"3:\n"
> 		: "=3D&r" (result)
> 		: "m" (*dst), "r" (val)
> 		: "memory");
>=20
> 	*res =3D result;
> }
