x.c
----------------------------

#include <stdlib.h>
#include <X11/Xlib.h>
#include <X11/extensions/xf86vmode.h>

Display *disp;

char *dstr;

int scr;

static int          std_vid_modes_num = 0;
static int          std_vid_mode_cur = 0;
static XF86VidModeModeInfo **std_vid_modes = NULL;


int main ()
{
  dstr = getenv("DISPLAY");
  if (!dstr) {
      dstr = ":0.0";
  };
  disp = XOpenDisplay(dstr);
  scr = DefaultScreen(disp);
  XF86VidModeGetAllModeLines(disp, scr, &std_vid_modes_num,
			     &std_vid_modes);
};

---------------------------------------------

Makefile
---------------------------------------------
CFLAGS = -g
LIBS = -L/usr/X11R6/lib -lX11 -lXext -lXxf86vm
CC = cc

OBJ= x.o

x:	x.o
	$(CC) x.o $(LIBS) -o x

all:	x

clean:
	rm -f $(OBJ) x

----------------------------------------------




