#!/bin/ksh
#
#**************************************************************************
# Function to display main menu selection                                 *
#**************************************************************************
displaymenu()
{
clear
  echo "TMS Password Maintenance & Application Menu"
  echo "==========================================="
  echo
  echo "  1) Password Maintenance"
  echo
  echo "  2) TMS STORE Application"
  echo
  echo "  3) TMS YARD  Application"
  echo
  echo "q|Q) quit"
  echo
  echo "Select Option[(1-3)|(q)]: \c"
  read OPTION
  echo
}
#**************************************************************************
# Main Processing Control Section                                         *
#**************************************************************************
/usr/bin/clear
displaymenu                                             # display main menu
while [ "$OPTION" != "q" ] || [ "$OPTION" != "Q" ]
do
  case $OPTION
  in
     1)
       /usr/bin/clear
       badpass=0
       while ((badpass < 1))
       do
           print "   "
           print "   "
           print -n "   Enter Userid For Password Maintenance : "
           read USRMNT
           print "   "
           print "   "
           print -n "   Enter New Password : "
           read newpass1
           print "   "
           print "   "
           print -n "   Enter New Password Again For Verification : "
           read newpass2
           npass_len=${#newpass1}
           if [[ $newpass1 = $USRMNT ]]                  # Password Matches Userid
           then
               print "   Password Can Not Match Userid, Try Again"
               continue
           elif [[ $newpass1 != $newpass2 ]]           # Passwords Don't Match
           then
               print "   Passwords Do Not Match, Try Again"
               continue
           elif [[ $newpass1 = +([a-z]) ]]             # Password ALL Lowercase
           then
               print "   Password Can Not Be All Lowercase, Try Again"
               continue
           elif ((npass_len != 6))                     # Password 6 Characters
           then
               print "   Password Must Be 6 Characters Long, Try Again"
               continue
           else
               ((badpass = badpass + 1))               # Terminate Loop Control
               exec /usr/local/bin/TMSpassmnt $USRMNT $newpass1   # Expect Script
           fi
       done
     ;;
     2)
       cd /dir
       run tmsstore
     ;;
     3)
       cd /dir
       run tmsyard
     ;;
     Q|q)
       exit
     ;;
     *)
       echo "**** Invalid selection ****"
     ;;
  esac
  echo
  displaymenu
done

