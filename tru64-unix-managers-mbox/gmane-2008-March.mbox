Found a conditional in the ksh man pages. =20
=20
#!/bin/ksh
LOCALDRV=3D/home/users/mfg/xxbusint1; export LOCALDRV
NFSDRV=3D/home/whlzdev/xxbusint1; export NFSDRV
=20
cd $LOCALDRV

if [ -d $NFSDRV]
    then
        cd $NFSDRV
    else
        echo "failover mode, no NFS, writing locally"
fi
exec /someexecutable


