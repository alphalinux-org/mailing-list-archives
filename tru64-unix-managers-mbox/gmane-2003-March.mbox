#!/usr/local/bin/perl

$mbox = "/usr/spool/mailINBOX";

print "cleaning out fluff mail...\n";

opendir(MBOX, "$mbox") || die "Can't open mail box directory\n" ;

@fn = readdir MBOX ;

foreach $fn (@fn) {
  open (MSG, "<$mbox/$fn") || die "Can't open mail message $fn\n" ;
  next if -d "$mbox/$fn" ;
  foreach () {
    /Gutenberg/ && do { `rm -f $mbox/$fn`; last; };
    /ht_lit/ && do { `rm -f $mbox/$fn`; last; };
    /hyperjournal/ && do { `rm -f $mbox/$fn`; last; };
    /html-wg/ && do { `rm -f $mbox/$fn`; last; };
    /PetriNet/ && do { `rm -f $mbox/$fn`; last; };
    /deptcal/ && do { `rm -f $mbox/$fn`; last; };
    /UMCP COGNITIVE SCIENCE/ && do { `rm -f $mbox/$fn`; last; };
