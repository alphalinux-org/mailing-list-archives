#!/freeware/bin/perl -w

$| = 1 ;
$sum = 0 ;
foreach $file (@ARGV){
   print "Processinv $file: " ;
   $file =~ /.bad$|.save/ && print " skipped\n" && next ;
   @stat = lstat $file ;
   -l _ && print "is a link!\n" && next ;
   open(IN,"< $file") || ( print "read: @!\n" && next ) ;
   $mbox = join('',(<IN>)) ;
   close(IN) ;
   @mbox = split(/\n\nFrom /,$mbox) ;
   undef $mbox ;
   @cbox = grep(!/ILOVEYOU/,@mbox) ;
   @vbox = grep( /ILOVEYOU/,@mbox) ;
   print $#mbox + 1, " messages, ", $#vbox + 1, " virii " ;
   $sum += $#vbox + 1 ;
   undef @mbox ;

   if( $#vbox >= 0 ){ 
      rename("$file","$file.save") || ( print "rename failed: @!\n" && next ) ;

      open(OUT,"> $file" ) || ( print "save: @!\n"   && next ) ;
      chmod($stat[2],"$file" ) ; 
      chown($stat[4],$stat[5],"$file") ;
      print OUT @cbox ;
      close(OUT) || print "close/save: @!\n" ;

      open(BUT,"> $file.bad") || ( print "reject: @!\n" && next ) ;
      chmod($stat[2],"$file.bad") ; 
      chown($stat[4],$stat[5],"$file.bad" ) ;
      print BUT @vbox ;
      close(BUT) || print "close/reject: @!\n" ;
      }
   undef @cbox ;
   undef @vbox ;
   print "\n" ;
   }
print "Total $sum virii found\n" ;
