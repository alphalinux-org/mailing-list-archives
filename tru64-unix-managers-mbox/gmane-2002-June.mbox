#!/bin/ksh=0A=
wd=3D$(pwd)=0A=
if [[ ! -r ./zapb ]] ;=0A=
then=0A=
	echo zapb is missing, please compile zapb.c with: '"cc -o zapb =
zapb.c"'=0A=
	exit 1=0A=
fi=0A=
cd /=0A=
grep ris.dec /etc/bootptab | tr ':' '\n' | grep bf=3D | sed 's/bf=3D//' =
| while read kr=0A=
do=0A=
	echo Found Ris Kernel: $kr=0A=
	if [[ -L $kr ]] && [[ -r $kr ]] ; then=0A=
		dr=3D$(dirname $kr)=0A=
		cd $dr=0A=
		fi=3D$(ls -l $kr | awk '{print $11}')=0A=
		kn=3D$(basename $fi)=0A=
		case $kn in=0A=
		vmunix*[0-9])=0A=
			sum $fi | read ck1 ck2 xx=0A=
			if [[ $ck1 =3D 18569 ]] && [[ $ck2 =3D 8716 ]]; then=0A=
				/bin/true=0A=
			else=0A=
				echo Ris Kernel: Original Checksum Not Match $fi=0A=
				exit 1=0A=
			fi=0A=
			/bin/cp -p $fi $fi.BT=0A=
			echo Patching: netboot_bootp_open:467=0A=
			echo '	"bis zero, 2, s5" =3D=3D> "bis zero, 30, s5"'=0A=
			$wd/zapb $fi.BT  171388 0x455ff10a47e3d40e=0A=
			echo Patching: bootp_info:3464=0A=
			echo '	"bis zero, 4, s4" =3D=3D> "bis zero, 30, s4"'=0A=
			echo '	"bis zero, 5, s6" =3D=3D> "bis zero, 31, s6"'=0A=
			$wd/zapb $fi.BT 3139788 0x47e3f40f47e3d40d=0A=
			sum $fi.BT | read ck1 ck2 xx=0A=
			if [[ $ck1 =3D 53020 ]] && [[ $ck2 =3D 8716 ]]; then=0A=
				/bin/rm -f $kr=0A=
				ln -s $fi.BT $kr=0A=
				echo Ris Kernel: $kr '->' $fi.BT Successfully Patched=0A=
				exit 0=0A=
			else=0A=
				echo Ris Kernel: $fi.BT Patch Failed Checksum Not Match=0A=
				exit 1=0A=
			fi=0A=
			;;=0A=
		vmunix*.BT)=0A=
			sum $fi | read ck1 ck2 xx=0A=
			if [[ $ck1 =3D 53020 ]] && [[ $ck2 =3D 8716 ]]; then=0A=
				echo Ris Kernel: Already Patched $fi=0A=
			else=0A=
				echo Ris Kernel: Patched Checksum Not Match $fi=0A=
				exit 1=0A=
			fi=0A=
			;;=0A=
		*)=0A=
			echo Ris Kernel: Illegal Name $fi=0A=
			exit 1=0A=
		esac=0A=
		=0A=
	else=0A=
		echo Ris Kernel: Invalid $kr=0A=
		exit 1=0A=
	fi=0A=
done=0A=

