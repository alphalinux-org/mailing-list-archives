> --- 9/19/94
> - install YMODEM, ZMODEM, and XMODEM 3.03/3.00 on osf1
> ftp software from gatekeeper.dec.com in
> /pub/comm/zmodem-part[1234].shar.
>  1. modify Makefile
>  2. make sysvr3 >& make.log&
>  3. cp *.1 /usr/local/man/man1  (root.system 444)
>  4. strip sz rz
>  5. cp sz rz /usr/local/bin     (root.system 755)
>  6. cd /usr/local/bin
>  7. ln -s rz rb
>  8. ln -s rz rx
