controller scsi0 at	isp0	slot	0
device disk rz1	 at	scsi0	drive	8

bus 	isp1	 at	pci0	slot	1	vector	ispintr
controller scsi1 at	isp1	slot	0
device disk rz10 at	scsi1	drive	80

bus 	isp2	 at	pci0	slot	4	vector	ispintr
controller scsi2 at	isp2	slot	0
device disk rz19 at	scsi2	drive	152

** end **

