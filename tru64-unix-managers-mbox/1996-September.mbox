/* snip here--------------------*/
#include <stdio.h>
#include <stdlib.h>
int main(long argc, char *argv[])
{
        long col=0, columns;
        char ch;
        if(argc!=2) {
                fprintf(stderr,"Syntax: chop columns < file\n");
                exit(-1);
        }
        if(argc==2){
                columns = atoi(argv[1]);
                while((ch=getc(stdin))!=EOF){
                        col++;
                        if(col % columns == 0){
                                putchar(ch);
                                putchar('\n');
                        }
                        else
                                putchar(ch);
                }
