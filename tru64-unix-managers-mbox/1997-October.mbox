Content-Transfer-Encoding: quoted-printable
Content-Disposition: attachment;
	filename="diskback.sh"

#!/bin/sh=0A=
=0A=
###################=0A=
# declare variables=0A=
###################=0A=
=0A=
bakrootdir=3D/backup_mounts/root; export bakrootdir=0A=
bakusrdir=3D/backup_mounts/usr; export bakusrdir =0A=
=0A=
###################=0A=
echo " Checking for spare root and usr devices..."=0A=
###################=0A=
=0A=
rtdev=3D`mount | grep $bakrootdir | cut -d" " -f3`=0A=
if [ -z "$rtdev" ]=0A=
then=0A=
    echo " Backup device not mounted... exiting"=0A=
    exit 1=0A=
fi=0A=
=0A=
usrdev=3D`mount | grep $bakusrdir | cut -d" " -f3`=0A=
if [ -z "$usrdev" ]=0A=
then=0A=
     echo " Backup device for /usr not mounted... exiting"=0A=
     exit 1=0A=
fi=0A=
=0A=
###################=0A=
echo " backup the root filesystem..."=0A=
###################=0A=
=0A=
rm -rf $bakrootdir/*=0A=
rm -rf $bakrootdir/.*=0A=
cd /=0A=
dump -0f - / | (cd $bakrootdir; restore -xf -)=0A=
=0A=
###################=0A=
echo " backup the usr filesystem..."=0A=
###################=0A=
=0A=
rm -rf $bakusrdir/*=0A=
rm -rf $bakusrdir/.*=0A=
cd /=0A=
dump -0f - /usr | (cd $bakusrdir; restore -xf -)=0A=
=0A=
###################=0A=
echo " swap new fstab with original..."=0A=
###################=0A=
=0A=
cd $bakrootdir/etc=0A=
if test -w fstab.recover=0A=
then=0A=
     mv fstab fstab.orig=0A=
     cp fstab.recover fstab=0A=
else=0A=
     echo "no fstab.recover found... exiting"=0A=
     exit 1=0A=
fi=0A=
=0A=
###################=0A=
echo " swap new rc.config with original... "=0A=
###################=0A=
=0A=
cd $bakrootdir/etc=0A=
if test -w rc.config.recover =0A=
then=0A=
     mv rc.config rc.config.orig=0A=
     cp rc.config.recover rc.config=0A=
else=0A=
     echo "no rc.config.recover found... exiting"=0A=
     exit 1=0A=
fi=0A=
=0A=
###################=0A=
echo " remove symlink to swapdefault..."=0A=
###################=0A=
=0A=
cd $bakrootdir/sbin=0A=
if test -h swapdefault=0A=
then=0A=
     rm swapdefault=0A=
else=0A=
     echo "no swapdefault link found... skipping symlink creation."=0A=
     exit 0=0A=
fi=0A=
=0A=
###################=0A=
echo " create new symlink to swapdefault..."=0A=
###################=0A=
=0A=
ln -s /dev/rz10b swapdefault=0A=

