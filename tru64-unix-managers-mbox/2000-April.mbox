>
> #!/bin/ksh
> #
> #  dir_tree
> # Display from current Directory Tree.
> #
> homedir=`pwd`
> dodir=""
> dowhat="Files and Directories"
> set -- `getopt d $*`
> if [ "$?" != "0" ]
> then
>         exit 1
> fi
>
> while [ "$1" != "--" ]
> do
>         case $1 in
>                 -d)     dodir="-type d " export dodir
>                         dowhat="Directories only" export dowhat
>                 ;;
>         esac
>         shift
> done
> shift
>
> if [ "$1" != "" ]
> then
>         cd $1
> fi
>
> { echo "$dowhat ... Directory: `pwd`"
> find . $dodir -print | sed '
>         s:^'$base':|:
>         s:/\([^/]*\)$:?? \1:
>         s:/[^ ?/]*:   |:g
>         s:?:_:g
>         '
> }
>
> cd $homedir
>
