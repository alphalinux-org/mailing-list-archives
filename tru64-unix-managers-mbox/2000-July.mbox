/----- snip1 ----------------------------/
AnsiString s="Test Test";

while( int Pos = s.AnsiPos(" ") )
{
   s = s.SubString(1, Pos - 1) + s.SubString(Pos + 1, s.Length() - Pos);
}
/----- end snip1 ------------------------/

/----- snip2 ----------------------------/
AnsiString s="Test Test";

while( int Pos = s.AnsiPos(" ") )
   s = s.SubString(1, Pos - 1) + s.SubString(Pos + 1, s.Length() - Pos);

