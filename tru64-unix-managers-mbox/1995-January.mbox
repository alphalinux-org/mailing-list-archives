{
  double x;

  x = 1.0;
  tmp(x);
}

void tmp( double xx )
{
  double fkn1, fkn2, arg, aux1, aux2;
  
  aux2 = xx;
  aux1 = 1.0;

  /** original definition - gives the inverse of the correct thing **/
  fkn1 = exp(-aux1 * aux2);

  /** alternative definition - gives the correct result **/
  arg = aux1 * aux2;
