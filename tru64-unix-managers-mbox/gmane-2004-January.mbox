...
NETDEV_0=3D=
"ee0"
export NETDEV_0
IFCONFIG_0=3D"172.16.4.1 netmask 255.255.255.0"
export IFCONFIG_0
NUM_NETCONFIG=3D"1"
export NUM_NETCONFIG
