	JobList $PRN=0A=
	echo -n "Please select a Number from 1 to $JSEL (0=3Dquit):  " =0A=
	read SEL=0A=
	while (  expr \( "${SEL}" \< "0" \) \| \( "${SEL}" \> "${JSEL}" \) =
2>/dev/null ) ; do=0A=
		JobList $PRN=0A=
		echo -n "Please select a Number from 1 to $JSEL (0=3Dquit):  " =0A=
		JOB=3D0	=0A=
		read SEL		=0A=
	done # end while=0A=
	if [ ${SEL} -ne 0 ] ; then=0A=
	=0A=
		JOB=3D`echo $JOBS | awk '{ print $'${SEL}' }' ` =0A=
	else=0A=
