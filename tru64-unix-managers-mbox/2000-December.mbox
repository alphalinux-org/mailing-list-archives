		QS=3D`lpc status ${i}| grep -v ${i}| grep -v daemon |grep -v =
1999|grep -v is|awk '{ print $1 }'`=0A=
		if [ "X${QS}" =3D 'Xno' ] ;then=0A=
			QS=3D0=0A=
		fi=0A=
