		echo -n "Please select a Printer from 1 to $ROW (0=3Dquit):  " =0A=
		read SEL		=0A=
	done # end while=0A=
	[ ${SEL} =3D 0 ] && exit 0=0A=
=0A=
	SO=3D0=0A=
	for i in  $PRNS ; do=0A=
		SO=3D`expr ${SO} + 1`=0A=
		if [ ${SO} =3D  ${SEL} ] ; then=0A=
			PRN=3D${i} =0A=
			break=0A=
		fi=0A=
	done=0A=
}=0A=
=0A=
SelectJ() {=0A=
	SEL=3D0=0A=
	OK=3D0=0A=
