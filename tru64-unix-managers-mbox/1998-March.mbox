     # mount -t cdfs -o noversion /dev/rz5c /mnt
     
     and 
     
     # mount -rt cdfs -o noversion /dev/rz5c /mnt
     
     and 
     
     # mount -r /dev/rz5c /mnt
     
     None of these mount flags work?
     
     The ideal is to copy all the Documentation files off the 
