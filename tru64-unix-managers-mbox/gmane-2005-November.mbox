I have found a small bug in the /usr/sbin/dupatch delivered as part of =
5.1.b PK4.
The version is
# @(#)$RCSfile: dupatch.sh,v $ $Revision: 1.1.2.56 $ (DEC) $Date: =
2004/06/07 14:40:21 $

and the problem is the following function:

FitsetSetup()
{
	PWD=3D`pwd`

	DEF_USRRSV=3D40960
	DEF_ROOTRSV=3D15360

	DUK=3D
	HOSTNAME=3D`/usr/sbin/rcmgr get HOSTNAME`
	[ "$HOSTNAME" ] &&
	{
		HOSTNAME=3D`Parse . $HOSTNAME | awk '{print $1}'`
		HOSTNAME=3D`Ucase $HOSTNAME`
		[ -d /usr/sys/$HOSTNAME ] &&
