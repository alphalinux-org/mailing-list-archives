   to get port of nfs and mount daemon

2: on client:
   # ssh -f -L 7777:nfs-server:2049 -l user nfs-server /sbin/sleep =
86400

3: on client:
   # ssh -f -L 8888:nfs-server:2219 -l user nfs-server /sbin/sleep =
86400

4: on client:
   # mount -t nfs -o tcp,port=3D7777, mountport=3D8888
