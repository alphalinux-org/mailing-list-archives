Body contains "one-time mail"
Body contains "$$$"
Body contains "order today"
Body contains "order now!"
Body contains "money-back guarantee"
Body contains "100% satisfied"
Body contains " mlm"
Body contains "@mlm"
Body contains "///////////////"
Body contains "check or money order"
