#!/usr/bin/perl
$printer=3D$ARGV[0];
open(PRINTER,"</etc/printcap");
while($line=3D<PRINTER>){
  if ($line =3D~ /^$printer[:\|]/) {
    while($line=3D<PRINTER>){
      chomp($line);
      if ($line =3D~ /:sd/) {
        print substr($line,(index($line,"sd:")+6),length($line)-7);
        print("\n");
        close PRINTER;
        exit
      }
    }
  }
  close printer
}



