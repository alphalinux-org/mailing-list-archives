	{ "pdrv_unit_table" },
#define	NM_CAM		(1)
	{ "nCAMBUS" },
	{ NULL }
} ;

main()
{
	int n_pdrv = NDPS * NLPT, n_cam, i ;
	struct pdrv_unit_elem *table, *p, *lastp ;

