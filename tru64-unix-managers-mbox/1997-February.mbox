#include <stdio.h>
#include <sys/sysinfo.h>

int     status, *int_buff;

main()
{
if( -1 == (status = getsysinfo(GSI_PHYSMEM, &int_buff, sizeof(int_buff),
0, 0)) )
        fprintf(stdout, "error %d getting GSI_PHYSMEM\n", status);
else
        fprintf(stdout, "Physical memory in use: %d KB\n",
(int)int_buff);
}
