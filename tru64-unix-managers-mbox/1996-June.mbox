acs>     mode_t  my_umask;
acs>     
acs>     my_umask = umask(0077);     /* octal 077 */
acs>  
acs> #if defined(__svr4__) && defined(__sparc)
acs>     execv("/usr/sbin/in.ftpd", argv );
acs> #elif defined(__alpha)
acs>     execv("/usr/sbin/ftpd", argv );
acs> #endif
acs> 
