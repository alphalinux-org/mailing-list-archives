        :mx#0:\
        :of=/usr/lbin/ln03rof:\
        :pl#66:\
        :pw#80:\
        :sd=/usr/spool/lpd:\
        :sh:\
        :xc#0177777:\
        :xf=/usr/lbin/xf:\
