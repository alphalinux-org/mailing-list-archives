#include <stdio.h>
#include <stdlib.h>
main(int argc, char **argv)
{
        int status;
        char on[6]={27,'[','5','i','',0};
        char off[5]={27,'[','4','i',0};
        FILE *pf=NULL;
        char ch;
        if (argc < 2) {
           printf("Usage : pcprint <file>");
           exit(1);
        };
        if ((pf=fopen(argv[1],"r"))==NULL) {
                fprintf(stderr,"pcprint: Can't open file %s\n",argv[1]);
                perror("pcprint");
                exit(1);
                }
        status=fputs(on,stdout);

        if (status == EOF)
        {
            fprintf(stderr,"pcprint: Error while turning printer on");
            perror("pcprint");
            exit(1);
        }
        while ((ch=fgetc(pf))!=EOF) {
                   putc(ch,stdout);
         } /* end while */
        status=fputs(off,stdout);
        if (status == EOF)
        {
            fprintf(stderr,"pcprint: Error while turning printer off");
            perror("pcprint");
        }
        fclose(pf);
        exit(0);
}

