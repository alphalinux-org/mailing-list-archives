   read  yn?"Delete $SETNAME  <y/n>  "
done

if [[ $yn = N ]] ;  then 
   echo exiting  $SETNAME  deletion script...
   exit
fi



# delete the netalias
/sbin/init.d/$BASENAME stop


echo rm $SKRIPT
     rm $SKRIPT
echo rm $SSK
     rm $SSK
echo rm $KSK
