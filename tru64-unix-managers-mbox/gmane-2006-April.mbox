2:14.06, rsh florida cd /disk04/oradata/psprod_from_odin/hotback/current

cnx_oadm     , 95316,  0.3,  0.0, 2.48M, 352K, ??       ,S N  ,00:01:00,
1:10.32, /home/app/oracle/local/HIGH_CPU_PROC_CHECK.sh 90
