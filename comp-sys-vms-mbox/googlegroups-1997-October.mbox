Hi.

I use a command procedure like this:

$ set noon
$ if p1 .nes. ""
$ then
$       pid=p1
$       goto Check_pid
$ endif
$
$Enter_pid:
$ read/end=Finito/prompt="Enter PID: " sys$command pid
$Check_pid:
$ prcnam=f$getjpi(pid,"prcnam")
$ if "''prcnam'" .eqs. "" then goto Enter_pid
$ if prcnam .eqs. "" then goto Enter_pid
$
$ open/write ud sys$login:analsys.com
$ write ud "$ define/user sys$output sys$login:anal.lis"
$ write ud "$ anal/system"
$ write ud "set proc """,prcnam,""""
$ write ud "show proc/channel"
$ write ud "$ exit"
$ close ud
$ @sys$login:analsys
$
$ of=0
$ open/read/error=Finito ind sys$login:anal.lis
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ read/end=Finito ind lin
$ write sys$output "Open files for ",prcnam
$File_loop:
$ read/end=Finito ind lin
$ fil=f$extract(27,999,lin)
$ if f$locate("[",fil) .eq. f$length(fil) then goto File_loop
$ of=of+1
$ write sys$output "    ",f$element(0," ",fil)
$ goto File_loop
$
$Finito:
$ if f$trnlnm("IND") .nes. "" then close ind
$ if of .eq. 0 then -
        write sys$output "      none..."
$ delete/nolog sys$login:anal.lis;*
$ delete/nolog sys$login:analsys.com;*



