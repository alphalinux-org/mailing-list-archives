/*

   Fast tan/cotan approximation including range reduction by Joachim Wesner,

   <joachim.wesner@frankfurt.netsurf.de>, see also mc 8/1991 p. 78-93.

   Done in June/July 1998.

*/

/* improved and modified by Kazushige Goto <goto@statabo.rim.or.jp> */

/*

   now including illegal/denormal argument handling by Kazushige Goto and

   Joachim Wesner (Nov 1998).

*/

/*

    entirely revised by Kazushige Goto <goto@statabo.rim.or.jp>

*/

        .set noat

        .set noreorder

#ifdef __ELF__

        .section .rodata

#else

        .rdata

#endif

        .align 5

$K:

        .t_floating  6.746518852e9			 # 2**32*pi/2

        .t_floating  6.36619772367581382433e-1		 # 2./M_PI

        .t_floating  1.57079601287841796875e0

        .t_floating  3.13916416416759602726e-7

        .t_floating  6.22337217189661338378e-14

        .t_floating -3.5852891647471419219e+001

        .t_floating  5.1513699203375195243e+004

        .t_floating -2.6773388479715725433e+005

        .t_floating -6.2589095005702739694e+002

        .t_floating  6.8746022970978239588e+003

        .t_floating -9.3681685518878501841e+005

        .t_floating  2.0072489111748832058e+006

.text

        .align 5

        .globl	tan

        .ent	tan

tan:

        lda	$30, -32($30)

        ldgp	$29,.-tan($27)

        stt	$f16,  0($30)

#ifdef PROF

        lda	$28, _mcount

        jsr	$28, ($28), _mcount

        unop

        unop

#endif

        .prologue 1	

        lda	$28,  $K

        lda	$6, 0x7ff

        lda	$8, 0x41f

        sll	$6, 52, $6

        ldq	$5, 0($30)

        sll	$8, 52, $8

        ldt	$f18,   0($28)		# K[0]

        ldt	$f19,   8($28)		# K[1]

        fabs	$f16, $f0

        and	$5, $6, $7

        unop

        beq	$7, $TanSubNormal

        cmplt	$8, $7, $0

        bne	$0, $Inf_and_NaN

# Now we can calculate.

        mult	$f16, $f19, $f19	# z = x * K[1]

        ldt	$f20,  16($28)		# K[2]

        ldt	$f21,  24($28)		# K[3]

        ldt	$f22,  32($28)		# K[4]

        ldt	$f23,  40($28)		# K[5]

        ldt	$f24,  48($28)		# K[6]

        ldt	$f25,  56($28)		# K[7]

        cmptlt  $f18, $f0, $f18		# |arg| >= max. |arg| ?

        ldt	$f26,  64($28)		# K[8]

        mult	$f16, $f16, $f12	# y  = x * x

        cvttq	$f19, $f17		# float -> quad

        ldt	$f27,  72($28)		# K[9]

        ldt	$f28,  80($28)		# K[10]

        cvtqt	$f17, $f10		# quad  -> float

        fbeq	$f17, $SkipReduction

        mult	$f10,  $f20, $f20	# z * K[2]

        mult	$f10,  $f21, $f21	# z * K[3]

        mult	$f10,  $f22, $f22	# z * K[4]

        subt	$f16, $f20, $f16

        subt	$f16, $f21, $f16

        subt	$f16, $f22, $f16

        mult	$f16, $f16, $f12	# y  = x * x

        .align 4

$SkipReduction:

        mult	$f12, $f12, $f13	# y1 = y * y

        stt	$f17,   8($30)

        ldt	$f29,  88($28)		# K[11]

        mult	$f23, $f12, $f23	# r1 = K[5] * y

        mult	$f24, $f12, $f24	# r4 = K[6] * y

        fneg	$f16, $f10

        mult	$f25, $f12, $f25	# r2 = K[7] * y

        ldq	$0, 8($30)

        mult	$f13, $f12, $f14	# y2 = y1 * y

        addt	$f12, $f26, $f26	# r3 = y  + K[8]

        addt	$f23, $f27, $f23	# r1 = r1 + K[9]

        and	$0, 1, $0

        addt	$f24, $f28, $f24	# r4 = r4 + K[10]

        stq	$0, 16($30)

        addt	$f25, $f29, $f25	# r2 = r2 + K[11]

        mult	$f26, $f14, $f26	# r3 = r3 * y2

        mult	$f24, $f12, $f24	# r4 = r4 * y

        ldt	$f11, 16($30)

        mult	$f23, $f13, $f23	# r1 = r1 * y1

        fbne	$f18, $Inf_and_NaN

        fcmovne	$f11, $f10, $f16

        lda	$30, 32($30)

        addt	$f26, $f24, $f26	# r3 = r3 + r4

        addt	$f23, $f25, $f23	# r1 = r1 + r2

        addt	$f26, $f29, $f26	# r3 = r3 + K[12]

        unop

        mult	$f23, $f16, $f23	# r1 = r1 * x

        beq	$0, $Skip

        divt	$f26, $f23, $f0

        ret

$Skip:

        divt	$f23, $f26, $f0

        ret

        .align 4

$TanSubNormal:

        fmov	$f16, $f0

        lda	$30, 32($30)

        ret

        .end tan

        .align 5

        .globl	cotan

        .ent	cotan

cotan:

        lda	$30, -32($30)

        ldgp	$29,.-cotan($27)

        stt	$f16,  0($30)

#ifdef PROF

        lda	$28, _mcount

        jsr	$28, ($28), _mcount

        unop

        unop

#endif

        .prologue 1	

        lda	$28,  $K

        lda	$6, 0x7ff

        lda	$8, 0x41f

        sll	$6, 52, $6

        ldq	$5, 0($30)

        sll	$8, 52, $8

        ldt	$f18,   0($28)		# K[0]

        ldt	$f19,   8($28)		# K[1]

        fabs	$f16, $f0

        and	$5, $6, $7

        unop

        beq	$7, $CotanSubNormal

        cmplt	$8, $7, $0

        bne	$0, $Inf_and_NaN

# Now we can calculate.

        mult	$f16, $f19, $f19	# z = x * K[1]

        ldt	$f20,  16($28)		# K[2]

        ldt	$f21,  24($28)		# K[3]

        ldt	$f22,  32($28)		# K[4]

        ldt	$f23,  40($28)		# K[5]

        ldt	$f24,  48($28)		# K[6]

        ldt	$f25,  56($28)		# K[7]

        cmptlt  $f18, $f0, $f18		# |arg| >= max. |arg| ?

        ldt	$f26,  64($28)		# K[8]

        mult	$f16, $f16, $f12	# y  = x * x

        cvttq	$f19, $f17		# float -> quad

        ldt	$f27,  72($28)		# K[9]

        ldt	$f28,  80($28)		# K[10]

        cvtqt	$f17, $f10		# quad  -> float

        fbeq	$f17, $CotanSkipReduction

        mult	$f10,  $f20, $f20	# z * K[2]

        mult	$f10,  $f21, $f21	# z * K[3]

        mult	$f10,  $f22, $f22	# z * K[4]

        subt	$f16, $f20, $f16

        subt	$f16, $f21, $f16

        subt	$f16, $f22, $f16

        mult	$f16, $f16, $f12	# y  = x * x

        .align 4

$CotanSkipReduction:

        mult	$f12, $f12, $f13	# y1 = y * y

        stt	$f17,   8($30)

        ldt	$f29,  88($28)		# K[11]

        mult	$f23, $f12, $f23	# r1 = K[5] * y

        mult	$f24, $f12, $f24	# r4 = K[6] * y

        fneg	$f16, $f10

        mult	$f25, $f12, $f25	# r2 = K[7] * y

        ldq	$0, 8($30)

        mult	$f13, $f12, $f14	# y2 = y1 * y

        addt	$f12, $f26, $f26	# r3 = y  + K[8]

        addt	$f23, $f27, $f23	# r1 = r1 + K[9]

        and	$0, 1, $0

        addt	$f24, $f28, $f24	# r4 = r4 + K[10]

        stq	$0, 16($30)

        addt	$f25, $f29, $f25	# r2 = r2 + K[11]

        mult	$f26, $f14, $f26	# r3 = r3 * y2

        mult	$f24, $f12, $f24	# r4 = r4 * y

        ldt	$f11, 16($30)

        mult	$f23, $f13, $f23	# r1 = r1 * y1

        fbne	$f18, $Inf_and_NaN

        fcmovne	$f11, $f10, $f16

        lda	$30, 32($30)

        addt	$f26, $f24, $f26	# r3 = r3 + r4

        addt	$f23, $f25, $f23	# r1 = r1 + r2

        addt	$f26, $f29, $f26	# r3 = r3 + K[12]

        unop

        mult	$f23, $f16, $f23	# r1 = r1 * x

        beq	$0, $CotanSkip

        divt	$f23, $f26, $f0

        ret

$CotanSkip:

        divt	$f26, $f23, $f0

        ret

        .align 4

$CotanSubNormal:

        stq	$6,  0($30)

        ldt	$f0, 0($30)

        bge	$2,$Non_Negative

        fneg	$f0, $f0

$Non_Negative:

        lda	$30, 32($30)

        ret

        .align 4

$Inf_and_NaN:

        lda	$0, -1

        stq	$0,   0($30)

        ldt	$f0,  0($30)

        lda	$30, 32($30)

        ret

        .end cotan

