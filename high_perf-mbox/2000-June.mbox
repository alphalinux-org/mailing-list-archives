+                            ((end - addr ) >= (PAGE_SIZE << page_gh_order[i]))) {

+				if (handle_mm_fault_pages(mm, vma, addr, write, i) < 0)

+					return -1;

+				addr += PAGE_SIZE << page_gh_order[i];

+			};

+		}

         } while (addr < end);

