diff -rup 2.2.3/include/asm-alpha/semaphore-helper.h 2.2.3-axp/include/asm-alpha/semaphore-helper.h
--- 2.2.3/include/asm-alpha/semaphore-helper.h	Sat Mar 13 10:43:40 1999
