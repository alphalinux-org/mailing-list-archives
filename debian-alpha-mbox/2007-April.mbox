	name="local-waitpid-not-cancel.diff"
Content-Transfer-Encoding: quoted-printable
Content-Disposition: attachment;
	filename="local-waitpid-not-cancel.diff"

diff -ur sysdeps/unix/sysv/linux/not-cancel.h =
sysdeps/unix/sysv/linux/not-cancel.h=0A=
--- sysdeps/unix/sysv/linux/not-cancel.h	2003-09-04 16:05:12.000000000 =
+0200=0A=
+++ sysdeps/unix/sysv/linux/not-cancel.h	2007-04-19 13:46:59.000000000 =
+0200=0A=
@@ -55,6 +55,11 @@=0A=
 # define waitpid_not_cancel(pid, stat_loc, options) \=0A=
   INLINE_SYSCALL (waitpid, 3, pid, stat_loc, options)=0A=
 #else=0A=
-# define waitpid_not_cancel(pid, stat_loc, options) \=0A=
-  INLINE_SYSCALL (wait4, 4, pid, stat_loc, options, NULL)=0A=
+# if defined(__alpha__) =0A=
+#  define waitpid_not_cancel(pid, stat_loc, options) \=0A=
+   wait4(pid, stat_loc, options, NULL)=0A=
+# else=0A=
+#  define waitpid_not_cancel(pid, stat_loc, options) \=0A=
+   INLINE_SYSCALL (wait4, 4, pid, stat_loc, options, NULL)=0A=
+# endif=0A=
 #endif=0A=

