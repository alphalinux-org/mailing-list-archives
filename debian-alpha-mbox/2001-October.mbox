extern asmlinkage void ret_from_rproc(void) __asm__("ret_from_rproc");

int kernel_thread_rproc(void (*fn)(void *, struct pt_regs *), void *arg, 
			unsigned long flags, pid_t pid)
{
	long retval, d0;

	__asm__ __volatile__(
		"movl %%esp,%%esi\n\t"
		"int $0x80\n\t"		/* Linux/i386 system call */
		"cmpl %%esp,%%esi\n\t"	/* child or parent? */
		"je 1f\n\t"		/* parent - jump */
		"subl %8,%%esp\n\t"	/* space for user-registers */
		/* Load the arguments into eax, edx, and push them.
		 * That way, it does not matter whether the called function
		 * is compiled with -mregparm or not.  */
		"movl %4,%%eax\n\t"
		"movl %%esp,%%edx\n\t"
		"pushl %%edx\n\t"
		"pushl %%eax\n\t"		
		"call *%5\n\t"		/* call fn (won't return on error) */
		"addl $8,%%esp\n\t"
		"jmp ret_from_rproc\n\t"
		"1:\t"
		:"=&a" (retval), "=&S" (d0)
		:"0" (__NR_clone_with_pid), "i" (__NR_exit),
		 "r" (arg), "r" (fn),
		 "b" (flags | CLONE_VM | IS_KTHREAD), "r" (pid),
		 "i" (sizeof(struct pt_regs))
		: "memory");
	return retval;
}

