Content-Type: text/plain; charset=us-ascii
Content-Disposition: attachment; filename="libtool.m4.20030204.ccc.patch"
Content-Transfer-Encoding: quoted-printable

--- ../libtool-1.4.3/libtool.m4	Tue Feb  4 22:06:40 2003
+++ /usr/share/aclocal/libtool.m4	Tue Feb  4 22:05:13 2003
@@ -972,6 +972,21 @@
       fi
       ;;
=20
+    linux*)
+      $rm conftest.c
+      cat > conftest.c <<EOF
+  #if defined(__DECC) || defined(__DECCXX)
+    yes;
+  #endif
+  EOF
+      if { ac_try=3D'${CC-cc} -E conftest.c'; { (eval echo $progname:@LINE=
NO@: \"$ac_try\") 1>&5; (eval $ac_try) 2>&5; }; } | egrep yes >/dev/null 2>=
&1; then
+        # All DEC C code is PIC.
+        wl=3D'-Wl,'
+        link_static_flag=3D'-non_shared'
+      fi
+      $rm conftest.c
+      ;;
+
     *)
       lt_cv_prog_cc_can_build_shared=3Dno
       ;;

