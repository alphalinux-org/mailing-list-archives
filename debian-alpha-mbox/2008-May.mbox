        if ((regs.REG_ORIG_ACCUM =3D=3D SYS_read || regs.REG_ORIG_ACCUM =3D=
=3D SYS_write) && (regs.REG_PARAM3 =3D=3D regs.REG_ACCUM)) {
                for (unsigned int i =3D 0; i < regs.REG_PARAM3; i++) {
                        unsigned int a =3D ptrace(PTRACE_PEEKTEXT, pid, reg=
s.REG_PARAM2 + i, 0);
#ifdef _BIG_ENDIAN
                        a =3D bswap_32(a);
#endif
                        if(!modified) {
                                //Before we add text or change the color, m=
ake sure we are at the end
                                moveCursor(QTextCursor::End);
                        }
                        if(regs.REG_ORIG_ACCUM !=3D lastdir) {
                                if(regs.REG_ORIG_ACCUM =3D=3D SYS_read)
