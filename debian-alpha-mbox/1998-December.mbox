--- glibc-2.0.7u/sysdeps//unix/sysv/linux/alpha/chown.c	Thu Jan  1 01:00:00 1970
+++ glibc-2.0.7u.new/sysdeps//unix/sysv/linux/alpha/chown.c	Sat Dec 12 01:09:13 1998
@@ -0,0 +1,41 @@
