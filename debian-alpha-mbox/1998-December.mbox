+++ glibc-2.0.7u.new/sysdeps//unix/sysv/linux/alpha/sysdep.h	Sat Dec 12 01:09:13 1998
@@ -26,6 +26,9 @@
 
 /* There is some commonality.  */
 #include <sysdeps/unix/alpha/sysdep.h>
+#ifndef __NR_lchown
+#define __NR_lchown 208
+#endif
 
