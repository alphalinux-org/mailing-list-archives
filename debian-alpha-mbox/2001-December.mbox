diff -burN gentoo-0.11.18/src/gentoo.h gentoo-patched/src/gentoo.h
--- gentoo-0.11.18/src/gentoo.h	Sat Sep  1 15:21:37 2001
+++ gentoo-patched/src/gentoo.h	Sat Dec  8 17:19:21 2001
@@ -13,14 +13,14 @@
 
 #include "config.h"
 
-#if !defined __alpha		/* I've heard this helps on Alpha systems... */
+#if !(defined(__alpha) && defined(__osf__))	/* I've heard this helps on Alpha systems... */
 #define __EXTENSIONS__
 #define _POSIX_C_SOURCE	3	/* This is for Solaris. */
 #define	POSIX_C_SOURCE	3
 
-#endif				/* !__alpha */
+#endif				/* !__alpha && !__osf__ */
 
-#if defined __osf__ && defined __alpha__		/* On Tru64, this should bring in mknod(). */
+#if defined(__osf__) && defined(__alpha__)		/* On Tru64, this should bring in mknod(). */
 #define	_XOPEN_SOURCE_EXTENDED
 #define	_OSF_SOURCE					/* For MAXNAMLEN on Tru64. */
 #endif

