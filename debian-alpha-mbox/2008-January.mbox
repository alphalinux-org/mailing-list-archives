   x *= (1.0f / 65536.0f);
   x *= (1.0f / 65536.0f);
   x *= (1.0f / 65536.0f);
   x *= (1.0f / 65536.0f);
   x *= (1.0f / 32.0f);
   g(x);
   y = x;
   g(y);
}

