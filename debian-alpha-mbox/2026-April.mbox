--- debian/control.orig	2025-11-22 18:25:50.000000000 +0100
+++ debian/control	2026-04-13 17:37:17.996915777 +0200
@@ -10,7 +10,7 @@
  libtbb-dev (>= 2021.9.0),
  libzstd-dev,
  zlib1g-dev,
- clang,
+ clang [amd64 arm64 armhf i386 loong64 ppc64el risc64 s390x powerpc ppc64 sparc64 x32],
