--===============2554842148981370067==
Content-Type: text/plain; charset="us-ascii"
MIME-Version: 1.0
Content-Transfer-Encoding: 7bit
Content-Disposition: attachment; filename="doxygen-disable-llvm-alpha.patch"

diff -Nru old/doxygen-1.8.13/debian/control new/doxygen-1.8.13/debian/control
--- old/doxygen-1.8.13/debian/control	2018-03-12 09:22:14.000000000 +0100
+++ new/doxygen-1.8.13/debian/control	2018-12-15 14:52:21.790295464 +0100
@@ -11,8 +11,8 @@
   libxapian-dev (>= 1.2.21-1.2),
   cmake,
   yui-compressor,
-  llvm-6.0-dev [alpha amd64 armel armhf arm64 i386 mips mipsel mips64el powerpc powerpcspe ppc64 ppc64el s390x sparc64],
-  libclang-6.0-dev [alpha amd64 armel armhf arm64 i386 mips mipsel mips64el powerpc powerpcspe ppc64 ppc64el s390x sparc64],
+  llvm-6.0-dev [amd64 armel armhf arm64 i386 mips mipsel mips64el powerpc powerpcspe ppc64 ppc64el s390x sparc64],
+  libclang-6.0-dev [amd64 armel armhf arm64 i386 mips mipsel mips64el powerpc powerpcspe ppc64 ppc64el s390x sparc64],
   sassc,
 Build-Depends-Indep: texlive-fonts-recommended,
   texlive-generic-recommended,
diff -Nru old/doxygen-1.8.13/debian/rules new/doxygen-1.8.13/debian/rules
--- old/doxygen-1.8.13/debian/rules	2018-03-12 09:22:14.000000000 +0100
+++ new/doxygen-1.8.13/debian/rules	2018-12-15 14:51:47.306294233 +0100
@@ -20,7 +20,7 @@
 
 export LLVM_CONFIG = llvm-config-6.0
 
-clang_archs = alpha amd64 armel armhf arm64 i386 mips mipsel mips64el \
+clang_archs = amd64 armel armhf arm64 i386 mips mipsel mips64el \
 	powerpc powerpcspe ppc64 ppc64el s390x sparc64 \
 
 #	kfreebsd-amd64 kfreebsd-i386

