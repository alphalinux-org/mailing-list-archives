-I$(BUILDINCDIR) -o target src libs=0A=
=0A=
/* ComplexHostProgramTarget - Compile a program such that we can run=0A=
 * it on this host, i.e., don't use the default cross compiler.=0A=
 */=0A=
#ifndef ComplexHostProgramTarget=0A=
#define	ComplexHostProgramTarget(program)				@@\=0A=
              CC=3DHostCcCmd							@@\=0A=
    STD_INCLUDES=3D							@@\=0A=
          CFLAGS=3D$(TOP_INCLUDES) $(INCLUDES) $(BOOTSTRAPCFLAGS)		@@\=0A=
EXTRA_LOAD_FLAGS=3D							@@\=0A=
        PROGRAM =3D program						@@\=0A=
									@@\=0A=
AllTarget(HostProgramTargetName(program))				@@\=0A=
									@@\=0A=
HostProgramTargetName(program): $(OBJS) $(DEPLIBS)			@@\=0A=
	RemoveTargetProgram($@)						@@\=0A=
	HostLinkRule($@,$(_NOOP_),$(OBJS),$(DEPLIBS) $(LOCAL_LIBRARIES)) @@\=0A=
									@@\=0A=
DependTarget()								@@\=0A=
									@@\=0A=
LintTarget()								@@\=0A=
									@@\=0A=
clean::									@@\=0A=
	RemoveFile(HostProgramTargetName(program))=0A=
#endif /* ComplexHostProgramTarget */=0A=
=0A=
=0A=
#ifndef SimpleHostProgramTarget=0A=
