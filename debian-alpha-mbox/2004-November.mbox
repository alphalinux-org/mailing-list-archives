----------------------------
ametzler@spe142:/tmp/ametz$ cat statfstest.c
#include <stdio.h>
#include <sys/statvfs.h>
#include <sys/vfs.h>

int main(void) {
  struct statvfs buf;
  struct statfs buf2;

  if (statvfs("/var/spool", &buf) == -1) {
    perror("statvfs");
    return 1;
  }
  if (statfs("/var/spool", &buf2) == -1) {
    perror("statfs");
    return 1;
  }

  printf("            statvfs     statfs\n");
  printf("f_blocks:%10ld %10ld\n", buf.f_blocks,
                  buf2.f_blocks);
