ccc -o crrtree -O RRTree.c -lm

ccc -o crrtree -O RRTree.c -lffm -lm

ccc -o crrtree -O RRTree.c -lcpml -lffm -lm

ccc -o crrtree -O1 RRTree.c -lcpml -lffm -lm

ccc -o crrtree -O2 RRTree.c -lcpml -lffm -lm

