Content-Type: text/plain; charset="us-ascii"
MIME-Version: 1.0
Content-Transfer-Encoding: 7bit
Content-Disposition: attachment; filename="libdeflate-alpha-fix.patch"

--- debian/rules.orig	2022-10-03 13:55:19.000000000 +0200
+++ debian/rules	2023-01-13 16:48:12.970221727 +0100
@@ -4,6 +4,10 @@
 
 export DEB_BUILD_MAINT_OPTIONS=hardening=+all
 
+ifeq (alpha,$(DEB_HOST_ARCH))
+	export DEB_CFLAGS_MAINT_APPEND=-O1
+endif
+
 %:
 	dh $@
 

