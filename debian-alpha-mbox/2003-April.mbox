Kerstin Hoef-Emden <Kerstin.Hoef-Emden@Uni-Koeln.DE> writes:

> The window frames in mozilla, however, are still absent.

Here's a patch for fvwm. I've also filed a bug report, so hopefully
this will be fixed in sarge soon.

-- 
	Falk


--=-=-=
Content-Type: text/x-patch
Content-Disposition: attachment; filename=fvwm-mwmhints.patch

--- fvwm/decorations.c~	2003-02-08 14:09:43.000000000 +0100
+++ fvwm/decorations.c	2003-04-09 14:07:49.000000000 +0200
@@ -73,10 +73,10 @@
 /* Motif  window hints */
 typedef struct
 {
-  CARD32      flags;
-  CARD32      functions;
-  CARD32      decorations;
-  INT32       inputMode;
+  ulong      flags;
+  ulong      functions;
+  ulong      decorations;
+  long       inputMode;
 } PropMotifWmHints;
 
 typedef PropMotifWmHints        PropMwmHints;

--=-=-=--



