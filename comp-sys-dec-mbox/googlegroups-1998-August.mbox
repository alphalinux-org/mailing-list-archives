>     YEAR = YEAR - 1
>   ENDIF
>   DATE = (YEAR-1910)*365      ! 365 days per year
>        + (YEAR-1910+2)/4      ! leap day every four years
>        + (MONTH+1)*28         ! amazing days per month calculation
>        + (26*MONTH-2)/10
>        + DAY
>        + 6                    ! magic number to make it all
>                               ! come out right,
>                               ! but coincidentally the number of days
>                               ! from Dec 26 to Jan 1.
>
