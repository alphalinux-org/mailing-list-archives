Sorry, I don't do FAX.  But here's a VMS SMGTERMS definition for
an ADDS terminal.  Clear screen is just ^L, cursor positioning is
a la the VT52.

Hope this helps,

Aaron

Aaron Leonard           MultiNet-VMS@Support.TGV.COM [ work ]        
                        Leonard@Leonard.Tucson.AZ.US [ home ]

---

! ADDS Regent 20 - should be valid for all ADDS terminals
! from ADDS Display Terminal Guide, p 2-20
!
NAME = 'ADDS'
    BOOLEAN
        advanced_video = 0,
        ansi_crt = 0,
        auto_margin = 0,
        backspace = 1,
        dec_crt = 0,
        dec_crt_2 = 0,
        edit = 0,
        eight_bit = 0,
        fulldup = 1,
        lowercase = 1,
        no_scroll = 0,
        physical_ff = 1,
        physical_tabs = 0,              ! ?
        regis = 0,
        scope = 1
    NUMERIC
        columns = 80,
        number_fn_keys = 16,            ! Regent 40 and 60 only
        rows = 24,
        wide_screen_columns = 80
    STRING
        set_cursor_abs = "$Y(%1+31)(%2+31)",    ! a la VT52
        cursor_down = "^J",             cursor_up = "^Z",
        cursor_right = "^F",            cursor_left="^H",
        home = "^A",                    erase_whole_display = "^L",
        erase_to_end_line = "$K",       erase_to_end_display = "$k",
        key_down_arrow = "^J",          key_up_arrow = "^Z",
        key_right_arrow = "^F",         key_left_arrow = "^H",
        !
        ! function keys - Regent 40 and 60 only
        key_f1 = "^B1", key_f2 = "^B2", key_f3 = "^B3", key_f4 = "^B4",
        key_f5 = "^B5", key_f6 = "^B6", key_f7 = "^B7", key_f8 = "^B8",
        ! function keys 9-16 are function keys 1-8 shifted
        key_f9 = "^B_!",        key_f10 = "^B_"",       key_f11 = "^B#",
        key_f12 = "^B_$",       key_f13 = "^B%",        key_f14 = "^B_&",
        key_f15 = "^B_'",       key_f16 = "^B_("
END



