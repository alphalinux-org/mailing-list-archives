+ #define	DES_SP_ENCRYPT_ROUND(left, right, temp, kp) \
+ 	(temp) = (right) ^ *(kp)++; \
+ 	(left) ^= SP[0][((temp) >> 24) & 0x3f] \
+ 		| SP[1][((temp) >> 16) & 0x3f] \
+ 		| SP[2][((temp) >>  8) & 0x3f] \
+ 		| SP[3][((temp)      ) & 0x3f]; \
+ 	(temp) = (((right) >> 12) | ((right) << 20)) ^ *(kp)++; \
+ 	(left) ^= SP[4][((temp) >> 24) & 0x3f] \
+ 		| SP[5][((temp) >> 16) & 0x3f] \
+ 		| SP[6][((temp) >>  8) & 0x3f] \
