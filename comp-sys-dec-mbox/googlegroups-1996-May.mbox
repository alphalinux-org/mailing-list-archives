	list='uname uerf rc startup lp lmf fstab df advfsdmns sysdisk files named route 
syslog mail users crontab ntp firewall'

	Title "System Census for `hostname`"
	echo "<body>"
	Header 1 "System Census for `hostname`"
	Header 2 "`date`"

	#+
	# First, generate the table of contents.
	#-
	Header 2 "<a name=\"_contents\">Table of Contents</a>"
	echo "<ol>"
	for section in $list; do
		echo "<li><a href=\"#$section\">`Section $section`</a>"
	done
	echo "</ol>"

	#+
	# Now, generate the contents.
	#-
	secnum=1
	export secnum
	for section in $list; do
		$0 - $section
		secnum=`expr $secnum + 1`
	done
	echo "<hr>"
	echo "<address>Generated by $0 on `date`.</address>"
	echo "<address>Original author: Peter Mayne, Digital Equipment Corporation</address>"
	echo "</body>"
