Note: the observed remarkable slowness of an Alpha system seems
to be partly due to a compiler bug. I tried compiling the same
sources, with the same options, to be confronted with optimizer
core-dumps. Compiling the same code with -O1 in stead of -O2
produced faster code than before... The old binary which
somehow got through the optimizer still runs at the reported
'speed'.

So the Alpha people can relax now... Or can they? Read on.

I hacked up a little benchmark (unaware of the compiler bug).
The benchmark compiles without a problem. It consists of a
simplified version of the performance bottleneck in the
original, with some hardwired values tossed around to make
it work. Notably some (byte!) accesses to large data structures
have been omitted/replaced. Source is appended below.

Results so far:

system       | time (sec.) | cc options
-------------------------------------------
Sun IPC      | 65.1        | -O2 -fsingle
Indigo R3000 | 23.7        | -O2 -ansi
Indigo R3000 | 16.5        | *
DEC 3000-500 | 11.0        | -O2 -std        (Clock frequency?)
HP 730       |  5.0        | +O2 +r

* - with trivial tuning of compiler output for R3000. Tuning
    is not needed for R4000.

Maybe some kind soul could add R4000 results (or results for
the newer HP systems).

Well, what do you think? I'm still rather unimpressed with the
Alpha results - somewhere between an old 50 MHz PA-RISC and a
33 MHz R3000... Can we expect much better from compilers soon?

- Reinoud



/*----------------------------------------------------------------------------

    Andromeda1 benchmark

----------------------------------------------------------------------------*/

#include <stdlib.h>
#include <string.h>


main()
{
    register float d_xwx, d_ywx, d_zwx;
    register float d_xwp, d_ywp, d_zwp;
    register float d_xwz, d_ywz, d_zwz;
    register int k, d_c;
    register float d_z;
    register float d_zp, d2_x, d2_y;
    register unsigned char *mpix;
	     float d_xwi, d_ywi, d_zwi;
	     int i, j;
	     unsigned char pix[1048576];
	     float suzy;

    mpix=pix+524800;
    suzy=atof("0.0");
    d_xwx=1018.88+suzy;
    d_ywx=1.024+suzy;
    d_zwx= -0.1+suzy;
    d_xwz=102.4+suzy;
    d_ywz=880.64+suzy;
    d_zwz=0.5+suzy;
    
    for (i=0; i<10; i++)
    {
      memset(pix, 0, 1048576);
      
      d_xwp= -574095.375+suzy;
      d_ywp=261619.71875+suzy;
      d_zwp= -2713.120117-i+suzy;
      d_xwi=d_xwp;
      d_ywi=d_ywp;
      d_zwi=d_zwp;

      for (j=0; j<1024; j++)
      {
	d_z=0;
	d_zp=d_z*d_zwz+d_zwp;
	d_zwp+=d_zwx;
	d2_y=(d_z*d_ywz+d_ywp)/d_zp;
	d_ywp+=d_ywx;
	d2_x=(d_z*d_xwz+d_xwp)/d_zp;
	d_xwp+=d_xwx;
  
	for (k=1; k<1024; k++)
	{
	  d_z=(float)(k&0xfec);
	  d_zp=d_z*d_zwz+d_zwp;
	  d_zwp+=d_zwx;
	  
	  mpix[((int)d2_y<<10)-(int)d2_x]=k-1;
	  
	  d2_y=(d_z*d_ywz+d_ywp)/d_zp;
	  d_ywp+=d_ywx;
	  d2_x=(d_z*d_xwz+d_xwp)/d_zp;
	  d_xwp+=d_xwx;
	}
	
	mpix[((int)d2_y<<10)-(int)d2_x]=k-1;
  
	d_xwi-= -102.4;
	d_ywi-=512.0;
	d_zwi-= -0.86;
	d_xwp=d_xwi;
	d_ywp=d_ywi;
	d_zwp=d_zwi;
      }
    }

    return 0;
}


