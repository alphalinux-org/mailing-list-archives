I wouldn't. Let's see... Windows file names don't have newlines or
backslashes in the filename part, so this should be safe:

#!/bin/sh

ls ${1+"$@"} | while read file
  do
    target="`echo $file | tr '[A-Z ~]' '[a-z__]'`"
    newfile="$target"
    index=0
    while [ -f $newfile ]
    do
      index="`expr $index + 1`"
      newfile="$target.$index"
    done
    if [ ".$file" != ".$newfile" ]
    then mv "$file" "$newfile"
    fi
  done

