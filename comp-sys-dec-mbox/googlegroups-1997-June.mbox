I was looking for a similar program on HP-UX. I think it may work as well
on an Alpha machine (please let me know).

-----------begin-------------
| #include <stdio.h>
| #include <fcntl.h>
| #include <sys/ioctl.h>
| #include <netio.h>
| 
| int main()
| {
|     int lan;
|     struct fis f;
| 
|     if ((lan = open("/dev/lan0", O_RDONLY)) == -1) {
|         printf("Can't open /dev/lan0\n");
|         exit(1);
|     }
|     f.reqtype = LOCAL_ADDRESS;
|     if (ioctl(lan, NETSTAT, &f) == -1) {
|         printf("ioctl failed\n");
|         exit(1);
|     }
|     printf("LAN Address = 0x%02x%02x%02x%02x%02x%02x\n",
|       f.value.s[0],
|       f.value.s[1],
|       f.value.s[2],
|       f.value.s[3],
|       f.value.s[4],
|       f.value.s[5]);
|     exit(0);
| }
------------end--------------

You may have to be root to run this program.

