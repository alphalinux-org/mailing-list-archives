#include <stdio.h>
#include <starlet.h>
#include <descrip.h>
#define SYS$ASCEFC sys$ascefc
#define SYS$SETEF sys$setef
#define SYS$CLREF sys$clref
#define SYS$READEF sys$readef


main()
  {
    long VMSsts, EFstate;
    $DESCRIPTOR(EFcluster,"MY_EVENT_FLAGS");

    if (!((VMSsts=SYS$ASCEFC(64,&EFcluster,0,0))&1)) return VMSsts;

    if (!((VMSsts=SYS$SETEF(64))&1)) return VMSsts;

    if (!((VMSsts=SYS$READEF(64,&EFstate))&1)) return VMSsts;
    printf("%08X\n",EFstate);

    if (!((VMSsts=SYS$CLREF(64))&1)) return VMSsts;

    if (!((VMSsts=SYS$READEF(64,&EFstate))&1)) return VMSsts;
    printf("%08X\n",EFstate);
  }


Simple enuf?
