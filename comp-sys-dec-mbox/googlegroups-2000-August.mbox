    KB=`/usr/sbin/sizer -wk | cut -c -2`
    case $KB in
    LK) # OSF1 LK2xx or LK4xx VMS style keyboards
      ${DECXTERM_EMULATOR:=/usr/bin/X11/xterm} \
                           -xrm 'xterm*VT100.Translations: #override\n\
        Shift<Key>F1                  :string("\033") string("[23~")\n\
