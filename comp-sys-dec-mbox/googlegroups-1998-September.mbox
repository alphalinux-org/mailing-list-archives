A portable solution that will work on any UNIX is to chdir into the
same directory as the file to be deleted, check that it's the same
directory you think it is, then delete the file. Something like:

W="` 	'"'$"'		# whitespacish type stuff we want to skip
find /tmp -type f -mtime +7 -print | grep '^/tmp' | grep -v "$W" |
  while read victim
  do
    d=`dirname "$victim"`
    f=`basename "$victim"`
    (
      cd "$d"
      if [ "`pwd`" = "$d" ]
      then
        rm "$f"
      fi
    )
  done

-- 
