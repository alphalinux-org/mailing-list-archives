        xsh.width = width;
        xsh.height = height;
        cout<<"I am in the win constructor."<<endl;
        if ((pDisp = XOpenDisplay(NULL)) == NULL) {
            cout<< "Can't open display"<<endl;
        };
        mainWin = XCreateSimpleWindow(pDisp,
                                      DefaultRootWindow(pDisp),
                                      xsh.x, xsh.y, xsh.width, xsh.height,
                                      1,        /* default_bdwidth */
                            fgPix = BlackPixel(pDisp, DefaultScreen(pDisp)),
                            bgPix = WhitePixel(pDisp, DefaultScreen(pDisp))
                );
        XFlush(pDisp);
        XSelectInput(pDisp, mainWin, ExposureMask | ButtonPressMask |
                              Button1MotionMask | ButtonReleaseMask);
        XFlush(pDisp);
        XMapRaised(pDisp, mainWin);

        xgcv.foreground = fgPix;
        xgcv.background = bgPix;
        xgcv.function = GXcopy;
        cout<<fgPix<<";;;"<<bgPix<<endl;
        mask = GCForeground | GCBackground | GCFunction;
       mask = GCForeground | GCBackground | GCFunction;
        cout<<mask<<";;;"<<bgPix<<endl;
        gc = XCreateGC(pDisp, mainWin, mask, &xgcv);
        XFlush(pDisp);
        XClearWindow(pDisp, mainWin);
        XNextEvent(pDisp,&the_event);
        while(the_event.type != Expose) ;   /* wait for window popping up */ 
                                         XDrawLine(pDisp,mainWin,gc,100,100,500`
        cout<<"end of window."<<endl;
}

void ZWindow::lineto(int x, int y)
{
        p0 = cp;
        cp.x = x;
        cp.y = y;
        XDrawLine(pDisp, mainWin, gc, p0.x, p0.y, cp.x, cp.y);
        XFlush(pDisp);
        return;
}
void ZWindow::line(int x1, int y1, int x2, int y2)
{
        cp.x = x1; cp.y = y1;
        lineto(x2, y2);
        return;
}

void ZWindow::moveto(int x, int y)
{
        cp.x= x; cp.y = y;
        return;
}
