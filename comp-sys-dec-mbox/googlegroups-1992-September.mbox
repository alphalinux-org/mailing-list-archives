Code obtained from: dano@petrucio.ae.utexas.edu (Dano Carroll); 
Changes the record length of a file via RMS calls. High wizardry.

      OPTIONS /EXTEND_SOURCE
      subroutine fixupfile(filename)
      character*(*) filename
      integer*4 lib$spawn, status, reclen 
 
      INCLUDE '($SYSSRVNAM)'
      INCLUDE '($FABDEF)/LIST'
      INCLUDE '($NAMDEF)/LIST'
      INCLUDE '($RMEDEF)/LIST'
      INCLUDE '($RMSDEF)/LIST'
      RECORD /FABDEF/ MYFAB
      RECORD /NAMDEF/ MYNAM
      byte  RESNAME(NAM$C_MAXRSS), EXPNAME(NAM$C_MAXRSS)   
C
C	Set file attribute block values
C
      MYFAB.FAB$B_BID = FAB$C_BID
      MYFAB.FAB$B_BLN = FAB$C_BLN
      MYFAB.FAB$L_FNA = %LOC(FILENAME)

      MYFAB.FAB$B_FNS = LENGTH(FILENAME)

      MYFAB.FAB$B_FAC = FAB$M_PUT
      MYFAB.FAB$L_FOP = IOR(FAB$M_ESC,MYFAB.FAB$L_FOP)
      MYFAB.FAB$L_FOP = IOR(FAB$M_NAM,MYFAB.FAB$L_FOP)
      MYFAB.FAB$L_CTX = IOR(RME$C_SETRFM,MYFAB.FAB$L_CTX)
      MYFAB.FAB$W_IFI = 0
      MYFAB.FAB$L_NAM = %LOC(MYNAM)
      MYNAM.NAM$B_BID = NAM$C_BID
      MYNAM.NAM$B_BLN = NAM$C_BLN
      MYNAM.NAM$L_RSA = %LOC(RESNAME)
      MYNAM.NAM$B_RSS = NAM$C_MAXRSS
      MYNAM.NAM$L_ESA = %LOC(EXPNAME)
      MYNAM.NAM$B_ESS = NAM$C_MAXRSS
C
C	Parse the file specification
C
      STATUS = SYS$PARSE(MYFAB)
      IF ( .NOT. STATUS ) CALL LIB$SIGNAL(%VAL(STATUS))
C
C	Search for the file
C
      STATUS = SYS$SEARCH(MYFAB)
      IF ( .NOT. STATUS ) CALL LIB$SIGNAL(%VAL(STATUS))
C
C	  Open the file
C
      STATUS = SYS$OPEN(MYFAB)
      IF ( .NOT. STATUS ) CALL LIB$SIGNAL(%VAL(STATUS))
      if (MYFAB.FAB$W_MRS .eq. 512) then
c         presumably file was copied over; convert record length
c         to Beat's 80*4 = 320
C	  It will be in bytes (not longwords), unlike in other places
C
         MYFAB.FAB$W_MRS = 320
         STATUS = SYS$MODIFY(MYFAB)
         IF ( .NOT. STATUS ) CALL LIB$SIGNAL(%VAL(STATUS))
      else 
         if (MYFAB.FAB$W_MRS .ne. 320) then
            type *,'-W- File QBUFFER.BUF has weird record length'
         endif
      endif
C     
C     Close the file
C     
      STATUS = SYS$CLOSE(MYFAB)
      IF ( .NOT. STATUS ) CALL LIB$SIGNAL(%VAL(STATUS))

      end

--
