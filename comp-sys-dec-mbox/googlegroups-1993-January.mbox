		sizeof(ttstart), 0, 0, 0, 0);	/* get current settings */

	SYS$QIOW(qiow_efn, Fdtty, IO$_SETMODE, &iosb, 0, 0,
		&ttstart, sizeof(ttstart), 0, 0,
		(ttparms.parity<<4)|TT$M_BREAK, 0);	/* set the break bit */

	SYS$WAITFR(delay_efn);		/* wait (at least) 200 msec. */

	SYS$QIOW(qiow_efn, Fdtty, IO$_SETMODE, &iosb, 0, 0, 
		&ttstart, sizeof(ttstart), 
		ttparms.speed, ttparms.fill,		/* restore prev state */
		(ttparms.parity>>4)|(1<<TT$V_ALTRPAR), 0);

