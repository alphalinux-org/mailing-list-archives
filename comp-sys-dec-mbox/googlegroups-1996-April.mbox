------------------------- IntList.H -------------------------

#ifndef INTLISTH
#define INTLISTH

#include "MyList.H"

class intnode : public listnode<intnode> {
protected:
  int i;
public:
  int Get_i(void) { return(i); }
};

class intlist : public list<intnode> {
protected:
  // Empty
public:
  // Empty
};

#endif

--------------------------- MyList.H ------------------------------
#ifndef MYLISTH
#define MYLISTH

template <class nodetype>
class listnode {
protected:
  long int index;
  nodetype *next;
  nodetype *prev;
public:
  listnode();
  virtual ~listnode();

  nodetype *Next(void) { return(next); }
  nodetype *Prev(void) { return(prev); }
};

template <class nodetype>
class list {
protected:
  nodetype *head;    // head of list 
  nodetype *tail;    // tail of list
  nodetype *current; // current element
  long int num;      // number of elements in list
public:
  list();
  virtual ~list();
};

template <class nodetype>
listnode<nodetype>::~listnode(void)
{
  // Empty
}

template <class nodetype>
listnode<nodetype>::listnode(void)
{
  next=NULL; prev=NULL; index=0;
}

template <class nodetype>
list<nodetype>::list(void)
{
  num=0; head=NULL; tail=NULL; current=NULL;
}

template <class nodetype>
list<nodetype>::~list(void)
{
  // Empty
}

#endif

