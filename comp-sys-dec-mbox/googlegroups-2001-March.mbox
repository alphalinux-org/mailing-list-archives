#include <stdio.h>
#include <stdlib.h>

main ()
{
   FILE *inp;
   char buffer[81];
   int count;

   inp = fopen("indata","r");

   if (inp == NULL)
   {
      perror("unable to open indata");
      exit(0);
   }

   count = fscanf(inp, "%s", buffer);
   if (count != 1)
   {
      fprintf(stderr,"where's the data?\n");
      exit(0);
   }

   printf("%s\n",buffer);

}


