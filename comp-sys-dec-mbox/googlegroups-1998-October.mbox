Here's a version of 'ldd' for DigitalUnix I picked up somewhere.

#!/bin/sh
# This is a shell archive (produced by GNU sharutils 4.2).
# To extract the files from this archive, save it to some FILE, remove
# everything before the `!/bin/sh' line above, then type `sh FILE'.
#
# Made on 1998-10-09 09:40 MDT by <grunwald@foobar.cs.colorado.edu>.
# Source directory was `/tmp_mnt/home/foobar/grunwald/Src'.
#
# Existing files will *not* be overwritten unless `-c' is specified.
#
# This shar contains:
# length mode       name
# ------ ---------- ------------------------------------------
#    642 -rw-r--r-- ldd/README
#    366 -rw-r--r-- ldd/Makefile
#   3735 -rw-r--r-- ldd/ldd.c
#   1710 -rw-r--r-- ldd/ldd.1
#
save_IFS="${IFS}"
IFS="${IFS}:"
gettext_dir=FAILED
locale_dir=FAILED
first_param="$1"
for dir in $PATH
do
  if test "$gettext_dir" = FAILED && test -f $dir/gettext \
     && ($dir/gettext --version >/dev/null 2>&1)
  then
    set `$dir/gettext --version 2>&1`
    if test "$3" = GNU
    then
      gettext_dir=$dir
    fi
  fi
  if test "$locale_dir" = FAILED && test -f $dir/shar \
     && ($dir/shar --print-text-domain-dir >/dev/null 2>&1)
  then
    locale_dir=`$dir/shar --print-text-domain-dir`
  fi
done
IFS="$save_IFS"
if test "$locale_dir" = FAILED || test "$gettext_dir" = FAILED
then
  echo=echo
else
  TEXTDOMAINDIR=$locale_dir
  export TEXTDOMAINDIR
  TEXTDOMAIN=sharutils
  export TEXTDOMAIN
  echo="$gettext_dir/gettext -s"
fi
touch -am 1231235999 $$.touch >/dev/null 2>&1
if test ! -f 1231235999 && test -f $$.touch; then
  shar_touch=touch
else
  shar_touch=:
  echo
  $echo 'WARNING: not restoring timestamps.  Consider getting and'
  $echo "installing GNU \`touch', distributed in GNU File Utilities..."
  echo
fi
rm -f 1231235999 $$.touch
#
if mkdir _sh23912; then
  $echo 'x -' 'creating lock directory'
else
  $echo 'failed to create lock directory'
  exit 1
fi
# ============= ldd/README ==============
if test ! -d 'ldd'; then
  $echo 'x -' 'creating directory' 'ldd'
  mkdir 'ldd'
fi
if test -f 'ldd/README' && test "$first_param" != -c; then
  $echo 'x -' SKIPPING 'ldd/README' '(file already exists)'
else
  $echo 'x -' extracting 'ldd/README' '(text)'
  sed 's/^X//' << 'SHAR_EOF' > 'ldd/README' &&
README for ldd.
X
This is a version of ldd for Alpha's running DEC OSF/1. Its based on
the SUNOS one in functionality, although the sunos one is probably the
more polished of the two. ldd requies no special priviledges to run.
Installing is a case of 'make', followed by 'make install'.
X
Currently (2/2/94) ldd does not support all the environment variables
that loader(1) uses - these will be added as time permits, and if people
want them. See the man page for more details.
X
As with the rest of OSF/1 1.x, ldd knows about library versions, where
they exist, but doesnt know what to do with them
X
Anthony Baxter, <anthony.baxter@aaii.oz.au>
SHAR_EOF
  $shar_touch -am 0202085994 'ldd/README' &&
  chmod 0644 'ldd/README' ||
  $echo 'restore of' 'ldd/README' 'failed'
  if ( md5sum --help 2>&1 | grep 'sage: md5sum \[' ) >/dev/null 2>&1 \
  && ( md5sum --version 2>&1 | grep -v 'textutils 1.12' ) >/dev/null; then
