hmm ... I wasn't able to reproduce that one but found another
interesting thing:



/* c89 -DL1 -DL2 -DBIGNUM=<something large> */

main (int ac, char **av)
{
        switch (ac) {
#ifdef L1
                case -1:
                        break;
#endif
#ifdef L2
                case 1:
                        break;
#endif
#ifdef BIGNUM
                case BIGNUM:
                        break;
#endif
        }
}

/* end */




If you use cc or leave out one of { -DL1 -DL2 -DBIGNUM=... } everything
works fine.
