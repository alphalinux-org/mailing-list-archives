system on an Alpha workstation. This same code works great on machines  
using the version 1.2 OSF operating system. Running this very simple test  
program causes a segmentation fault immediately upon entering the main  
function! The code and Makefile is shown below. Please send replies via  
internet email to kent@kentaurus.gsfc.nasa.gov. Thanks...

======================================================================

alpha> cat hjunk.c

/*
 filename: hjunk.c
 purpose:  c - wrapper for fortran junk subroutine
 author:   Kent Blackburn - kent@kentaurus.gsfc.nasa.gov
*/

#include <stdio.h>

int main (argc,argv)
int argc;
char **argv;
{
 void junk_();

 junk_();
 return(0);
}

alpha> cat junk.f

C Simple fortran subroutine called by C
C
        subroutine junk
        print*,'hello world'
        return
        end

alpha> cat Makefile

# Makefile for junk program:

F77LIBS = -L/usr/lib -ldnet_stub -lUfor -lfor -lFutil -lm -lots -lc
CFLAGS  = -I./ -g

all:	junk

junk:	hjunk.o junk.o 
	$(CC) -o junk $(CFLAGS) hjunk.o junk.o $(F77LIBS)

FFLAGS = -c -g
junk.o:	junk.f
	$(FC) $(FFLAGS) $<



