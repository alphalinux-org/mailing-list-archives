#include <stdio.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <sys/devio.h>
X
char	*choose_name(char *try);
X
main(int argc, char *argv[])
{
X    /*
X      Ask SCSI disk for its device geometry information.
X    */
X    DEVGEOMST		buf;
X    int			f, s;
X    char		*t;
X    char		temp[128];
X    unsigned long	got;
X
#define P buf.geom_info
X
X    if (argc != 2)
X	usage();
X
X    if (strlen(argv[1]) > 40) {
X	fprintf(stderr,"Unlikely device name: %s\n", argv[1]);
X	exit(1);
X    }
X
X    t = choose_name(argv[1]);
X    f = open(t, O_RDONLY, 0666);
X    if (f != -1) {
X	s = ioctl(f, DEVGETGEOM, &buf);
X	if (s != -1) {
X	    printf("Device geometry information for %s\n", t);
X	    printf(" Total blocks: %d\n", P.dev_size);   /* number of blocks in the user area (#pc)*/
X	    printf("       tracks: %d\n", P.ntracks);    /* number of tracks per cylinder (#nt)    */
X	    printf("      sectors: %d\n", P.nsectors);   /* number of sectors per track (#ns)      */
X	    printf("    cylinders: %d\n", P.ncylinders); /* total number of cylinders   (#nc)      */
X	    printf("   attributes:");			 /* Device attributes; see defs below */
X	    got = 0;
#ifdef DEVGEOM_REMOVE
X	    if (P.attributes & DEVGEOM_REMOVE) {
X		printf(" Removeable_media");
X		got |= DEVGEOM_REMOVE;
X	    }
#endif
#ifdef DEVGEOM_DYNAMIC
X	    if (P.attributes & DEVGEOM_DYNAMIC) {
X		printf(" Dynamic_geometry");
X		got |= DEVGEOM_DYNAMIC;
X	    }
#endif
X	    if (P.attributes != got)
X		printf(" unknown:0x%x", P.attributes-got);
X	    else if (P.attributes == 0)
X		printf(" none");
X	    printf("\n");
X	}
X	else
X	    perror("ioctl failed");
X	close(f);
X    }
X    else {
X	sprintf(temp, "open failed for %s", t);
X	perror(temp);
X    }
X
X    exit(0);
}
X
usage()
{
X    printf("usage: sizedrive device\n");
X    printf("\tQuery SCSI disk drive for geometry infomation.\n");
X    exit(1);
}
X
char *
choose_name(char *try)
{
X    /*
X      Try to turn rzNNx into /dev/rrzNNx.
X    */
X    static char		temp[64], *t;
X    char		c;
X    int			i;
X    int			unit;
X
X    i = sscanf(try, "rz%d%c", &unit, &c);
X    if (i == 1) {
X	strcpy(temp, "/dev/r");
X	strcat(temp, try);
X	strcat(temp, "a");
X    }
X    else if (i == 2) {
X	strcpy(temp, "/dev/r");
X	strcat(temp, try);
X    }
X    else {
X	i = sscanf(try, "rrz%d%c", &unit, &c);
X	if (i == 1) {
X	    strcpy(temp, "/dev/");
X	    strcat(temp, try);
X	    strcat(temp, "a");
X	}
X	else if (i == 2) {
X	    strcpy(temp, "/dev/");
X	    strcat(temp, try);
X	}
X	else
X	    strcpy(temp, try);			/* punt */
X    }
X    return temp;
}
SHAR_EOF
