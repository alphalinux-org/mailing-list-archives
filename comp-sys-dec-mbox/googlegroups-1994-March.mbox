Although I'm about 10 days behind with this, I do have a solution for
this problem that is easy to use (unless you still have to install
perl, that is :-)

Greetings,
				Ripley

----8<---- /usr/local/bin/mem ----8<----
#!/usr/local/bin/perl
#
# Copyright 1993 by H.Eckert (ripley@nostromo.in-berlin.de)
# (Can you say ``GNU public licence'' ?  I knew you can...)
#

# If suid/sgid-scripts are available uncomment and remove the else-part
# You then need to set mem to sgid kmem...
#die "Permission denied on /dev/kmem.\n" unless (-r "/dev/kmem");
if (-r "/dev/kmem") {
	open (MEM,"/usr/etc/kvar -s physmem -rl -k /vmunix|")
		|| die "invokation of /usr/etc/kvar failed\n";
	while(<MEM>){
		($size) = /.* (.*)$/ ;
	}
	$memsize = (hex($size)*4);
}
else
{
	open (MEM, "/usr/etc/uerf -R -r 300|")
		|| die "invokation of /usr/etc/uerf failed\n";
	$i=0;$tmp="";
	while(($tmp=<MEM>) && ($i<30)){
		$size = $tmp if grep(/real mem/, $tmp);
		$i++;
	}
	($memsize) = $size =~ /.*=(.*)$/;
	$memsize /= 1024;
}

print ("This machine has ". $memsize . "KB of physical memory.\n");
