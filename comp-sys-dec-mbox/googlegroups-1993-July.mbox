/*
   Program  :  read_keystrokes.c
   Author   :  Korben Kirscht
   Site     :  EDS / Unigraphics, Cypress, CA
   Date     :  24-April-1993


   Since the curses keyboard functions do not pass special keys correctly on
   VMS, one must use the SMG Virtual Keyboard routines for getting characters
   from the keyboard.

   This program was designed to test the keyboard and print the integer value
   passed back by the keyboard routines.  This integer value may then be
   associated with a defined value and comparisons may be made within your
   application. (ie. if (keystroke == UP_ARROW) )  Within my application
   programs I make these definitions in a header file named "keydefs.h".
   (see example below)


*/



#include <curses.h>
#include <smgdef.h>
#define bool int




main ()

{



     WINDOW *win1;

     int keyboard,    /*  Pointer to keyboard */ 
         status;      /*  General status field for checking return values  */

     short keystroke; /* Holds key entered on the keyboard */




  /*  Create the virtual keyboard and return the pointer to the keyboard
      into keyboard variable.
  */

     if ( ((status = SMG$CREATE_VIRTUAL_KEYBOARD(&keyboard))&1) !=1 ) return;
  




  /*  Create a basic window.  Nothing is displayed on the window however */

     initscr(); 

     win1 = newwin(15, 10, 5, 5);

     wrefresh(win1);

     refresh();

  


  /*  Read a keystroke from the virtual keyboard  */

  SMG$READ_KEYSTROKE(&keyboard,&keystroke); 

  /*  Within your *REAL* application, you may test the keystroke against 
      defined values from "keydefs.h".

      Example:  if ( keystroke == UP_ARROW ) ...

  */




      endwin(); 





  /*  Print the printable translation of the keystroke and the integer value
      returned from the SMG routine.  The integer value is used in "keydefs.h"
  */

     fprintf(stdout, "\n%c(%d)", keystroke, keystroke );




}
/*

keydefs.h

        Defines       Integer from SMG$SMG$READ_KEYSTROKE



   ...  Stuff deleted  ...

#define BACKSPACE     8
#define UP_ARROW      274
#define DOWN_ARROW    275
#define LEFT_ARROW    276
#define RIGHT_ARROW   277
#define RETURN        13
#define ESCAPE        291
#define TAB           9
#define CTRLW         23



   ...  Stuff deleted  ...

*/


