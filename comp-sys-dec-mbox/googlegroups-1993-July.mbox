/******* hp7550f.c **********/

#include     <stdio.h>
#include     <sgtty.h>

#define BUFSIZE (1024)

main(argc, argv)
int argc;
char **argv;

{

    hp7550_init();

    hp7550_cat();

    exit(0);

}

hp7550_init()
{
    struct sgttyb params;

    ioctl(fileno(stdout), TIOCGETP, &params);
    params.sg_flags &= ~(ECHO|XTABS|CRMOD);
    params.sg_ospeed = params.sg_ispeed = B9600;
    ioctl(fileno(stdout), TIOCSETP, &params);

}

hp7550_cat()
{
    char c[BUFSIZE];
    register int got;

    while ((got = read(fileno(stdin), c , BUFSIZE)) > 0)
    {
        write(fileno(stdout), c, got);
    }
}


/* END OF CODE */


