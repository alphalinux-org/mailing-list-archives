Dec should have a prompt for a passwd in init before it goes single user.
I have solved this problem by patching init to use /etc/sh rather than /bin/sh

/etc/sh.c
----------------------------
#include <sys/types.h>
#include <signal.h>

#include <stdio.h>
#include <pwd.h>

main(argc,argv,envp)
char ** argv, **envp;
{
      if( isatty(0)
      &&  isatty(1)
      && *argv[0] == '-' )
      {
	struct  passwd *pwd, *getpwnam();
	register char *namep;
	char *pp;
	char *getpass(), *crypt() ;

	    signal(SIGTERM, SIG_IGN);
	    signal(SIGHUP, SIG_IGN);
	    signal(SIGALRM, SIG_IGN);
	    signal(SIGTSTP, SIG_IGN);
	    signal(SIGSTOP, SIG_IGN);
	    signal(SIGTTIN, SIG_IGN);
	    signal(SIGTTOU, SIG_IGN);

	    if ((pwd = getpwnam("root")) != NULL)
	    {
		do
		{
		    pp = getpass("Password:");
		    namep = crypt(pp, pwd->pw_passwd);
		} while(strcmp(namep, pwd->pw_passwd));
	    }

	    signal(SIGTERM, SIG_DFL);
	    signal(SIGHUP, SIG_DFL);
	    signal(SIGALRM, SIG_DFL);
	    signal(SIGTSTP, SIG_IGN);
			
      }
      execve("/bin/sh", argv, envp);
      exit(0);
}


