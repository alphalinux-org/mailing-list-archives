If the result that you are getting is "botched" then manually restore the
stack pointer (see setjmp.h) just before the longjmp, see my code example
below, where "SETSP" is the piece that you need.


 ##*********************************************************************
 ##
 ##   Author:         Charles Richmond , IIS Corporation.
 ##   Creation Date:  19-Jul-91
 ##
 ##**********************************************************************



        .globl  STKSTART
        .globl  GETSP
        .globl  SETSP


        .ent    STKSTART
STKSTART:

        .frame  $sp, 0, $31     ## the debuggers need .frame

        move    $sp, $4         ## Put the new stack address in.
        move    $3,  $5         ## put the ldr function address in r3
        move    $4,  $6         ## Move aguments 2 and 3 into
        move    $5,  $7         ## the arg 0 and 1 postions.

        j       $3              ## jump to the loader (not returning)
        .end    STKSTART


        .ent    GETSP
GETSP:
        subu    $sp, 8          ## get the value of the stack and
        .frame  $sp, 8, $31
        move    $2,  $sp        ## return it (r2) to the caller.
        j       $31
        .end    GETSP
SETSP:
        subu    $sp, 8          ## set the previous stack value
        .frame  $sp, 8, $31     ## in place to defeat the ULTRIX
        lw      $sp, 128($4)    ## test for corrupted stacks.
        j       $31             ## This hack depends on the setjmp
        .end    SETSP           ## storing the old stack 128 offset
                                ## from the address stored. !!!?!!!



Hope that this helps.

Charlie

