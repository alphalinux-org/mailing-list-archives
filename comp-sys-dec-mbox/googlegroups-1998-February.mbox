usleep_thread () = 0
gettimeofday (0x11fffd5d0, 0x0) = 0
             :
socket (AF_INET,STREAM,PF_UNSPEC) = 5
connect (5, 0x11fffd6c0=<2/INET, 59139, 129.186.140.50>, 16) =  -1,
  (Connection refused)
close (5) = 0
gettimeofday (0x11fffd5d0, 0x0) = 0
usleep_thread () = 0
gettimeofday (0x11fffd5d0, 0x0) = 0
socket (AF_INET,STREAM,PF_UNSPEC) = 5
connect (5, 0x11fffd6c0=<2/INET, 59139, 129.186.140.50>, 16) =  -1,
  (Connection refused)
                             <=== NOTE, no "close(5)" here!
getuid () = 129
open ("/usr/lib/nls/msg/C/libc.cat", O_RDONLY, 020002625670) = -1
  (No such file or directory)
getuid () = 129
open ("libc.cat", O_RDONLY, 020002625670) = -1
  (No such file or directory)
