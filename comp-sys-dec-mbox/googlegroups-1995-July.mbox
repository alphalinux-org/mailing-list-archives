Following works on a DEC 3000/600 running OSF/1 2.0:

# cat a_f.f
      program test
      external a
      integer*4 i
      i = 2
      call a(i)
      write(6,*) i
      stop
      end
# cat a_c.c
void a_(int *i){
	*i = 1;
}
# cc  -c a_c.c
# f77 -o a.out a_f.c a_c.o
# a.out
           1




