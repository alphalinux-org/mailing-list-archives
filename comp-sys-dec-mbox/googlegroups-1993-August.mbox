Michael Schroeder, one of the authors of screen was able to fix that
problem.  Do not use the "-YPOSIX" flag to cc if you are using cc.
Here is the patch:

*** ../../jnweiger/screen/tty.sh	Thu Aug  5 16:48:36 1993
--- tty.sh	Thu Aug 12 19:06:40 1993
***************
*** 516,521 ****
--- 516,524 ----
  
  /*
   *  Job control handling
+  *
+  *  Somehow the ultrix session handling is broken, so use
+  *  the bsdish variant.
   */
  
  /*ARGSUSED*/
***************
*** 523,529 ****
  brktty(fd)
  int fd;
  {
! #ifdef POSIX
    setsid();		/* will break terminal affiliation */
  # ifdef BSD
    ioctl(fd, TIOCSCTTY, (char *)0);
--- 526,532 ----
  brktty(fd)
  int fd;
  {
! #if defined(POSIX) && !defined(ultrix)
    setsid();		/* will break terminal affiliation */
  # ifdef BSD
    ioctl(fd, TIOCSCTTY, (char *)0);



