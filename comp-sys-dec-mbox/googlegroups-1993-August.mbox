We have come across some sort of weakness on the Dec Alpha that causes
a real slowdown in execution speed.  Even the Apple Quadra 900 running A/UX
runs rings around the Alpha on the following little test program.  Anyone
know why?

Here is the test program:

/*********************************************************/

#include<stdio.h>
#include <fcntl.h>

/*
 * Set RECSIZE to the size of each record ( up to 128 bytes ).
 * Set RECS to the number of writes.
 * Adjust them so that RECSIZE * RECS gives the desired size of file "foo".
 */
#define RECSIZE 13
#define RECS 5042

main()
{

  int fd,i,val;
  char buf1[128];
  char buf2[128];

  /* Fill up a couple of bogus buffers to write out */
  for( i = 0; i < RECSIZE; i++ ) {
    buf1[i] = 'X';
    buf2[i] = 'O'; 
  }

  unlink("./foo");
  fd = open("./foo",O_CREAT|O_RDWR,0644);

  /* 
   * Unbuffer stdout so I can see how fast things are printing out.
   */ 
  setbuf(stdout,NULL);

  printf("creating file...\n");
  for( i = 0; i < RECS; i++ ) {
    write(fd,buf1,RECSIZE);
    if ( !(i%100) )    /* print out every hundredth write. */
      printf("%d ",i);
  }
  printf("\n");

  printf("random access...\n");
  for ( i = 0; i < RECS; i++ ) {
    val = rand()%RECS;
    lseek(fd,0,0);        /* rewind the file then jump to a random offset */
    lseek(fd,val*RECSIZE,0);
    write(fd,buf2,RECSIZE);
    if ( !(i%100) )
      printf("%d ",val*RECSIZE);
  }
  printf("\n");
}


/******************************************************************/


Here is the output of uname -a on the alpha:

