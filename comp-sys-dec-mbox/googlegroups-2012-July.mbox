diff -r d480ad380981 -r 5fedd998fc73 src/mmap_fun.c
--- /dev/null	Thu Jan 01 00:00:00 1970 +0000
+++ b/src/mmap_fun.c	Mon Jul 30 15:58:08 2012 +0300
@@ -0,0 +1,230 @@
+#if CENV_MMAP
+
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include "mmap_fun.h"
+#include <string.h>
+
+#define MMAP_MAGIC	1270978931
+#define MMAP_MAGIC2	(MMAP_MAGIC + 0x01020304)
+
+#ifndef MMAP_DEBUG
+#define MMAP_DEBUG	0
+#endif
+
+struct mmap_info {
+  int	magic;
+  size_t	mmap_size;
+  int		pagesize;
+  char	fname[128];
+  char	vinfo[1024];
+};
+
+struct mmap_info2 {
+  int	magic;
+};
+
+char *
+tp_to_name(char *buf, int tp)
+
+{
+  int	pid,lp;
+  pid = mmap_tp_to_pid(tp);
+  lp = mmap_tp_to_lp(tp);
+  sprintf(buf,"mmap/%05d.%05d",pid,lp);
+  return buf;
+}
+
+static int	mmap_localpid = 0;
+
+int
+new_mmap_id()
+
+{
+  int	mypid = getpid();
+  int	thispid;
+
+  thispid = mmap_pid_lp_to_tp(mypid,mmap_localpid);
+  mmap_localpid++;
+  return thispid;
+}
+
+void *
+mmap_attach_by_tp(int thispid, size_t *memsizp)
+
+{
+  char	namebuf[100];
+  char	*mmap_fname;
+  int		fd = -1;
+  struct stat	stb;
+  void	*rp = 0;
+  void 	*ptr;
+  int	pagesize = getpagesize();
+  struct mmap_info	*ip;
+  struct mmap_info2	*ip2;
+  
+  mmap_fname = tp_to_name(namebuf,thispid);
+
+  MMAP_DEBUG && fprintf(stderr,"Pid:%d Attach: Opening file %s\n",getpid(),mmap_fname);
+  fd = open(mmap_fname,O_RDWR,0);
+  if (fd == -1) {
+    fprintf(stderr,"Pid:%d cannot open file %s\n",getpid(),mmap_fname);
+    goto err;
+  }
+  fstat(fd,&stb);
+  ptr = mmap(0,stb.st_size,PROT_READ|PROT_WRITE,MAP_SHARED|MAP_HASSEMAPHORE,fd,0);
+  MMAP_DEBUG && fprintf(stderr,"Pid:%d mmap returns %p\n",getpid(),ptr);
+  if (ptr == MAP_FAILED)
+    goto err;
+  if (minherit(ptr,stb.st_size,INHERIT_SHARE) != 0) {
+    fprintf(stderr,"Pid:%d minherit fails\n",getpid());
+  }
+  if (mlock(ptr,stb.st_size) != 0) {
+    fprintf(stderr,"Pid:%d mlock fails\n",getpid());
+  }
+  ip = ptr;
+  if (memsizp) {
+    *memsizp = ip->mmap_size - pagesize - pagesize;
+  }
+  if (ip->magic == MMAP_MAGIC) {
+    ip2 = ptr + ip->mmap_size - pagesize;
+    if (ip2->magic == MMAP_MAGIC2) {
+      MMAP_DEBUG && fprintf(stderr,"Pid:%d Mapped file %s %ld bytes, vinfo: %s\n",getpid(),mmap_fname,ip->mmap_size - pagesize,ip->vinfo);
+    } else {
+      fprintf(stderr,"Pid:%d Invalid magic2 %s\n",getpid(),mmap_fname);
+      goto err;
+    }
+  } else {
+    fprintf(stderr,"Pid:%d Invalid magic %s\n",getpid(),mmap_fname);
+    goto err;
+  }
+  rp = ptr + pagesize;
+ err:
+  if (fd != -1) {
+    close(fd);
+    fd = -1;
+  }
+  return rp;
+}
+
+void
+mmap_unmap_unlink(int thispid, void *ptr)
+
+{
+  char	namebuf[100];
+  char	*mmap_fname;
+  int		fd = -1;
+  struct stat	stb;
+  int	pagesize = getpagesize();
+  struct mmap_info	*ip;
+  
+  ip = ptr - pagesize;
+
+  mmap_fname = tp_to_name(namebuf,thispid);
+
+#if 0
+  fd = open(mmap_fname,O_RDWR,0);
+  if (fd == -1)
+    goto err;
+  fstat(fd,&stb);
+  munmap(ptr, stb.st_size);
+#else
+  munmap(ip, ip->mmap_size);
+#endif
+  unlink(mmap_fname);
+
+ err:
+  if (fd != -1) {
+    close(fd);
+    fd = -1;
+  }
+}
+
+void*
+mmap_new_segment(size_t memsiz0, int *thisid_p)
+
+{
+  int	thisid;
+  char	namebuf[100];
+  char	*mmap_fname;
+  void	*rp = 0;
+  void	*ptr;
+  int	fd = -1;
+  int	pagesize = getpagesize();
+  size_t	memsiz;
+  struct mmap_info	*ip;
+  struct mmap_info2	*ip2;
+
+  memsiz = pagesize + memsiz0 + pagesize;
+
+  thisid = new_mmap_id();
+
+  mmap_fname = tp_to_name(namebuf,thisid);
+
+  MMAP_DEBUG && fprintf(stderr,"Pid:%d Create: Opening file %s\n",getpid(),mmap_fname);
+  fd = open(mmap_fname,O_RDWR|O_CREAT|O_TRUNC,0666);
+
+  if (fd == -1) {
+    fprintf(stderr,"Pid:%d cannot open file %s\n",getpid(),mmap_fname);
+    goto err;
+  }
+
+  {
+    char	b[16*1024];
+    int	n;
+    size_t	o;
+    memset(b,0,sizeof(b));
+    
+    for(o = 0; o < memsiz; o += n) {
+      int	n0;
+      n0 = memsiz - o;
+      if (n0 > sizeof(b))
+	n0 = sizeof(b);
+      n = write(fd,b,n0);
+      if (n != n0) {
+	goto err;
+      }
+    }
+  }
+  
+#ifndef MAP_NOSYNC
+#define MAP_NOSYNC 0
+#endif
+  ptr = mmap(0,memsiz,PROT_READ|PROT_WRITE,MAP_SHARED|MAP_HASSEMAPHORE,fd,0);
+  MMAP_DEBUG && fprintf(stderr,"Pid:%d mmap returns %p\n",getpid(),ptr);
+  if (ptr == MAP_FAILED)
+    goto err;
+  
+  if (minherit(ptr,memsiz,INHERIT_SHARE) != 0) {
+    fprintf(stderr,"Pid:%d minherit fails\n",getpid());
+  }
+  if (mlock(ptr,memsiz) != 0) {
+    fprintf(stderr,"Pid:%d mlock fails\n",getpid());
+  }
+
+  ip = ptr;
+  ip->mmap_size = memsiz;
+  ip->pagesize = pagesize;
+  strncpy(ip->fname,mmap_fname,sizeof(ip->fname));
+  sprintf(ip->vinfo,"\n.....verbose\nFilename: %s\nPagesize: %d\nMemsize: %ld\n",mmap_fname,pagesize,(long int)memsiz);
+  ip->magic = MMAP_MAGIC;
+  ip2 = ptr + memsiz - pagesize;
+  ip2->magic = MMAP_MAGIC2;
+  rp = ptr + pagesize;
+  if (thisid_p)
+    *thisid_p = thisid;
+  MMAP_DEBUG && fprintf(stderr,"Pid:%d Mapped file %s %ld bytes\n",getpid(),mmap_fname,ip->mmap_size - pagesize);
+
+ err:
+  if (fd != -1) {
+    close(fd);
+    fd = -1;
+  }
+
+  return rp;
+
+}
+#endif
