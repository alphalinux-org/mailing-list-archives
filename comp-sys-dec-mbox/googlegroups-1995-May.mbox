distribution: world
references: <3mkrhi$88l@larch.cc.swarthmore.edu>  <MICHAELV.95Apr18232550@MindBender.HeadCandy.com>  <3n3h21$a47@inews.sc.intel.com> <3n9dkf$lsj@helena.MT.net> <PREP.95May1061848@yarrow.wt.com.au> <3om9kl$mjt@onramp.arc.nasa.gov> <3p8tvb$gsc@onramp.arc.nasa.gov> <3pamdo$n6h@onramp.arc.nasa.gov> <3pbtu5$j61@natasha.rmii.com>
organization: Netcom
