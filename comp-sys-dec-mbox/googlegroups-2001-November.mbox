        INC BLKN         ;keep a record of number of blocks output to
disk.
        CMP #20.,BLKN    ;maximum number of outputs is 20 blocks
        BGT BUFLP        ;if 20 blocks then exit finished.
        .CLOSE #0        ;close the output channel
        .PRINT #done
        .PRINT #DBG1
        .EXIT            ;  
;
; *** Errors and exit point, if cannot initialise.
;
FERR:   .PRINT #DNFMSG ;disk drive not available
        .EXIT
