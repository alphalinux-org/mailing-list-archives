//
// makerom.c
//
//	Convert a E/P/N image into a rom image
//
// History
//
//	11/12/2001 - Kevin Handy
//		Original Version
//

#include <stdio.h>
#include <stdlib.h>

//
// Main program
//
int main(int argc, char* argv[])
{
	FILE *fpin;
	FILE *fpout;
	char buffer[128];
	unsigned long base = 0;
	unsigned long last = 0;
	unsigned long loc;
	unsigned long code;
	unsigned long romsize = 0x20000;

	if (argc != 3)
	{
		fprintf(stderr, "makerom <source> <dest>\n");
		exit(EXIT_FAILURE);
	}

// fprintf(stderr, "Source: %s, dest %s\n", argv[1], argv[2]);

	fpin = fopen(argv[1], "r");
	if (fpin == 0)
	{
		fprintf(stderr, "Unable to open source file '%s'\n", argv[1]);
		exit(EXIT_FAILURE);
	}

	fpout = fopen(argv[2], "w");
	if (fpout == 0)
	{
		fprintf(stderr, "Unable to open output file '%s'\n", argv[2]);
		exit(EXIT_FAILURE);
	}

	while (fgets(buffer, sizeof(buffer), fpin) != NULL)
	{
		if (strncmp(buffer, "  P ", 4) == 0)
		{
			loc = strtoul(buffer + 4, 0, 16);
			code = strtoul(buffer + 14, 0, 16);

// printf(" P %08lx %08lx\n", loc, code);

			if (base == 0)
			{
				base = loc;
				last = loc;

				fputc(base & 0xff, fpout);
				fputc((base >> 8) & 0xff, fpout);
				fputc((base >> 16) & 0xff, fpout);
				fputc((base >> 24) & 0xff, fpout);

				fputc(romsize & 0xff, fpout);
				fputc((romsize >> 8) & 0xff, fpout);
				fputc((romsize >> 16) & 0xff, fpout);
				fputc((romsize >> 24) & 0xff, fpout);
			}
			else
			{
				if (last + 4 != loc)
				{
					printf("Missing values after %08lx\n", last);
				}
				last = loc;
			}

			fputc(code & 0xff, fpout);
			fputc((code >> 8) & 0xff, fpout);
			fputc((code >> 16) & 0xff, fpout);
			fputc((code >> 24) & 0xff, fpout);
		}
	}

	fclose(fpin);
	fclose(fpout);
}



