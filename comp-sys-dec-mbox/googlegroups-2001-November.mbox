// This program reads a binary output file. Each word is two bytes
// and converts the value into decimal ASCII numbers. 
// The bytes on the PC and PDP are both stored as Most Significant
Byte
// followed by Least Significant Byte.  Word = LSB + MSB. This is ok
because
// this is what the PC expects and it will shuffle the bytes.
//
#include <stdio.h>
#include <stdlib.h>
#include <io.h>
#include <fcntl.h>
#include <alloc.h>

#define RECSPERLINE  4
FILE *infile, *outfile;
main ()
{
int           bufcnt ; //data saved in blocks of 256 records.
unsigned int  totrecs; //counters for the number of blocks and recs
unsigned char reclncnt;//counter for outputing three records a line
int  fsrec, *ptrfsrec; //cannot use unsigned int because its 4 words
long on PC.
char          string[8];
//
// Executable statements
//
// open binary file for reading to be converted to ascii
//
infile=fopen("numdat.001","rb");
if (!infile) {
  puts ("Can't open numdata.001");
  exit (1);
}
if ((outfile = fopen("emudat.txt", "w"))
       == NULL)
   {
      puts("Cannot open output file rpdatnov.001.\n");
      return 1;
   }
//
// Both files are open and ready.
// initialize the counters
//
totrecs  =  0; //running total
reclncnt =  0; //used for counting number of records per line
//
ptrfsrec = &fsrec;
while (!feof(infile)){
  for(bufcnt=0; bufcnt <= 255; bufcnt++) {
    if (reclncnt < RECSPERLINE){  //checks how many records per line
have been output.
      fread(ptrfsrec, 2, 1, infile); //fread (*pointer, recordsize,
numberofrecs, filehandle)
      itoa(*ptrfsrec, string, 10);  // integer, string, radix
      fprintf(outfile,"%6s",string);
      reclncnt++; //counts the number of records output per line.
      totrecs++;  //sum of all records output.
    } else {  // starts a new line.
      fprintf (outfile,"%6u\n",totrecs);  //running total of records
read.
      reclncnt=0;
    } //end of if-else,for putting out 4 records per line.
  }// end of for statement for outputing a buffer full of information.
   // housekeeping and exit
}  // end of while statement
  fprintf (outfile,"%6u",totrecs);
  fprintf(outfile,"\n\nTotal number of records output = %5u",totrecs);
  fclose (infile);
  fclose (outfile);

return 0;
}
