;
; buffer full save buffer to disk.
;
        CLR BUFPTR;       ;reset for the next buffer
        MOV #WBUFF, R2    ;reset the buffer pointer to start of
buffer.
;
; output user information to the screen on how many buffers written.
;
        .PRINT #DBG5
        ADD #60,BLKN
        .TTYOUT BLKN
        .TTYOUT #12
        .TTYOUT #15
        SUB #60,BLKN
;
; end of user information.
;
        .WRITE #EMTAA,#0,#WBUFF, #256., BLKN     
