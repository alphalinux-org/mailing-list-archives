You're right. The following works, though, when compiled with ...

cc -taso -xtaso -o foo foo.c 

In this case, I've changed a single typedef to be a 4-byte pointer.

-----------------------------------------------------------------------------
#include <stdio.h>
#pragma pointer_size(short)
typedef char *schar;
#pragma pointer_size(long)

main(int argc, char**argv)
{
  char *woof = "woof";
  char *block = argv[0];
  fprintf(stderr,"size of scharp = %d\n", sizeof(schar));
  fprintf(stderr,"woof = 0x%lx\n", woof);
  fprintf(stderr,"block = 0x%lx\n", block);
  fprintf(stderr,"woof = %s\n", woof);
  fprintf(stderr,"block = %s\n", block);

}
-----------------------------------------------------------------------------

Also, the following works:

[foobar-46] cc -non_shared -taso -xtaso_short -o foo foo.c 
[foobar-47] ./foo
size of scharp = 4
woof = 0x14001150
block = 0x11ffee08
woof = woof
block = ./foo

for the program...

#pragma pointer_size(long)
#include <stdio.h>
#pragma pointer_size(short)

typedef char *schar;

main(int argc, char**argv)
{
  char *woof = "woof";
  schar block = argv[0];
  fprintf(stderr,"size of scharp = %d\n", sizeof(schar));
  fprintf(stderr,"woof = 0x%lx\n", woof);
  fprintf(stderr,"block = 0x%lx\n", block);
  fprintf(stderr,"woof = %s\n", woof);
  fprintf(stderr,"block = %s\n", block);

}


Basically, you need to insure that the libraries & your code use the
same sized pointers for the same structs. I don't see this as a big
burden.

If think you'd be better off simply using -xtaso and using the #pragma
where appropriate.



