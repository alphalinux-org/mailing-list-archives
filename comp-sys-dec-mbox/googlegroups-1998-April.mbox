|>slot 1 = E2045-AA S06
|>slot 2 = E2045-AA P07
|>slot 3 = E2045-AA P07
|>slot 4 = Empty / E2045-AA S06 (New upgrade)
|>slot 5 = Empty
|>slot 6 = E2043-BA
|>slot 7 = E2043-BA
|>slot 8 = E2044-AA
