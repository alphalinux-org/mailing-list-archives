$ mem = mem + 1
$ IF mem .LT. 65535 THEN GOTO loop
$ WRITE SYS$OUPUT "No free UIC found in group ",p1
$ EXIT
$done:
$ SHOW SYMBOL mem


Or walking backwards from within a hole (best not done across full range !)

$ IF p1.eqs."" THEN INQUIRE p1 "Group (octal)"
$ IF p1.eqs."" THEN EXIT
$ grp = %o'p1' * 65536
$ mem = 65535 
$ IF p2.nes."" THEN mem = %o'p2'
$loop:
$ mem = mem - 1
$ IF F$IDENT (grp + mem, "NUMBER_TO_NAME") .NES. "" THEN GOTO done
$ IF mem .GT. 0 THEN GOTO loop
$ WRITE SYS$OUPUT "No free UIC found in group ",p1
$ EXIT
$done:
$ mem = mem + 1
$ SHOW SYMBOL mem

