X
char mkSCCS_sid [] = "@(#)	mkSCCS.c	1.3	10/10/91	hp@vmars.tuwien.ac.at";
X
X#include <errno.h>
X#include <stdio.h>
X#include <stdlib.h>
X#include <stdarg.h>
X
X#include <pwd.h>
X#include <unistd.h>
X#include <sys/types.h>
X#include <sys/file.h>
X#include <sys/stat.h>
X
extern int getopt (int argc, char ** argv, char * options);
X
X#define SCCS	"SCCS"	/* name of SCCS directory	*/
X#define PERM	0755	/* perms for "   "		*/
X#define SCCSACC	"sccs"	/* name of SCCS account	*/
X
char	buffer [BUFSIZ];	/* should be big enough for a filename	:-)	*/
char	* scratchdir;
X
X	void
error (
X	int		status,
X	char const	* fmt, ...
X){
X	va_list	ap;
X	va_start (ap, fmt);
X	vfprintf (stderr, fmt, ap);
X	va_end (ap);
X	perror ("");
X	switch (status) {
X	case 3:
X		rename (SCCS, "../" SCCS);
X	case 2:
X		chdir ("..");
X	case 1:
X		rmdir (scratchdir) ;
X	case 0:
X		break;
X	}
X	exit (1);
X}
X
X
X	int
main (
X	int	argc,
X	char	** argv
X){
X	int		user;	/* who called me ?	*/
X	int		euser;	/* effective uid of program (should be root)	*/
X	int		sccs;	/* uid of sccs	*/
X	struct stat	sb;
X	struct passwd	* pwe;
X	int		fd;
X	int		renflag = 0;
X	int		paranoid = 0;
X	int		oldumask;
X	int		c, m;
X
X	while ((c = getopt (argc, argv, "p")) != EOF) {
X		switch (c) {
X		case 'p': 
X			paranoid = 1;
X			break;
X		default:
X			fprintf (stderr, "Usage: %s [-p]\n", argv [0]);
X			exit (1);
X		}
X	}
X
X	/* get necessary uids
X	 */
X	user = getuid ();
X	euser = geteuid ();
X	if ((pwe = getpwnam (SCCSACC)) == NULL) error (0, "%s: %s has no account: ", argv [0], SCCS);
X	sccs = pwe->pw_uid;
X
X	oldumask = umask (022);
X
X	if (setuid (euser) == -1) error (0, "%s: cannot setuid to %d: ", argv [0], euser);
X
X	/* set effective uid to that of the user
X	 * while making the directory.
X	 * This prevents the user from making SCCS subdirectories
X	 * in directories where he does not have write permissions.
X	 */
X
X	if (seteuid (user) == -1) error (0, "%s: cannot seteuid to %d: ", argv [0], user);
X
X	if (stat (".", &sb) < 0) error (0, "%s: cannot stat .: %s ", argv [0]);
X	if (((sb.st_mode & 0222) >> 1) != (sb.st_mode & 0111)) {
X		if (paranoid) {
X			if (chmod (".", ((m = sb.st_mode & 0222) | (m << 1) | (m >> 1)) & sb.st_mode) < 0) {
X				error (0, "%s: cannot chmod .: ", argv [0]);
X			}
X		} else {
X			fprintf (stderr,
X				"%s: Warning: mode %o of \".\" allows editing without write permission\n",
X				argv [0], sb.st_mode);
X		}
X	}
X
X	if ((scratchdir = tempnam (".", SCCS)) == NULL) error (0, "%s: cannot create scratch directory: ", argv [0]);
X	if (mkdir (scratchdir, 0700) < 0) error (0, "%s: cannot mkdir %s: ", argv [0], SCCS);
X
X	/* Ok. I now have a private directory in the CWD
X	 * So I do the rest as root.
X	 */
X	if (seteuid (euser) == -1) error (1, "%s: cannot seteuid to %d: ", argv [0], user);
X	/* Set the directory so that only root can do something in it
X	 */
X	if (chown (scratchdir, 0, 0) < 0) error (1, "%s: cannot chown %s: ", argv [0], scratchdir);
X	/* and set up the SCCS dir in this scratch dir
X	 */
X	if (chdir (scratchdir) < 0) error (1, "%s: cannot chdir to %s: ", argv [0], SCCS);
X	/* try to use existing SCCS dir
X	 */
X	if (rename ("../" SCCS, SCCS) < 0) {
X		if (mkdir (SCCS, PERM) < 0) error (2, "%s: cannot mkdir %s: ", argv [0], SCCS);
X	} else {
X		renflag = 1;
X	}
X
X	/* check if everything is ok
X	 */
X	if (stat (SCCS, &sb) < 0) error (3, "%s: cannot stat %s: ", argv [0], SCCS);
X	if (! (sb.st_mode & S_IFDIR)) error (3, "%s: %s is not a directory\n", argv [0], SCCS);
X	if (renflag && sb.st_uid != user) error (3, "%s: Not owner of %s\n", argv [0], SCCS);
X	/* give dir to sccs
X	 */
X	if (chown (SCCS, sccs, sb.st_gid) < 0) error (3, "%s: cannot chown %s: ", argv [0], SCCS);
