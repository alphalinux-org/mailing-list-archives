#!/bin/sh5
#
# Xsession
#
# This is the program that is run as the client
# for the display manager.  This example is
# quite friendly as it attempts to run a per-user
# .xsession file instead of forcing a particular
# session layout
#

# If there's error in ~/.xsession, type F1 in the login window; the default
# translations will cause this file be called with an argument "failsafe"
case $# in
1)
	case $1 in
	failsafe)
		exec xterm -geometry 80x24-0-0 -ls
		;;
	esac
esac

# If normal authentication, will end up here (no extra parameters)
startup=$HOME/.xsession
resources=$HOME/.Xresources

if [ -f $startup ]; then
	# exec $startup
	exec /bin/sh $startup
else
	# execute children in background, wait for all
	(
	if [ -f $resources ]; then
		xrdb -load $resources
	else
		resources=/usr/lib/X11/xdm/.Xresources
		if [ -f $resources ]; then
			xrdb -load $resources
		fi
	fi
	/usr/bin/X11/mwm &
	sleep 1; /usr/bin/X11/xmodmap -e "keycode 10 = Escape"   &
	sleep 1; /usr/bin/X11/xinfo -geometry 570x555+400-0 -iconic -fn 8x13 &
        ) & wait $!

#      "login" xterm with smooth scrolling and scroll bars, 
#       font for Xterms comes from resources, set in ./.Xresources
	exec xterm -geometry 80x24+10+10 -ls +j -sb
fi
