#include <stdio.h>
#include <sys/time.h>
#include <limits.h>

#define COUNT 1000000

int main() {
    unsigned min = UINT_MAX;
    unsigned sum = 0;
    unsigned i;
    static struct timeval tvs[COUNT];

    for (i = 0; i < COUNT; i++) {
	gettimeofday(&tvs[i],0);
    }

    for (i = 1; i < COUNT; i++) {
	unsigned delta = (((tvs[i].tv_sec - tvs[i-1].tv_sec) * 1000000) + 
			  (tvs[i].tv_usec - tvs[i-1].tv_usec));
	if (delta < min)
	    min = delta;
	sum += delta;
    }
    printf("min is %u, average is %f.\n", min, (float)sum/COUNT);
    return 0;
}

