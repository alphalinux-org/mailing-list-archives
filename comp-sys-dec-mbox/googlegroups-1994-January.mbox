/*
 * Newsgroups: comp.unix.ultrix
 * From: jm@decuk.uvo.dec.com (John McNulty)
 * Subject: Re: Help : Copy 
 * Message-ID: <1992Oct16.072054.783@decuk.uvo.dec.com>
 * Organization: Digital Equipment Co. Ltd
 * Date: Fri, 16 Oct 1992 07:20:54 GMT
 */

#include <stdio.h>
#include <sys/ioctl.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <net/if.h>

int main (int argc, char *argv[])
{
	int	s;
	struct ifdevea	i;

	if ( argc != 2 ) {
		fprintf (stderr, "usage: %s interface\n", argv[0]);
		exit (1);
	}

	if ((s = socket (AF_INET, SOCK_STREAM, 0)) == -1) {
		perror ("socket");
		exit (1);
	}

	strncpy (i.ifr_name, argv[1], sizeof (i.ifr_name));
	if (ioctl (s, SIOCRPHYSADDR, &i) == -1) {
		perror ("ioctl");
		exit (1);
	}

	printf ("%s: %x-%x-%x-%x-%x-%x\n", i.ifr_name, i.default_pa[0], 
		i.default_pa[1], i.default_pa[2], i.default_pa[3], 
		i.default_pa[4], i.default_pa[5]);
	exit (0);
}


