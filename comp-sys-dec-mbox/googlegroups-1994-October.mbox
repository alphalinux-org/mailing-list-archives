#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/time.h>

#define BLOCKSIZE 1024              /* Maximum size of each write. */
#define FILESIZE  (1000*BLOCKSIZE) /* Size of file being randomly updated. */

static double elapsed_seconds (struct timeval* tp)
{
    static struct timeval otp;
    static struct timezone tzp;
    otp = *tp;
    if (gettimeofday(tp, &tzp) < 0)
        perror("gettimeofday"), exit(1);
    return (tp->tv_sec - otp.tv_sec) + (tp->tv_usec - otp.tv_usec)/1000000.0;
}

int main ()
{
    char* fp = 0;
    int i = 0, fd = 0;
    const int Count = 5000;
    const char* file = "/dev/rrz9g";
    struct timeval timer   = { 0, 0 };
    unsigned char buf[BLOCKSIZE];

    srandom(13);  /* Use the same random seed for repeatability. */

    if ((fd = open(file, O_RDWR|O_CREAT|O_TRUNC, 0666)) < 0)
        perror("open"), exit(1);

    memset(buf, 'x', BLOCKSIZE);  /* Initialize buf to known value. */

    (void) fprintf(stderr, "Building %d byte file in memory ...\n", FILESIZE);

    if ((fp = (char*) malloc(FILESIZE)) == 0)
        fprintf(stderr, "malloc() failed, bye\n"), exit(1);

    memset(fp, '#', FILESIZE);    /* Touch every byte in buffer. */

    (void) fprintf(stderr, "Writing %d bytes to %s ...\n", FILESIZE, file);

    (void) elapsed_seconds(&timer);
    if (!(write(fd, fp, FILESIZE) == FILESIZE))
        perror("write"), exit(1);
    if (fsync(fd) < 0)
        perror("fsync"),exit(1);
    (void) fprintf(stderr,
                   "Wrote %d bytes to %s in %g seconds.\n",
                   FILESIZE, file, elapsed_seconds(&timer));
    free(fp);

    (void) fprintf(stderr, "Doing %d random writes to %s ...\n", Count, file);

    (void) elapsed_seconds(&timer);
    for (i = 0; i < Count; i++)
    {
        int size = random() % (BLOCKSIZE-1) + 1;
        if (lseek(fd, random()%(FILESIZE-BLOCKSIZE-1), SEEK_SET) < 0)
            perror("lseek"), exit(1);
        if (!(write(fd, buf, size) == size))
            perror("write"), exit(1);
        if (fsync(fd) < 0)
            perror("fsync"), exit(1);
    }
    (void) fprintf(stderr,
                   "Average write time per block was %g seconds.\n",
                   elapsed_seconds(&timer)/Count);
    return 0;
}

