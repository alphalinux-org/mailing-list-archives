\section*{Appendix 2}

\begin{verbatim}
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <sys/types.h>
#include <sys/times.h>
#define NUMRUNS 200000
/* #define ARRAY */
/* #define PTRS  */
#define INDPTRS 
struct element {
  float x,y;
  struct element *next;
};

float sum(float, float);
void fill_array(float *x, float *y);
void fill_ptrs(struct element *);
void fill_ind_ptrs(struct element **);

int main(int argc, char *argv) {

  int i;
  float x[NUMRUNS],y[NUMRUNS],total=0.;
  struct element *top, *ptr, *indptr, *indtop;
  clock_t r_time1, r_time2
  time_t ut1, ut2, ut3, ut4;
  struct tms buf;

#ifdef INDPTRS 
/* Fill ind ptrs */
  fill_ind_ptrs(&indptr);
  indtop = indptr;
/* Do sum */
  r_time1 = times(&buf);
  ut1 = buf.tms_utime;
  while (indptr != NULL) {
    total += sum(indptr->x,indptr->y);
    indptr=indptr->next;
  }

  r_time2 = times(&buf);
  ut2 = buf.tms_utime;
  printf("Elapsed time is %i ; Total equals %f\n",ut2-ut1,total);
#endif /* INDPTRS */
#ifdef ARRAY 
/* Fill array */
  fill_array(x,y);
/* Do sum */
  r_time1 = times(&buf);
  ut1 = buf.tms_utime;
  for (i=0; i<NUMRUNS; i++) {
    total += sum(x[i],y[i]);
  }

  r_time2 = times(&buf);
  ut2 = buf.tms_utime;
  printf("Elapsed time is %i ; Total equals %f\n",ut2-ut1,total);
#endif /* ARRAY */
#ifdef PTRS
/* Fill ptrs */
  top = (struct element *) malloc(NUMRUNS*sizeof(struct element));
  ptr = top;
  for (i=0; i<NUMRUNS-1; i++) {
    ptr->next = ptr+1;
    ptr = ptr->next;
  }
  ptr->next = NULL;  
  fill_ptrs(top);
  ptr = top;
/* Do sum */
  r_time1 = times(&buf);
  ut1 = buf.tms_utime;
  while (ptr != NULL) {
    total += sum(ptr->x,ptr->y);
    ptr=ptr->next;
  }

  r_time2 = times(&buf);
  ut2 = buf.tms_utime;
  printf("Elapsed time is %i ; Total equals %f\n",ut2-ut1,total);
#endif /* PTRS */
  return 1;
}


float sum(float x, float y) {
  return sin(x)+cos(y);
}

void fill_array(float x[], float y[]) {
  
  int i;
  
  for (i=0; i<NUMRUNS; i++) {
    x[i] = i*(10./NUMRUNS);
    y[i] = i*(5./NUMRUNS);
  }

}

void fill_ptrs(struct element *ptr) {

  int i=0;

  while (ptr != NULL) {
    ptr->x = i*(10./NUMRUNS);
    ptr->y = i*(5./NUMRUNS);
    i++;
    ptr = ptr->next;
  }
}

void fill_ind_ptrs(struct element **top) {

  int i=0,*waste;
  struct element *ptr,*optr;
  
  *top = (struct element *) malloc(sizeof(struct element));
  ptr = *top;
  for (i=0; i<NUMRUNS; i++) {
    waste = (int *) malloc(5); 
    ptr->x = i*(10./NUMRUNS);
    ptr->y = i*(5./NUMRUNS);
    ptr->next = (struct element *) malloc(sizeof(struct element));
    optr=ptr;
    ptr=ptr->next;
  }
  optr->next = NULL;
}
\end{verbatim}
\end{document}











