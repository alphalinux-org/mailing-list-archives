	struct timeval timeout = {10,0};

	/* s is my socket file descriptor */

	stat = setsockopt(s, SOL_SOCKET, SO_RCVTIMEO,
	                  (void *)&timeout, sizeof timeout);
	if (stat != 0) perror("setsockopt");

