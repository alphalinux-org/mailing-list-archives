To All DEC Assebmler & C Programmers:
I will highly appreciate if any one can change the following code into C.

   This program is used by COBOL Program to Que Files. The passed parameters
   are as following.
   01 SPOOL-ATTRIBUTES.
      03  SPOOL-DEVICE     PIC X(4).
      03  SPOOL-FILE       PIC S(24).
      03  SPOOL-DELETE     PIC S9(4) USAGE IS COMP.
      03  SPOOL-COPIES     PIC S9(4) USAGE IS COMP.

.ENABL LC
TITLE  QUE,,QUE PASSED FILE NAME>

   ;THE CALLING PROCEDURE IS TO:
   ;    CALL "QUE" USING SPOOL-ATTRIBUTES
   ;TO ASSEMBLER:
   ;   CCL MAC  QUE=$SYSMAC,[P,PN]QUE.MUT

      .PSECT QUE,RO,I,GBL,REL,CON

QUE::  SAVE
       INC   R5                   ;HOUSE KEEPING
       INC   R5
       MOV   (R5),R2              ;GET WORK ADDRESS
       INC   30.(R2)              ;SETUP COPIES COUNTER

LOOP:  DEC   30.(R2)              ;TEST FOR ZERO COPIES LEFT
       BLE   DONE                 ;IF SO, RETURN

       CLRXRB
       CLRFQB
       MOV    #24.,XRB+XRLEN      ;SET XRB FOR .FSS CALL
       MOV    #24.,XRB+XRBC
       MOV    R2,XRB+XRLOC        ;SET STRING ADDRESS
       ADD    #4.,XRB+XRLOC       ;GET CORRECT OFFSET
       .FSS                       ;FILE STRING SCAN

       TSTB   FIRQB               ;SUCCESSFUL!
       BNE    DONE                ;NOPE, RETURN

       MOVB   #-28.,FIRQB+FQFUN   ;SET SPOOLING FLAG
       MOV    (R2),FIRQB+16       ;SET QUE DEVICE

       CLR    FIRQB+20            ;CLEAR QUE DEVICE NUMBER
       CMPB   #32.,2(R2)          ;TEST FOR GENERIC UNIT
       BEQ    CONT2               ;GOT SPACE IN THIRD POSITION
       CMPB   #58.,2(R2)          ;TEST AGAIN
       BEQ    CONT2               ;GOT SEMI-COLON IN THIRD

       MOVB   2(R2),R3            ;SET UP UNIT TRANSLATION
       SUB    #60,R3              ;ASCII TO BINARY TRANSLATION
       MOVB   R3,FIRQB+20         ;ADD UNIT NUMBER
       MOVB   #377,FIRQB+21       ;MAKE UNIT NUMBER REAL

CONT2:
       CLR    FIRQB+22            ;SET DUMMY
       CLR    FIRQB+24            ;CLEAR DELETE FLAG
       CMP    #1,30.(R2)          ;ONLY DELETE LAST COPY
       BNE    CONT1
       TST    28.(R2)             ;TEST FOR DELETE PARAMETER
       BEQ    CONT1               ;NOPE, SKIP
       BIS    #4,FIRQB+24         ;SET DELETE AFTER FALG
CONT1:
       .UUO                       ;BASIC SYS CALL
       TSTB   FIRQB               ;SUCCESSFUL!
       BNE    DONE                ;NOPE, RETURN
       BR     LOOP                ;YES, CONTINUE WITH NEXT COPY
DONE:
       RESTOR
       RETURN
       .END

THANK YOU.


