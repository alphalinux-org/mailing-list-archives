call:  build_socket(<servicename>, 0, 1, 1);

int
build_socket (char *service_name, unsigned short port_nbr, int use_host, int max_listen)
  {
  int                   optval;
  int                   socket_nbr = -1;
  struct hostent     *  host;
  struct servent     *  serv;
  struct sockaddr_in    sin;
  struct utsname        u_name;
  char                  buffer[sizeof u_name.nodename + 1;

  if ( (socket_nbr = socket(AF_INET, SOCK_STREAM, 0)) == -1)
    return -1;
  printf("socket number: %d\n", socket_nbr);
  optval = 1;
  setsockopt(socket_nbr, SOL_SOCKET, SO_REUSEADDR,(void*)&optval,sizeof optval);
  memset((void*)&sin, 0 , sizeof sin);
  sin.sin_family      = AF_INET;
  if (use_host)
    {
    if (uname(&u_name) == -1)
      {
      return -1;
      }
    else
      {
      memcpy(buffer, u_name.nodename, sizeof u_name.nodename);
      if ( (host = gethostbyname(buffer)) == NULL )
        return -1;
      }
    memcpy((char*)&sin.sin_addr, host->h_addr, host->h_length);
    }
  else
    sin.sin_addr.s_addr = INADDR_ANY ;
  if (service_name)
    {
    printf("getting main socket: %s\n", service_name);
    if ( (serv = getservbyname(service_name, "tcp")) == NULL )
      return -1;
    sin.sin_port = htons(serv->s_port);
    printf("service info: %s %s %d\n", serv->s_name,serv->s_proto,sin.sin_port);
    }
  else
    sin.sin_port        = port_nbr;
  if ( bind(socket_nbr, (void *)&sin, sizeof sin) == -1)
    return -1;
  printf("bind to address: %s\n", inet_ntoa(sin.sin_addr));

  if (listen(socket_nbr, max_listen ) == -1)
    return -1;

  printf("listening\n");
  return socket_nbr;
  }



