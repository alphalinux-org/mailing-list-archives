%Title Context switch times in microseconds (raw numbers)

The test program used to generate these numbers used a pair of processes
signaling each other, to get the context switches. Similar to


#include <signal.h>
#include <time.h>

int other;

void sig(sign)
int sign;
{
	kill(other,16);
}

main()
{
	int	p=getpid();
	int	me, q, count = 0;
        struct timeval t1,t2;
        struct timezone junk;
	
	struct sigaction act,oact;

	act.sa_handler=sig;
	sigemptyset( & ( act.sa_mask ) );
	act.sa_flags=0;

	sigaction(16,&act,&oact);
	switch( q=fork() ) {
	case 0:		/*child*/
			other=p;
			break;
	default:
			other=q;
			kill(other,16);
	}
        gettimeofday(&t1,&junk);
        me = getpid();
	while(1) { pause();
                   count++;
            if (count == 2000) {
                gettimeofday(&t2,&junk);
                printf ("Me: %5d %7d signals in %6.3f seconds \n", me, count, (
                  ( (double)t2.tv_usec + 1000000*(double)t2.tv_sec) -
                  ( (double)t1.tv_usec + 1000000*(double)t1.tv_sec) )/
                    1000000) ;
                count=0;
                gettimeofday(&t1,&junk);
            }
        }
}

