#include	<stdio.h>
#include	<termios.h>


void	usage(const char *progname)
{
    fprintf(stderr, "Usage: %s [on|off]\n", progname);
}


int	main(int argc, char *argv[])
{
    struct termios tp;


    memset(&tp, 0, sizeof(struct termios));
    if (tcgetattr(0, &tp))
    {
	perror("tcgetattr");
	exit(1);
    }

    switch(argc)
    {
    case	1:
	fprintf(stderr, "RTS/CTS %s\n",
		tp.c_cflag & CRTSCTS ? "on" : "off");
	exit(0);

    case	2:
	if (!strcmp(argv[1], "on"))
	    tp.c_cflag |= CRTSCTS;
	else
	    if (!strcmp(argv[1], "off"))
		tp.c_cflag &= ~CRTSCTS;
	    else
	    {
		usage(argv[0]);
		exit(-1);
	    }
	if (tcsetattr(0, TCSANOW, &tp))
	{
	    perror("tcsetattr");
	    exit(1);
	}
	exit(0);

    default:
	usage(argv[0]);
	exit(-1);
    }

    return 0;
}
