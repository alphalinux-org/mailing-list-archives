	!        +-------+-------+-------+   n   |
	!        |      101      |  57   |   t   |
	!        |               |       |   e   |
	!        |       0       |   .   |   r   |
	!        +---------------+-------+-------+
	!     
	keycode 28 = Left
	keycode	29 = Right
	keycode 30 = KP_Separator comma
	keycode 52 = KP_F1  KP_Equal
	keycode 53 = KP_F2  KP_Divide
	keycode 54 = KP_F3  KP_Multiply
	keycode 78 = KP_F4  KP_Subtract
	!
