long getTZOffs(boolean dst)		// return minutes west
{

#if defined(HP)
    if (dst)
      return (timezone/60) - 60;
    else
      return (timezone/60);
#else

#if defined(AABSD) || defined(IBM)

    struct timeval junk;
    struct timezone tz;

#if defined(sony)
    tzset();
#endif
    gettimeofday(&junk, &tz);
    if (dst)
	return tz.tz_minuteswest - 60;
    else
	return tz.tz_minuteswest;

#else  /* SYS5 - I assume */

    tzset();
    if (dst)
      return altzone/60;
    else
      return timezone/60;

#endif
#endif
}

int maxFileDescriptors()
{
#if defined(IBM) || defined(HP)
