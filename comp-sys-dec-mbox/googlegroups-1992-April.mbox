	!if [ -f $HOME/.xmodmaprc ]; then
	!    xmodmap $HOME/.xmodmaprc		# Install user-defined keyboard
mapping
	!fi
	!
	!
	!        +-------+-------+-------+-------+
	! Keycode|  28   |   29  |  30   |  105  |
	!        |       |       |       |       |
	!  VT100 |  <-   |   ->  |   ,   |Nm_Lock|
	!        +-------+-------+-------+-------+
	!        |  52   |   53  |  54   |   78  |
	!        |       |       |       |       |
