     dbg = True;

   if(theConsole.mapped == False)
     XtSetMappedWhenManaged(theConsole.shell,False);

   AbortOtherConsole(&theConsole);
     
   CreateConsole(&theConsole);

   SetupTTY(&theConsole);

   InitializeConsole(&theConsole);

   XtRealizeWidget(theConsole.shell);

