                           (%BLISS(BLISS32E) OR %BLISS(BLISS64E))%; ! = 0 if compiled /VAX /Inn

                   MACRO IA64 =                    ! = 1 if compiled BLISS/I* (New arch name)
                           (%BLISS(BLISS32I) OR %BLISS(BLISS64I))%; ! = 0 if compiled /VAX or /Ann

                   MACRO ADDRESSBITS =
                           %BPADDR%;               ! = 32 or 64 based on compiler used

