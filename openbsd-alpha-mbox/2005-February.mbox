I have manual ipsec keying:
---------------------------------------
ipsecadm flush
IP_A=10.195.2.103
IP_B=10.195.2.123
ipsecadm new esp -spi 1000 -src $IP_A -dst $IP_B -forcetunnel -enc 3des -auth sha1 -keyfile enc_key -authkeyfile auth_key
ipsecadm new esp -spi 1001 -src $IP_B -dst $IP_A -forcetunnel -enc 3des -auth sha1 -keyfile enc_key -authkeyfile auth_key
ipsecadm flow -dst $IP_A -proto esp -addr $IP_B 255.255.255.255 $IP_A 255.255.255.255 -out -require -src $IP_B
---------------------------------------


