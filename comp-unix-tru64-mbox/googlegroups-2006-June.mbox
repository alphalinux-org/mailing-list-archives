> ------------------------------------------------------------------------------------------------------
> EDITOR=vi
> export EDITOR
> PATH=$HOME/bin:/usr/sbin:/usr/atria/bin:/usr/opt/temip/bin:${PATH:-/usr/bin:.}
> export PATH
> 
> /usr/bin/ksh
> # My customisations
