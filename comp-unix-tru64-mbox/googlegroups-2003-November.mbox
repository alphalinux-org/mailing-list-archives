radius$ CC=cc \
         CFLAGS="-I/usr/local/include" \
         ./configure --prefix=/usr/local/freeradius \
                     --localstatedir=/var \
                     --with-logdir=/var/radius \
                     --sysconfdir=/etc


radius$ cat<<__EOF__>>  src/include/autoconf.h
#undef OSFC2
#undef OSFSIA
__EOF__

radius$ make

