Yes, I am backing up clearcase so mine is a little more involved but I
think this is what you want:

#!/usr/bin/ksh -x
/sbin/mkdir /local1_clone_mount_pt
/usr/sbin/clonefset vobs_dmn vobs_fs vobs_fs_clone
/sbin/mount -t advfs vobs_dmn#vobs_fs_clone /local1_clone_mount_pt
/sbin/vdump -0uf /dev/nrmt0h /local1_clone_mount_pt
/sbin/umount /local1_clone_mount_pt
/sbin/rmfset -f vobs_dmn vobs_fs_clone
/sbin/rmdir /local1_clone_mount_pt

