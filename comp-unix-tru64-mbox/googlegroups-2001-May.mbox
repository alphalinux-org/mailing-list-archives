In a similar situation I used the following script to set
initial passwords to "loginname-numericuserid".  Could be
modified to create random passwords instead.   Hope this
helps.

Needs to be called for each user name as in something like:
for u in `cat names.lst`
do
    setinitialpw $u
done

--- setinitialpw script below -- Must be run as root of
course

PRG=`basename $0`
usedefaultpw=y
if [ $# -lt 1 ]; then
        echo "Need a user name argument.\nAbort"
        exit 1
fi

## Subroutine
setdefaultpw(){
        pw=${user}-${uid}
        /usr/sbin/usermod -p $user <<EOF
$pw
$pw
EOF

        if [ $? ]; then
                echo "Set Password $pw for $user $comment"
                return 0
        else
                echo "Could not set password $pw for $user
$comment"
                return 1
        fi
}

user=$1
pwline=`grep "^$user:" /etc/passwd`
if [ -z "$pwline" ]; then
        print "$PRG ERROR: Could get info from /etc/passwd
for user [$user].\Abort"
        exit 2
fi
uid=`echo "$pwline" | cut -d : -f 3`
comment=`echo "$pwline" | cut -d : -f 5`
if [ -z "$uid" ]; then
        print "$PRG ERROR: Could not extract UID for user
[$user].\Abort"
        exit 3
fi
if [ "$usedefaultpw" != "y" ]; then
        echo "Other than default pw not implemented
yet.\nAbort"
        exit 4
else
        setdefaultpw
        rval=$?
        if [ $rval -ne 0 ]; then
                exit 5
        fi
fi
exit 0




