Hello,

using ksh:

#!/bin/ksh
# grep -r with ksh
# michael@heiming.de - 2001-04-08
# usage: rgrep <search_for> <search_path>
SW=${1}
SP=${2}
if [ $# -ne 2 ]
   then
echo "usage: rgrep <search_for> <search_path>"
exit 1
fi
find $SP -type f -exec grep $SW {} /dev/null \;     

