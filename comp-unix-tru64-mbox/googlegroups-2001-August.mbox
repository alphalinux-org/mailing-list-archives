X  #endif
X  
X  #define MALLOC(space, cast, size, type, flags) \
X          (space) = (cast)malloc((u_long)(size), FINDINDEX(size), type,
X  flags)
X  
X  
X  int     statesize = 5737;
X  static state_t **table = NULL;
X  
X  int table_init()
X  {
X          MALLOC(table, state_t **, sizeof(state_t *) * statesize,
X  M_TEMP, M_NOWAIT);
X          if (table != NULL)
X                  bzero((char *)table, statesize * sizeof(state_t *));
X          else {
X                  return -1;
X          }
X              ......................
X  }
X  -------------------------------------------
X  
X  In this case, if statesize is 5737, I can't have the system to
X  allocate memory using MALLOC. if statesize is 127 or 100, system can
X  allocate memory using MALLOC.
X  This program is a part of the loadable kernel module in Tru64UNIX 5.1.
X  Do Tru64UNIX V5.1 have the option that kernel memory to be allocate is
X  limited?
X  If then, how can it be increased?

MALLOC is used when the size of the storage can be specified as either
a hard coded constant, a #define contant, or a sizeof(...) constant.

MALLOC_VAR is used when the size of the storage is passed as a
variable.  'statesize' is a variable and thus you should be using
MALLOC_VAR

                                        Bob Harris


