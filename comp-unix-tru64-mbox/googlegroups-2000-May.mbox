"Stefan A. Deutscher" wrote:
> 
> Howdy,
> 
>  I have another one that has got to be a runner-up to 'how much memory
> do I have?': How do I figure out at what clock my Alpha box is ticking?


You should use getsysinfo().  Here's a sample program:

#include <sys/types.h>
#include <sys/errno.h>
#include <machine/hal_sysinfo.h>

int
main(argc, argv)
int argc;
char **argv;
{
        struct cpu_info cpu_info;

        if (getsysinfo(GSI_CPU_INFO, &cpu_info,
                                        sizeof(cpu_info), 0L, 0L) <= 0)
{
                perror("getsysinfo");
                exit( 0 );
        }

        printf("current_cpu = 0x%lx\n", cpu_info.current_cpu);
        printf("cpus_in_box = 0x%lx\n", cpu_info.cpus_in_box);
        printf("cpu_type = 0x%lx\n", cpu_info.cpu_type);
        printf("ncpus = 0x%lx\n", cpu_info.ncpus);
        printf("cpus_present = 0x%lx\n", cpu_info.cpus_present);
        printf("cpus_running = 0x%lx\n", cpu_info.cpus_running);
        printf("cpu_binding = 0x%lx\n", cpu_info.cpu_binding);
        printf("cpu_ex_binding = 0x%lx\n", cpu_info.cpu_ex_binding);
        printf("mhz = 0x%lx\n", cpu_info.mhz);
}



