I have written a script a long time ago, looks like

..
echo 0 : making initial status etc.
mt -f /dev/nrmt0h online
mt -f /dev/nrmt0h status
mt -f /dev/rmt0h rewind

#
# First disk
#
date
echo 1 : Tar fulldump av /admin/cirocco/ora_bck
/sbin/vdump -0 -q -u -b 60 -f /dev/nrmt0h /admin/cirocco/ora_bck
sleep 15

date
echo 2 : Takes fulldump of /admin/cirocco/ora_arc
/sbin/vdump -0 -q -u -b 60 -f /dev/nrmt0h /admin/cirocco/ora_arc
sleep 15

