Try this:

#!/bin/ksh -vx

localtime=$(date +%H)
utc=$(date -u +%H)

offset=$(($utc - $localtime))
today=$(TZ="EST${offset}EDT${offset}" date)

offset=$(($offset + 24))
yesterday=$(TZ="EST+${offset}EDT+${offset}" date)



