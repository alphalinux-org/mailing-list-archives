To look at the # of file/record locks in use try compiling and running 
this program:


/*
  * Show the number of record locks configured on a system
  *
  * This program should be run set group-id kmem
  */

#include <stdio.h>
#include <nlist.h>
#include <sys/types.h>
#include <sys/fcntl.h>
#include <sys/flock.h>


/*
  * Define the name lists were are interested in
  */
struct nlist name_list[] = {
   { "_flckinfo" },
   { 0 }
};


void
main ()
{
   int kmem;
   struct flckinfo lock_info;

   kmem = open ("/dev/kmem", 0);

   /*
    * Get the kernel name list
    */
   nlist ("/vmunix", name_list);

   /*
    * Read the value of flckinfo
    */
   lseek (kmem, (off_t) name_list[0].n_value, 0);
   read (kmem, &lock_info, sizeof (struct flckinfo));

   /*
    * Print out the lock information
    */
   printf ("Max records locked       =  %d\n", (int) lock_info.recmax);
   printf ("Max files locked         =  %d\n", (int) lock_info.filmax);
   printf ("Lock records in use      =  %d\n", (int) lock_info.reccnt);
   printf ("File headers in use      =  %d\n", (int) lock_info.filcnt);
   printf ("Total lock records used  =  %d\n", (int) lock_info.rectot);
   printf ("Total file headers used  =  %d\n", (int) lock_info.filtot);
}




On a V5.x box to see the number of record locks configured run:

# sysconfig -q vfs nlock_record
vfs:
nlock_record = 10000


Use sysconfigdb or dxkerneltuner to change the nlock_record parameter.


Regards,

Stephen Carpenter



