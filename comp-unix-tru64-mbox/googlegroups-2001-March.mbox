% as -oldas -v _clz.s -o _clz.o

/usr/lib/cmplrs/cc/cpp -DLANGUAGE_ASSEMBLY -D__LANGUAGE_ASSEMBLY__ -D__unix__ -D__alpha -D_SYSTYPE_BSD -D_LONGLONG -D__digital__ -D__arch64__ -D__osf__ -std0 -I/usr/include _clz.s > /tmp/ctmppAAAakrdxa
