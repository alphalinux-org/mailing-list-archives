#include<stdio.h>
#include<stdlib.h>
#include<pthread.h>
#include <sys/types.h>
#include<unistd.h>

void fork_handler1() {
  printf("prepare handler called\n");
}
void fork_handler2() {
  printf("parent handler called\n");
}
void fork_handler3() {
  printf("child handler called\n");
}


void func(void *pData) {

 pthread_atfork(fork_handler1,fork_handler2,fork_handler3); 
 printf("thread launched\n");

 if(fork()==0) {
   printf("new fork started, pid=%d\n",getpid());
   exit(0);
 } else {
   printf("old fork running, pid=%d\n",getpid());
 }
}


main() {
  char buf[10];     
  pthread_t theThread;
 
  if(!pthread_create(&theThread,NULL,(void *(*)(void *))&func,NULL)) {
    pthread_detach(theThread);
  } else {
    printf("Unable to launch a thread\n");
  }  
      
  printf("hit Enter, please\n");
  fgets(buf,sizeof(buf),stdin);
//sleep(1);
