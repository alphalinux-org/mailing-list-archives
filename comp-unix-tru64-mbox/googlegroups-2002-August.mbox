OK, what mutexes are locked by fgets? Are they documented anywhere?

Try launching the program below under Tru64 and see which files are 
created and which are not. How to make it to create all the files 
_while_ it's waiting for the input? 

------
#include<stdio.h>
#include<stdlib.h>
#include<pthread.h>
#include <sys/types.h>
#include<unistd.h>
#include<fcntl.h>


void fork_handler1() {
  creat("forkPrepareHandler.txt",0666);
}
void fork_handler2() {
  creat("forkParentHandler.txt",0666);
}
void fork_handler3() {
  creat("forkChildHandler.txt",0666);
}


void func(void *pData) {

 pthread_atfork(fork_handler1,fork_handler2,fork_handler3);
 if(fork()==0) {
   creat("forkChild.txt",0666);
   _exit(0);
 } else {
   creat("forkParent.txt",0666);
 }
}


main() {
  char buf[10];     
  pthread_t theThread;
  if(!pthread_create(&theThread,NULL,(void *(*)(void *))&func,NULL)) {
    pthread_detach(theThread);
  } else {
    printf("Unable to launch a thread\n");
  }
  
  creat("forkMain.txt",0666);
      
  printf("hit Enter, please\n");
  fgets(buf,sizeof(buf),stdin);
  _exit(0); //important
}

---

