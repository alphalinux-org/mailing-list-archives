Recovery procedure:
===========================

#!/bin/ksh
PATH=$PATH:/sbin:/usr/sbin ; export PATH
# save disklabel of remaining member
#
disklabel rz8 > /var/adm/rz8.label
#
# remove disk entries of failed disk from rootdg while keeping database
records
#
voldg -k rmdisk rz33a rz33b rz33d rz33g
voldisk rm rz33a rz33b rz33d rz33g
#
# make disklabel of new disk same as that of remaining member
#
disklabel -z /dev/rrz33c
disklabel -r -R -t {advfs|ufs} /dev/rrz33c /var/adm/rz8.label RZXX
#
# init LSM disks with type according to voldisk list
#
voldisk -f init rz33a type=nopriv
voldisk -f init rz33b type=nopriv
voldisk -f init rz33d type=simple privlen=1024 nconfig=2 nlogs=2
voldisk -f init rz33g type=nopriv
#
# add disks back to rootdg based on saved config data
#
voldg -k adddisk rz33a=rz33a
voldg -k adddisk rz33b=rz33b
voldg -k adddisk rz33d=rz33d
voldg -k adddisk rz33g=rz33g
#
# now start volume recovery
#
volrecover -sb rz33a rz33b rz33d rz33g
#
exit




