Lazy is good !!!  This why I always use AdvFS.

> Create copies of each disklabel on the root filesystem and on paper that you 
> keep with backup media.

Great advice to make a paper copy and keep it with your vdump tape.

Here is the procedure I use to make my "disaster recovery" info.  Minor changes
required for V5.x

=============================< cut here >=========================================

#! /usr/bin/ksh
export CMD_ENV=xpg4
echo    SCSI information for `hostname` > /SCSI_info
echo "" >> /SCSI_info
date >> /SCSI_info
echo "" >> /SCSI_info
#
#       show what is currently mount using df
#
df -k -F ufs,advfs >> /SCSI_info
echo "" >> /SCSI_info
echo
"================================================================================" >>
/SCSI_info
echo "" >> /SCSI_info
#
#       list /etc/fstab
#
cat /etc/fstab >> /SCSI_info
echo "" >> /SCSI_info
echo
"================================================================================" >>
/SCSI_info
echo "" >> /SCSI_info
#
#       show how the file domains are hooked up
#
ls -ld /etc/fdmns/*/* | cut -b55- | sort >> /SCSI_info
echo "" >> /SCSI_info
echo
"================================================================================" >>
/SCSI_info
echo "" >> /SCSI_info
#
#       list the tape drives
#
file /dev/nrmt*h            >> /SCSI_info
echo "" >> /SCSI_info
#
#       list the disk drives
#
file /dev/rrz?c /dev/rrz??c /dev/rrz???c >> /SCSI_info
echo "" >> /SCSI_info
echo
"================================================================================" >>
/SCSI_info
echo "" >> /SCSI_info
#
#       show the label on each disk
#
for I in `echo /dev/rrz?c /dev/rrz??c /dev/rrz???c`;
do
        file $I | grep -q 'SCSI'
        if [ "$?" = "0" ] ;
        then
                file $I | egrep -q 'RRD|ROM'
                if [ "$?" = "1" ]
                then
                        /sbin/disklabel -r $I >> /SCSI_info;
                        echo "" >> /SCSI_info;
                        echo
"================================================================================" >>
/SCSI_info
                        echo "" >> /SCSI_info;
                fi
        fi
done

=============================< cut here >=========================================


Don't forget to print /SCSI_info and keep it with your vdump tape !!

-- 

Jack Patteeuw


