Here's a script that'll do it:

#!/bin/sh
echo "81 ea 70 90 cd 05 8b 95 40 00" | awk '{
  print "obase=2"
  print "ibase=16"
  for (i=NF; i > 0; i--) print toupper($i)
}' | bc | awk '{ printf "%.8d ", $1 }'

Any enhancements will be an exercise for the reader!

