  {
    int             current, target, rate;
+   long int        flags;
  
    compute_volume (voice, volume);
    voices[voice].current_volume = voices[voice].initial_volume;
  
+   DISABLE_INTR(flags);
+   gus_select_voice(voice);
    current = gus_read16 (0x09) >> 4;
    target = voices[voice].initial_volume;
  
