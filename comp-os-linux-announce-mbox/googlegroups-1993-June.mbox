  (cond ((not dirbuffer-list) nil)
	((string= (car dirbuffer-list) (buffer-name))
	 (cdr dirbuffer-list))
	(t (cons (car dirbuffer-list) 
		 (hm--dired-remove-dirbuffer-from-list 
