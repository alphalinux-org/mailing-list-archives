(defun hm--dired-make-subdirlist (subdirname)
"Function returns a list with the subdirmenu."
  (cond ((not subdirname) ())
	(t (cons (vector subdirname
			 (list 'dired subdirname)
			 t)
		 (hm--dired-make-subdirlist (hm--dired-get-next-dir))))))


(defun hm--dired-make-submenu-with-subdirs ()
  "Function generates the \"Goto relativ\" submenu with the subdir entries."
  (interactive)
  (let ((submenu nil))
    (save-excursion
      (hm--dired-ls)
      (setq submenu
	    (hm--dired-make-subdirlist (hm--dired-get-next-dir)))
      (kill-buffer "*hm-dired-tmp*"))
    (add-menu '("Dired" "Directory") 
	      "Goto relativ"
	      (cons
	       ["Up directory" dired-up-directory t]
	       (cons
		"----"
		submenu)))))


(defun hm--dired-build-subdir-pulldown-menu ()
"Hook-Function which builds a new subdir menu, if one selects the
menubar in the Dired-mode. It is an activate-menubar-hook."
  (if (string-equal mode-name "Dired")
      (hm--dired-make-submenu-with-subdirs)))



;; Functions which builds a submenu with the subdirectories
;; and menu item names defined in the file .lemacs-absolutdirs-menu.


(defvar hm--dired-absolutdirs-filename "~/.lemacs-absolutdirs-menu"
  "Name of the file (with path) which spezifies the menu items for
the \"Goto absolut\".")


(defun hm--dired-load-file-with-absolutdirs ()
  "Function loads a file with specifies the menu items for the
\"Goto absolut\" menu and returns the buffername or nil, if
the file doesn't exist."
  (if (file-readable-p hm--dired-absolutdirs-filename)
      (let ((buffername (generate-new-buffer "*absolut-subdirs*")))
	(switch-to-buffer buffername)
	(insert-file hm--dired-absolutdirs-filename)
	(goto-char (point-min))
	buffername)
    nil))


(defun hm--dired-make-absolutdirlist (item-name directory-name)
  "Returns a list with a menu item for the \"Goto absolut\" menu
with item name item-name and the directory directory-name."
  (cond ((not (and item-name directory-name)) ())
	((string= "-" directory-name) 
	 (cons item-name
		 (hm--dired-make-absolutdirlist (hm--dired-get-next-string)
						(hm--dired-get-next-string))))
	(t (cons (vector item-name
			 (list 'dired directory-name)
			 t)
		 (hm--dired-make-absolutdirlist (hm--dired-get-next-string)
						(hm--dired-get-next-string))
		 ))))


(defun hm--dired-get-next-string ()
  "Returns the next string from the current buffer and moves the
point behind that string. It returns nil, if the end of the buffer
is reached !"
  (interactive)
  (forward-sexp)
  (if (= (point) (point-max))
      nil
    (mark-sexp -1)
    (buffer-substring (+ (mark t) 1) (- (point) 1))))


(defun hm--dired-make-submenu-with-absolutdirs ()
  "Function generates the \"Goto absolut\" submenu 
with the absolut dir entries. The names of the menu-items
and the directory strings must be in the current buffer.
The point must be on the beginning of the buffer."
  (interactive)
  (let ((submenu nil))
    (save-excursion
      (let ((dirbuffer (hm--dired-load-file-with-absolutdirs)))
	(if dirbuffer
	    (progn
	      (setq submenu
		    (hm--dired-make-absolutdirlist 
		     (hm--dired-get-next-string)
		     (hm--dired-get-next-string)))
	      (kill-buffer dirbuffer)))))
    (add-menu '("Dired" "Directory") 
	      "Goto absolut"
	      (cons
	       ["Homedirectory"  (dired "~/") t]
	       submenu))))


(defun hm--dired-install-submenu-with-absolutdirs ()
  "Installs the submenu with the \"Goto absolut\" submenu."
  (hm--dired-make-submenu-with-absolutdirs)
  (remove-hook 'dired-mode-hook 'hm--dired-install-submenu-with-absolutdirs))



