(defun mouse-on-modeline-p ()
  "Non-nil iff mouse pointer is within a modeline."
  (equal x-mode-pointer-shape (cdr (assq 'pointer (screen-parameters)))))

(defun mouse-left (event)
  "Perform commands bound to left mouse button."
  (interactive "@e")
  (if (mouse-on-modeline-p)
      (scroll-down)
    (mouse-track event)))

;; Mode specific scroll functions

(defun hm--dired-mouse-right (event)
  "Perform commands bound to right mouse button."
  (interactive "@e")
  (if (mouse-on-modeline-p)
      (scroll-up)
    (hm--popup-dired-menu event)))

(defun hm--info-mouse-right (event)
  "Perform commands bound to right mouse button."
  (interactive "@e")
  (if (mouse-on-modeline-p)
      (scroll-up)
    (Info-select-node-menu event)))

(defun hm--buffer-mouse-right (event)
  "Perform commands bound to right mouse button."
  (interactive "@e")
  (if (mouse-on-modeline-p)
      (scroll-up)
    (Buffer-menu-popup-menu event)))


;; Key-Bindings

(global-set-key 'button1 'mouse-left)

(define-key Info-mode-map '(button3) 'hm--info-mouse-right)

(define-key Buffer-menu-mode-map '(button3) 'hm--buffer-mouse-right)


