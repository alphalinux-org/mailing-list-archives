while($group=<GROUPS>)
 	{print "Posting to: $group";
 open(NEWS,"|inews -h"); 
print NEWS "Newsgroups: $group";
 open(MESSAGE, "message.txt"); 
while($line=<MESSAGE>) {
print NEWS $line;
 }
 close NEWS; 
if($?==0) { $success++ } 
else { $fail++
}}$total = $success + $fail;print "Tried to post to $total
