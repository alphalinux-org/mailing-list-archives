    menu->addLabel("&File");
    menu->addItems( Entry("Menu Item &One", CB(Test::cmd)), 
                    Entry("Menu Item &Two", CB(Test::cmd)),
                    NULLENTRY);
    menu->addSeparator();
    menu->addItem(	Entry("E&xit", CB(Test::quit)));

    addSubpane(Edit, "myEdit");
