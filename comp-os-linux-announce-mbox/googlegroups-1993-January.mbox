*** 112,117 ****
--- 112,136 ----
      exit 1
  fi
  
+ badlib=""
+ if [ "`echo 'X(Y)' | sed 's/\(X\)(Y)/\1/'`" != "X" ]; then
+     echo "Your sed doesn't behave like sed."
+     badlib=y
+ fi
+ if [ "`echo 'X(Y)' | grep '^X(Y)'`" != "X(Y)" ]; then
+     echo "Your grep doesn't behave like grep."
+     badlib=y
+ fi
+ if [ "`echo 'X(Y)' | egrep '^(X)\(Y\)'`" != "X(Y)" ]; then
