-  
- 	INT		=	5 
- 	mem		=	D0000 
- 	i/o addr	=	280 
- 	memory start	=	D0000 
- 	memory end	=	D2000	( 8K block for 8003, make it D4000 
- 					  16k for the wd8013 ) 
  
  
! 	INT		=	card interupt, usually selectable between 2-7
! 	mem		=	where in memory to start stuffing data
! 	i/o addr	=	low level communications to the board
