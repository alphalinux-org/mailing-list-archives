>                 rand=`expr \( "${rand}" + "${mypid}" \) % 100`
>         fi
>         echo "inside loop: rand=" ${rand}
> done
> echo "outside loop: rand=" ${rand}

Did you find a solution ?

What about:

#!/bin/sh

rand=1

set - `/bin/ps -e -o pid`
while [ $# -gt 0 ]
do
mypid=$1
      if [ "$mypid" != "PID" ]; then
              rand=`expr \( $rand + $mypid \) % 100`
      fi
      echo "inside loop: rand=" $rand
shift
done
echo "outside loop: rand=" $rand


