---------------------------------------------------------------------------
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/stream.h>
#include <sys/stropts.h>
#include <sys/strlog.h>
#include <sys/dlpihdr.h>
#include <sys/poll.h>

main()
{
  int 			fd, unit ;
  struct strioctl	str ;

  if ( (fd = open("/dev/streams/pcids", O_RDWR)) < 0 ) {
    perror("pcids : open failed ....") ;
    exit(1) ;
  }
  
  if (isastream(fd))
    printf("\nSTREAMS based open\n") ;
  else
    printf("\nSockets based open\n") ;

  if(ioctl(fd,I_PUSH,"ifnet") < 0 ) 
      printf("\n\n ifnet I_PUSH failed \n\n") ;
  else
      printf("\n\n Ifnet module pushed \n\n") ;

  unit = 61 ; /* My device driver's MAJOR id */
  str.ic_cmd = 1236 ;     /* IS THIS THE RIGHT COMMAND ? <<<<<<<<<<<<<<<< */
  str.ic_dp = (char *)&unit ;
  
  if ( ioctl(fd, I_STR, (void *)&str) < 0 ){
    perror("ioctl IFNET_IOCTL_UNIT failed ...") ;
    exit(2) ;
  }

  close (fd) ;
}

