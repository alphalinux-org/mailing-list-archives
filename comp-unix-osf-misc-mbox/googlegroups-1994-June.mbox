argument list and core dumps?  Here is a sample program.  Is a fix available?


#include <stdio.h>
#include <sys/fcntl.h>
#include <errno.h>

main()
{
  FILE *lockfile;
  int lockfd, i;
  char hostname[80];

  lockfd = open("xyz", O_CREAT , S_IRUSR | S_IWUSR);
  lockfile = fdopen(lockfd, "r");
  perror("error at fdopen:");
  printf("%d  %d\n",lockfd,lockfile);
  gethostname(hostname, sizeof(hostname));
  fprintf(lockfile, "%s %d\n", hostname, getpid());
  fclose(lockfile);
  return 0;
  close(lockfd);
}


