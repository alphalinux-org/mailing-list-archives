To turn off the messages programattically:

#include <sys/types.h>
#include <sys/sysinfo.h>

void uac_msg_off(void)
{
   int buf[2];
   /*  Don't print the warning to the user */
   buf[0] = SSIN_UACPROC;
   buf[1] = UAC_NOPRINT;
   setsysinfo(SSI_NVPAIRS,(caddr_t *) buf, 1,(caddr_t) 0, 0);
}

To turn them off at system or process level:
man uac

