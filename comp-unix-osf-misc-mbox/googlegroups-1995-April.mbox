                       Chris McDonald     EMAIL:  chris@cs.uwa.edu.au
       Department of Computer Science       WWW:  http://www.cs.uwa.edu.au/
  The University of Western Australia     PHONE:  ((+61) 09) 380 2533
     Crawley, Western Australia, 6907       FAX:  ((+61) 09) 380 1089



#include <stdio.h>
#include <stdlib.h>

#define	CC_PATH		"/bin/cc"
#define	GCC_PATH	"/usr/gnu/bin/gcc"

int main(argc, argv) int argc; char **argv;
{
    extern char		*strrchr();

    char		*argv0;
    char		*args[8];
    int			ac, pid, status;

    argv0 = (argv0 = strrchr(argv[0],'/')) ? argv0+1 : argv[0];
    argc--; argv++;

    ac		= 0;
    args[ac++]	= "gcc";

    switch (pid = (int)fork()) {
    case -1 :
	(void)fprintf(stderr,"%s: cannot fork\n",argv0);
	status = 1;
	break;
    case 0 :
	args[ac++]	= "-c";
	args[ac++]	= "-o";
	args[ac++]	= "try.o";
	args[ac++]	= "try.c";
	args[ac++]	= (char *)NULL;

	{
	    char	**av		= args;

	    while(*av)
		(void)fprintf(stderr,"%s ", *av++);
	    (void)fputc('\n',stderr);
	}

	if(argc > 0)
	    (void)close(0);

	(void)execv(GCC_PATH, args);
	exit(1);
        break;

    default :
	while(wait(&status) != pid)	/* wait for child to exit */
	    ;
	status = (status >> 8)&0177;
	break;
    }

    (void)fprintf(stderr,"%s exit(%d)\n", args[0], status);
    return(status);
    exit(status);
}



