{
        if (f->fg_name) printf("fd_name = %s\n", p->fd_name);
        if (f->fg_uid) printf("fd_uid = %d\n", p->fd_uid);
        if (f->fg_encrypt) printf("fd_encrypt = %s\n", p->fd_encrypt);
