    {
      if (HCSR->canceled_by_destination)
        {
          ICONFIG.error=HPI_CBDST;
          ICONFIG.transfer=0;
          ICONFIG.done=0;

          call_handler(unit);
          hpi_wakeup(unit);
          return clear_intr(unit);
        }
    }
  else
    {
     if (HCSR->last_connection_end)
        {
          ICONFIG.transfer=0;
          ICONFIG.done=1;
          ICONFIG.error=0;


          hpi_wakeup(unit);
          call_handler(unit);
          clear_intr(unit);
          return;

        }
     }
}

hpi_wakeup(int unit)
{
  wakeup((caddr_t)&ICONFIG.sleep);
  select_wakeup(&KCONFIG.queue);
}


