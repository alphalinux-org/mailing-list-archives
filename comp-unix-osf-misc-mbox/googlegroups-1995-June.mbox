X**  ROUTINE NAME:       init
X**
X**  SCOPE:              INTERNAL - declared locally
X**
X**  DESCRIPTION:
X**
X**  Startup initialization routine for the UUID module.
X**
X**  INPUTS:             none
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:     void
X**
X**  SIDE EFFECTS:       sets uuid_init_done so this won't be done again
X**
X**--
X**/
X
XINTERNAL void init 
X#ifdef _DCE_PROTO_
X(
X    unsigned32              *status
X)
X#else
X(status)
Xunsigned32              *status;
X#endif
X{
X#ifdef CMA_INCLUDE
X    /*
X     * Hack for CMA pthreads.  Some users will call uuid_ stuff before
X     * doing any thread stuff (CMA is uninitialized).  Some uuid_
X     * operations alloc memory and in a CMA pthread environment,
X     * the malloc wrapper uses a mutex but doesn't do self initialization
X     * (which results in segfault'ing inside of CMA).  Make sure that
X     * CMA is initialized.
X     */
X    pthread_t   t;
X    t = pthread_self();
X#endif /* CMA_INCLUDE */
X
X    CODING_ERROR (status);
X
X    /*
X     * init the random number generator
X     */
X    true_random_init();
X
X    uuid__get_os_time (&time_last);
X
X#ifdef UUID_NONVOLATILE_CLOCK
X    clock_seq = uuid__read_clock();
X#else
X    clock_seq = true_random();
X#endif
X
X    uuid_init_done = TRUE;
X
X    *status = uuid_s_ok;
X}
