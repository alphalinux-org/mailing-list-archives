X#define CHECK_STRUCTURE(uuid) \
X( \
X    (((uuid)->clock_seq_hi_and_reserved & 0x80) == 0x00) || /* var #0 */ \
X    (((uuid)->clock_seq_hi_and_reserved & 0xc0) == 0x80) || /* var #1 */ \
X    (((uuid)->clock_seq_hi_and_reserved & 0xe0) == 0xc0)    /* var #2 */ \
X)
X
X/*
X * The following macros invoke CHECK_STRUCTURE(), check that the return
X * value is okay and if not, they set the status variable appropriately
X * and return either a boolean FALSE, nothing (for void procedures),
X * or a value passed to the macro.  This has been done so that checking
X * can be done more simply and values are returned where appropriate
X * to keep compilers happy.
X *
X * bCHECK_STRUCTURE - returns boolean FALSE
X * vCHECK_STRUCTURE - returns nothing (void)
X * rCHECK_STRUCTURE - returns 'r' macro parameter
X */
X
X#define bCHECK_STRUCTURE(uuid, status) \
X{ \
X    if (!CHECK_STRUCTURE (uuid)) \
X    { \
X        *(status) = uuid_s_bad_version; \
X        return (FALSE); \
X    } \
X}
X
X#define vCHECK_STRUCTURE(uuid, status) \
X{ \
X    if (!CHECK_STRUCTURE (uuid)) \
X    { \
X        *(status) = uuid_s_bad_version; \
X        return; \
X    } \
X}
X
X#define rCHECK_STRUCTURE(uuid, status, result) \
X{ \
X    if (!CHECK_STRUCTURE (uuid)) \
X    { \
X        *(status) = uuid_s_bad_version; \
X        return (result); \
X    } \
X}
