XINTERNAL void new_clock_seq 
X#ifdef _DCE_PROTO_
X(
X    unsigned16              *clkseq
X)
X#else
X(clkseq)
Xunsigned16              *clkseq;
X#endif
X{
X    /*
X     * A clkseq value of 0 indicates that it hasn't been initialized.
X     */
X    if (*clkseq == 0)
X    {
X#ifdef UUID_NONVOLATILE_CLOCK
X        *clkseq = uuid__read_clock();           /* read nonvolatile clock */
X        if (*clkseq == 0)                       /* still not init'd ???   */
