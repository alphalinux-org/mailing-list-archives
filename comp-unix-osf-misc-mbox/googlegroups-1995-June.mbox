X/*
X**++
X**
X**  ROUTINE NAME:       uuid_hash
X**
X**  SCOPE:              PUBLIC - declared in UUID.IDL
X**
X**  DESCRIPTION:
X**
X**  Return a hash value for a given UUID.
X**
X**  Note: Since the length of a UUID is architecturally defined to be
X**        128 bits (16 bytes), we have forgone using a '#defined'
X**        length.  In particular, since the 'loop' has been unrolled
X**        (for performance) the length is by definition 'hard-coded'.
X**
X**  INPUTS:
X**
X**      uuid            A UUID for which a hash value is to be computed
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_bad_version
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:
X**
X**      hash_value      The hash value computed from the UUID
X**
X**  SIDE EFFECTS:       none
X**
X**--
X**/
X
XPUBLIC unsigned16 uuid_hash 
X#ifdef _DCE_PROTO_
X(
X    uuid_p_t                uuid,
X    unsigned32              *status
X)
X#else
X(uuid, status)
Xuuid_p_t                uuid;
Xunsigned32              *status;
X#endif
X{
X    short               c0, c1;
X    short               x, y;
X    byte_p_t            next_uuid;
X
X    RPC_LOG_UUID_HASH_NTR;
X
X    CODING_ERROR (status);
X    UUID_VERIFY_INIT (FALSE);
X
X    rCHECK_STRUCTURE (uuid, status, 0);
X
X    /*
X     * initialize counters
X     */
X    c0 = c1 = 0;
X    next_uuid = (byte_p_t) uuid;
X
X    /*
X     * For speed lets unroll the following loop:
X     *
X     *   for (i = 0; i < UUID_K_LENGTH; i++)
X     *   {
X     *       c0 = c0 + *next_uuid++;
X     *       c1 = c1 + c0;
X     *   }
X     */
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X    c0 = c0 + *next_uuid++;
X    c1 = c1 + c0;
X
X    /*
X     *  Calculate the value for "First octet" of the hash
X     */
X    x = -c1 % 255;
X    if (x < 0)
X    {
X        x = x + 255;
X    }
X
X    /*
X     *  Calculate the value for "second octet" of the hash
X     */
X    y = (c1 - c0) % 255;
X    if (y < 0)
X    {
X        y = y + 255;
X    }
X
X    /*
X     * return the pieces put together
X     */
X    *status = uuid_s_ok;
X
X    RPC_LOG_UUID_HASH_XIT;
X    return ((y * 256) + x);
X}
