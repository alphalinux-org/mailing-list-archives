X    UUID_VERIFY_INIT (FALSE);
X
X    bCHECK_STRUCTURE (uuid, status);
X
X    *status = uuid_s_ok;
X
X    /*
X     * Note: This should later be changed to a field-by-field compare
X     * because of portability problems with alignment and garbage in a UUID.
X     */
X    if (memcmp (uuid, &uuid_g_nil_uuid, sizeof (uuid_t)) == 0)
X    {
X        return (TRUE);
X    }
