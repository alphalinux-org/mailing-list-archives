X/*
X * local defines used in uuid bit-diddling
X */
X#define HI_WORD(w)                  ((w) >> 16)
X#define RAND_MASK                   0x3fff      /* same as CLOCK_SEQ_LAST */
X
X#define TIME_MID_MASK               0x0000ffff
X#define TIME_HIGH_MASK              0x0fff0000
X#define TIME_HIGH_SHIFT_COUNT       16
X
X#define MAX_TIME_ADJUST             0x7fff
X
X#define CLOCK_SEQ_LOW_MASK          0xff
X#define CLOCK_SEQ_HIGH_MASK         0x3f00
X#define CLOCK_SEQ_HIGH_SHIFT_COUNT  8
X#define CLOCK_SEQ_FIRST             1
X#define CLOCK_SEQ_LAST              0x3fff      /* same as RAND_MASK */
X
X/*
X * Note: If CLOCK_SEQ_BIT_BANG == TRUE, then we can avoid the modulo
X * operation.  This should save us a divide instruction and speed
X * things up.
X */
X
X#ifndef CLOCK_SEQ_BIT_BANG
X#define CLOCK_SEQ_BIT_BANG          1
X#endif
X
X#if CLOCK_SEQ_BIT_BANG
X#define CLOCK_SEQ_BUMP(seq)         ((*seq) = ((*seq) + 1) & CLOCK_SEQ_LAST)
X#else
X#define CLOCK_SEQ_BUMP(seq)         ((*seq) = ((*seq) + 1) % (CLOCK_SEQ_LAST+1))
X#endif
X
X#define UUID_VERSION_BITS           (uuid_c_version << 12)
X#define UUID_RESERVED_BITS          0x80
X
X#define IS_OLD_UUID(uuid) (((uuid)->clock_seq_hi_and_reserved & 0xc0) != 0x80)
