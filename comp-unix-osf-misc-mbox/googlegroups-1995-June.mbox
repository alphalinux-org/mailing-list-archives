X/*****************************************************************************
X *
X *  LOCAL MATH PROCEDURES - math procedures used internally by the UUID module
X *
X ****************************************************************************/
X
X/*
X** T I M E _ C M P
X**
X** Compares two UUID times (64-bit UTC values)
X**/
X
XINTERNAL uuid_compval_t time_cmp 
X#ifdef _DCE_PROTO_
X(
X    uuid_time_p_t           time1,
X    uuid_time_p_t           time2
X)
X#else
X(time1, time2)
Xuuid_time_p_t           time1;
Xuuid_time_p_t           time2;
X#endif
X{
X    /*
X     * first check the hi parts
X     */
X    if (time1->hi < time2->hi) return (uuid_e_less_than);
X    if (time1->hi > time2->hi) return (uuid_e_greater_than);
X
X    /*
X     * hi parts are equal, check the lo parts
X     */
X    if (time1->lo < time2->lo) return (uuid_e_less_than);
X    if (time1->lo > time2->lo) return (uuid_e_greater_than);
X
X    return (uuid_e_equal_to);
X}
X
X/*
X**  U U I D _ _ U E M U L
X**
X**  Functional Description:
X**        32-bit unsigned quantity * 32-bit unsigned quantity
X**        producing 64-bit unsigned result. This routine assumes
X**        long's contain at least 32 bits. It makes no assumptions
X**        about byte orderings.
X**
X**  Inputs:
X**
X**        u, v       Are the numbers to be multiplied passed by value
X**
X**  Outputs:
X**
X**        prodPtr    is a pointer to the 64-bit result
X**
X**  Note:
X**        This algorithm is taken from: "The Art of Computer
X**        Programming", by Donald E. Knuth. Vol 2. Section 4.3.1
X**        Pages: 253-255.
X**--
X**/
X
XPRIVATE void uuid__uemul 
X#ifdef _DCE_PROTO_
X(
X    unsigned32          u,
X    unsigned32          v,
X    unsigned64_t        *prodPtr
X)
X#else
X(u, v, prodPtr)
Xunsigned32          u;
Xunsigned32          v;
Xunsigned64_t        *prodPtr;
X#endif
X{
X    /*
X     * following the notation in Knuth, Vol. 2
X     */
X    unsigned32      uuid1, uuid2, v1, v2, temp;
X
X
X    uuid1 = u >> 16;
X    uuid2 = u & 0xffff;
X    v1 = v >> 16;
X    v2 = v & 0xffff;
X
X    temp = uuid2 * v2;
X    prodPtr->lo = temp & 0xffff;
X    temp = uuid1 * v2 + (temp >> 16);
X    prodPtr->hi = temp >> 16;
X    temp = uuid2 * v1 + (temp & 0xffff);
X    prodPtr->lo += (temp & 0xffff) << 16;
X    prodPtr->hi += uuid1 * v1 + (temp >> 16);
X}
X
X/****************************************************************************
X**
X**    U U I D   T R U E   R A N D O M   N U M B E R   G E N E R A T O R
X**
X*****************************************************************************
X**
X** This random number generator (RNG) was found in the ALGORITHMS Notesfile.
X**
X** (Note 16.7, July 7, 1989 by Robert (RDVAX::)Gries, Cambridge Research Lab,
X**  Computational Quality Group)
X**
X** It is really a "Multiple Prime Random Number Generator" (MPRNG) and is
X** completely discussed in reference #1 (see below).
X**
X**   References:
X**   1) "The Multiple Prime Random Number Generator" by Alexander Hass
X**      pp. 368 to 381 in ACM Transactions on Mathematical Software,
X**      December, 1987
X**   2) "The Art of Computer Programming: Seminumerical Algorithms
X**      (vol 2)" by Donald E. Knuth, pp. 39 to 113.
X**
X** A summary of the notesfile entry follows:
X**
X** Gries discusses the two RNG's available for ULTRIX-C.  The default RNG
X** uses a Linear Congruential Method (very popular) and the second RNG uses
X** a technique known as a linear feedback shift register.
X**
X** The first (default) RNG suffers from bit-cycles (patterns/repetition),
X** ie. it's "not that random."
X**
X** While the second RNG passes all the emperical tests, there are "states"
X** that become "stable", albeit contrived.
X**
X** Gries then presents the MPRNG and says that it passes all emperical
X** tests listed in reference #2.  In addition, the number of calls to the
X** MPRNG before a sequence of bit position repeats appears to have a normal
X** distribution.
X**
X** Note (mbs): I have coded the Gries's MPRNG with the same constants that
X** he used in his paper.  I have no way of knowing whether they are "ideal"
X** for the range of numbers we are dealing with.
X**
X****************************************************************************/
X
X/*
X** T R U E _ R A N D O M _ I N I T
X**
X** Note: we "seed" the RNG with the bits from the clock and the PID
X**
X**/
X
XINTERNAL void true_random_init (void)
X{
X    uuid_time_t         t;
X    unsigned16          *seedp, seed=0;
X
X
X    /*
X     * optimal/recommended starting values according to the reference
X     */
X    static unsigned32   rand_m_init     = 971;
X    static unsigned32   rand_ia_init    = 11113;
X    static unsigned32   rand_ib_init    = 104322;
X    static unsigned32   rand_irand_init = 4181;
X
X    rand_m = rand_m_init;
X    rand_ia = rand_ia_init;
X    rand_ib = rand_ib_init;
X    rand_irand = rand_irand_init;
X
X    /*
X     * Generating our 'seed' value
X     *
X     * We start with the current time, but, since the resolution of clocks is
X     * system hardware dependent (eg. Ultrix is 10 msec.) and most likely
X     * coarser than our resolution (10 usec) we 'mixup' the bits by xor'ing
X     * all the bits together.  This will have the effect of involving all of
X     * the bits in the determination of the seed value while remaining system
X     * independent.  Then for good measure to ensure a unique seed when there
X     * are multiple processes creating UUID's on a system, we add in the PID.
X     */
X    uuid__get_os_time(&t);
X    seedp = (unsigned16 *)(&t);
X    seed ^= *seedp++;
X    seed ^= *seedp++;
X    seed ^= *seedp++;
X    seed ^= *seedp++;
X    rand_irand += seed + uuid__get_os_pid();
X}
X
X/*
X** T R U E _ R A N D O M
X**
X** Note: we return a value which is 'tuned' to our purposes.  Anyone
X** using this routine should modify the return value accordingly.
X**/
X
XINTERNAL unsigned16 true_random (void)
X{
X    rand_m += 7;
X    rand_ia += 1907;
X    rand_ib += 73939;
X
X    if (rand_m >= 9973) rand_m -= 9871;
X    if (rand_ia >= 99991) rand_ia -= 89989;
X    if (rand_ib >= 224729) rand_ib -= 96233;
X
X    rand_irand = (rand_irand * rand_m) + rand_ia + rand_ib;
X
X    return (HI_WORD (rand_irand) ^ (rand_irand & RAND_MASK));
X}
