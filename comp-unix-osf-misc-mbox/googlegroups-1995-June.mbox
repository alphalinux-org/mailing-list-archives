X**  Decode a UUID from a printable string.
X**
X**  INPUTS:
X**
X**      uuid_string     The string UUID to be converted to a binary UUID
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      uuid            The binary representation of the given UUID
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_bad_version
X**          uuid_s_invalid_string_uuid
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:     void
X**
X**  SIDE EFFECTS:       none
X**
X**--
X**/
X
XPUBLIC void uuid_from_string 
X#ifdef _DCE_PROTO_
X(
X    unsigned_char_p_t       uuid_string,
X    uuid_t                  *uuid,
X    unsigned32              *status
X)
X#else
X(uuid_string, uuid, status)
Xunsigned_char_p_t       uuid_string;
Xuuid_t                  *uuid;
Xunsigned32              *status;
X#endif
X{
X    uuid_t              uuid_new;       /* used for sscanf for new uuid's */
X    uuid_old_t          uuid_old;       /* used for sscanf for old uuid's */
X    uuid_p_t            uuid_ptr;       /* pointer to correct uuid (old/new) */
X    int                 i;
X
X
X    CODING_ERROR (status);
X    UUID_VERIFY_INIT(EmptyArg);
X
X    /*
X     * If a NULL pointer or empty string, give the nil UUID.
X     */
X    if (uuid_string == NULL || *uuid_string == '\0')
X    {
X	memcpy (uuid, &uuid_g_nil_uuid, sizeof *uuid);
X	*status = uuid_s_ok;
X	return;
X    }
X
X    /*
X     * check to see that the string length is right at least
X     */
X    if (strlen ((char *) uuid_string) != UUID_C_UUID_STRING_MAX - 1)
X    {
X        *status = uuid_s_invalid_string_uuid;
X        return;
X    }
X
X    /*
X     * check for a new uuid
X     */
X    if (uuid_string[8] == '-')
X    {
X        long    time_low;
X        int     time_mid;
X        int     time_hi_and_version;
X        int     clock_seq_hi_and_reserved;
X        int     clock_seq_low;
X        int     node[6];
X
X
X        i = UUID_SSCANF(
X            (char *) uuid_string, "%8lx-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x",
X            &time_low,
X            &time_mid,
X            &time_hi_and_version,
X            &clock_seq_hi_and_reserved,
X            &clock_seq_low,
X            &node[0], &node[1], &node[2], &node[3], &node[4], &node[5]);
X
X        /*
X         * check that sscanf worked
X         */
X        if (i != UUID_ELEMENTS_NUM)
X        {
X            *status = uuid_s_invalid_string_uuid;
X            return;
X        }
X
X        /*
X         * note that we're going through this agony because scanf is defined to
X         * know only to scan into "int"s or "long"s.
X         */
X        uuid_new.time_low                   = time_low;
X        uuid_new.time_mid                   = time_mid;
X        uuid_new.time_hi_and_version        = time_hi_and_version;
X        uuid_new.clock_seq_hi_and_reserved  = clock_seq_hi_and_reserved;
X        uuid_new.clock_seq_low              = clock_seq_low;
X        uuid_new.node[0]                    = node[0];
X        uuid_new.node[1]                    = node[1];
X        uuid_new.node[2]                    = node[2];
X        uuid_new.node[3]                    = node[3];
X        uuid_new.node[4]                    = node[4];
X        uuid_new.node[5]                    = node[5];
X
X        /*
X         * point to the correct uuid
X         */
X        uuid_ptr = &uuid_new;
X    }
X    else
X    {
X        long    time_high;
X        int     time_low;
X        int     family;
X        int     host[7];
X
X
X        /*
X         * format = tttttttttttt.ff.h1.h2.h3.h4.h5.h6.h7
X         */
X        i = UUID_OLD_SSCANF(
X            (char *) uuid_string, "%8lx%4x.%2x.%2x.%2x.%2x.%2x.%2x.%2x.%2x",
X            &time_high, &time_low, &family,
X            &host[0], &host[1], &host[2], &host[3],
X            &host[4], &host[5], &host[6]);
X
X        /*
X         * check that sscanf worked
X         */
X        if (i != UUID_ELEMENTS_NUM_OLD)
X        {
X            *status = uuid_s_invalid_string_uuid;
X            return;
X        }
X
X        /*
X         * note that we're going through this agony because scanf is defined to
X         * know only to scan into "int"s or "long"s.
X         */
X        uuid_old.time_high      = time_high;
X        uuid_old.time_low       = time_low;
X        uuid_old.family         = family;
X        uuid_old.host[0]        = host[0];
X        uuid_old.host[1]        = host[1];
X        uuid_old.host[2]        = host[2];
X        uuid_old.host[3]        = host[3];
X        uuid_old.host[4]        = host[4];
X        uuid_old.host[5]        = host[5];
X        uuid_old.host[6]        = host[6];
X
X        /*
X         * fix up non-string field, and point to the correct uuid
X         */
X        uuid_old.reserved = 0;
X        uuid_ptr = (uuid_p_t) (&uuid_old);
X    }
X
X    /*
X     * sanity check, is version ok?
X     */
X    vCHECK_STRUCTURE (uuid_ptr, status);
X
X    /*
X     * copy the uuid to user
X     */
X    memcpy (uuid, uuid_ptr, sizeof (uuid_t));
X
X    *status = uuid_s_ok;
X}
