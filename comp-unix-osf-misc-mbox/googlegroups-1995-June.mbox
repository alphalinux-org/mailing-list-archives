X/*
X**++
X**
X**  ROUTINE NAME:       uuid_compare
X**
X**  SCOPE:              PUBLIC - declared in UUID.IDL
X**
X**  DESCRIPTION:
X**
X**  Compare two UUID's "lexically"
X**
X**  If either of the two arguments is given as a NULL pointer, the other
X**  argument will be compared to the nil uuid.
X**
X**  Note:   1) lexical ordering is not temporal ordering!
X**          2) in the interest of keeping this routine short, I have
X**             violated the coding convention that says all if/else
X**             constructs shall have {}'s. There are a little million
X**             return()'s in this routine. FWIW, the only {}'s that
X**             are really required are the ones in the for() loop.
X**
X**  INPUTS:
X**
X**      uuid1           The first UUID to compare
X**
X**      uuid2           The second UUID to compare
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_bad_version
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:     uuid_order_t
X**
X**      -1   uuid1 is lexically before uuid2
X**      1    uuid1 is lexically after uuid2
X**
X**  SIDE EFFECTS:       none
X**
X**--
X**/
X
XPUBLIC signed32 uuid_compare 
X#ifdef _DCE_PROTO_
X(
X    uuid_p_t                uuid1,
X    uuid_p_t                uuid2,
X    unsigned32              *status
X)
X#else
X(uuid1, uuid2, status)
Xuuid_p_t                uuid1;
Xuuid_p_t                uuid2;
Xunsigned32              *status;
X#endif
X{
X    int                 i;
X
X    CODING_ERROR (status);
X    UUID_VERIFY_INIT (FALSE);
X
X
X    /*
X     * check to see if either of the arguments is a NULL pointer
X     * - if so, compare the other argument to the nil uuid
X     */
X    if (uuid1 == NULL)
X    {
X        /*
X         * if both arguments are NULL, so is this routine
X         */
X        if (uuid2 == NULL)
X        {
X            *status = uuid_s_ok;
X            return (0);
X        }
X
X        rCHECK_STRUCTURE (uuid2, status, -1);
X        return (uuid_is_nil (uuid2, status) ? 0 : -1);
X    }
X
X    if (uuid2 == NULL)
X    {
X        rCHECK_STRUCTURE (uuid1, status, -1);
X        return (uuid_is_nil (uuid1, status) ? 0 : 1);
X    }
X
X    rCHECK_STRUCTURE (uuid1, status, -1);
X    rCHECK_STRUCTURE (uuid2, status, -1);
X
X    *status = uuid_s_ok;
X
X    if (uuid1->time_low == uuid2->time_low)
X    {
X        if (uuid1->time_mid == uuid2->time_mid)
X        {
X            if (uuid1->time_hi_and_version == uuid2->time_hi_and_version)
X            {
X                if (uuid1->clock_seq_hi_and_reserved
X                    == uuid2->clock_seq_hi_and_reserved)
X                {
X                    if (uuid1->clock_seq_low == uuid2->clock_seq_low)
X                    {
X                        for (i = 0; i < 6; i++)
X                        {
X                            if (uuid1->node[i] < uuid2->node[i])
X                                return (-1);
X                            if (uuid1->node[i] > uuid2->node[i])
X                                return (1);
X                        }
X                        return (0);
X                    }       /* end if - clock_seq_low */
X                    else
X                    {
X                        if (uuid1->clock_seq_low < uuid2->clock_seq_low)
X                            return (-1);
X                        else
X                            return (1);
X                    }       /* end else - clock_seq_low */
X                }           /* end if - clock_seq_hi_and_reserved */
X                else
X                {
X                    if (uuid1->clock_seq_hi_and_reserved
X                        < uuid2->clock_seq_hi_and_reserved)
X                        return (-1);
X                    else
X                        return (1);
X                }           /* end else - clock_seq_hi_and_reserved */
X            }               /* end if - time_hi_and_version */
X            else
X            {
X                if (uuid1->time_hi_and_version < uuid2->time_hi_and_version)
X                    return (-1);
X                else
X                    return (1);
X            }               /* end else - time_hi_and_version */
X        }                   /* end if - time_mid */
X        else
X        {
X            if (uuid1->time_mid < uuid2->time_mid)
X                return (-1);
X            else
X                return (1);
X        }                   /* end else - time_mid */
X    }                       /* end if - time_low */
X    else
X    {
X        if (uuid1->time_low < uuid2->time_low)
X            return (-1);
X        else
X            return (1);
X    }                       /* end else - time_low */
X}
