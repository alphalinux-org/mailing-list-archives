X**++
X**
X**  ROUTINE NAME:       uuid_equal
X**
X**  SCOPE:              PUBLIC - declared in UUID.IDL
X**
X**  DESCRIPTION:
X**
X**  Compare two UUIDs.
X**
X**  INPUTS:
X**
X**      uuid1           The first UUID to compare
X**
X**      uuid2           The second UUID to compare
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_bad_version
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:
X**
X**      result          true if UUID's are equal
X**                      false if UUID's are not equal
X**
X**  SIDE EFFECTS:       none
X**
X**--
X**/
X
XPUBLIC boolean32 uuid_equal 
X#ifdef _DCE_PROTO_
X(
X    register uuid_p_t                uuid1,
X    register uuid_p_t                uuid2,
X    register unsigned32              *status
X)
X#else
X(uuid1, uuid2, status)
Xregister uuid_p_t                uuid1;
Xregister uuid_p_t                uuid2;
Xregister unsigned32              *status;
X#endif
X{
X    RPC_LOG_UUID_EQUAL_NTR;
X    CODING_ERROR (status);
X    UUID_VERIFY_INIT (FALSE);
X
X    bCHECK_STRUCTURE (uuid1, status);
X    bCHECK_STRUCTURE (uuid2, status);
X
X    *status = uuid_s_ok;
X
X    /*
X     * Note: This used to be a memcmp(), but changed to a field-by-field compare
X     * because of portability problems with alignment and garbage in a UUID.
X     */
X    if ((uuid1->time_low == uuid2->time_low) && 
X	(uuid1->time_mid == uuid2->time_mid) &&
X	(uuid1->time_hi_and_version == uuid2->time_hi_and_version) && 
X	(uuid1->clock_seq_hi_and_reserved == uuid2->clock_seq_hi_and_reserved) &&
X	(uuid1->clock_seq_low == uuid2->clock_seq_low) &&
X	(memcmp(uuid1->node, uuid2->node, 6) == 0))
X    {
X	RPC_LOG_UUID_EQUAL_XIT;
X	return ( TRUE );
X    }
X    else
X    {
X        RPC_LOG_UUID_EQUAL_XIT;
X        return (FALSE);
X    }
X}
