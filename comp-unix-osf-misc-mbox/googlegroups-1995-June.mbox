X#else
X        /*
X         * with a volatile clock, we always init to a random number
X         */
X        *clkseq = true_random();
X#endif
X    }
X
X    CLOCK_SEQ_BUMP (clkseq);
X    if (*clkseq == 0)
X    {
X        *clkseq = *clkseq + 1;
