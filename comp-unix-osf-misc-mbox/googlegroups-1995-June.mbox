X#define EmptyArg
X#define UUID_VERIFY_INIT(Arg)          \
X    if (! uuid_init_done)           \
X    {                               \
X        init (status);              \
X        if (*status != uuid_s_ok)   \
X        {                           \
X            return Arg;                 \
X        }                           \
X    }
