X/*
X**++
X**
X**  ROUTINE NAME:       uuid_create
X**
X**  SCOPE:              PUBLIC - declared in UUID.IDL
X**
X**  DESCRIPTION:
X**
X**  Create a new UUID. Note: we only know how to create the new
X**  and improved UUIDs.
X**
X**  INPUTS:             none
X**
X**  INPUTS/OUTPUTS:     none
X**
X**  OUTPUTS:
X**
X**      uuid            A new UUID value
X**
X**      status          return status value
X**
X**          uuid_s_ok
X**          uuid_s_coding_error
X**
X**  IMPLICIT INPUTS:    none
X**
X**  IMPLICIT OUTPUTS:   none
X**
X**  FUNCTION VALUE:     void
X**
X**  SIDE EFFECTS:       none
X**
X**--
X**/
X
XPUBLIC void uuid_create 
X#ifdef _DCE_PROTO_
X(
X    uuid_t                  *uuid,
X    unsigned32              *status
X)
X#else
X(uuid, status)
Xuuid_t                  *uuid;
Xunsigned32              *status;
X#endif
X{
X    uuid_address_t          eaddr;      /* our IEEE 802 hardware address */
X    boolean32               got_no_time = FALSE;
X
X    RPC_LOG_UUID_CREATE_NTR;
X
X    CODING_ERROR (status);
X    UUID_VERIFY_INIT (EmptyArg);
X
X    /*
X     * get our hardware network address
X     */
X    uuid_get_address (&eaddr, status);
X    if (*status != uuid_s_ok)
X    {
X        DEBUG_PRINT("uuid_create:uuid_get_address", *status);
X        return;
X    }
X
X    do
X    {
X        /*
X         * get the current time
X         */
X        uuid__get_os_time (&time_now);
X
X        /*
X         * do stuff like:
X         *
X         *  o check that our clock hasn't gone backwards and handle it
X         *    accordingly with clock_seq
X         *  o check that we're not generating uuid's faster than we
X         *    can accommodate with our time_adjust fudge factor
X         */
X        switch (time_cmp (&time_now, &time_last))
X        {
X            case uuid_e_less_than:
X                new_clock_seq (&clock_seq);
X                time_adjust = 0;
X                break;
X            case uuid_e_greater_than:
X                time_adjust = 0;
X                break;
X            case uuid_e_equal_to:
X                if (time_adjust == MAX_TIME_ADJUST)
X                {
X                    /*
X                     * spin your wheels while we wait for the clock to tick
X                     */
X                    got_no_time = TRUE;
X                }
X                else
X                {
X                    time_adjust++;
X                }
X                break;
X            default:
X                *status = uuid_s_internal_error;
X                DEBUG_PRINT ("uuid_create", *status);
X                return;
X        }
X    } while (got_no_time);
X
X    time_last.lo = time_now.lo;
X    time_last.hi = time_now.hi;
X
X    if (time_adjust != 0)
X    {
X        UADD_UW_2_UVLW (&time_adjust, &time_now, &time_now);
X    }
X
X    /*
X     * now construct a uuid with the information we've gathered
X     * plus a few constants
X     */
X    uuid->time_low = time_now.lo;
X    uuid->time_mid = time_now.hi & TIME_MID_MASK;
X
X    uuid->time_hi_and_version =
X        (time_now.hi & TIME_HIGH_MASK) >> TIME_HIGH_SHIFT_COUNT;
X    uuid->time_hi_and_version |= UUID_VERSION_BITS;
X
X    uuid->clock_seq_low = clock_seq & CLOCK_SEQ_LOW_MASK;
X    uuid->clock_seq_hi_and_reserved =
X        (clock_seq & CLOCK_SEQ_HIGH_MASK) >> CLOCK_SEQ_HIGH_SHIFT_COUNT;
X
X    uuid->clock_seq_hi_and_reserved |= UUID_RESERVED_BITS;
X
X    memcpy (uuid->node, &eaddr, sizeof (uuid_address_t));
X
X    *status = uuid_s_ok;
X    RPC_LOG_UUID_CREATE_XIT;
X}
