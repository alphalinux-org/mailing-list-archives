#include <pthread.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <dce/rpc.h>
#include <dce/dce_error.h>

#include "nRPC.h"

static unsigned long   nRPC;     /* Number of RPCs */

static pthread_mutex_t nRPC_MT;  /* Mutex on nRPC  */

void vector_sum (handle_t client_handle, idl_long_int first,
                 idl_long_int length, idl_char* array,
                 idl_char* sum, error_status_t* status)
{
    *sum = array[first] + array[first+length-1];

    if (pthread_mutex_lock (&nRPC_MT) < 0)
        perror("pthread_mutex_lock"), exit(1);

    nRPC++; /* Update RPC counter. */

    if (pthread_mutex_unlock (&nRPC_MT) < 0)
        perror("pthread_mutex_unlock"), exit(1);
}

static void report_dce_error (unsigned long status)
{
    int  error_status;
    char error_text[dce_c_error_string_len];
    dce_error_inq_text (status, error_text, &error_status);
    if (error_status != -1)
        (void) printf(">>> rpc runtime error: %s.\n", error_text);
    else
        (void) printf(">>> rpc runtime error: no error text translation.\n");
    exit (EXIT_FAILURE);
}

static void* rpc_counter (pthread_addr_t ignore)
{
    const int Seconds = 5;    /* Output RPC rate every five seconds */

    struct timespec interval; 

    interval.tv_sec  = 5L, interval.tv_nsec = 0L;

    for (;;)
    { 
        if (pthread_mutex_lock (&nRPC_MT) < 0)
            perror("pthread_mutex_lock"), exit(1);

        (void) printf ("*** RPC rate = %lu per second.\n", nRPC/Seconds);

        nRPC = 0;
        
        if (pthread_mutex_unlock (&nRPC_MT) < 0)
            perror("pthread_mutex_unlock"), exit(1);

        if (pthread_delay_np (&interval))
            perror("pthread_delay_np"), exit(1);
    }

    return 0;
}

static void* sigint_handler (pthread_addr_t ignore)
{
    sigset_t set;
    if (sigemptyset(&set) < 0)
        perror("sigemptyset"), exit(1);
    if (sigaddset(&set, SIGINT) < 0)
        perror("sigemptyset"), exit(1);
    if (sigwait(&set) < 0)
        perror("sigwait"), exit(1);
    (void) fprintf(stderr, "caught a SIGINT, exiting ...\n");
    exit(1);
}

int main ()
{
    unsigned32             status = 0;
    unsigned_char_t*       string_binding;
    rpc_binding_vector_p_t binding_vector;
    FILE*                  binding;
    pthread_t              counterID, sigintID;
    int                    i = 0, listen_count = 10;
    /*
    ** Set up transfer rate counter thread.
    */
    if (pthread_mutex_init (&nRPC_MT, pthread_mutexattr_default) < 0)
        perror("pthread_mutex_init"), exit(1);

    if (pthread_create(&counterID, pthread_attr_default, rpc_counter, 0) < 0)
        perror("pthread_create"), exit(1);
    /*
    ** Set up SIGINT handler thread.
    */
    if (pthread_create(&sigintID, pthread_attr_default, sigint_handler, 0) < 0)
        perror("pthread_create"), exit(1);
    /*
    ** Tell the server to use all available protocol sequences.
    */
    rpc_server_use_all_protseqs (rpc_c_protseq_max_reqs_default, &status);
    if (!(status == rpc_s_ok))
        (void) printf("No available protocol sequences.\n"),
        report_dce_error(status);
    /*
    ** Register the server interface.
    */
    rpc_server_register_if (nRPC_v1_0_s_ifspec, NULL, NULL, &status);
    if (!(status == rpc_s_ok))
        (void) printf ("Can't register interface.\n"),
        report_dce_error (status);
    /*
    ** Find out what binding information is actually available.
    */
    rpc_server_inq_bindings (&binding_vector, &status);
    if (!(status == rpc_s_ok))
        (void) printf ("Can't inquire binding information.\n"),
        report_dce_error (status);
    /*
    ** Walk the binding vector and output the information.
    */
    for (i = 0; i < binding_vector->count; i++)
    {
        unsigned_char_t *uuid, *protseq, *netaddr, *endpoint, *netopt;

        rpc_binding_to_string_binding (binding_vector->binding_h[i],
                                       &string_binding, &status);
        if (!(status == rpc_s_ok))
            (void) printf ("Can't get string binding\n"),
            report_dce_error(status);

        rpc_string_binding_parse (string_binding, &uuid, &protseq, &netaddr,
                                  &endpoint, &netopt, &status);
        if (!(status == rpc_s_ok))
            (void) printf ("Can't parse string binding\n"),
            report_dce_error (status);

        rpc_string_free (&string_binding, &status);
        if (!(status == rpc_s_ok))
            (void) printf ("Can't free string binding.\n"),
            report_dce_error (status);

        printf("%s %s %s\n", (char*)protseq, (char*)netaddr, (char*)endpoint);
    }
    /*
    ** Wait for incoming client requests.
    **
    ** Default maximum is `rpc_c_listen_max_calls_default'.
    **/
    (void) printf("Listen count = %d\n", listen_count);
    
    rpc_server_listen (listen_count, &status);
    if (!(status == rpc_s_ok))
        (void) printf ("Abnormal termination of server listener.\n"),
        report_dce_error (status);
}
