	IN	AFSDB	2	server04.icaen.uiowa.edu.
	IN	AFSDB	2	s-dce01.icaen.uiowa.edu.
	IN	TXT		"1 16aecfdc-6c94-11cd-85d3-080009176ac6   Master  /.../icaen.uiowa.edu/server04_ch 15aa7a00-6c94-11cd-85d3-080009176ac6 server04.icaen.uiowa.edu"
