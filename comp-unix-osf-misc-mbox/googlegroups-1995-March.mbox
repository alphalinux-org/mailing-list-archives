			360000	; Expire  100 hours
			21600 )	; Minimum 6 hours
;
	IN	NS	icaen6.icaen.uiowa.edu.
	IN	NS	icaen7.icaen.uiowa.edu.
	IN	NS	dns1.uiowa.edu.
	IN	NS	dns2.uiowa.edu.
	IN	NS	dns3.uiowa.edu.
	IN	A	128.255.21.56
	IN	A	128.255.16.56
	IN	MX	10	icaen6.icaen.uiowa.edu.
	IN	MX	20	ns-mx.uiowa.edu.
