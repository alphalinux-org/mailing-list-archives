Try this version with "noisy" copy constructor and assignment operator.

#include <iostream.h>

class exp {
  public:
    exp( int x ) : i( x ) {
      cout << "ctor -- " << *this << endl; }

    ~exp() {
      cout << "dtor -- " << *this << endl; }

    exp( const exp& e ) : i( e.i ) {
      cout << "copy ctor -- " << *this << " from " << e << endl; }

    exp& operator=( const exp& e ) {
      cout << "assignment " << *this << " = " << e << endl;
      if( &e != this )
        i = e.i;
      return *this; }

    friend ostream& operator<<( ostream& o, const exp& e ) {
      return o << "exp{" << e.i << "} at: " << &e; }

  private:
    int i;
};

main() {
  try {
    cout << "Throwing exception\n";
    throw exp(1);
  } catch (exp a) {
    cout << "Caught " << a << endl;
  }
  cout << "Exiting\n";
}


