-		volatile u_int64_t *p, v;
+		volatile u_int64_t *p, qv;
 		u_int64_t shift, msk;
 
 		shift = off & 0x3;
@@ -532,9 +532,9 @@ tc_mem_write_1(v, memh, off, val)
 		p = (u_int64_t *)(memh + (off << 1));
 
