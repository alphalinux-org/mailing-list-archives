LKMDIR=/usr/pkg/lkm
CACHEDIR=/usr/pkg/cache
LIBEXECDIR=/usr/pkg/libexec
VARDB=/var/db

if [ ! -e $CACHEDIR ] ; then
    mkdir $CACHEDIR
    chmod 700 $CACHEDIR
    chown root $CACHEDIR
fi

if test -f  $LKMDIR/xfs.ko; then
   if test ! -c /dev/xfs0; then
     mknod /dev/xfs0 c 128 0
   fi
   kldload $LKMDIR/xfs.ko
elif test -x /sbin/kextload; then
