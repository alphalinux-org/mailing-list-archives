   *              int             lifetime
   *              int             kvno
   *              KTEXT_ST        ticket_st
!  *              int32_t         issue_date
   *
   * Short description of routines:
   *
***************
*** 570,577 ****
      if (write(fd, (char *) (ticket->dat), count) != count)
  	goto bad;
      /* Issue date */
!     if (write(fd, (char *) &issue_date, sizeof(long))
! 	!= sizeof(long))
  	goto bad;
  
      /* Actually, we should check each write for success */
--- 570,577 ----
      if (write(fd, (char *) (ticket->dat), count) != count)
  	goto bad;
      /* Issue date */
!     if (write(fd, (char *) &issue_date, sizeof(issue_date))
