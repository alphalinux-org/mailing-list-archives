	./usr/lib/cmplrs/fortrtl/libFutil.so
	./usr/lib/cmplrs/fortrtl/libUfor.so
	./usr/lib/cmplrs/fortrtl/libfor.so
	./usr/lib/nls/loc/charmaps/ascii.cm
	./usr/lib/nls/loc/C
	./usr/lib/nls/loc/en_US.ISO8859-1
	./usr/lib/nls/msg/*
	./usr/lib/nls/help
	./usr/lib/nls/patterns
	./usr/lib/X11/locale/*
