Hey!

I recently needed to rebuild the kernel for my headless netbsd-7 system, and 
bumped into a couple of warnings in sys/arch/alpha/pci/pci_machdep.c that 
halted the build (because of -Werror). Applying some #if like below fixed it 
for me.

Staffan

--- pci_machdep.c       2016-12-04 12:42:12.000000000 +0000
+++ pci_machdep.c.orig  2016-12-04 12:34:55.000000000 +0000
@@ -65,8 +65,13 @@
  pci_display_console(bus_space_tag_t iot, bus_space_tag_t memt, 
pci_chipset_tag_t pc, int bus, int device, int function)
  {
         pcitag_t tag;
-       pcireg_t id, class;
+       pcireg_t id;
+#if NVGA_PCI || NTGA
+       pcireg_t class;
         int match, nmatch;
+       match = nmatch = 0;
+#endif
+
         int (*fn)(bus_space_tag_t, bus_space_tag_t, pci_chipset_tag_t,
             int, int, int);

@@ -75,12 +80,12 @@
         if (id == 0 || id == 0xffffffff)
                 panic("pci_display_console: no device at %d/%d/%d",
                     bus, device, function);
-       class = pci_conf_read(pc, tag, PCI_CLASS_REG);

-       nmatch = match = 0; /* XXX really only if we've got FBs configured */
         fn = NULL;

  #if NVGA_PCI
+       class = pci_conf_read(pc, tag, PCI_CLASS_REG);
+
         nmatch = DEVICE_IS_VGA_PCI(class, id);
         if (nmatch > match) {
                 match = nmatch;


