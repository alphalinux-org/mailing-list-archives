+void
+db_lock_cmd(addr, have_addr, count, modif)
+	db_expr_t addr;
+	int have_addr;
+	db_expr_t count;
+	char *modif;
+{
+	struct lock *l;
+
+	if (!have_addr) {
+		db_printf("What lock address?\n");
