***************
*** 709,714 ****
- --- 709,715 ----
    *-*-netbsd* )
      opsys=netbsd
      case "${canonical}" in
+       alpha-*-netbsd*)	machine=alpha ;;
        i[345]86-*-netbsd*) machine=intel386 ;;
        m68k-*-netbsd*)
  			# This is somewhat bogus.
***************
*** 748,753 ****
- --- 749,756 ----
    alpha-*-linux* )
      machine=alpha opsys=linux
    ;;
+ 
+   # NetBSD/Alpha is above, under NetBSD ports
  
    ## Altos 3068
    m68*-altos-sysv* )
Only in emacs-19.30: paths.h.1722
