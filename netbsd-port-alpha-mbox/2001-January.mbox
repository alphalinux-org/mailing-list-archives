	Option	"omit xfree86-dga"
    EndSubSection

    Load	"type1"
    Load	"freetype"
EndSection

# **********************************************************************
# Server flags section.  This contains various server-wide Options.

Section "ServerFlags"
    Option	"NoTrapSignals"
    Option	"blank time"	"10"	# 10 minutes

    Option	"standby time"	"20"
    Option	"suspend time"	"30"
    Option	"off time"	"60"
