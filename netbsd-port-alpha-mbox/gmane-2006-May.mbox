# endif
-# ifdef __FreeBSD__
+#if defined (__FreeBSD__) || defined (__NetBSD__)
#  include <sys/types.h>
extern void outb(u_int32_t port, u_int8_t val);
extern void outw(u_int32_t port, u_int16_t val);

