 			    CTB_TURBOSLOT_SLOT(ctb->ctb_turboslot), 0);
+		else
+			isa_display_console(&ccp->cc_iot, &ccp->cc_memt);
 #else
 		panic("not configured to use display && keyboard console");
 #endif

