 	error = pci_sgmap_pte64_load_uio(t, map, uio, flags, t->_sgmap);
 	if (error == 0)
 		tsp_tlb_invalidate(t->_cookie);
@@ -326,6 +329,7 @@ tsp_bus_dmamap_load_raw_sgmap(bus_dma_ta
