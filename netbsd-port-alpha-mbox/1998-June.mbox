if [ -n "$p" ]; then
  echo -n killing pppd...
  kill $p
  if [ -f /etc/resolv.conf ]; then
    mv /etc/resolv.conf /etc/resolv.conf.down
  fi
  echo done
else
  echo ppp already is down 1>&2
fi



