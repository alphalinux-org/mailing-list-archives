 	simple_unlock(&pmap_all_pmaps_slock);
 
+#ifdef PMAP_NO_LAZY_LEV1MAP
+	i = pmap_lev1map_create(pmap, cpu_number());
+	KASSERT(i == 0);
+#endif
+
 	return (pmap);
 }
 
@@ -1240,14 +1256,16 @@ pmap_destroy(pmap_t pmap)
