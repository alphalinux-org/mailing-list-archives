@@ -1685,6 +1703,9 @@ pmap_enter(pmap_t pmap, vaddr_t va, padd
 			panic("pmap_enter: user pmap, invalid va 0x%lx", va);
 #endif
 
+#ifdef PMAP_NO_LAZY_LEV1MAP
