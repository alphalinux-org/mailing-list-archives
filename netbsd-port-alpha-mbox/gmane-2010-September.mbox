-#define	ELF64_FSZ_SWORD	8
-typedef	uint64_t	Elf64_Word;
-#define	ELF64_FSZ_WORD	8
-
 #define	ELF32_MACHDEP_ENDIANNESS	XXX	/* break compilation */
 #define	ELF32_MACHDEP_ID_CASES						\
 		/* no 32-bit ELF machine types supported */

