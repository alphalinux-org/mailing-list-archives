Xint safe_store (int *loc, int new)
X{
X  int locked, old;
X  asm ("mb" : : : "memory");
X  do {
X    asm ("ldl_l %0,%1" : "=r" (old) : "m" (*loc));
X    asm ("stl_c %0,%1" : "=r" (locked), "=m" (*loc) : "0" (new));
X  } while (!locked);
X  asm ("mb" : : : "memory");
X  return old;
X}
