On Wed, Nov 13, 2002 at 01:32:06AM +0100, Falk Hueffner wrote:
> You probably want something like (untested):
> 
> long tmp;
> asm volatile(
>         "ldl_l  %2,%1\n"
>         "addl   %2,1,%0\n"
>         "stl_c  %0,%1\n"
>         : "=r"(ret), "=m"(dest)
>         : "r"(tmp));

tmp needs to be an output as well, since it is modified.
dest needs to be an input, since its old value isn't dead.

	asm volatile (
         "ldl_l  %2,%1\n"
         "addl   %2,1,%0\n"
         "stl_c  %0,%1\n"
	 : "=r"(ret), "=m"(dest), "=r"(tmp)
	 : "m"(dest));

		

r~




