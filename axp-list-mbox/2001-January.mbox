postgresql-server-7.0.3-2.alpha.rpm
-rw-r--r--    1 root     root      1037449 Jan 18 19:20
postgresql-test-7.0.3-2.alpha.rpm

[root@peewee3 /tmp]# rpm -i postgresql-7.0.3-2.alpha.rpm

[root@peewee3 /tmp]# rpm -i postgresql-server-7.0.3-2.alpha.rpm
/sbin/ldconfig: warning: can't open var/tmp/rpm-tmp.98180 (Not a
directory), skipping
