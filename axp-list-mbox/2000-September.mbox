 static inline unsigned short from64to16(unsigned long x)
 {
-	/*
-	 * using extract instructions is a bit more efficient
-	 * than the original shift/bitmask version.
-	 */
-
-    union {
-	unsigned long	ul;
-	unsigned int	ui[2];
-	unsigned short	us[4];
-	} in_v, tmp_v, out_v;
