+int proc_permission(struct inode * inode, int mask)
+{
+	unsigned long ino, pid;
+	struct task_struct * p;
+	int i, mode;
+
+	ino = inode->i_ino;
+	pid = ino >> 16;
+	p = task[0];
+	for (i = 0; i < NR_TASKS ; i++)
+		if ((p = task[i]) && (p->pid == pid))
+			break;
+	if (!p || i >= NR_TASKS)
