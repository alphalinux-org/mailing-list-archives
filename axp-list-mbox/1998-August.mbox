Hi Keith !

> How does one setup ip masqing with ipchains?  does any have an example?

Maybe the following helps you. The "same" silly setup in a ipfwadm and
a ipchains version...

on_ipfwadm () {
 /sbin/ipfwadm -F -f
 /sbin/ipfwadm -I -f
 /sbin/ipfwadm -O -f
 /sbin/ipfwadm -F -p reject
 /sbin/ipfwadm -I -p reject
 /sbin/ipfwadm -O -p reject
 /sbin/ipfwadm -I -a accept -S 192.168.175.0/24 -D 0.0.0.0/0      -W eth0
 /sbin/ipfwadm -O -a accept -S 0.0.0.0/0      -D 192.168.175.0/24 -W eth0

 /sbin/ipfwadm -I -a accept -S 0.0.0.0/0 -D $MYIP -W $DEV
 /sbin/ipfwadm -O -a accept -S $MYIP -D 0.0.0.0/0 -W $DEV

 /sbin/ipfwadm -F -a accept -b -m -S 192.168.175.0/24 -D 0.0.0.0/0
}

on_ipchains () {
 /sbin/ipchains -F input
 /sbin/ipchains -F output
 /sbin/ipchains -F forward
 /sbin/ipchains -P input   REJECT
 /sbin/ipchains -P output  REJECT
 /sbin/ipchains -P forward REJECT
 /sbin/ipchains -A input  -s 192.168.175.0/24 -d 0.0.0.0/0 -i eth0 -j ACCEPT
 /sbin/ipchains -A output -d 192.168.175.0/24 -s 0.0.0.0/0 -i eth0 -j ACCEPT

 /sbin/ipchains -A input  -d $MYIP -s 0.0.0.0/0 -i $DEV -j ACCEPT
 /sbin/ipchains -A output -s $MYIP -d 0.0.0.0/0 -i $DEV -j ACCEPT
 
 /sbin/ipchains -A forward -b -s 192.168.175.0/24 -d 0.0.0.0/0 -j MASQ
}


