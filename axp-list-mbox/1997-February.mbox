@@ -147,7 +193,7 @@ static inline unsigned long csum_partial
 	checksum += carry;
 	if (len >= 0) {
 		unsigned long second_dest;
-		word = *src;
+		err |= __get_user(word, src);
 		mskql(word, len-doff, word);
 		checksum += word;
