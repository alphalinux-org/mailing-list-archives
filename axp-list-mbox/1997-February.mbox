-    if ( f->bigend != bigendian ) {
-      swaps ( &t.tag ) ;
-      swaps ( &t.type ) ;
-      swapl ( &t.count ) ;
-      swapl ( &t.offset ) ;
-    }
-    
     switch ( t.type ) {
     case 1 : tv = * (u_char*) &t.offset ; break ;
     case 2 : break ; 
     case 3 : tv = * (short* ) &t.offset ; break ;
-    case 4 : tv = * (long*  ) &t.offset ; break ;
+    case 4 : tv = t.offset ; break ;
