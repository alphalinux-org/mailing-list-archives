 	err = msg ( "E2can't read/seek tag data" ) ;
       } else {
 	ftv = (float) l[0] / ( l[1] ? l[1] : 1 ) ;
@@ -848,7 +905,7 @@
   
   if ( ! err ) {
   
-    if ( ifread ( (u_char*) &f->next, 4, f ) != 4 ) {
+    if ( read32 ( &f->next, f ) ) {
