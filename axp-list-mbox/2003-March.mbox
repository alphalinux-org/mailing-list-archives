Hello,
for some which is doing some CPU detection I wanted to add the alpha
part. I looked around at various sources and found the following code
segment which seemed to do the job:

char* cputype() {
        unsigned long ver, mask;
            asm ("implver %0" : "=3Dr" (ver));
            asm ("amask %1, %0" : "=3Dr" (mask) : "r" (-1));
//    printf("%ld-%x\n", ver, ~mask);
        switch (ver)
        {  =20
            case 0 : return "ev4";
            case 1 : switch (~mask)
                         {
                            case 0   : return "ev5";=20
                            case 1   : return "ev56";=20
                            case 101 : return "pca56";=20
                            default  : return "ev5-unknown";
                         }
            case 2 : switch (~mask)
                         {
                             case 303  : return "ev6";
                             case 307  : return "ev67";
                             case 1307 : return "ev68";
                             default   : return "ev6-unknown";
                         }
            case 3 : return "ev7";  // I assume this
            default : return "Unknown";
        }
}

For ev7 I guessed, but for ev67 it is definitly false because
our XP1000 report ~mask=3D775 not 307. Also when looking into
/proc/cpuinfo I see various entries for cpu model: Unknown, EV6 and
EV67. Does anyone (Jay ?) know a proper table of ~mask values?

Thanks

        Helge
