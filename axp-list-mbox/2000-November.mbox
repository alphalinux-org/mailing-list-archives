@@ -27,4 +27,8 @@
 
 #define MAXHOSTNAMELEN 64      /* max length of hostname */
 
+#ifdef __KERNEL__
+# define CLOCKS_PER_SEC        1024    /* frequency at which times() counts */
+#endif
+
 #endif /* _ASM_ALPHA_PARAM_H */




