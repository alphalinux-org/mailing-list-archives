Index: configure.sh
===================================================================
RCS file: configure.sh
diff -N configure.sh
--- /dev/null	Thu Aug 24 05:00:32 2000
+++ /tmp/cvsyZXBxm	Wed Nov  1 19:26:14 2000
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+find_build_arch() {
+	case `uname -m` in
+		i[0-9]86*)
+			echo i386
+		;;
+		alpha*)
+			echo alpha
+		;;
+	esac
+}
+
+arch=`find_build_arch`
+bdir=${arch}_linux22
+mkdir $bdir
+rm -f @sys
+ln -s $bdir @sys
+mkdir -p $bdir/{obj,dest}
+rm -f obj dest
+ln -s @sys/{obj,dest} .
+ln -s src/Makefile .
+make links
