 	       this_cpu, *pending_ipis, regs->pc);
@@ -737,8 +740,13 @@
 
 int smp_info(char *buffer)
 {
-        return sprintf(buffer, "CPUs probed %d active %d map 0x%x\n",
-		       smp_num_probed, smp_num_cpus, cpu_present_map);
+	int i;
+	unsigned long sum = 0;
