-rwxrwxrwx   1 root     root        72302 Feb  2  1999 r3100cfg*
-rwxrwxrwx   1 root     root        72302 Mar 11  1999 r3100ortinat*
-rw-rw-r--   1 root     root            0 Oct 26 17:25 routercfg
