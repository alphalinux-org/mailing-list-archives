/usr/bin/em86 with the following

#!/bin/sh
env LD_LIBRARY_PATH=/usr/alpha-glibc20-linux/lib \
/usr/alpha-glibc20-linux/lib/ld-2.0.7.so /usr/bin/em86.bin

