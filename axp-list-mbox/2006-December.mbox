************
--- include/linux/jiffies.h~	2006-06-18 03:49:35.000000000 +0200
+++ include/linux/jiffies.h	2006-12-01 11:30:32.000000000 +0100
@@ -119,7 +119,7 @@
  * Have the 32 bit jiffies value wrap 5 minutes after boot
