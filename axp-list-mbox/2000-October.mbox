   int reg;								\
 									\
+  if (! TARGET_OPEN_VMS && ! TARGET_WINDOWS_NT)				\
+    fprintf (FILE, "\tldgp $29,0($27)\n");				\
+									\
   /* Mark end of prologue.  */						\
   output_end_prologue (FILE);						\
 									\

