 #include <string.h>
+#include <unistd.h>
+#include <linux/elf.h>
 #include <sys/stat.h>
 #include <sys/mman.h>
-#include <linux/elf.h>
 #include "../config.h"
 #include "readelf.h"
 #include <sys/types.h>
 
-#define ELF32_R_SYM(x) ((x) >> 8)
-#define ELF32_R_TYPE(x) ((x) & 0xff)
-
 void warn(char *fmt, ...);
 char *xstrdup(char *);
 
@@ -31,18 +29,25 @@
   { NULL,           LIB_ELF }
 };
 
+#if ELF_CLASS == ELFCLASS32
+typedef Elf32_Dyn Elf_Dyn;
+#else
+typedef Elf64_Dyn Elf_Dyn;
+#endif
+
