The yum.conf (better yum.conf-devel) should look like this:
[main]
cachedir=/var/cache/yum
debuglevel=2
logfile=/var/log/yum.log
pkgpolicy=newest
distroverpkg=redhat-release
tolerant=1
exactarch=1
retries=20
obsoletes=1

[base]
name=Fedora Core $releasever - $basearch - Base
baseurl=ftp://ftp.rdsor.ro/pub/Linux/Distributions/AlphaLinux/core/development/alpha/

