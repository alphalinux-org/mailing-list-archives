It's just about as good as it can get.  I came up with one
sequence that executes in 11 cycles, but it's 4 insns longer.


r~


        lda     $0, -1                  e0      0
        lda     $2, 0xcccd($31)         e1      0
        zap     $0, 0x0f, $15           e0      1
        ldah    $2, 0xcccd($2)          e1      1

        sll     $2, 32, $3                      2
        addq    $2, $3, $2                      2
        zap     $0, 0x33, $14                   3
        subq    $2, 1, $11                      3

        zap     $0, 0x55, $13                   4
        addq    $11, $11, $4                    4
        srl     $13, 4, $1                      5
        xornot  $4, $11, $4                     5

        stq     $11, 8($30)                     6
        xor     $1, $13, $12                    6
        stq     $12, 16($30)                    7
        subq    $4, 1, $10                      7

        stq     $10, 0($30)                     8
        stq     $13, 24($30)                    9
        stq     $14, 32($30)                    10
        stq     $15, 40($30)                    11


