EndSection
Section "Device"
    Identifier  "TGA"
    VendorName  "DEC"
    BoardName   "ZLXp-E1"
    MemBase     0xa000000 
    #VideoRam    2048
    # Insert Clocks lines here if appropriate
EndSection
Section "Screen"
    Driver      "accel"
    Device      "TGA"
    #Device      "My Video Card"
    Monitor     "CTX 1785GMd"
    Subsection "Display"
        Depth       8
        Modes       "1280x1024"
        ViewPort    0 0
        Virtual     1280 1024
    EndSubsection
EndSection

