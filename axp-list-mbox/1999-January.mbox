       M[4] = 0xffff0000ffff0000; M[5] = 0xffffffff00000000; */

        .align 4                pipe    cycle
>       lda $0,-1               e1      0
>       zap $0,0x0f,$6          e0      1
>       zap $0,0x33,$5          e0      2
>       zap $0,0x55,$4          e0      3

