/* c2f.C,  Y.F. Sun*/

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <math.h>

extern "C" cprint(int , float *);
extern "C" void f2c_(int *, float *);
  
int main(int argc, char *argv[])
{
    int dv1d;
    float *v1df;
    int i;

    dv1d = 10;  
    v1df = (float *) malloc(dv1d*sizeof(float));
 
    for(i=0; i< dv1d;i++) v1df[i] = i;
    cprint(dv1d,v1df);
    f2c_(&dv1d,v1df);
    cprint(dv1d,v1df);
    free ( (char *) v1df);   

    printf("done.\n");
}

----------
