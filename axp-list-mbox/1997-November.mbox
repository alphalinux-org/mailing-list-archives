    VendorName  "DEC"
    BoardName   "ZLXp-E1"
EndSection

Section "Screen"
    Driver      "accel"
    Device      "TGA"
    Monitor     "15sx"
    Subsection "Display"
        Depth       8
        Modes       "1152x900"
        ViewPort    0 0
    EndSubsection
EndSection

