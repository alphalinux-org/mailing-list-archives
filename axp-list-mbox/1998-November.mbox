 * IRIX uses ULONGLONG_MAX. Are there any other names for this?
 */
 
-#ifndef HAVE64
-#if defined(ULONG_LONG_MAX) || defined (ULLONG_MAX) || defined(ULONGLONG_MAX)
+  //#ifndef HAVE64
+  //#if defined(ULONG_LONG_MAX) || defined (ULLONG_MAX) || defined(ULONGLONG_MAX)
 typedef unsigned long long word64;
 typedef long long int64;
 #define HAVE64 1
