  + g++ -O -rdynamic -fno-exceptions -Ivvm -Ivpi -Lvvm foo.cc -lvvm -ldl
  /usr/bin/ld: /tmp/ccLUGdgi.o: .got subsegment exceeds 64K (size 137792)
