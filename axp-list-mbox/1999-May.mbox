+		fpcr |= ieee_swcr_to_fpcr(swcr);
 		wrfpcr(fpcr);
 		   
 		return 0;
@@ -1405,18 +1409,19 @@ asmlinkage int sys_old_adjtimex(struct t
 	/* copy relevant bits of struct timex. */
 	if (copy_from_user(&txc, txc_p, offsetof(struct timex32, time)) ||
