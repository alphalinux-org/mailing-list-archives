/* Usage link /dev/cua0 */

#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/types.h>

#define BUFSIZE 1024

void copy_bytes(int in_fd, int out_fd)
{
  char buf[BUFSIZE];
  int rbytes;
  
  if ( (rbytes=read(in_fd, buf, BUFSIZE)) > 0 ) 
    {
      int wbytes;
      char* buf_p=buf;
      fprintf(stderr, "Reading %d bytes from %d.\n", rbytes, in_fd);

      while (buf_p < buf+rbytes)
	{
	  int wsize=rbytes+buf-buf_p;
	  wbytes=write(out_fd, buf_p, wsize);
	  fprintf(stderr, "Writing %d bytes to %d.\n", wbytes, out_fd);
	  buf_p += wbytes;
	}
      if (wbytes < 0)
	{
	  perror("write");
	  exit(-1);
	}
    } 
  else if (rbytes < 0)
    {
      perror("read");
      exit(-1);
    }
}

int main(int argc, char** argv)
{
  int fd;
  fd_set read_set;
  /* Initialize the file descriptor set. */

  if (argc !=2)
    {
      fprintf(stderr, "Using %s device-file.\n", argv[0]);
      return -1;
    }

  if ((fd=open(argv[1], O_RDWR)) < 0)
    {
      perror("open");
      return -1;
    }
  FD_ZERO (&read_set);
  FD_SET (fd, &read_set);
  FD_SET (0, &read_set);
  
  while (1)
    {
      if ( select(FD_SETSIZE, &read_set, NULL, NULL, NULL) < 0 )
	{
	  perror("select");
	  return -1;
	}

      if ( FD_ISSET(fd, &read_set))
	{
	  copy_bytes(fd, 1);
	}
      else if (FD_ISSET(0, &read_set))
	{
	  copy_bytes(0, fd);
	}
      else
	{
	  return -1;
	}
    }
  
  close(fd);
  return 0;
}


