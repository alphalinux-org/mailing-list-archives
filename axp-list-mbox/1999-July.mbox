 For 16-bit quantities the program is as follows:

typedef struct { uint16_t v __attribute__((packed)); } uint16_s;

volatile int16_t *src, *dst;

int main(int argc)
{
        src = (void *)argc;
        dst = (void *)~argc;
        *src = argc;

        itoh16_u(*dst, *src);

        return (src - dst) + *dst;
}

