+++ linux/arch/alpha/vmlinux.lds	Thu May 18 16:56:05 2000
@@ -1,10 +1,11 @@
 OUTPUT_FORMAT("elf64-alpha")
 ENTRY(__start)
+PHDRS { kernel PT_LOAD ; }
 SECTIONS
 {
   . = 0xfffffc0000310000;
   _text = .;
-  .text : { *(.text) }
+  .text : { *(.text) } :kernel
   _etext = .;
 
   /* Exception table */
