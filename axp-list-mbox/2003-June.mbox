Hi there,

Below are the patches which got the iprobe kernel driver to work again under SRM-5.5
(PC164, gcc-3.3, 2.4.21-ac1 kernel). The newly built rep seems broken, but the one from
the iprobe_suite-4.3 alpha rpm works, so the only thing missing now is a patched MILO
(and that harness.pl perl script..). For I couldn't find any hint of wr_perfmon PALcode
in a kcore dump, the obvious thing to try next is to transfer the relevant 21064/21066
PALcode to the 21164A osfpal.S. Any other (better) ideas?

	Oliver



diff -Nur iprobe/driver/src/common/buffer_descriptor.c iprobe-2.4/driver/src/common/buffer_descriptor.c
--- iprobe/driver/src/common/buffer_descriptor.c	Mon Dec 14 21:14:44 1998
+++ iprobe-2.4/driver/src/common/buffer_descriptor.c	Tue Jun 17 21:40:56 2003
@@ -61,7 +61,6 @@
 #endif
 
 #ifdef __LINUX__
-#include <linux/kernel.h>
 #endif
 
 // This array is initialized in KIprInitSysInfo in OS specific kernel_general
diff -Nur iprobe/driver/src/linux/driver_linux.c iprobe-2.4/driver/src/linux/driver_linux.c
--- iprobe/driver/src/linux/driver_linux.c	Fri Jul  2 15:32:13 1999
+++ iprobe-2.4/driver/src/linux/driver_linux.c	Tue Jun 17 20:31:53 2003
@@ -449,17 +449,24 @@
 /* The FLUSH was added for the later kernels. ie, 2.1.12X and beyond */
 
 struct file_operations ipr_fops = {
-	NULL,		/* lseek */
+	NULL,		/* owner */
+	NULL,		/* llseek */
 	NULL,       	/* read */
 	NULL,      	/* write */
 	NULL,		/* readdir */
-	NULL,		/* Poll */
+	NULL,		/* poll */
 	ipr_ioctl,	/* ioctl */
 	NULL,		/* mmap */
 	ipr_open,	/* just a selector for the real open */
-	NULL,           /* Flush */
+	NULL,           /* flush */
 	ipr_close,	/* release */
-	NULL		/* fsync */
+	NULL,		/* fsync */
+	NULL,		/* fasync */
+	NULL,		/* lock */
+	NULL,		/* readv */
+	NULL,		/* writev */
+	NULL,		/* sendpage */
+	NULL		/* get_unmapped_area */
 };
 
 /* I believe that this takes the place of ipr_init for modules. */
@@ -540,7 +547,7 @@
 #define THIS_PID() (current->pid)
 
 /* LINUX: These MAY be right. */
-#define THIS_PRIORITY() (current->priority)
+#define THIS_PRIORITY() (current->rt_priority)
 #define THIS_IPL() (getipl())
 
 #define BARRIER() mb()
diff -Nur iprobe/driver/src/linux/kernel_general_linux.c iprobe-2.4/driver/src/linux/kernel_general_linux.c
--- iprobe/driver/src/linux/kernel_general_linux.c	Mon Dec 14 21:16:14 1998
+++ iprobe-2.4/driver/src/linux/kernel_general_linux.c	Tue Jun 17 20:32:56 2003
@@ -47,7 +47,7 @@
 #include <linux/mm.h>
 
 /* This has information about how to allocate kernel memory. */
-#include <linux/malloc.h>
+#include <linux/slab.h>
 
 #include <asm/system.h>
 
diff -Nur iprobe/iprobe/src/common/iprobe_counting.c iprobe-2.4/iprobe/src/common/iprobe_counting.c
--- iprobe/iprobe/src/common/iprobe_counting.c	Tue Apr 13 18:14:35 1999
+++ iprobe-2.4/iprobe/src/common/iprobe_counting.c	Tue Jun 17 20:49:22 2003
@@ -74,6 +74,7 @@
 #include <stdio.h>
 #include <string.h>
