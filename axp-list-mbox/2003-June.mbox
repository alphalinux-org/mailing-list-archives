diff -Nur iprobe/iprobe/src/common/iprobe_histogram.c iprobe-2.4/iprobe/src/common/iprobe_histogram.c
--- iprobe/iprobe/src/common/iprobe_histogram.c	Mon Dec 14 21:36:24 1998
+++ iprobe-2.4/iprobe/src/common/iprobe_histogram.c	Tue Jun 17 20:49:53 2003
@@ -56,6 +56,7 @@
 #endif
 #include <stdio.h>
 #include <string.h>
+#include <time.h>
 #include <math.h>
 #include "stdtypes.h"
 #include "iprobe_struct.h"
diff -Nur iprobe/suite_common/inc/common/getopt.def iprobe-2.4/suite_common/inc/common/getopt.def
--- iprobe/suite_common/inc/common/getopt.def	Mon Aug 17 19:47:23 1998
+++ iprobe-2.4/suite_common/inc/common/getopt.def	Tue Jun 17 20:43:43 2003
@@ -23,7 +23,9 @@
 
