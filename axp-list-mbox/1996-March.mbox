#include <stdlib.h>
#include <math.h>

main()
{
    int i;
    int x;
    for (i=0;i<6;i++)
    {
     x=pow(2,i);
       printf("%d   %ld\n",i,x);
    }
}
Output :
0   1
1   2
2   4
3   7
4   15
5   32

It seems to be something strange in the conversion from one type to another.
For example : 
 main()
 {
     int i;
     double x,y;
     for (i=0;i<21;i++)
     {
        x= pow(2.0,i);
        y = (int)x;
        printf("%d   %g %g\n",i,x,y);
     }
 }

