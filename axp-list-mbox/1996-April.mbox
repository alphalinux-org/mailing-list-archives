diff -u ORIG/ev4sched.c ./ev4sched.c
--- ORIG/ev4sched.c	Wed Apr 24 17:04:04 1996
+++ ./ev4sched.c	Fri Apr 26 20:42:03 1996
@@ -121,7 +121,12 @@
 			    argv[0], argv[i]);
 		    goto cleanup;
 		}
