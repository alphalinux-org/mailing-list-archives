  * Note: Suspicious mixture of sizes in NA_NEW [173] */
+#ifdef __alpha__
+  mp3 = (macrorec *)Malloc(strlen(name) + 16L);
+#else
   mp3 = (macrorec *)Malloc(strlen(name) + 9L);
+#endif
   if (mp != NULL && mp->key == key) {
     mp3->next = mp->next;
     Free(mp);


