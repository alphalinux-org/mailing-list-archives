Makefile to:

linux-alpha:
        $(MAKE) CC=gcc LDFLAGS= OBJECTS='decode.o dct64.o audio_oss.o' \
                CFLAGS='-DLINUX -DOSS -DREAL_IS_FLOAT -Wall -DREAD_MMAP \
