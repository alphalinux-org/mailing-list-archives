-		"stq $31,56(%1)\n\t"
-		"addq $1,64,$1\n\t"
-		"bne %0,1b"
-		:"=r" (count),"=r" (page)
-		:"0" (PAGE_SIZE/64), "1" (page));
+	unsigned long count = PAGE_SIZE/64;
+	unsigned long *ptr = (unsigned long *)page;
+
+	do {
+		ptr[0] = 0;
