# /etc/profile

# System wide environment and startup programs
# Functions and aliases go in /etc/bashrc

QTDIR=/usr/local/qt
PATH="$PATH:/usr/X11R6/bin:$QTDIR/bin:$PATH"
# PATH=$QTDIR/bin:$PATH
PS1="[\u@\h \W]\\$ "

ulimit -c 1000000
if [ `id -gn` = `id -un` -a `id -u` -gt 14 ]; then
	umask 002
else
	umask 022
fi

if [ $LD_LIBRARY_PATH ]
then 
	LD_LIBRARY_PATH=$QTDIR/lib:$LD_LIBRARY_PATH
else
	LD_LIBRARY_PATH=$QTDIR/lib
fi
	
LIBRARY_PATH=$LD_LIBRARY_PATH

if [ $CPLUS_INCLUDE_PATH ]
then
	CPLUS_INCLUDE_PATH=$QTDIR/include:$CPLUD_INCLUDE_PATH
else
	CPLUS_INCLUDE_PATH=$QTDIR/include
fi

USER=`id -un`
LOGNAME=$USER
MAIL="/var/spool/mail/$USER"

HOSTNAME=`/bin/hostname`
HISTSIZE=1000
HISTFILESIZE=1000

export PATH PS1 HOSTNAME HISTSIZE HISTFILESIZE USER LOGNAME MAIL
export QTDIR PATH LD_LIBRARY_PATH LIBRARY_PATH
export CPLUS_INCLUDE_PATH
export LD_LIBRARY_PATH=/opt/kde/lib
exoprt PATH=$PATH:/opt/kde/bin
export KDEDIR=/opt/kde
export LANG=launguage

for i in /etc/profile.d/*.sh ; do
	if [ -x $i ]; then
		. $i
	fi
done

unset i



