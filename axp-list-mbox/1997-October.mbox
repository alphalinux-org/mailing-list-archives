ftp> tick
ftp> cd /pub/DEC/Linux-Alpha/X11/
ftp> get axpbin-Xtga-BETA-0.2.gz
ftp> close
ftp> quit
gunzip -d /usr/quake/axpbin-Xtga-BETA-0.2.gz
