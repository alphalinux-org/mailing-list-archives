Try this:

==============================================================================

#ifndef __alpha
#error Use an Alpha!
#endif

#include <stdio.h>

typedef unsigned int u32;
typedef unsigned long u64;

/*-- main ------------------------------------------------------------------*/

#define BLA() \
   asm volatile ( \
       "addt %2,%3,%0
        addq $1,$2,$3
        mult %4,%5,%1
        addq $4,$5,$6" \
        : "=f"(f3), "=f"(f6) \
        : "f"(f1), "f"(f2), "f"(f4), "f"(f5) \
        : "$1", "$2", "$3", "$4", "$5", "$6" \
        )

#define ITERS (1000UL)

int main(int argc, char *argv[]) {
  u32 cycles, minimum;
  u64 c0, c1, i, total;
  double f1,f2,f3,f4,f5,f6;

  minimum = -1U;
  total = 0UL;
  f1 = f2 = f4 = f5 = 0.0;
  for (i = 0UL; i < ITERS; ++i) {
    asm volatile (".align 4; rpcc %0" : "=r"(c0));
    BLA();
    BLA();
    BLA();
    BLA();
    asm volatile ("rpcc %0" : "=r"(c1));
    cycles = (u32)(c1-c0+(c1>>32)-(c0>>32));
    if (cycles < minimum) minimum = cycles;
    total += (u64)cycles;
  } /* end for */
  printf( "Average cycles = %g, minimum = %u.\n"
        , (double)total/(double)ITERS, minimum
        );

  return 0;
} /* end main */

==============================================================================


