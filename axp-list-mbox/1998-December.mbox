+++ mmu_context.h       1998/12/18 16:51:25
@@ -169,7 +169,9 @@ __reload_tss(struct thread_struct *tss)
 __EXTERN_INLINE void
 reload_context(struct task_struct *task)
 {
+       int pcc = task->tss.pcc;
        __reload_tss(&task->tss);
+       task->tss.pcc = pcc;
 }
 
