I've just been running some little test problems on out UDB 233 Mhz and
have got some interesting results. The two C programs are below....

****************** benchi **********************************************
#include <stdio.h>

#define MAXI 1000
#define MAXJ 1000
#define MAXK 500

int main(
         int argc,
         char *argv[]
         )
{
  int i, j, k;
  int a, b, c;

  for (i=0;i<MAXI;i++) {
    a = i;
    for (j=MAXJ;j>-MAXJ;j--) {
      b = a*j;
      for (k=MAXK;k>-MAXK;k--) {
        c = b + k;
      }
    }
  }
  printf("%d %d %d\n",a ,b, c);
  exit(0);
}
****************** benchf **********************************************
#include <stdio.h>

#define MAXI 1000
#define MAXJ 1000
#define MAXK 100

int main(
         int argc,
         char *argv[]
         )
{
  int i, j, k;
  double a, b, c;

  for (i=0;i<MAXI;i++) {
    a = (double)i;
    for (j=MAXJ;j>-MAXJ;j--) {
      b = a*(double)j;
      for (k=MAXK;k>-MAXK;k--) {
        c = b + (double)k;
      }
    }
  }
  printf("%f %f %f\n",a ,b, c);
  exit(0);
}
