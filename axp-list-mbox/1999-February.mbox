gat
main()
{

        int x1,x2,x3;
        int y1,y2,y3;
        unsigned int P;
        unsigned int S;
        void *a;

        a = (void *)0;
        x1=20,x2=0,x3=0;
        y1=5, y2=0,y3=0;
        P = 1;
        S = 348;

        a = (int *)a +(x2-x1-x3)*P + (y2-y1-y3)*S;
        printf("a = %p\n",a);
}






