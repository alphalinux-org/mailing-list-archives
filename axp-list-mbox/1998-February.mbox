 install: 
-	install -c -s -m 4755  $(EXE) /usr/bin/X11
+	install -c -s -m 755  $(EXE) /usr/bin/X11
 	install -c Xdefaults /usr/lib/X11/app-defaults/XOsview
 endif
 
