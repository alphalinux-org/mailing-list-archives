 net_aboot.nh: net_aboot tools/objstrip=0A=
+	strip net_aboot=0A=
 	tools/objstrip -vb net_aboot $@=0A=
 =0A=
 net_aboot: $(ABOOT_OBJS) $(ABOOT_OBJS) $(NET_OBJS) $(LIBS)=0A=
@@ -114,7 +122,7 @@=0A=
 clean:	sdisklabel/clean tools/clean lib/clean=0A=
 	rm -f aboot abootconf net_aboot net_aboot.nh net_pad vmlinux.bootp =
\=0A=
 		$(ABOOT_OBJS) $(DISK_OBJS) $(NET_OBJS) bootlx \=0A=
-		include/ksize.h vmlinux.nh=0A=
+		include/ksize.h vmlinux.nh b2c bootloader.h netabootwrap=0A=
 =0A=
