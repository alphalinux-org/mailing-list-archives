#include <unistd.h>
#include <sys/mman.h>
#include <stdio.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>

#ifndef MAP_FAILED
#define MAP_FAILED ((void *)-1)
#endif

main(int argc,char **argv) {
  int blocksize;
  int numfiles;
  int handle=-1;
  char filename[256];
  int i;
  char *p;

  blocksize=atoi(argv[1])*1024;
  numfiles=atoi(argv[2]);

  for(i=0;i<numfiles;i++) {
#if defined(ONE_FILE)||defined(ONE_OPEN)
    strcpy(filename,"file-one");
#else
    sprintf(filename,"file.%04d",i);
#endif
#if defined(ONE_OPEN)
    if(handle==-1) {
#endif
    handle=open(filename,O_RDWR|O_CREAT,0666);
    lseek(handle,blocksize-1,SEEK_SET);
    write(handle,"X",1);
#if defined(ONE_OPEN)
    }
#endif
    p=mmap(NULL,blocksize-1,PROT_READ|PROT_WRITE,MAP_SHARED,handle,0);
    if(p==MAP_FAILED) {
       perror("mmap()");
       return 1;
    }
/*    printf("%03d: %p\n",i,p); */
#if !defined(ONE_OPEN)
    close(handle);
#endif
    }

  
}

