+			if (sk->rto < HZ/5)	/* Was 1*HZ, then 1 - turns out we must allow about
 						   .2 of a second because of BSD delayed acks - on a 100Mb/sec link
 						   .2 of a second is going to need huge windows (SIGH) */
-			sk->rto = 20;
+			sk->rto = HZ/5;
 		}
 	}
 
@@ -3743,8 +3743,8 @@
 				sk->rto = ((sk->rtt >> 2) + sk->mdev) >> 1;
 				if (sk->rto > 120*HZ)
