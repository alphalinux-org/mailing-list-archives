Here's my forwarding script; you'l need to make appropriate changes for
yourself of coarse, like: I'm adding my route(ppp0) through it too, you
probably won't need it. Also the network IP addresses will need to change!

#!/bin/sh
/sbin/route add default gw 207.155.73.69
/sbin/route add -net 207.155.73.0 dev ppp0

/sbin/ipfwadm -I -p accept
/sbin/ipfwadm -I -f
/sbin/ipfwadm -O -p accept
/sbin/ipfwadm -O -f
/sbin/ipfwadm -F -p deny
/sbin/ipfwadm -F -f

/sbin/ipfwadm -F -a masquerade -S 10.0.2.5 -D 0.0.0.0/0.0.0.0
/sbin/ipfwadm -F -a masquerade -S 10.0.2.7 -D 0.0.0.0/0.0.0.0
/sbin/ipfwadm -F -a masquerade -S 10.0.2.6 -D 0.0.0.0/0.0.0.0
/sbin/ipfwadm -F -a masquerade -S 10.0.2.9 -D 0.0.0.0/0.0.0.0

