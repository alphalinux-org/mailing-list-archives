--- 2.3.15-1/arch/alpha/vmlinux.lds	Wed Aug  4 15:48:00 1999
+++ 2.3.15-axp/arch/alpha/vmlinux.lds	Sat Aug 21 02:38:00 1999
@@ -59,4 +59,27 @@ SECTIONS
   .mdebug 0 : { *(.mdebug) }
   .note 0 : { *(.note) }
   .comment 0 : { *(.comment) }
+
