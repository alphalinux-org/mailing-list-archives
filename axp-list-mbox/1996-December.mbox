-DX_LOCALE -DNO_MESSAGE_CATALOG -DFUNCPROTO=15 -DNARROWPROTO -I./ -Iglib 
 -I/usr/X11R6/include
+CFLAGS         =       -g -Wall -ansi -I/usr/X11R6/include
-D_POSIX_SOURCE -D_BSD_SOURCE -D_GNU_SOURCE -DX_LOCALE
