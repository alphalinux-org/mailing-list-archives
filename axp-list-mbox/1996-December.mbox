--- linux/arch/alpha/lib/Makefile.old	Sun Dec  1 20:26:07 1996
+++ linux/arch/alpha/lib/Makefile	Sun Dec  1 20:23:56 1996
@@ -8,10 +8,10 @@
 	strchr.o strrchr.o csum_ipv6_magic.o \
 	copy_user.o clear_user.o strncpy_from_user.o strlen_user.o
 
-ifeq($(CONFIG_IPV6),y)
+ifeq ($(CONFIG_IPV6),y)
   OBJS += csum_ipv6_magic.o
 else
-  ifeq($(CONFIG_IPV6),m)
+  ifeq ($(CONFIG_IPV6),m)
     OBJS += csum_ipv6_magic.o
   endif
 endif

