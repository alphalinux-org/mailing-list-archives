>         stt $f3,16($3)
>         stt $f4,24($3)
>         stt $f5,32($3)
>         stt $f6,40($3)
>         stt $f7,48($3)
>         addq $2,64,$2
>         addl $9,8,$9
>         cmple $9,$4,$1
>         stt $f8,56($3)
>         addq $3,64,$3
>         bne $1,$L24
> 
> Bottom opcodes may have better order. It's basically the
> bottom of the gcc code. Also, depending on memory latency,
> you can start the stt's before you get all the ldt's
> done, assuming you can do both an stt and an ldt in the
> same cycle.
> 
> Seems that should perform quite a bit better than the
> gcc loop. Can gcc be setup to do this??
> 
> If you seriously want to use wh64, you need to do a
> pre-process loop to handle the non-64 byte boundary
> at the front, and a post-process loop to handle the
> end.
> 
> Just some thoughts.
> 
> Wes

Tom sent me the asm from DUNIX cc. 
There was very little cleanup code on the end of the loops.
Perhaps the compiler knew the loop variable was divisible
by four, which is the unroll amount since it was hard coded.

Looks like it uses conditionals to decide when to do wh64.
Also, the instruction count is similar to the suggested loop
style above if you exclude the wh64 stuff.

copy vector:

L$31:
      ldl     r31, 256(r2)
      ldt     f1, (r2)
      lda     r6, 159(r3)
      lda     r8, -64(sp)
      ldt     f10, 8(r2)
      ldt     f11, 16(r2)
      cmplt   r6, r10, r7
      addl    j, 4, j                                 # r1, 4, r1  
      ldt     f12, 24(r2)                                   
      cmoveq  r7, r8, r6
      cmplt   j, r11, r16                             # r1, r11, r16
      lda     r2, 32(r2)
      lda     r3, 32(r3)
      wh64    (r6)                                   
      stt     f1, -32(r3)
      unop
      stt     f10, -24(r3)
      stt     f11, -16(r3)
      unop
      unop
      stt     f12, -8(r3)
      bne     r16, L$31                        

vector times scalar:

L$33:
      ldt     f1, (r2)                            
      ldl     r31, 256(r2)
      lda     r7, 159(r3)
      lda     r16, -64(sp)
      ldt     f10, 8(r2)
      ldt     f11, 16(r2)
