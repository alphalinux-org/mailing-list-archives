On Friday, 19 Mar, Nils Faerber wrote:
>   I just compiled and install kernel 2.2.3 and noticed that insmodding the
> SCSI cdrom driver causes my machine to crash immediately with a kernel
> panic!

I found that as well.  It looks like a bug in recenly changed semaphore.h.
I came up with a patch that seems to fix it (although formally may
produce faulty code as well...) - see attached.

The problem is in the inline asm, which references a global symbol, thus
using gp, assuming it has been provided by the function's entry code.
The patch fixes only the 'up' function, which causes problems in
sr_ioctl.c, but several other functions from semaphore.h need similar
treatment as well.

I think Richard Henderson, who I believe wrote that code in semaphore.h,
can think of a better solution.

Nikita

--zhXaljGHf11kAtnf
Content-Type: text/plain; charset=us-ascii
Content-Disposition: attachment; filename="semaphore.diff"

--- linux-2.2.4/include/asm-alpha/semaphore.h.orig	Fri Mar 26 20:26:59 1999
+++ linux-2.2.4/include/asm-alpha/semaphore.h	Fri Mar 26 21:03:08 1999
@@ -167,25 +167,27 @@
 	   it's return address in $28.  The pv is loaded as usual.
 	   The gp is clobbered (in the module case) as usual.  */
 
+	register void *pv __asm__ ("$27") = __up_wakeup;
+
 	__asm__ __volatile__ (
 		"/* semaphore up operation */\n"
 		"	mb\n"
-		"1:	ldl_l	$27,%0\n"
-		"	addl	$27,1,$27\n"
-		"	mov	$27,$28\n"
+		"1:	ldl_l	$24,%0\n"
+		"	addl	$24,1,$24\n"
+		"	mov	$24,$28\n"
 		"	stl_c	$28,%0\n"
 		"	beq	$28,2f\n"
 		"	mb\n"
-		"	ble	$27,3f\n"
+		"	ble	$24,3f\n"
 		"4:\n"
 		".section .text2,\"ax\"\n"
 		"2:	br	1b\n"
 		"3:	lda	$24,%0\n"
-		"	jsr	$28,__up_wakeup\n"
+		"	jsr	$28,(%1),__up_wakeup\n"
 		"	ldgp	$29,0($28)\n"
 		"	br	4b\n"
 		".previous"
-		: : "m"(sem->count)
+		: : "m"(sem->count), "r"(pv)
 		: "$24", "$27", "$28", "memory");
 }
 

--zhXaljGHf11kAtnf--


