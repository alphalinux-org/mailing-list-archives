     {"count", "Count", XtRInt, sizeof(int),
-	    (Cardinal)&count, XtRInt, (caddr_t) &defaultCount},
+	    0, XtRInt, (caddr_t) &defaultCount},
 };
 
 /*
@@ -147,8 +147,13 @@
 
