 {
     int i;
@@ -1106,6 +1108,9 @@
 /*****************************************************************************
  *  Do any CPU specific initialisation required                              *
  *****************************************************************************/
+
+    /* enable memory fault handler */
+    wrent (entMM, 2);
 
     /* we need the hwrpb set up before we can do this */
     /* This gets us keyboard and VGA (I hope) */
