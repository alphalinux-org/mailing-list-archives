-	br	gp,1f
+entMM:	br	gp,1f
 1:	ldgp	gp,0(gp)
-	lda	sp,-8(sp)
-	stq	ra,0(sp)
-	ldq	a3,8(sp)
-	ldq	a4,16(sp)
-	ldq	a5,24(sp)
+	ldq	a3,0(sp)
+	ldq	a4,8(sp)
+	ldq	a5,16(sp)
+	bis	zero,ra,a0
 	jsr	ra,do_entMM
-	ldq	ra,0(sp)
