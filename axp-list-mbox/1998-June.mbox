Date: Tue, 30 Jun 1998 09:51:44 +0300
Message-Id: <9806300651.AA25283@beta.cc.tut.fi>
To: axp-list@redhat.com
Cc: axp-list@redhat.com
In-Reply-To: <359826A3.505690F4@bwl.uni-kiel.de> (message from Olaf Grundey on Mon, 29 Jun 1998 23:43:32 +0000)
Subject: Re: which ISDN card ?

Hello.

> Which ISDN cards work under Linux/Alpha (2.0.34) ?
> Which patches do I need ? 

Teles S0/16.3 seems to work with Thomas's patch (at
the end of this e-mail); at least to some extent. I
don't know if the PnP versions of the card work as
well.

After the patch has been applied, the isdn and hisax 
modules can be loaded and everything seems to be OK, 
unless you try sending a big chunks of data (or 
someone tries downloading something from your 
computer). After a meager ~8000 bytes, the sending
stops without any error messages or traps on the
screen or in the logs. The connection does not 
break down, the ftp (or scp) transfer just stops.

So, in order to answer your question, Teles S0/16.3
"works" if you apply the patch below. At the moment
receiving data does not cause any problems, but 
sending lots (= something bigger than typed in 
commands ;) of data does.

Here's the patch (it's for 2.0.33, but the code in
2.0.34 was similar):

diff -ru linux-2.0.33/drivers/isdn.orig/hisax/fsm.c linux-2.0.33/drivers/isdn/hisax/fsm.c
--- linux-2.0.33/drivers/isdn.orig/hisax/fsm.c  Thu Oct 30 23:24:00 1997
+++ linux-2.0.33/drivers/isdn/hisax/fsm.c       Sat Mar  7 11:37:44 1998
@@ -32,13 +32,13 @@
 {
        int i;

-       fsm->jumpmatrix = (int *)
-           kmalloc(4L * fsm->state_count * fsm->event_count, GFP_KERNEL);
-       memset(fsm->jumpmatrix, 0, 4L * fsm->state_count * fsm->event_count);
+       fsm->jumpmatrix = (long *)
+           kmalloc(sizeof (long *) * fsm->state_count * fsm->event_count, GFP_KERNEL);
+       memset(fsm->jumpmatrix, 0, sizeof (long *) * fsm->state_count * fsm->event_count);

        for (i = 0; i < fncount; i++)
                fsm->jumpmatrix[fsm->state_count * fnlist[i].event +
-                             fnlist[i].state] = (int) fnlist[i].routine;
+                             fnlist[i].state] = (long) fnlist[i].routine;
 }

 void
diff -ru linux-2.0.33/drivers/isdn.orig/hisax/hisax.h linux-2.0.33/drivers/isdn/hisax/hisax.h
--- linux-2.0.33/drivers/isdn.orig/hisax/hisax.h        Sat Mar  7 11:23:31 1998
+++ linux-2.0.33/drivers/isdn/hisax/hisax.h     Sat Mar  7 11:34:50 1998
@@ -199,14 +199,14 @@
  * Statemachine
  */
 struct Fsm {
-       int *jumpmatrix;
-       int state_count, event_count;
+       long *jumpmatrix;
+       long state_count, event_count;
        char **strEvent, **strState;
 };

 struct FsmInst {
        struct Fsm *fsm;
-       int state;
+       long state;
        int debug;
        void *userdata;
        int userint;
@@ -214,7 +214,7 @@
 };



 struct FsmNode {
-       int state, event;
+       long state, event;
        void (*routine) (struct FsmInst *, int, void *);
 };

diff -ru linux-2.0.33/drivers/isdn.orig/hisax/isdnl2.c linux-2.0.33/drivers/isdn/hisax/isdnl2.c
--- linux-2.0.33/drivers/isdn.orig/hisax/isdnl2.c       Thu Oct 30 23:24:01 1997
+++ linux-2.0.33/drivers/isdn/hisax/isdnl2.c    Sat Mar  7 11:44:11 1998
@@ -260,7 +260,7 @@
 {
        struct PStack *st = fi->userdata;

-       st->l2.l2tei(st, MDL_ASSIGN, (void *) st->l2.ces);
+       st->l2.l2tei(st, MDL_ASSIGN, (void *) (long)st->l2.ces);
        FsmChangeState(fi, ST_L2_3);
 }

@@ -725,7 +725,7 @@
 {
        struct PStack *st = fi->userdata;

-       st->l2.tei = (int) arg;
+       st->l2.tei = (long) arg;
        establishlink(fi);
 }

@@ -805,7 +805,7 @@

        if (st->l2.rc == st->l2.n200) {
                FsmChangeState(fi, ST_L2_4);
-               st->l2.l2tei(st, MDL_VERIFY, (void *) st->l2.tei);
+               st->l2.l2tei(st, MDL_VERIFY, (void *) (long)st->l2.tei);
                st->l2.l2man(st, DL_RELEASE, NULL);
        } else {
                st->l2.rc++;
diff -ru linux-2.0.33/drivers/isdn.orig/hisax/tei.c linux-2.0.33/drivers/isdn/hisax/tei.c
--- linux-2.0.33/drivers/isdn.orig/hisax/tei.c  Thu Oct 30 23:24:02 1997
+++ linux-2.0.33/drivers/isdn/hisax/tei.c       Sat Mar  7 11:39:00 1998
@@ -111,7 +111,7 @@
                                        sprintf(tmp, "ces %d --> tei %d", tces, ai);
                                        st->l2.l2m.printdebug(&st->l2.l2m, tmp);
                                }
-                               otsp->ma.teil2(otsp, MDL_ASSIGN, (void *) (int) ai);
+                               otsp->ma.teil2(otsp, MDL_ASSIGN, (void *) (long) ai);
                        }
                        break;
                case (3):
@@ -205,22 +205,22 @@
            u_char pr, struct sk_buff *skb)
 {
        u_char *bp;
-       unsigned int data;
+       unsigned long data;
        char tmp[32];

        switch (pr) {
                case (MDL_ASSIGN):
-                       data = (unsigned int) skb;
+                       data = (unsigned long) skb;
                        if (st->l3.debug) {
-                               sprintf(tmp, "ces %d assign request", data);
+                               sprintf(tmp, "ces %ld assign request", data);
                                st->l2.l2m.printdebug(&st->l2.l2m, tmp);
                        }
                        mdl_unit_data_res(st, data, 1, 127);
                        break;
                case (MDL_VERIFY):
-                       data = (unsigned int) skb;
+                                 if (st->l3.debug) {
-                               sprintf(tmp, "%d id verify request", data);
+                               sprintf(tmp, "%ld id verify request", data);
                                st->l2.l2m.printdebug(&st->l2.l2m, tmp);
                        }
                        mdl_unit_data_res(st, 0, 7, data);
diff -ru linux-2.0.33/drivers/isdn.orig/isdn_tty.c linux-2.0.33/drivers/isdn/isdn_tty.c
--- linux-2.0.33/drivers/isdn.orig/isdn_tty.c   Thu Oct 30 23:24:03 1997
+++ linux-2.0.33/drivers/isdn/isdn_tty.c        Sat Mar  7 12:16:14 1998
@@ -1270,7 +1270,7 @@
        status = info->lsr;
        restore_flags(flags);
        result = ((status & UART_LSR_TEMT) ? TIOCSER_TEMT : 0);
-       put_user(result, (ulong *) value);
+       put_user(result, (uint *) value);
        return 0;
 }

@@ -1294,7 +1294,7 @@
            | ((status & UART_MSR_RI) ? TIOCM_RNG : 0)
            | ((status & UART_MSR_DSR) ? TIOCM_DSR : 0)
            | ((status & UART_MSR_CTS) ? TIOCM_CTS : 0);
-       put_user(result, (ulong *) value);
+       put_user(result, (uint *) value);
        return 0;
 }

              data = (unsigned long) skb;


