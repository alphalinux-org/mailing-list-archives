Ouups, your example is simply broken; it can't work.

> #include <sys/stat.h>
> #include <dirent.h>
> #include <unistd.h>
> 
> main()
> {
>    struct stat *buf;
>    stat("teststat.c",buf);
>    printf("%d\n",buf->st_mode);
> }

This cannot work, because you must allocate buf !
try something like:

#include <sys/stat.h>
#include <dirent.h>
#include <unistd.h>

main()
{
   struct stat buf;
   stat("teststat.c", &buf);
   printf("%d\n",buf.st_mode);
}

or

#include <stdlib.h>
#include <sys/stat.h>
#include <dirent.h>
#include <unistd.h>

main()
{
   struct stat *buf;  
   /* blah */
   buf = malloc(sizeof(buf));
   stat("teststat.c", buf);
   printf("%d\n",buf->st_mode);
   free(buf);
   /*blah*/
}

and it should work (untested, but may work if stat isn't broken ;-}).
BTW, what you really want is maybe:
   printf("%o\n",buf->st_mode & ~S_IFMT);

