void cprint(int lx, float *x)
{
    int i;
 
    for(i=0; i< lx;i++) printf("%d %f\n", i, x[i]);
    printf("\n");
}

void fcallc_(int *lx,float *x)
{
     int i;

     for( i = 0; i < *lx; i++) x[i] += 1000.; 

