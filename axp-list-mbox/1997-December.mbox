c Y.F. Sun
      subroutine f2c(lx,x)
      real x(*)
      external  fcallc
c
      do i=1,lx
        x(i) =  x(i) + 100.
      enddo
      call fcallc(lx,x)
      call matrixmulc()
      return
      end
c***************************************************************
c***************************************************************
      subroutine matrixmulc()
c
      parameter(lx1 = 1000, lx2 = 500, lx3 = 500)
      real a(lx1,lx2), b(lx2,lx3), c(lx1,lx3)
      real at(lx2,lx1)
      external  fcallc
c
      print *, 'C matrix multiplication: C = AB, Cmn, m,n = ',lx1,lx3
      do j=1,lx2
         do i=1,lx1
            a(i,j) = 0.000 
            if(i .eq. j) a(i,j) = 1.
         enddo
      enddo
      do j=1,lx2
         do k=1,lx3
            b(j,k) = j*0.0001+k
         enddo
      enddo
c transpose of A
      do j=1,lx1
         do i=1,lx2
            at(i,j) = a(j,i) 
         enddo
      enddo
      do j=1,lx3
         do i=1,lx1
            c(i,j) = 0.
            do m=1, lx2
              c(i,j) = c(i,j) + at(m,i) * b(m,j)
            enddo
            if(j .eq. lx3 .and. i .le. 10) 
     $         write(*, 100) ' c(',i,',',j,') = ', c(i,j)
         enddo
      enddo
100   format(a,I4,a,I4,a,f15.4)
      return
      end
