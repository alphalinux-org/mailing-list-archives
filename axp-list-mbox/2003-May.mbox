diff -Naur alsa-driver-0.9.3a/alsa-kernel/isa/sb/emu8000_patch.c alsa-driver-0.9.3a-linux2420/alsa-kernel/isa/sb/emu8000_patch.c
--- alsa-driver-0.9.3a/alsa-kernel/isa/sb/emu8000_patch.c	2002-08-12 03:43:46.000000000 -0500
+++ alsa-driver-0.9.3a-linux2420/alsa-kernel/isa/sb/emu8000_patch.c	2003-05-18 15:50:53.000000000 -0500
@@ -233,7 +233,7 @@
 		/* we may take too long time in this loop.
