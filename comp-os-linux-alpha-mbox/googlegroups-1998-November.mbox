Content-Type: text/plain; charset=us-ascii;
 name="Makefile"
Content-Transfer-Encoding: 7bit
Content-Disposition: inline;
 filename="Makefile"

# Adam Powell's makefile for Christian Simmendinger's Alpha 21164A BLAS package
# including Kazushige Goto's amazing dgemm routine

FFLAGS = -O3 -fomit-frame-pointer -funroll-loops -fno-schedule-insns \
	-fschedule-insns2 -fno-emulate-complex
SRCS := $(wildcard *.f)
OBJS = $(SRCS:.f=.o)

all: $(OBJS)
	make -C BLAS_RISC lib && make -C dgemm || exit
	ln -sf BLAS_RISC/*.o dgemm/*.o .
	rm -f libblas.a
	ar qv libblas.a *.o
	rm -f libblas.so
	g77 -shared -Wl,-soname -Wl,libblas.so -o libblas.so *.o
	chmod +x libblas.so

clean:
	make -C BLAS_RISC clean && make -C dgemm clean || exit
	rm -f *.a *.so *.o *~ core

