==============================================================================
#!/bin/sh
#Run Netscape Navigator 4.5 standalone for x86 Linux using em86

set MOZILLA_HOME /home/corton/harley/navigator
export MOZILLA_HOME
export MOZILLA_NO_ASYNC_DNS=True
exec /home/corton/harley/navigator/netscape &
==============================================================================


