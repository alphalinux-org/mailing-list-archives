you have overrun the static storage limit for arrays...

#include <stdio.h>
#define SIZE 1047977

main ()
{
/*        double vector_x [SIZE]; */
        double *vector_x = NULL;
        int x = 0;

        vector_x = (double *) malloc(sizeof(double) * (SIZE + 1));
	if (! vector_x)
	   {
	   perror("malloc failed");
	   exit(-1);
	   }
	for ( x = 0; x < SIZE; x++ )
                vector_x [x] = (double) x;

        printf ("\n  x [%d] = %.4lf\n\n", SIZE - 1, vector_x [SIZE - 1] );
}

(Xp1000 512mb 500mhz ev6 redhat 7.0 running 2.4.5)

Xp1000@alleycat /tmp> cc test.c 
test.c: In function `main':
