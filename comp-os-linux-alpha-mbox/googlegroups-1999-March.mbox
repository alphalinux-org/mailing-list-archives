      IMPLICIT NONE
      DOUBLE PRECISION X
      INTEGER*8 LOCMEM,LOCX,LOFFS1,LOFFS2,MEMGET,LADDRS
      INTEGER*4 MEMLIM,LOFFS
      COMMON /F/ X(1)
      EXTERNAL MEMGET
      EXTERNAL LADDRS
      LOCX=LADDRS(X(1))
      MEMLIM = 100000
      LOCMEM = MEMGET(MEMLIM)
C  Allocate MEMLIM words (8 bytes) of memory.
      LOFFS1 = LOCMEM - LOCX
      LOFFS2 = (LOFFS1+7)/8 + 1
C  WE NEED LOFFS TO BE I*4
      LOFFS = LOFFS2
      WRITE(*,1) LOCMEM
      WRITE(*,1) LOCX
      WRITE(*,1) LOFFS1
      WRITE(*,1) LOFFS2
      WRITE(*,1) LOFFS
 1    FORMAT(1x,I16)
      STOP
      END

with this C linked in:-

long memget_(nwords) long *nwords;
   { unsigned int nbytes;
     long nn;
     nbytes = (*nwords+2)*8;
     nn = (long) malloc(nbytes);
     printf("size of nn = %ld nn = %ld\n",sizeof(nn),nn);
     return nn; }

/* Taking out the nn stuff and doing return malloc gives the
same result. */

long laddrs_(arg) long arg;
   { return(arg); }

laddrs is used in place of loc to give the address of X(1), so
