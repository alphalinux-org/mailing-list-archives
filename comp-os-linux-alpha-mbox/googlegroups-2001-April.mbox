    return (ERROR);
  }

  if (BytesRead < BUFLEN)
  {
    printf ("FATAL ERROR - Read from socket incomplete!!! \n");
    return (ERROR);
  }

  printf ("%s for %s \n", control_message.Buffer1, WscStationId);

