/usr/include/c++/3.3/bits/stl_algobase.h has:

  template<typename _Tp>
    inline const _Tp&
    min(const _Tp& __a, const _Tp& __b)
    {
      // concept requirements
      __glibcpp_function_requires(_LessThanComparableConcept<_Tp>)
      //return __b < __a ? __b : __a;
      if (__b < __a) return __b; return __a;
    }

boinc/lib/std_fixes.h has:

#ifndef HAVE_STD_MIN
namespace std {

#ifdef min
#undef min
#endif

template <typename T>
inline T min(const T &a, const T &b) {
	return ((a<b)?a:b);
}
}
#endif /* HAVE_STD_MIN */

	I'm not knowledgeable enough on templates to spot the incompatability;
if neither of these are different from what you have, I'd suspect the
generation of the HAVE_STD_MIN flag, etc.

