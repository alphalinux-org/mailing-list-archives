struct osf_ifdevea {
	char ifr_nam[16];
	char default_pa[6];
	char current_pa[6];
};

int osf_siocrphysaddr(void *addr) {
	struct osf_ifdevea devea;
	struct device *dev;

	if(copy_from_user(&devea, addr, sizeof(devea)))
		return -EFAULT;
	if(!(dev = dev_get(devea.ifr_nam)))
		return -ENODEV;
	memcpy(&devea.default_pa, &device->dev_addr, 6);
	memcpy(&devea.current_pa, &device->dev_addr, 6);
	if(copy_to_user(addr, &devea, sizeof(devea)))
		return -EFAULT;
	return 0;
}

