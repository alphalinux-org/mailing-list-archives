here is the code I posted to the alpha-c mailing list (for compaq ccc):
#define FAST or not and look at the speed differences.
I used the perl script at the bottom to find bad lines in the assembler
code
- Alex

===========snip example code follows

void subroutine(double *fmat_lin, const double __restrict x,
        const double __restrict dhdX0_loc)
{
#ifdef FAST
    double fmat_li[9];
#else
    double *fmat_li = fmat_lin;
#endif
    
    fmat_li[0+3*0] = x[0]*dhdX0_loc[0];
    fmat_li[0+3*1] = x[0]*dhdX0_loc[1];
    fmat_li[0+3*2] = x[0]*dhdX0_loc[2];
    fmat_li[1+3*0] = x[1]*dhdX0_loc[0];
    fmat_li[1+3*1] = x[1]*dhdX0_loc[1];
    fmat_li[1+3*2] = x[1]*dhdX0_loc[2];
    fmat_li[2+3*0] = x[2]*dhdX0_loc[0];
    fmat_li[2+3*1] = x[2]*dhdX0_loc[1];
    fmat_li[2+3*2] = x[2]*dhdX0_loc[2];
    for (k = 1;k < 8;k++) {
      fmat_li[0+3*0] += x[3*k+0]*dhdX0_loc[3*k+0];
      fmat_li[0+3*1] += x[3*k+0]*dhdX0_loc[3*k+1];
      fmat_li[0+3*2] += x[3*k+0]*dhdX0_loc[3*k+2];
      fmat_li[1+3*0] += x[3*k+1]*dhdX0_loc[3*k+0];
      fmat_li[1+3*1] += x[3*k+1]*dhdX0_loc[3*k+1];
      fmat_li[1+3*2] += x[3*k+1]*dhdX0_loc[3*k+2];
      fmat_li[2+3*0] += x[3*k+2]*dhdX0_loc[3*k+0];
      fmat_li[2+3*1] += x[3*k+2]*dhdX0_loc[3*k+1];
      fmat_li[2+3*2] += x[3*k+2]*dhdX0_loc[3*k+2];
    }
#ifdef FAST
    memcpy(fmat_lin, fmat_li, sizeof(double)*9);
#endif
}

