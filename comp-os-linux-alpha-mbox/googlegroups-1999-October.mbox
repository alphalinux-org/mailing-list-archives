I didn't say "proof". But I can show you an example (which you can test
yourself):
Seems here is the memcpy you were looking for :-)
The memcopy gets compiled to:

  d8:   00 00 b0 9d     stt     $f13,0(a0)    #pretty optimized IMHO
  dc:   08 00 10 9e     stt     $f16,8(a0)
  e0:   10 00 30 9c     stt     $f1,16(a0)
  e4:   18 00 d0 9d     stt     $f14,24(a0)
  e8:   20 00 30 9e     stt     $f17,32(a0)
  ec:   28 00 50 9d     stt     $f10,40(a0)
  f0:   30 00 10 9c     stt     $f0,48(a0)
  f4:   38 00 90 9d     stt     $f12,56(a0)
  f8:   40 00 70 9d     stt     $f11,64(a0)

Compile the following with ccc -O4 -DFAST and check the assembler.

void subroutine(double *res, const double *x,
        const double *y)
{
   int k;
#ifdef FAST
    double res_loc[9];
#else
    double *res_loc = res;
#endif
    
    res_loc[0+3*0] = x[0]*y[0];
    res_loc[0+3*1] = x[0]*y[1];
    res_loc[0+3*2] = x[0]*y[2];
    res_loc[1+3*0] = x[1]*y[0];
    res_loc[1+3*1] = x[1]*y[1];
    res_loc[1+3*2] = x[1]*y[2];
    res_loc[2+3*0] = x[2]*y[0];
    res_loc[2+3*1] = x[2]*y[1];
    res_loc[2+3*2] = x[2]*y[2];
    for (k = 1;k < 8;k++) {
      res_loc[0+3*0] += x[3*k+0]*y[3*k+0];
      res_loc[0+3*1] += x[3*k+0]*y[3*k+1];
      res_loc[0+3*2] += x[3*k+0]*y[3*k+2];
      res_loc[1+3*0] += x[3*k+1]*y[3*k+0];
      res_loc[1+3*1] += x[3*k+1]*y[3*k+1];
      res_loc[1+3*2] += x[3*k+1]*y[3*k+2];
      res_loc[2+3*0] += x[3*k+2]*y[3*k+0];
      res_loc[2+3*1] += x[3*k+2]*y[3*k+1];
      res_loc[2+3*2] += x[3*k+2]*y[3*k+2];
    }
#ifdef FAST
    memcpy(res, res_loc, sizeof(double)*9);
#endif
}

- Alex



