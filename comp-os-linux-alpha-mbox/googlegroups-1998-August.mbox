Here's the program, to be run on an unloaded machine.

--------------->
/*
 * test memory bandwidth
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>
#include <sys/time.h>

/* MUST be powers of two and multiples of sizeof(int) */
#define MINMEM	1024
#define	MAXMEM	(4096*1024)
#define RUNTIME	15		/* seconds per iteration */
#define WORD	long

char *progname;
int  run;

void handler(int sig)
{
  run = 0;
}

int main(int argc, char *argv[])
{
  long  i, count;
  WORD *buf, *p;
  struct itimerval it;
  
  progname = rindex(argv[0], '/');
  if (progname == NULL)
    progname = argv[0];

  buf = malloc(MAXMEM);
  if (buf == NULL) {
    fprintf(stderr, "%s: can't allocate memory.\n", progname);
    exit(1);
  }

  setvbuf(stdout, (char *)NULL, _IOLBF, 0);
  it.it_interval.tv_sec = 0;
  it.it_interval.tv_usec = 0;
  it.it_value.tv_sec = RUNTIME;
  it.it_value.tv_usec = 0;
  for (i = MINMEM; i <= MAXMEM; i <<= 1) {
    p = buf;
    run = 1;
    count = 0;
    signal(SIGVTALRM, handler);
    setitimer(ITIMER_VIRTUAL, &it, (struct itimerval *)NULL);
    while(run) {
      *p++ += 1;
      if (p >= buf + i / sizeof(WORD))
	p = buf;
      count++;
    }
    printf("%4ldk: %12ld\n", i/1024, count);
  }

  exit(0);
}
<---------------

