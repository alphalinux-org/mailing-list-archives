(notexpecting)
extern size_t mbstowcs __P ((wchar_t *__restrict  __pwcs,
-----------------------^
cc: Error: /usr/alpha-glibc21-linux/include/stdlib.h, line 709: Error
parsing parameter list. Found "*" when expecting one of: ",", ")".
(notexpecting)
extern size_t wcstombs __P ((char *__restrict __s,
-----------------------^
cc: Warning: /usr/alpha-glibc21-linux/include/alloca.h, line 33: In this
declaration, parameter 1 has a different type than specified in an earlier
declaration of this function. (mismatparam)
extern __ptr_t alloca __P ((size_t __size));
---------------^
cc: Error: /usr/alpha-glibc21-linux/include/alloca.h, line 33: In this
declaration, the type of "alloca" is not compatible with the type of a
