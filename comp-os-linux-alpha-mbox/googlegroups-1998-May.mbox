For many situations, polynomials are faster.&nbsp; I&nbsp;was able to speed
up code on other platforms, for example an intel paragon (I860 based) by
a factor of >10 like this. Code fragments below. The I860 has some features
in common with the alpha, for example add and multiply are cheap, but divide
is expensive.&nbsp; <B>It is so easy to try that for your situtation I
would not even discuss it further, just try it and see</B>.&nbsp; As I
said, the key is if you don't need to do range reduction.&nbsp; In this
case you can implement the formulas&nbsp; in Abramowitz and Stegun with
about 7 multiplies and adds for single precision accuracy.&nbsp; This should
be much faster than the library numbers that I&nbsp;have seen quoted.

<P>A number of readers have suggested a lookup table followed by iterations
of Newton-Raphson to clean up the accuracy.&nbsp; This works very well
for functions like x^(1/2) or x^(1/3) [square root and cube root] where
the derivative of the function can be re-expressed in terms of the quantity
being searched for.&nbsp; However Newton-Raphson can not be used to "clean
up" the solution here with small numbers of cycles because the derivative
of sin(x) is cos(x) which can not be cheaply computed -- at least, not
easily.

<P>Here are a couple of fragments from my own code [optimized for I860
but should work well on Alpha].&nbsp; The sin(x) and cos(x) routines are
NOT based on the Abramowitz and Stegun approximations -- I recommend that
if you use this idea you should get the approximations from there and modify
the code accordingly.&nbsp; The cuberoot function is based on a lookup
table to scale the argument into the range 1->2, then two passes of Newton-Raphson.&nbsp;
A good reference for Newton-Raphson is section 9.4 of Numerical Recipes
in C. I DO&nbsp;NOT&nbsp;GUARANTEE&nbsp;ACCURACY however these were more
than good enough for what I was doing.&nbsp; Compare the output of your
program with these versus library routines before reaching the same conclusion
yourself.

<P>Good luck!

<P>&nbsp;&nbsp;&nbsp; Bruce Allen
<BR>
<HR WIDTH="100%">

<P>#ifdef INLINE_TRIGS
<BR>/* Chebyshev polynomials for expansion of sin/cos on -pi &lt; x &lt;
pi */
<BR>static const float cs0=1.000000e+00, cs2=-4.999999e-01, cs4=4.166650e-02,
<BR>cs6=-1.388787e-03, cs8=2.477176e-05, cs10=-2.709995e-07,
<BR>cs12=1.732713e-09;

<P>static const float cs1=1.000000e+00, cs3=-1.666669e-01, cs5=8.333445e-03,
<BR>cs7=-1.984473e-04, cs9=2.760671e-06, cs11=-2.530742e-08,
<BR>cs13=1.544217e-10;
<BR>#endif
<BR>&nbsp;

<P>#ifdef INLINE_TRIG
<BR>&nbsp; phs2=phs*phs;
<BR>&nbsp; si=phs*(cs1+phs2*(cs3+phs2*(cs5+phs2*(cs7+phs2*(cs9+phs2*(cs11+phs2*cs13))))));
<BR>&nbsp; co=cs0+phs2*(cs2+phs2*(cs4+phs2*(cs6+phs2*(cs8+phs2*(cs10+phs2*cs12)))));
<BR>#else
<BR>&nbsp; si=sin(2.0*phs);
<BR>&nbsp; co=cos(2.0*phs);
<BR>#endif

<P>
<HR WIDTH="100%">

<P>#ifdef INLINE_CUBEROOT
<BR>&nbsp;static unsigned int psave=123456789;
<BR>&nbsp;unsigned int p;
<BR>&nbsp;static float scale1,scale2;
<BR>&nbsp;extern const float gcheb0,gcheb1,gcheb2,gcheb3,gcheb4,gcheb5;
<BR>&nbsp;extern const float scaling_cuberoot[];
<BR>&nbsp;float x,z;
<BR>#endif

<P>#ifdef INLINE_CUBEROOT
<BR>&nbsp; /* HARDWIRED INLINE CUBE ROOT (see cuberoot()) */
<BR>&nbsp; /* y=cuberoot(ptrfrequency[i]); */
<BR>&nbsp; x=ptrfrequency[i];
<BR>&nbsp; p=(*(int *)&amp;x) >> 23;
<BR>&nbsp; if (p!=psave) {
<BR>&nbsp;&nbsp; psave=p;
<BR>&nbsp;&nbsp; scale1=scaling_cuberoot[2*p];
<BR>&nbsp;&nbsp; scale2=scaling_cuberoot[2*p+1];
<BR>&nbsp; }
<BR>&nbsp; x*=scale1;
<BR>&nbsp; z=gcheb0+x*(gcheb1+x*(gcheb2+x*(gcheb3+x*(gcheb4+x*gcheb5))));
<BR>&nbsp; y=x*z;
<BR>&nbsp; y*=(4.0f-z*y*y)*scale2;
<BR>&nbsp; /* END OF HARDWIRED INLINE CUBE ROOT (see cuberoot()) */
<BR>#else
<BR>&nbsp; y=pow(ptrfrequency[i],1.0/3.0);
<BR>#endif
<BR>&nbsp;
<BR>&nbsp;
<BR>&nbsp;

<P>#ifdef INLINE_CUBEROOT
<BR>float cuberoot(float x) {
<BR>&nbsp;static unsigned int psave=4096;
<BR>&nbsp;static float scale1,scale2;
<BR>&nbsp;unsigned int p;
<BR>&nbsp;float y,z;
<BR>&nbsp;extern const float gcheb0,gcheb1,gcheb2,gcheb3,gcheb4,gcheb5;
<BR>&nbsp;extern const float scaling_cuberoot[];

<P>&nbsp;/* the exponent of the float rep of x */
<BR>&nbsp;p=(*(int *)&amp;x) >> 23;

<P>&nbsp;/* if exponent hasn't changed, neither have scale factors */
<BR>&nbsp;if (p!=psave) {
<BR>&nbsp; psave=p;
<BR>&nbsp; scale1=scaling_cuberoot[2*p];
<BR>&nbsp; scale2=scaling_cuberoot[2*p+1];
<BR>&nbsp;}
<BR>&nbsp;
<BR>&nbsp;/* rescale x to the range from 1.0->2.0 inclusive */
<BR>&nbsp;x*=scale1;

<P>&nbsp;/* fifth-order fit to z=x^(-2/3) with uniform-error Chebyshevs
*/
<BR>&nbsp;z=gcheb0+x*(gcheb1+x*(gcheb2+x*(gcheb3+x*(gcheb4+x*gcheb5))));

<P>&nbsp;/* y ~ x^(-2/3) x ~ x^(1/3) */
<BR>&nbsp;y=x*z;

<P>&nbsp;/* Now do one pass of Newton-Raphson on f(z)=z^-3-x^2
<BR>&nbsp;&nbsp;&nbsp; so dz=-f/f' = -(z^-3 - x^2)/(-3 z^-4)
<BR>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; so z'=
z+dz = z(4 - z^3 x^2)/3 = z(4- y^2 z)/3
<BR>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; This pass
doubles # of decimal places of precision.
<BR>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; */
<BR>&nbsp;y*=(4.0f-z*y*y)*scale2;

<P>&nbsp;return y;
<BR>}

<P>/* Coefficients of Chebyshev polynomial approx for x^(-2/3) on interval
<BR>&nbsp;&nbsp; 1&lt;x&lt;2.&nbsp; Error about part in 10^4.
<BR>*/
<BR>const float
<BR>&nbsp;gcheb0=2.8567583422f,
<BR>&nbsp;gcheb1=-4.0127830607f,
<BR>&nbsp;gcheb2=3.4804896648f,
<BR>&nbsp;gcheb3=-1.7355624528f,
<BR>&nbsp;gcheb4=0.4620750592f,
<BR>&nbsp;gcheb5=-0.05099705856f;

<P>/* Table to reduce domain of input for Chebychev polynomial approx.
<BR>&nbsp;&nbsp; First column is (1/2)^k.&nbsp; Second column 1/3 2^(-k/3)
*/
