+++ mount-2.7l/lomount.c	Wed May 20 23:38:32 1998
@@ -18,6 +18,8 @@
 #include <sys/ioctl.h>
 #include <sys/stat.h>
 
+#include <linux/types.h> /* prye */
+
 #include "loop.h"
 #include "lomount.h"
 
diff -u -r mount-2.7l.orig/losetup.c mount-2.7l/losetup.c
--- mount-2.7l.orig/losetup.c	Mon Jan 26 22:59:58 1998
+++ mount-2.7l/losetup.c	Wed May 20 23:38:32 1998
@@ -11,6 +11,8 @@
 #include <errno.h>
 #include <sys/ioctl.h>
 
+#include <linux/types.h> /* prye */
+
 #include "loop.h"
 #include "lomount.h"
 
diff -u -r mount-2.7l.orig/mount.c mount-2.7l/mount.c
--- mount-2.7l.orig/mount.c	Mon Feb  2 08:51:54 1998
+++ mount-2.7l/mount.c	Wed May 20 23:38:32 1998
@@ -45,6 +45,8 @@
 #include <sys/wait.h>
 #include <sys/mount.h>
 
+#include <linux/types.h> /* prye */
+
 #include "mount_constants.h"
 #include "sundries.h"
 #include "fstab.h"
diff -u -r mount-2.7l.orig/nfsmount.c mount-2.7l/nfsmount.c
--- mount-2.7l.orig/nfsmount.c	Thu Feb  5 00:26:25 1998
+++ mount-2.7l/nfsmount.c	Wed May 20 23:38:32 1998
@@ -47,6 +47,8 @@
 #define _LINUX_SOCKET_H
 #endif /* __GLIBC__ */
 #define _I386_BITOPS_H
+#include <linux/posix_types.h> /* prye */
+#include <asm/posix_types.h> /* prye */
 #include <linux/fs.h>
 #include <linux/nfs.h>
 #include "nfs_mount3.h"
diff -u -r mount-2.7l.orig/umount.c mount-2.7l/umount.c
