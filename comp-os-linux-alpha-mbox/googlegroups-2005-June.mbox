I doubt it.  However, if you want a challenge, here's one.  Optimize
this bit of assembler for size.  It can be assembled and linked to a
functioning, but not very useful, program.

	lda $16, 1($31)
	br $17, 8
	.quad 0x0101010101010101
	ldq $4, 0($17)
	zapnot $4, 0x80, $3
	mulq $4, 0x30, $9
	mulq $4, 0xa, $5
	lda $2, 0($31)
	lda $18, 8($31)
	lda $1, 0x14($31)
1:	lda $0, 4($31)
	addq $2, $9, $10
	stq $10, 0($17)
	callsys
	addq $2, $3, $2
2:	cmpbge $2, $5, $6
	beq $6, 3f
	srl $6, 1, $7
	zapnot $4, $7, $8
	addq $2, $8, $2
	zap $2, $6, $2
	br 2b
3:	lda $1, -1($1)
	bne $1, 1b
	lda $0, 1($31)
	callsys


