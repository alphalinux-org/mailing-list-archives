I had the same problem, it can be tracked down in the code below:
On SGI's and SUN's this works as expected, on OSF1 it seems to be 
broken. I it is the same error, we would be very happy to get new
compiler versions.
How to refer to this bug when contacting the support ? Do they
no it ?

Juergen Fuhrmann


Begin Sample code:

      subroutine sigenable(isig)
      integer*4 isig
      external sighand
      call signal(isig,sighand,-1)
      return
      end

      subroutine sighand(isig)
      integer*4 isig
      call sigenable(isig)
      type *,'break, enter i (0 for stop)>'
      accept *,i
      if (i.eq.0) stop
      return
      end
     
      
      program tio
      call sigenable(2)
      do i=1,10000
         type *, 'i=',i
         do j=1,100
            x=i+j+sin(x)
         enddo
      enddo
      end

End Sample code

