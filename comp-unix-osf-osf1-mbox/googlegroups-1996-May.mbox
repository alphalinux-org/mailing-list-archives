------------------------------ title.c ---------------------------------------
/*
 * title: put stuff in xterm title using tcsh'ish escapes
 *      : typically used as tcsh's `cwdcmd'
 *	- John Hascall, ISU Comp Ctr
 *      Freely distributable as long as ISU and I am credited.
 *
 * Note: may need local frobbing in function itshome()
 */
#include <time.h>

#define	FALSE	0
#define	TRUE	1

static void	add_cdir();
static void	add_host();
static void	add_line();
static void	add_time();
static void	add_user();
static int	itshome();
static char *	itoa();
static int	match();
static int	levels();
static char *	lastnofm();

extern char *	getenv();
extern int	getuid();
extern int	isatty();
extern char *	ttyname();
extern int	write();

int main(argc, argv)
	int	argc;
	char **	argv;
{
	char	buffer[8192];
	char *	p	= buffer;
	char *	q;
	int	a	= 0;
	int	c;
	int	n;
	int	z;

	/*
	 * if stdout is not a tty quit so we don't send junk down a pipe like:
	 *   (cd /src; tar cf - .) | tar xpf -
	 */
	if (!isatty(0)) return(0);

	/*
	 * first, the special xterm escape sequence initiator
	 */
	*p++ = '\033'; *p++ = ']'; *p++ = '0'; *p++ = ';';

	/*
	 * now get either their format string or the default
	 */
	if (argc == 1) argv[argc++] = "%#%~ (%n@%m)";
	while (++a < argc) {
		q = argv[a];

		/*
		 * process the format string...
		 */
		while (*q != '\0') {
			if ((c = *q++) != '%') {
				*p++ = c;
				continue;
			}
			switch (c = *q++) {
			    case '%':			/* %% inserts % */
				*p++ = '%';
				break;
			    case '#':			/* root indicator */
				if (getuid() == 0) {	/* note difference */
					*p++ = '#';	/* from tcsh def'n */
					*p++ = ' ';
				}
				break;
			    case 'l':
				add_line(c, &p);
				break;
			    case 'n':
				add_user(c, &p);
				break;
			    case 'M':
			    case 'm':
				add_host(c, &p);
				break;
			    case '/':
			    case '~':
				add_cdir(c, &p, (c == '~'), FALSE, FALSE, 0);
				break;
			    case 'c':
			    case '.':
			    case 'C':
				z = FALSE;
				n = 1;
				if (*q == '0') { ++q; z = TRUE; }
				if ((*q >= '1') && (*q <= '9')) n = *q++ - '0';
				add_cdir(c, &p, (c != 'C'), TRUE, z, n);
				break;
			    case 't': case '@': case 'T': case 'd': case 'D':
			    case 'w': case 'W': case 'y': case 'Y':
				add_time(c, &p);
				break;
			    default:	/* %X, if X unknown, then nothing */
				break;
			}
		}
		*p++ = ' ';
	}
	
	/*
	 * a hex 0x07 terminates the escape sequence (put it over last space)
	 */
	p[-1] = '\007';

	/*
	 * splat it out
	 */
	(void)write(1, buffer, p - buffer);
	return (0);
}

/*
 * get current dir with much twiddling and such...
 */
static void add_cdir(c, pp, subs, abbrev, before, n)
	int	c;
	char **	pp;
	int	subs;
	int	abbrev;
	int	before;
	int	n;
{
	char *	p	= *pp;
	char *	pwd;
	char *	w;
	char *	u;
	char *	ldr;
	int	m;
	int	tilde	= FALSE;

	if ((pwd = getenv("PWD")) == NULL) pwd = "(Where?)";

	/*
	 * do ~[user] substitution if requested
	 */
	if (subs) {
		if ((m = itshome(pwd)) != 0) {		/* it's a home */
			pwd += m;
			if ((u = getenv("USER")) == NULL) u = "";
			for (w = pwd; *u != '\0'; ++w,++u) {
				if (*u != *w) break;
			}
			if (*u == '\0') pwd = w;	/* it's our home */
			tilde = TRUE;
		}
	}

	/*
	 * do they only want a trailing few components?
	 */
	if (abbrev) {
		ldr = pwd;
		m = levels(pwd);
		pwd = lastnofm(pwd, n, m);
		/*
		 * if we actually trimmed the pwd...
		 */
		if (pwd != ldr) {
			/*
			 * if they want a count of trimmed levels...
			 */
			if (before)  {
				/*
				 * leader (upto+including first /) comes first
				 */
				if (tilde) *p++ = '~';		/* add tilde */
				while (*ldr != '\0') {
					if ((*p++ = *ldr++) == '/') break;
				}
				*p++ = '<';
				w = itoa(m - n);
				while (*w != '\0') *p++ = *w++;
				*p++ = '>';
			}
			tilde = FALSE;		/* would be spurious now */
		}
	}
	if (tilde) *p++ = '~';			/* add the tilde if needed */

	/*
	 * and the rest...
	 */
	while (*pwd != '\0') *p++ = *pwd++;
	*pp = p;
}

/*
 * FQDN or short hostname
 */
static void add_host(c, pp)
	int	c;
	char **	pp;
{
	char *	p	= *pp;
	char	host[64] = "(Which?)";
	char *	hst	= host;
	char *	h;

	(void)gethostname(host, sizeof(host));
	if (c == 'm') {
		for (h = hst; *h != '\0'; ++h) {
			if (*h == '.') {
				*h = '\0';
				break;
			}
		}
	}
	while (*hst != '\0') *p++ = *hst++;
	*pp = p;
}

/*
 * ttyline (less /dev/ prefix)
 */
static void add_line(c, pp)
	int	c;
	char **	pp;
{
	char *	p	= *pp;
	char *	t;
	int	m;

	if ((t = ttyname(1)) == NULL) t = "(How?)";
	if ((m = match(t, "/dev/")) != 0) t += m;
	while (*t != '\0') *p++ = *t++;
	*pp = p;
}

/*
 * various time/date bits
 */
static void add_time(c, pp)
	int	c;
	char **	pp;
{
	char *			p	= *pp;
	char *			t;
	int			hr;
	static time_t		now	= 0;
	static struct tm	tm;
	static char *		day[]	= {"Sun", "Mon", "Tue",
					   "Wed", "Thu", "Fri", "Sat"};
	static char *		mon[]	= {"Jan", "Feb", "Mar", "Apr",
					   "May", "Jun", "Jul", "Aug",
					   "Sep", "Oct", "Nov", "Dec"};

	if (now == 0) {
		now = time(NULL);
		tm = (*localtime(&now));
	}
	switch (c) {
	    case 't':
	    case '@':
		hr = tm.tm_hour;
		if (hr >= 12) hr -= 12;
		t = itoa(hr);
		while (*t != '\0') *p++ = *t++;
		*p++ = ':';
		t = itoa(tm.tm_min);
		while (*t != '\0') *p++ = *t++;
		t = (hr == tm.tm_hour) ? "am" : "pm";
		break;
	    case 'T':
		t = itoa(tm.tm_hour);
		while (*t != '\0') *p++ = *t++;
		*p++ = ':';
		t = itoa(tm.tm_min);
		break;
	    case 'd':
		t = day[tm.tm_wday];
		break;
	    case 'D':
		t = itoa(tm.tm_mday);
		break;
	    case 'w':
		t = mon[tm.tm_mon];
		break;
	    case 'W':
		t = itoa(tm.tm_mon + 1);
		break;
	    case 'y':
		t = itoa(tm.tm_year);
		break;
	    case 'Y':
		t = itoa(1900 + tm.tm_year);
		break;
	}
	while (*t != '\0') *p++ = *t++;
	*pp = p;
}

/*
 * username (in case they forget :)
 */
static void add_user(c, pp)
	int	c;
	char **	pp;
{
	char *	p	= *pp;
	char *	u;

	if ((u = getenv("USER")) == NULL) u = "(Who?)";
	while (*u != '\0') *p++ = *u++;
	*pp = p;
}

/* ====================== HELPER FUNCTIONS =========================== */

static int itshome(path)
	char *	path;
{
	int	m;
	int	m0;
	int	m1;

	/*
	 * first, some hopefully reasonably generic tests
	 */
	if ((m = match(path, "/home/")) != 0) return (m);
	if ((m = match(path, "/usr/users/")) != 0) return (m);
	if ((m = match(path, "/usr/people")) != 0) return (m);
#ifdef	ISU
	/*
	 * now, some very local frobbing...
	 */
	if ((m = match(path, "/nfs/*fs-*/u*/")) != 0) return (m);
	if (((m0 = match(path, "/afs/iastate.edu/")) != 0) ||
	    ((m0 = match(path, "/afs/isu/")) != 0)) {
		if ((m1 = match(path + m0, "users/*/*/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "group/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "public/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "private/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "rental/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "project/")) != 0) return (m0+m1);
		if ((m1 = match(path + m0, "academic/")) != 0) return (m0+m1);
	}
#endif
	return (0);
}

/*
 * a not-very powerfull, but small wildcard matcher
 */
static int match(s, p)
	char *	s;
	char *	p;
{
	char *	q	= s;

	while (*p != '\0') {
		if (*p == '*') {		/* match stuff */
			++p;
			while (*q != *p) {
				if (*q == '\0') return (0);
				++q;
			}
			continue;
		}
		if (*p++ != *q++) return (0);
	}
	return (q - s);
}

/*
 * int-to-ascii (note: static buffer)
 */
static char * itoa(i)
	int	i;
{
	static char	buffer[16];
	char *		a =	buffer + 16;
	*--a = '\0';
	do {
		*--a = '0' + (i % 10);
		i /= 10;
	} while (i != 0);
	return (a);
}

/*
 * how many levels in a path? * (note: doesn't handle a trailing slash!)
 */
static int levels(path)
	char *	path;
{
	int	lvls	= 0;
	char *	p	= path;

	while (*p != '\0') {
		if (*p++ == '/') ++lvls;
	}
	return (lvls);
}

/*
 * point to last n levels of the m levels present in a path
 * lastnofm("/afs/iastate.edu/system/rw/dec/v4/usr", 3, 7) == "dec/v4/usr"
 * lastnofm("/usr/tmp", 2, 2) == "/usr/tmp"
 */
static char * lastnofm(path, n, m)
	char *	path;
	int	n;
	int	m;
{
	if (n >= m) return (path);		/* all of it (or more :) */
	for (m -= n; m >= 0; --m) {
		do {} while (*path++ != '/');
	}
	return (path);
}
