   t=T0;
   MyStart=1;
   POIEXT=0;
   if(res==1||STOCH_FLAG)storind=0;
   if(itype==IC)x[ivar]=p;
   else {
     set_val(range.item,p);
     re_evaluate_kernels();
   }
   sprintf(bob,"%s=%.16g  i=%d",range.item,p,i);
   bottom_msg(2,bob);
     if(integrate(&t,x,TEND,DELTA_T,1,NJMP,&MyStart)==1){
