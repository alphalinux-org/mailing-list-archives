X-Deja-AN: 153671891
references: <4kbb3c$fc9@larry.rice.edu> <4kbuhr$nn3@valhalla.cs.wright.edu> <4l0d6q$iet@mserv1.dl.ac.uk>
content-type: text/plain; charset=us-ascii
