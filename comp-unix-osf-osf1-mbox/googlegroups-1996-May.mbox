    c3e00000 30 br      zero, 0x120005b10 <output_line+2160>
0x120005b10 <output_line+2160>: 275e0001  9     ldah    ra, 65536(sp)
0x120005b14 <output_line+2164>: a75a09f0 29     ldq     ra, 2544(ra)
0x120005b18 <output_line+2168>: 253e0001  9     ldah    s0, 65536(sp)
0x120005b1c <output_line+2172>: a52909f8 29     ldq     s0, 2552(s0)
0x120005b20 <output_line+2176>: 279e0001  9     ldah    at, 65536(sp)
0x120005b24 <output_line+2180>: 23dc0a50  8     lda     sp, 2640(at)
0x120005b28 <output_line+2184>: 6bfa8001 1a     ret     zero, (ra), 1

Source routine:


void output_line(struct _line 		*curline,
		 enum section 		section,
		 struct _function	*fdata)
{
   int i;
   int argnum;
   struct _word *curwordp;
   static int bold = FALSE;
   static int italic = FALSE;

   curwordp = curline->wordlist;
   if(curwordp == NULL)
      return;

   /* check for the modal start of line characters */

   /* verbatim mode */

   if(curwordp->word[0] == VERBATIM)
   {
      if(!verbatim)
	 fprintf(docfile,"\\begin{verbatim}\n");
      else
	 fprintf(docfile,"\\end{verbatim}\n");
      verbatim = !verbatim;
      return;
   }

   /* and listing mode ( only if we are not in verbatim ) */

   if(!verbatim && curwordp->word[0] == '@')
   {
      if(!listing)
      {
	 listing = TRUE;
	 fprintf(docfile,"\\begin{itemize}\n");
	 fprintf(docfile,"\\item{");
      }
      else
      {
	 fprintf(docfile,"}\n");
	 fprintf(docfile,"\\item{");
      }
      /* strip the @ and any leading spaces */
      for(curwordp = curwordp->nextwordp;
	  curwordp != NULL && isspace(curwordp->word[0]);
	  curwordp = curwordp->nextwordp)
	 ;
   }
   
   /* if we are outputting return codes check for status code words */
   
   if(section == returncodes && is_a_status_code(curwordp->word))
   {
      fprintf(docfile,"\\Retcode{");
      output_string(docfile,curwordp->word);
      fprintf(docfile,"}\n");
      curwordp = curwordp->nextwordp;
   }
   
   for(;curwordp != NULL;curwordp = curwordp->nextwordp)
   {
      if(curwordp->word[0] == BOLDSTART)
      {
	 if(!bold)
	 {
	    fprintf(docfile,"{\\bf ");
	    bold = TRUE;
	 }
	 else
	    fprintf(stderr,"Bold start sequence \'<<\' found in BOLD block at
line %d\n",curline->lineno);
      }
      else if(bold && curwordp->word[0] == BOLDEND)
      {
	 fprintf(docfile,"}");
	 bold = FALSE;
      }
      else if(curwordp->word[0] == ITALSTART)
      {
	 if(!italic)
	 {
	    fprintf(docfile,"{\\em ");
	    italic = TRUE;
	 }
	 else
	    fprintf(stderr,"Italic start sequence \'[[\' found in ITALIC
block\n at line %d",curline->lineno);
      }
      else if(italic && curwordp->word[0] == ITALEND)
      {
	 fprintf(docfile,"}");
	 italic = FALSE;
      }
      else if (curwordp->word[0] == IGNOREPARAM)
	 ignoreparam = !ignoreparam;
      else if (curwordp->word[0] == '!' && curwordp->nextwordp == NULL)
      {
	 if(listing)
	 {
	    fprintf(docfile,"}\n\\end{itemize}\n");
	    listing = FALSE;
	 }
	 else
	    fprintf(docfile,"\\\\");
      }
      else if(section != introduction &&
	      !bold &&
	      isalpha(curwordp->word[0]) &&
	      is_an_arg(curwordp->word,*fdata,&argnum) &&
	      !verbatim &&
	      !ignoreparam)
      {
	 fprintf(docfile,"{\\bf ");
	 output_string(docfile,curwordp->word);
	 fprintf(docfile,"}");
      }
      else
	 output_string(docfile,curwordp->word);
   }
   fprintf(docfile,"\n");
}



