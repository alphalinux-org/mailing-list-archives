I added these lines to our /etc/sysconfigtab file

ipc:
  sem-mni = 400
  sem-msl = 500
  sem-opm = 200
  sem-ume = 200
  sem-vmx = 32767
  sem-aem = 16384

vm:
  ubc-maxpercent = 10

proc:
  autonice = 1


