Oh, that's easy:

	cd /usr/sbin
	mv uerf uerf.orig
	cat > uerf << \!
	#!/bin/sh -f
	/usr/sbin/uerf.orig ${1+"$@"} | sed 's/old_addr/new_addr/'
	!
	chmod +x uerf
