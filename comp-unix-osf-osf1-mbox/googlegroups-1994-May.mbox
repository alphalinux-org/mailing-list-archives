Quoting john@sable.WPI.EDU (John Stoffel) from comp.lang.perl:
:Has anyone been able to get a working version of perl on DEC's OSF/1
:2.0?  I've gotten it most of the way, even got the POSIX.c stuff to
:compile eventually.  Unfortunately, I get tons of "Unaligned Access"
:errors whenever I try running miniperl or perl.  The problem is in
:sv.c, more_xiv(), which Larry seems to have flagged already as a
:potential problem with the Alphas.

Well, try with this patch. It's not perfect, but at least it's a
start. A meta-configured copy has been sent to Larry Wall.

*** sv.c.orig	Wed Apr 13 09:09:15 1994
--- sv.c	Wed Apr 13 09:26:34 1994
***************
*** 160,166 ****
--- 160,173 ----
      I32* xiv;
      if (xiv_root) {
  	xiv = xiv_root;
+ 	/*
+ 	 * See comment in more_xiv() -- RAM.
+ 	 */
+ #ifndef __alpha
  	xiv_root = *(I32**)xiv;
+ #else
+ 	xiv_root = (I32*) *(long**) xiv;
+ #endif
  	return (XPVIV*)((char*)xiv - sizeof(XPV));
      }
      return more_xiv();
***************
*** 186,193 ****
      xiv += (sizeof(XPV) - 1) / sizeof(I32) + 1;   /* fudge by size of XPV */
      xiv_root = xiv;
      while (xiv < xivend) {
! 	*(I32**)xiv = (I32*)(xiv + 1); /* XXX busted on Alpha? */
  	xiv++;
      }
      *(I32**)xiv = 0;
      return new_xiv();
--- 193,212 ----
      xiv += (sizeof(XPV) - 1) / sizeof(I32) + 1;   /* fudge by size of XPV */
      xiv_root = xiv;
      while (xiv < xivend) {
! #ifndef __alpha
! 	*(I32**)xiv = (I32*)(xiv + 1);
  	xiv++;
+ #else
+ 	/*
+ 	 * For Alpha machine, make sure xiv is correctly aligned on a
+ 	 * long boundary before attempting dereferencing it.
+ 	 * Otherwise, we'll get an "Unaligned access" message from the
+ 	 * DEC OSF/1 kernel, or OPDEC PAL code exceptions with other
+ 	 * kernels not prepared to deal with that ;-) -- RAM
+ 	 */
+ 	*(long**) xiv = (long *) xiv + 1;
+ 	xiv = (I32*) ((long *) xiv + 1);
+ #endif
      }
      *(I32**)xiv = 0;
      return new_xiv();

