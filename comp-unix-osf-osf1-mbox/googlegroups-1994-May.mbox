In sys5 or similar system, the fork() will misplace a file position in a pointer
which opened by a parent and passed to children.  The bugs affects only fread().
fwrite() has not been tested yet, but similar peoblem should exist.

The tested systems are:

HP-UX A.09.01 A 9000/720
DEC OSF/1 V1.3A  (Rev. 112)
SunOS 5.4 ea1 sparc

IRIX 5.2 02282015 IP19 mips (fixed)


------------------------------ Cut Here ------------------------------
/* SV5 fork - fread bug . c
#
% Usages:
%	a.out [nrR] < fork-sv5.c
%		n or nothing = no fork and use gets to input
%		R = no fork and use fread to input
%		r = fork and use fread to input		!!! bug here
%		* all others = fork and use gets to input
%
% Author:	Jin Guojun - LBL
*/

#include <stdio.h>

main(argc, argv)
char	**argv;
{
char	buf[256];
FILE	*fp = stdin;

/*	first read in main()	*/
if (argc > 1 && *argv[1] == 'r')
	read_sbur(fp, buf, 0);
else	printf("start:\n%s", fgets(buf, 128, fp));

/*	second read in either parent or child	*/
if (argc > 1 && *argv[1] != 'n' && *argv[1] != 'R')	{
	switch (fork())	{
	case 0:	if (argc > 1 && *argv[1] == 'r')
			read_sbur(fp, buf, 1);
		else	subr(fp, buf);
		printf("done fork");
		break;
	case -1:printf("fork error\n");
		exit(-1);
	default:printf("FORK\n");
	}
} else	{	/* in parent	*/
	if (argc > 1 && *argv[1] == 'R')
		read_sbur(fp, buf, 1);
	else	subr(fp, buf);
	printf("end no fork\n");
}
exit(0);
}


read_sbur(fp, buf, more)
FILE *fp;
char* buf;
{
do {	int	i, j = fread(buf, 1, 80, fp);
	for (i=0; i<j; i++)	putchar(buf[i]);
} while (more && !feof(fp));
}

subr(fp, buf)
FILE *fp;
char *buf;
{
while (!feof(fp))
	printf("%s", fgets(buf, 128, fp));
}

