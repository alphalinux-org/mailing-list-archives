--/var/adm/sendmail/sendmail.cf-----
##### special local conversions (exit path from S3)
S7
# atp 1994 repeated use of %->@ in S3 (R$+%$+) on a name already
#	   containing an @ (atp%mssly1.mssl.ucl.ac.uk@ucl.ac.uk)
#	   causes a rewrite error in S9 
#	   so has to be undone here (defocus back to one)
R$*<@$+<@$+>>$*		$1%$2<@$3>$4			undo damage in S3
R$*<@$+%$+>$*		$1%$2<@$3>$4			move @ right after %
R$+<@POP>$*		$@$1<@POP>$2			POP already OK
R$*<@$->$*		$@$1<@$2.$N>$3			qualify hostnames
--------
