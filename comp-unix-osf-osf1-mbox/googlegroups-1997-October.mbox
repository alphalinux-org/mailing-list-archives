int ds_exit_error = (1);	
struct dstring *
ds_new (size_t size,
	enum ds_growth growth, size_t increment)
{
  struct dstring * res;
  if (size < 0)
    error (ds_exit_error, 0, "invalid size for dynamic string: %d",
	   size);
  if ((increment < 0)
      || (increment == 0 && growth != ds_steady))
    error (ds_exit_error, 0, "invalid increment for dynamic string: %d",
	   increment);
  res = ((struct dstring *) xmalloc (sizeof (struct dstring) * (1)));
  res->len = 0;
  res->size = size;
  res->growth = growth;
  res->increment = increment; 
  res->content = ((char *) xmalloc (sizeof (char) * (size)));
  res->content[0] = '\0';
  return res;
}
void
ds_erase (struct dstring *string)
{
  free (string->content);
  free (string);
}
void
ds_report (struct dstring * str, FILE * stream)
{
  char * cp = 0L;
  fprintf (stream, dcgettext (0L, "Dynamic string:\n", 5));
  fprintf (stream, dcgettext (0L, "\tload: %d/%d (%2.1f%%)\n", 5), 
	   str->len, str->size, 100.0 * str->len / str->size);
  switch (str->growth) {
  case ds_steady:
    cp = dcgettext (0L, "steady", 5);
    break;
  case ds_linear:
    cp = dcgettext (0L, "linear", 5);
    break;
  case ds_geometrical:
    cp = dcgettext (0L, "geometrical", 5);
    break;
  default:
    error (ds_exit_error, 0, "invalid growth type for dstring");
  }
  fprintf (stream, dcgettext (0L, "\tgrowth: %s, increment: %d\n", 5),
	   cp, str->increment);
}
void
ds_resize (struct dstring *string, size_t size)
{
  if (string->len + 1 < size) {
    string->size = size;
    string->content = ((char *) xrealloc ((string->content), sizeof (char) * (size)));
  }
}
void
ds_grow (struct dstring *string)
{
  switch (string->growth) {
  case ds_steady:
    return;
  case ds_linear:
    string->size += string->increment;
    break;
  case ds_geometrical:
    string->size *= string->increment;
    break;
  }
  string->content = ((char *) xrealloc ((string->content), sizeof (char) * (string->size))); 
}

int
ds_is_full (struct dstring *str)
{
  return (str->len + 1 >= str->size);
}

void
ds_strcat (struct dstring *s, char *t)
{
  size_t len = s->len;
  s->len += strlen (t);
  if (ds_is_full (s))
    ds_grow (s);
  strcpy (s->content + len, t);
}
void
ds_strncat (struct dstring *s, char *t, int n)
{
  size_t len = s->len;
  s->len += n;
  if (ds_is_full (s))
    ds_grow (s);
  strncpy (s->content + len, t, n);
  s->content[s->len] = '\0';
}
void
ds_strccat (struct dstring *s, char c)
{
  if (s->len + 2 >= s->size)
    ds_grow (s);
  s->content [s->len++] = c;
  s->content [s->len] = '\0';
}

void
ds_vsprintf (struct dstring * ds, const char *format, va_list args)
{
  int len;
  len = vprintflen (format, args);
  ds_resize (ds, len);
  vsprintf (ds->content, format, args);
  ds->len = strlen (ds->content);
} 
void
ds_sprintf (ds, format, va_alist)
  struct dstring * ds;
  char * format;
  long va_alist;
{
  va_list args;
  __builtin_va_start(args, va_alist, 0);
  ds_vsprintf (ds,
	       format, args);
  ;
} 
void
ds_cat_vsprintf (struct dstring * ds, const char *format, va_list args)
{
  int len;
  len = ds->len + vprintflen (format, args);
  ds_resize (ds, len);
  vsprintf (ds->content + ds->len, format, args);
  ds->len += strlen (ds->content + ds->len);
} 
void
ds_cat_sprintf (ds, format, va_alist)
  struct dstring * ds;
  char * format;
  long va_alist;
{
  va_list args;
  __builtin_va_start(args, va_alist, 0);
  ds_cat_vsprintf (ds,
		   format, args);
  ;
} 

void
ds_unsafe_vsprintf (struct dstring * ds, const char *format, va_list args)
{
  vsprintf (ds->content, format, args);
  ds->len = strlen (ds->content);
} 
void
ds_unsafe_sprintf (ds, format, va_alist)
  struct dstring * ds;
  char * format;
  long va_alist;
{
  va_list args;
  __builtin_va_start(args, va_alist, 0);
  ds_unsafe_vsprintf (ds,
		      format, args);
  ;
} 
void
ds_unsafe_cat_vsprintf (struct dstring * ds, const char *format, va_list args)
{
  if (ds->size < ds->len + 1024)
    ds_grow (ds);
  vsprintf (ds->content + ds->len, format, args);
  ds->len += strlen (ds->content + ds->len);
}
void
ds_unsafe_cat_sprintf (ds, format, va_alist)
  struct dstring * ds;
  char * format;
  long va_alist;
{
  va_list args;
  __builtin_va_start(args, va_alist, 0);
  ds_unsafe_cat_vsprintf (ds,
			  format, args);
  ;
}

char *
ds_getdelim (struct dstring *s, char eos, FILE *f)
{
  int insize;			
  int strsize;			
  int next_ch;
  insize = 0;
  strsize = s->len;
  next_ch = (--(f)->_cnt < 0 ? _filbuf(f) : (int) *(f)->_ptr++);
  while (next_ch != eos && next_ch != (-1))
    {
      if (insize >= strsize - 1)
	{
	  ds_grow (s);
	  strsize = s->len;
	}
      s->content[insize++] = next_ch;
      next_ch = (--(f)->_cnt < 0 ? _filbuf(f) : (int) *(f)->_ptr++);
    }
  s->content[insize++] = '\0';
  if (insize == 1 && next_ch == (-1))
    return 0L;
  else
    return s->content;
}
char *
ds_getline (struct dstring *s, FILE *f)
{
  return ds_getdelim (s, '\n', f);
}

