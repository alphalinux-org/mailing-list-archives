Here's a C++ class that may be helpful.  It creates a shared memory
with (one page) of overhead that records where in the address space
the page should be mapped.  This is intended to simplify applications
that need to have the same shared memory segment at the same address
repeatedly. It allows you to "name" the segments. Not fool-proof, but
it works. My intent was to eventually allow me to implement a malloc
in the overhead space, but haven't gotten to that yet.

main(int argc, char **argv)
{
  HPCXXshmem mem("foo");

  if (argc > 1) {
    cout << "Initializing...\n";
    int c = mem.create(1024 * 10);
    if ( c < 0 ) {
      cerr << "mem.create == " << c << ", errno = " << mem.errno() << endl;
      exit(0);
    }
  }

  int r = mem.attach();
  if ( r < 0 ) {
    cerr << "mem.create == " << r << ", errno = " << mem.errno() << endl;
    exit(0);
  }

  cout << "address is 0x" << hex << (unsigned long) mem.data() << dec << ", which should be a pointer" << endl;
}

