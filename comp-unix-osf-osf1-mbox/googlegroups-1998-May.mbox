/*
 * Mounts on unmounts a ISO-9660 CD-ROM: essentially
 *   mount -t cdfs -o noversion /dev/rz4c /cdrom
 * or
 *   umount /cdrom
 * Does not take any arguments (so is safe) ...
 *
 * by Hugues Talbot     10 Jan 1996
 * Modified PSz		12 Nov 96
 *
 * Note possible problem report at V4.0D below.
 */

/* Man page (created by PSz on 11 Mar 97)
 * Put this into /usr/local/man/man1/cdmount.1 or similar.
 * -----
.TH cdmount 1 ""
.ds n 5
.SH NAME
\fBcdmount\fR, \fBcdumount\fR - mounts or unmounts a CD-ROM to /cdrom
.SH SYNOPSIS
\fBcdmount\fR
.br
\fBcdumount\fR
.br
.SH DESCRIPTION
The \fBcdmount\fR command allows a (non-root) user to mount a CD-ROM on
/cdrom. It finds the CD drive device, and works similarly to the command
.PP
\fBmount\fR -t cdfs -o noversion /dev/rz4c /cdrom
.PP
The options used by \fBcdmount\fR are appropriate to the most common CD-ROM
disks, but they may not be suitable in all cases. Please see your system
administrator if you your disk needs different options.
.PP
The \fBcdumount\fR command allows a (non-root) user to unmount a CD-ROM from
/cdrom. It works similarly to the command
.PP
\fBumount\fR /cdrom
.PP
.SH SEE ALSO
\fBmount\fR(8), \fBcdfs\fR(4)
 * -----
 */

#include <errno.h>
#include <stdio.h>
#include <sys/mount.h>
#include <cdfs/cdfsmount.h>
#include <sys/types.h>
#include <sys/stat.h>


#define DIR "/cdrom"


char *pgm;


doerror( int res )
{
    if (errno == 0 && res != 0) errno = res;
    if (errno) { perror(pgm); }
    exit(errno);
}


main ( int argc, char *argv[] )
{
    int res;


    pgm = argv[0];

    if ( argc != 1 ) {
	fprintf (stderr, "%s: No arguments allowed\n", pgm);
	exit(1);
    }
    if ( strcmp(pgm,"cdmount") == 0 ) {
	struct stat stdat;
	struct cdfs_args cddat;
	char *devs[] = { "/dev/rz4c", "/dev/rz5c", NULL };
	char **devp, *dev;


	for ( devp = devs; *devp != NULL; devp++ ) {
	    dev = *devp;
	    /* printf("Trying device %s\n", dev); */
	    res = lstat(dev, &stdat);
	    if ( res || errno ) { errno = 0; continue; }
	    /* printf("st_rdev is  %d = 0x%08x\n", stdat.st_rdev, stdat.st_rdev); */
	    /*
	     * Device numbers are 0x0800002 + SCSI_ID * 0x0400
	     * How to tell a CD drive (as different from a disk)?
	     * Use #include <sys/devgetinfo.h>; ioctl (fd, DEVGETINFO, ... )?
	     */
	    if ( (stdat.st_rdev&0x0fff00ff) != 0x00800002 ) continue;

	    /* printf("Using device %s\n", dev); */

	    cddat.fspec = dev;
	    cddat.exflags = 0;
	    cddat.exroot = 0;
	    cddat.flags = M_NOVERSION /*| M_RRIP*/;
	    cddat.version = 0;
	    cddat.default_uid = 999;
	    cddat.default_gid = 999;  /* dummy user by default... */
	    cddat.default_fmode = 0555;
	    cddat.default_dmode = 0555;
	    cddat.map_uid_ct = 0;
	    cddat.map_uid = NULL;
	    cddat.map_gid_ct = 0;
	    cddat.map_gid = NULL;

	    printf ("Executing:  mount -t cdfs -o noversion %s %s\n", dev, DIR);

	    res = mount(MOUNT_CDFS, DIR,
		M_RDONLY | M_NOSUID | M_NODEV,
		&cddat);
	    doerror(res);
	}

	fprintf (stderr, "%s: No CD-ROM device found\n", pgm);
	exit(1);
    }
    else if ( strcmp(pgm,"cdumount") == 0 ) {
	printf ("Executing:  umount %s\n", DIR);

	res = umount(DIR, 0);
	doerror(res);
    }
    else {
	fprintf (stderr, "%s: Only cdmount or cdumount allowed\n", pgm);
	exit(1);
    }

    return errno;
}


