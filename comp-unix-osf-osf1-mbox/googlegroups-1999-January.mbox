#cd /dev
#MAKDEV rz16
#mkdir /etc/fdmns/usr_domain
#ln -s /dev/rz16g /etc/fdmns/usr_domain/rz16g
#mount usr_domain#usr /mnt

Delete the core files.   But you said you filled up the root filesystem, same
concept except for rz16a and root_domain#root if that's how they're named.

