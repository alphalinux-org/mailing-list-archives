#include <sys/sysinfo.h>
#include <sys/proc.h>

    int nvpair[2];

    nvpair[0] = SSIN_UACPROC;
    nvpair[1] = UAC_SIGBUS;

    setsysinfo(SSI_NVPAIRS, (char *) nvpair, 1, NULL, 0);

