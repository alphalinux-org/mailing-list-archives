Hmm...
This complicated piece of code I run on our HP9000 K200 under HP-UX
10.01:
-------------------------------------
#include <iostream.h>

int main()
{
   cout << "Size of int = " << sizeof(int) << endl;
   cout << "Size of long = " << sizeof(long) << endl;
   cout << "Size of long long = " << sizeof(long long) << endl;

   return 0;
}
-------------------------------

