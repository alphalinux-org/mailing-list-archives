Ack. Oop. Thhppt.  This annoyed me enough that I've arranged for our
system to automatically reset the tape drive density on reboot and also
(via cron) a few minutes before our nightly backups start.

Here's the expect script I hacked up (my very first one, so be gentle
about the programming style).  Note that the exec hack on line 3 is
mandatory if you will be using this as an rc3.d script (they are
unconditionally executed by /bin/sh).  Alternately, you could add it to
inittab and/or as a cronjob.

This works on our 3.2D-1 AlphaServer 1000A with a TLZ07 drive.  Your
mileage may vary.  Offer void where prohibited.  No warranty expressed
or implied.  Neither I nor CrossKeys takes any responsibility whatsoever
for any expense or damage arising from the use....  You get the picture.


Regards,
Neil


#!/usr/local/bin/expect --
#   avoid execution under /bin/sh using backslashed comment \
exec /usr/local/bin/expect "$0" "$@"

log_user 0

proc usage {} {
  global argv0
  send_error "usage: $argv0 {start|restart|high|on|1|stop|low|off|0}\n"
  exit
}

if { $argc == 1 } {

  switch -regexp -- [lindex $argv 0] {

    start|restart|high|on|1     { set compression 1 }
    stop|low|off|0              { set compression 0 }

  }

} elseif { $argc == 0 } {

  set compression 1

}

if { ! [info exists compression] } {
  usage
}

spawn /sbin/scu -f /dev/nrmt0h change page device-configuration

while 1 {
  expect {
    eof break
    "Compression*: " { send "$compression\r" }
    ": " { send "\r" }
  }
}

