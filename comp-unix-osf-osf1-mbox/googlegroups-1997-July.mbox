The "xset s off" or "xset s reset" command does not work if you run your
own start.Xserver file instead of S95xlogin.
Try this:
1. in "rc3" you append "/usr/bin/at now /sbin/init.d/start.Xserver",
2. "rm /sbin/rc3.d/S95xlogin",
3. "vi /sbin/init.d/start.Xserver" as follows:
"
PATH=/sbin:/usr/sbin:/usr/bin:/usr/bin/X11
export PATH
#
sleep 10
/usr/bin/X11/X -bs -su -nice -2 -to 10 -fp
/usr/lib/X11/fonts/misc/,/usr/lib/X11/fonts/75dpi/,/usr/lib/X11/fonts/100dpi,/usr/lib/X11/fonts/decwin/100dpi
-screen0 1280 -screen1 1280 -vsync 72 &
sleep 30
#
DISPLAY=:0.0
export DISPLAY
sleep  10
/usr/bin/X11/mwm -multiscreen &
sleep 10
# !!! does not work !!!
/usr/bin/X11/xset s off
#
/usr/lib/X11/xdm/Xsetup_0 > /dev/null
/usr/bin/X11/xhost + > /dev/null
"



