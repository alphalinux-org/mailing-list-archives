void jMsg::read(void *dataP,int size,long msgT=0L ) {
    int         result;
    struct flock  msg_flck={F_SETLKW,0,0,0};

    if (msgT==0) {
        msgT=this->myType;
    }

#ifdef _POSIX_SEMAPHORES
    msync(this->mapP,sysconf(_SC_PAGESIZE),MS_SYNC);
    if (sem_wait(this->mapP)<0)  { /* critical section lock */
        cout << "server read critical section failed with " << strerror(errno) << endl;
    }
    if ( (this->flags & _JWARE_CREAT)==_JWARE_CREAT) {
        int semVal;
        // after this client=1 server=1 Taunenbum UP 
        // server read after this block is like a socket accept()
        if (sem_getvalue(this->mapP+sizeof(sem_t),&semVal)>=0)
            cout << "server read pre-val" << semVal<< endl;
        else  cout << "server read pre-val failed with " << strerror(errno) << endl;
        if (sem_wait(this->mapP+sizeof(sem_t)) < 0) {
          cout << "read "<< strerror(errno) << endl;
        }
    } else {
        // at start the client goes right through this
        // to meet the "accept()" call goin  on in the then clause.
        // after this client=0 server=1 Taunenbum UP
        sem_wait(this->mapP+(2*sizeof(sem_t)));
    }
#else
    fcntl(lock_fd,F_SETLKW,&msg_flck);
#endif

    msync(this->mapP,sysconf(_SC_PAGESIZE),MS_SYNC/*|MS_INVALIDATE*/);
    memcpy (dataP,this->mapP+(3*sizeof(sem_t)),size);    

#ifdef _POSIX_SEMAPHORES

    if ( (this->flags & _JWARE_CREAT)!=_JWARE_CREAT) {
        // after this client=1 server =0 Taunenbaum UP
        if (sem_post(this->mapP+sizeof(sem_t)) < 0)
	  cout << "read post sync" << strerror(errno)<<endl;
    } else {
        // after this server=0 client=1 Taunenbaum DOWN
        if (sem_post(this->mapP+(2*sizeof(sem_t)))<0)
	  cout << "read post sync" << strerror(errno)<<endl;
    }
    sem_post(this->mapP); /* critical section unlock */
#else
    fcntl(lock_fd,F_UNLCK,&msg_flck);
#endif

}

void jMsg::write(void *dataP,int size) {
    int result;
    long temp;
    struct flock  msg_flck={F_SETLKW,0,0,0};
#ifdef _POSIX_SEMAPHORES
    if (sem_wait(this->mapP)<0) { /* critical section lock */
        cerr << "critical section for write :" << strerror(errno) << endl;
        msync(this->mapP,sysconf(_SC_PAGESIZE),MS_SYNC);
    }
    if ( (this->flags & _JWARE_CREAT)==_JWARE_CREAT) {   
        // after this client=1 server=1 Taunenbum UP 
        if (sem_wait(this->mapP+sizeof(sem_t))<0)
            cout << "server write " << strerror(errno) << endl;
    } else {
        // after this client=1 server=1 Taunenbum UP 
        if (sem_wait(this->mapP+(2*sizeof(sem_t)))<0)
            cout << "client write " << strerror(errno) << endl;
    }
#else
    fcntl(lock_fd,F_SETLKW,&msg_flck);
#endif

    memcpy (this->mapP+(3*sizeof(sem_t)),dataP,size);    
    msync(this->mapP,sysconf(_SC_PAGESIZE),MS_SYNC|MS_INVALIDATE);

#ifdef _POSIX_SEMAPHORES

    if ( (this->flags & _JWARE_CREAT)!=_JWARE_CREAT) {   
        int semValue;
        // client=1 server=0 Taunenbum DOWN server read
        sem_post(this->mapP+sizeof(sem_t));
//        sem_post(this->mapP+sizeof(sem_t));
//        sem_post(this->mapP+sizeof(sem_t));
        sem_getvalue(this->mapP+sizeof(sem_t),&semValue);
         cerr << "semval = " << (signed int)semValue << endl;



        sem_getvalue(this->mapP+sizeof(sem_t),&semValue);
        cerr << "semval = " << (signed int)semValue << endl;
    } else {
        // client=0 server=1 Taunenbum DONW client read
        sem_post(this->mapP+(2*sizeof(sem_t)));
    }
    sem_post(this->mapP); /* critical section lock */
#else
    fcntl(lock_fd,F_UNLCK,&msg_flck);
#endif
}









