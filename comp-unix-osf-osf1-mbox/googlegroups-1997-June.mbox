        memcpy(&sharedMem,this->mapCtlSharedMemP,sizeof(void*));
        this->mapP=mmap(sharedMem,sysconf(_SC_PAGESIZE),PROT_READ|PROT_WRITE,MAP_HASSEMAPHORE|MAP_FIXED/*|MAP_FILE*/|MAP_SHARED,map_fd,0);
        strcpy (this->mapP+(3*sizeof(sem_t)),"kangaroot");
        if ((long int)this->mapP == -1) 
            cerr << "mmap" << errno << " " << strerror(errno) << endl;

     }

#ifdef _POSIX_SEMAPHORES
    if ((this->flags & _JWARE_CREAT)==_JWARE_CREAT) {   
        cout << "creating semaphores in mapped file" <<endl;
        if (sem_init(this->mapP,1,1)<0)      /* init critical section semaphore */
          cerr << "sem_init" << errno << " " << strerror(errno) << endl;
        if (sem_init(this->mapP+sizeof(sem_t),1,0)<0)    /*init server semaphore*/
          cerr << "sem_init2" << errno << " " << strerror(errno) << endl;
        if (sem_init(this->mapP+(2*sizeof(sem_t)),1,1)<0)  /*init client semaphore*/
          cerr << "sem_init3" << errno << " " << strerror(errno) << endl;
    } else {
        int semval;
        cout << "semaphores not mapped " <<endl;
        msync(this->mapP/*+(3*sizeof(sem_t))*/,sysconf(_SC_PAGESIZE),MS_SYNC);
        if (sem_getvalue(this->mapP,&semval) <0)
	  cout << "semval1 " << semval << endl;
        else 
            cout << "semval1 " << strerror(errno) << endl;
        if (sem_getvalue(this->mapP+sizeof(sem_t),&semval) <0)
	  cout << "semval2 " << semval << endl;
        else 
            cout << "semval2 " << strerror(errno) << endl;
        if (sem_getvalue(this->mapP+(2*sizeof(sem_t)),&semval) <0)
	  cout << "semval3 " << semval << endl;
        else 
            cout << "semval3 " << strerror(errno) << endl;
    }
    if ((this->flags & _JWARE_CREAT)==_JWARE_CREAT) {   

       msync(this->mapP,sysconf(_SC_PAGESIZE),MS_SYNC|MS_INVALIDATE);
    }
#endif
    //unlink (mapfil_bstr.data());


