    struct shmid_ds removeBuf;
    if (this->lockfileP) {
        delete this->lockfileP;
    }
    if (this->mapfileP) {
        delete this->mapfileP; 
    }
    if ((this->flags & _JWARE_CREAT)==_JWARE_CREAT) {   
        shmctl(this->stationID,IPC_STAT,&removeBuf); 
