Newsgroups: comp.unix.osf.misc,comp.unix.osf.osf1


When writing install scripts in Perl for v3.2, I used something like
this:


#####################################################################
# Name:         createNewUser
# Purpose:      Add a user to the sytem
# Args:         $user   = login to add
#               $passwd = password
#               $uid    = UID to add
#               $group  = Group name for $user
#               $gcos   = user info
#               $shell  = user's login shell

sub createNewUser {
    local( $user, $passwd, $uid, $group, $gcos, $shell ) = @_;

  
    open( ADDUSER, '| /usr/sbin/adduser > /dev/null 2>&1' )
    || &Die( 1, "cannot run adduser" );

    print "\tAdding $user; press Control-D to continue...\n";

    # adduser asks the following questions:
    #   what is the new user's login?
    #   what is the new user's UID?
    #   what is the new user's full name?
    #   what is the new user's login group?
    #   what other groups does the new user belong to?
    #   what is the base directory for the new user's home directory?
    #   do you want to edit the user's authentication file entry?
    #   <runs passwd, which reads /dev/tty directly -- this is why the
user
    #    must hit Ctrl-D>
    print ADDUSER "$user\n"
                . "$uid\n"
                . "$gcos\n"
                . "$group\n"
                . "\n"
                . "/home\n"
                . "$shell\n"
		. "n\n";

    close ADDUSER;

    # Having created the user's entry in /etc/passwd, use vipw
    # to find the entry and hammer the password:
    &runVipw( "/^${user}:", "s/:[^:]*:/:${passwd}:/" );
}


#####################################################################
# Name:         runVipw
# Purpose:      Run vipw and send a sequence of commands at it
# Args:         @cmds   = vipw commands

sub runVipw {
    local( @cmds ) = @_;
    die "runVipw requires a command list" unless @cmds;
    local( $cmds ) = join( "\n", @cmds );

    local( $ENV{ 'EDITOR' }) = '/usr/bin/ex';
    local( $ENV{ 'TERM'   }) = 'dumb';

    open( VIPW, "| /usr/sbin/vipw > /dev/null 2>&1" )
    || &Die( 1, "cannot run vipw: $!" );
    print VIPW "$cmds\n";                           # caller's commands
    print VIPW "x\n";                               # exit
    close VIPW;
}

Icky, but true ;-)
bob

