X#include "tc.wait.h"
X
X#ifndef BSDSIGS
X
X/* this stack is used to queue signals
X * we can handle up to MAX_CHLD outstanding children now;
X */
X#define MAX_CHLD 50
Xstatic struct mysigstack {
X    int     s_w;		/* wait report			 */
X    int     s_errno;		/* errno returned;		 */
X    pid_t   s_pid;		/* pid returned			 */
X}       stk[MAX_CHLD];
Xstatic int stk_ptr = -1;
X
X
X# ifdef UNRELSIGS
X/* queue child signals
X */
Xstatic sigret_t
Xsig_ch_queue()
X{
X#  ifdef JOBDEBUG
X    xprintf("queue SIGCHLD\n");
X    flush();
X#  endif /* JOBDEBUG */
X    stk_ptr++;
X    stk[stk_ptr].s_pid = (pid_t) wait(&stk[stk_ptr].s_w);
X    stk[stk_ptr].s_errno = errno;
X    (void) signal(SIGCHLD, sig_ch_queue);
X#  ifndef SIGVOID
X    return(0);
X#  endif /* SIGVOID */
X}
X
X/* process all awaiting child signals
X */
Xstatic sigret_t
Xsig_ch_rel()
X{
X    while (stk_ptr > -1)
X	pchild(SIGCHLD);
X#  ifdef JOBDEBUG
X    xprintf("signal(SIGCHLD, pchild);\n");
X#  endif /* JOBDEBUG */
X    (void) signal(SIGCHLD, pchild);
X#  ifndef SIGVOID
X    return(0);
X#  endif /* SIGVOID */
X}
X
X
X/* libc.a contains these functions in SYSVREL >= 3. */
Xsigret_t
X(*xsigset(a, b)) ()
X    int     a;
X    sigret_t  (*b) __P((int));
X{
X    return (signal(a, b));
X}
X
X/* release signal
X *	release all queued signals and
X *	set the default signal handler
X */
Xvoid
Xsigrelse(what)
X    int     what;
X{
X    if (what == SIGCHLD)
X	sig_ch_rel();
X
X#  ifdef COHERENT
X    (void) signal(what, what == SIGINT ? pintr : SIG_DFL);
X#  endif /* COHERENT */
X}
X
X/* hold signal
X * only works with child and interrupt
X */
Xvoid
Xxsighold(what)
X    int     what;
X{
X    if (what == SIGCHLD)
X	(void) signal(SIGCHLD, sig_ch_queue);
X
X#  ifdef COHERENT
X    (void) signal(what, SIG_IGN);
X#  endif /* COHERENT */
X}
X
X/* ignore signal
X */
Xvoid
Xxsigignore(a)
X    int     a;
X{
X    (void) signal(a, SIG_IGN);
X}
X
X/* atomically release one signal
X */
Xvoid
Xxsigpause(what)
X    int     what;
X{
X    /* From: Jim Mattson <mattson%cs@ucsd.edu> */
X    if (what == SIGCHLD)
X	pchild(SIGCHLD);
X}
X
X
X/* return either awaiting processes or do a wait now
X */
Xpid_t
Xourwait(w)
X    int    *w;
X{
X    pid_t pid;
X
X#  ifdef JOBDEBUG
X    xprintf("our wait %d\n", stk_ptr);
X    flush();
X#  endif /* JOBDEBUG */
X
X    if (stk_ptr == -1) {
X	/* stack empty return signal from stack */
X	pid = (pid_t) wait(w);
X#  ifdef JOBDEBUG
X	xprintf("signal(SIGCHLD, pchild);\n");
X#  endif /* JOBDEBUG */
X	(void) signal(SIGCHLD, pchild);
X	return (pid);
X    }
X    else {
X	/* return signal from stack */
X	errno = stk[stk_ptr].s_errno;
X	*w = stk[stk_ptr].s_w;
X	stk_ptr--;
X	return (stk[stk_ptr + 1].s_pid);
X    }
X} /* end ourwait */
X
X#  ifdef COHERENT
X#   undef signal
Xsigret_t
X(*xsignal(a, b)) ()
X    int     a;
X    sigret_t  (*b) __P((int));
X{
X    if (a == SIGCHLD)
X	return SIG_DFL;
X    else
X	return (signal(a, b));
X}
X#  endif /* COHERENT */
X
X# endif /* UNRELSIGS */
X
X# ifdef SXA
X/*
X * SX/A is SYSVREL3 but does not have sys5-sigpause().
X * I've heard that sigpause() is not defined in SYSVREL3.
X */
X/* This is not need if you make tcsh by BSD option's cc. */
Xvoid
Xsigpause(what)
X{
X    if (what == SIGCHLD) {
X	bsd_sigpause(bsd_sigblock((sigmask_t) 0) & ~sigmask(SIGBSDCHLD));
X    }
X    else if (what == 0) {
X	pause();
X    }
X    else {
X	xprintf("sigpause(%d)\n", what);
X	pause();
X    }
X}
X# endif /* SXA */
X
X#endif /* !BSDSIGS */
X
X#ifdef NEEDsignal
X/* turn into bsd signals */
Xsigret_t(*
X	 xsignal(s, a)) ()
X    int     s;
X    sigret_t (*a) __P((int));
X{
X    sigvec_t osv, sv;
X
X    (void) mysigvec(s, NULL, &osv);
X    sv = osv;
X    sv.sv_handler = a;
X#ifdef SIG_STK
X    sv.sv_onstack = SIG_STK;
X#endif /* SIG_STK */
X#ifdef SV_BSDSIG
X    sv.sv_flags = SV_BSDSIG;
X#endif /* SV_BSDSIG */
X
X    if (mysigvec(s, &sv, NULL) < 0)
X	return (BADSIG);
X    return (osv.sv_handler);
X}
X
X#endif /* NEEDsignal */
X
X#ifdef POSIXSIGS
X/*
X * Support for signals.
X */
X
Xextern int errno;
X
X/* Set and test a bit.  Bits numbered 1 to 32 */
X
X#define SETBIT(x, y)	x |= sigmask(y)
X#define ISSET(x, y)	((x & sigmask(y)) != 0)
X
X#ifdef DEBUG
X# define SHOW_SIGNALS	1	/* to assist in debugging signals */
X#endif /* DEBUG */
X
X#ifdef SHOW_SIGNALS
Xchar   *show_sig_mask();
X#endif /* SHOW_SIGNALS */
X
Xint     debug_signals = 0;
X
X/*
X * sigsetmask(mask)
X *
X * Set a new signal mask.  Return old mask.
X */
X#ifndef __PARAGON__
Xsigmask_t
Xsigsetmask(mask)
X    sigmask_t     mask;
X{
X    sigset_t set, oset;
X    int     m;
X    register int i;
X
X    sigemptyset(&set);
X    sigemptyset(&oset);
X
X    for (i = 1; i <= MAXSIG; i++)
X	if (ISSET(mask, i))
X	    sigaddset(&set, i);
X
X    if (sigprocmask(SIG_SETMASK, &set, &oset))
X	xprintf("sigsetmask(0x%x) - sigprocmask failed, errno %d",
X		mask, errno);
X
X    m = 0;
X    for (i = 1; i <= MAXSIG; i++)
X	if (sigismember(&oset, i))
X	    SETBIT(m, i);
X
X    return (m);
X}
X
X/*
X * sigblock(mask)
X *
X * Add "mask" set of signals to the present signal mask.
X * Return old mask.
X */
Xsigmask_t
Xsigblock(mask)
X    sigmask_t     mask;
X{
X    sigset_t set, oset;
X    int     m;
X    register int i;
X
X    sigemptyset(&set);
X    sigemptyset(&oset);
X
X    /* Get present set of signals. */
X    if (sigprocmask(SIG_SETMASK, NULL, &set))
X	xprintf("sigblock(0x%x) - sigprocmask failed, errno %d",
X		mask, errno);
X
X    /* Add in signals from mask. */
X    for (i = 1; i <= MAXSIG; i++)
X	if (ISSET(mask, i))
X	    sigaddset(&set, i);
X
X    sigprocmask(SIG_SETMASK, &set, &oset);
X
X    /* Return old mask to user. */
X    m = 0;
X    for (i = 1; i <= MAXSIG; i++)
X	if (sigismember(&oset, i))
X	    SETBIT(m, i);
X
X    return (m);
X}
X#endif /* __PARAGON__ */
X
X
X/*
X * bsd_sigpause(mask)
X *
X * Set new signal mask and wait for signal;
X * Old mask is restored on signal.
X */
Xvoid
Xbsd_sigpause(mask)
X    sigmask_t     mask;
X{
X    sigset_t set;
X    register int i;
X
X    sigemptyset(&set);
X
X    for (i = 1; i <= MAXSIG; i++)
X	if (ISSET(mask, i))
X	    sigaddset(&set, i);
X    sigsuspend(&set);
X}
X
X/*
X * bsd_signal(sig, func)
X *
X * Emulate bsd style signal()
X */
Xsigret_t (*bsd_signal(sig, func))()
X        int sig;
X        sigret_t (*func)();
X{
X        struct sigaction act, oact;
X        sigset_t set;
X        sigret_t (*r_func)();
X
X        if (sig < 0 || sig > MAXSIG) {
X                xprintf("error: bsd_signal(%d) signal out of range\n", sig);
X                return((sigret_t(*)()) SIG_IGN);
X        }
X
X        sigemptyset(&set);
X
X        act.sa_handler = (sigret_t(*)()) func;      /* user function */
X        act.sa_mask = set;                      /* signal mask */
X        act.sa_flags = 0;                       /* no special actions */
X
X        if (sigaction(sig, &act, &oact)) {
X                xprintf("error: bsd_signal(%d) - sigaction failed, errno %d\n",
X                    sig, errno);
X                return((sigret_t(*)()) SIG_IGN);
X        }
X
X        r_func = (sigret_t(*)()) oact.sa_handler;
X        return(r_func);
X}
X#endif /* POSIXSIG */
X
X
X#ifdef SIGSYNCH
Xstatic long Synch_Cnt = 0;
X
Xsigret_t
Xsynch_handler(sno)
Xint sno;
X{
X    if (sno != SIGSYNCH)
X	abort();
X    Synch_Cnt++;
X}
X#endif /* SIGSYNCH */
