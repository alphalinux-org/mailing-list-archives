This should do the trick:

#include <sys/types.h>
#include <sys/sysinfo.h>
#include <sys/proc.h>
#include <stdio.h>
#include <errno.h>

extern char *sys_errlist[];
extern int sys_nerr;

main()
{

  int sbuf[2];

  sbuf[0] = SSIN_UACPARNT;
  sbuf[1] = UAC_NOFIX | UAC_SIGBUS;

  errno = 0;
  if (setsysinfo(SSI_NVPAIRS, (caddr_t) sbuf, 1, 0, 0) == 0)
    printf("uatrap: unaligned access will now cause SIGBUS\n");
  else {
    fprintf(stderr, "uatrap: setsysinfo(): ");
    if (errno < sys_nerr)
      fprintf(stderr, sys_errlist[errno]);
    else
      fprintf(stderr, "errno = %d", errno);
    fprintf(stderr, "\n");
  }
  exit(errno);
}

