---- cute here ----
#! Adolf Makefile
# (C) 1993 Peter Evans. All Rights Reserved. And Lefts too!
# You may use this makefile for compilation of FLUENT only.
# The author accepts no liability what so ever for the consequences of
# using these files. It does what it was designed to do and that's all
# that really matters.
#-----------------------------------------------------------------------
## START Gonk
## <make flags and the likes for gonk>
## END Gonk
START FLUENT
# What are we trying to make ... FLUENT
PROGRAM_NAME	= fluent.4.2.3
ALPHA_HOOPS_LIB	= -L../lib -lhoops -lXext
END FLUENT
START DECALPHA
# -------------------------------------------------------------------
# DEC AXP ALPHA workstations.
# faster and more robust than most.
# note that the 64-bit architecture causes problems between C and fortran
# fortran compiler:
FC		= f77
# compiler flags:
OPTIMISATION	= -O
LOW_OPTIMISATION	= -O1
FFLAGS_OPT	= -assume noaccuracy_sensitive -align dcommons

# noaccuracy allows rearrangement of maths.
# dcommons is for better alignment

FFLAGS		= $(OPTIMISATION) -v -u -assume backslash $(FFLAGS_OPT)
FFLAGS_LOW_O	= $(LOW_OPTIMISATION) -v -u -assume backslash $(FFLAGS_OPT)

# this code is FORTRAN, if fed to CPP with comment stripping, it takes
# out c++ comments too! Fortran //

CFLAGS		= -O
LDFLAGS		= $(FFLAGS) -v
# libraries:
LIBS		= $(X11_LIBS) $(MATH_LIBS)
#
# note "alpha" for 423, "Alpha" for P-Chan 422
CPP_FLAGS	= -Dalpha $(UNIX_FLAGS) $(X11_FLAGS)
END DECALPHA
## ---------------------------------------------------------------------------
START DECALPHA_COREDUMP
graphics.o: graphics.f
	@echo "Reduced optimisation to avoid core-dump"
	$(FC) $(FFLAGS_LOW_O) -c $< -o $@

graphics1.o: graphics1.f
	@echo "Reduced optimisation to avoid core-dump"
	$(FC) $(FFLAGS_LOW_O) -c $< -o $@

END DECALPHA_COREDUMP

