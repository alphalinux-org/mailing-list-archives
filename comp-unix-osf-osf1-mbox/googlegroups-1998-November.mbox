 Hello:

The makefile hereunder, run on a PWS 433au (Digital Unix 4.0D), gives me
trouble: the
command "make -f make.dec -n lib" leads to the error message:

                                Make: Don't know how to make /sph_lib.cpp.
Stop.

I also tried the POSIX make(1p), but without success (Error! Could not
figure out how
to make /sph_lib.cpp. Stop.)

What actually puzzles me is: where does the "/" in /sph_lib.cpp come from?
It seems as
if the SPHSRC macro in the target line "sph_lib:
${SPHSRC}/${SPHLIBSRC}" is
considered undefined at that stage, although it is defined at the top of
the makefile.

When I run the exact same makefile on a HP platform (HP-UX 10.20), I don't
have any
problem.

I am a newcomer to Digital Unix, and some help here would be appreciated.

Thanks,
                   Guy Paulus

---------------------------  make.dec:
###
#
# Local directories
#
###

SPHSRC = ../../COMMON/INCLUDE                       # SPH Lib files

SPHLIBSRC = sph_lib.cpp

DIR   = .
SRCDIR = $(DIR)/SOURCE                            # Source files
OBJDIR = $(DIR)/OBJ                                # Object files
SPHINC = -I$(SPHSRC) -I$(SRCDIR) -I../COMMON        # SPH header files

###
#
# Compilers, link editors
#
###

CCC = cc           # C compiler
CC  = cxx          # C++ compiler
LD  = cxx          # Link editor

###
#
# Defined symbols
#
###

SYMS        = -Dosf1 -DOSF1 -D__OSF1 -x cxx -Dwx_motif

###
#
# Compiler options
#
###

OPTIONS     = $(SYMS) $(CCOPTIM)

WARN        = -w2

###
#
# Includes
#
###

INCLUDE     = $(SPHINC) -I/usr/include/cxx
COMPPATHS   =
XINCLUDE    = -I/usr/include/X11 -I/usr/include/Xm -I/usr/include/X11/Xm \
              -I/usr/include

###
#
# Libraries
#
###

CLIB        = -lc -lm -lcxx
XLIB        = -L/usr/local/X11/lib -L/usr/X11/lib
BASICMOTIFLDLIBS = $(CLIB) -lXm -lXmu -lXt -lX11
MOTIFLDLIBS = $(BASICMOTIFLDLIBS)

###
#
# WX stuff: includes and libraries
#
###

WXDIR       = /opt/wx
WXINC       = $(WXDIR)/include/x
WXBASEINC   = $(WXDIR)/include/base
WXLIB       = -L$(WXDIR)/lib -lwx_motif
INC         = -I$(WXBASEINC) -I$(WXINC) $(COMPPATHS)

###
#
# Global flags
#
###


CXXFLAGS    = $(DEBUGFLAGS) $(OPTIONS) $(WARN) $(INCLUDE) $(XINCLUDE)
$(INC)
CFLAGS      = $(DEBUGFLAGS) $(OPTIONS) $(CWARN) $(INCLUDE) $(XINCLUDE)
$(INC)
LDFLAGS     = $(XLIB) $(WXLIB)
LDLIBS      = $(MOTIFLDLIBS)

###
#
# Targets
#
###

lib:     sph_lib

sph_lib:        ${SPHSRC}/${SPHLIBSRC}
        cd ${SPHSRC} ; \
        ${CC} -c ${CXXFLAGS} ${SPHLIBSRC}





