You should get wgrep.  I have a perl version of it, as follows:

#! /bin/perl
$before = 3 ; 
$after = 3; 
$show_stars = 1 ; 
$show_nums = 0;
$sep = "*********\n" ;

while (@ARGV[0] =~ /^-([A-z])(.*)/) 
{
    $arg = $1;
    if     ($arg eq "s")   { $show_stars = 0; }
    elsif  ($arg eq "n")   { $show_nums  = 1; }
    elsif  ($arg eq "w")   
    {
        split(/:/,$2);
        $before = @_[0] if @_[0] ne '';
        $after  = @_[1] if @_[1] ne ''; 
    }
    else 
        { 
        &usage("wgrep: invalid option: $ARGV[0]"); 
        }
    shift;
}

&usage("missing regular expression") if ! @ARGV[0];
$regexp = @ARGV[0];
print "Searching for ",$regexp ;
shift;
$regexp =~ s,/,\\/,g;

if (! @ARGV[0]) { @ARGV[0] = "STDIN"; }

FILELOOP:
foreach $file (@ARGV) 
{
    print " in $file \n";
    if ($file ne "STDIN" && ! open(NEWFILE,$file)) 
    {
        print STDERR "Can't open file $file; skipping it. \n";
        next FILELOOP;
    }

    $lnum = "000000"; 
    $nbef = 0; 
    $naft = 0;
    $matched = 0; 
    $matched2 = 0;
    &clear_buf(0) if $before > 0;
    
    $fhandle = $file eq "STDIN" ? STDIN : NEWFILE;

    while (<$fhandle>) 
    {
        ++$lnum;
        if ($matched) 
        {
            if ($_ =~ /$regexp/) 
            {
                $naft = 0;
                &print_info(1); 
                print $_;
            }
            else 
            {
                if ($after > 0 && ++$naft <= $after )
                {
                    &print_info(0); 
                    print $_;
                }
                else 
                {
                    $matched = 0;  
                    $naft = 0;
                    push(@line_buf, $_); 
                    $nbef++ ;
                }
            }
        }
        else 
        {
            if ($_ =~ /$regexp/) 
            {
                $matched = 1;
                print $sep if $matched2 && $nbef > $before ;
                print "******** file = $file ********\n" 
                     if ! $matched2++;
                &clear_buf(1) if $before > 0; 
                $nbef = 0 ;
                &print_info(1); 
                print $_;
            }
            elsif ($before > 0) 
            {
                shift (@line_buf) if $nbef >= $before;
                push (@line_buf, $_); 
                $nbef++;
            }
        }
    }
}

exit;

sub usage {
    print STDERR @_[0],"\n" if @_[0];
    print STDERR " usage: wgrep [-n] [-w[b][:a]] [-s] regexp [files] \n";
    print STDERR " option:  -n, number lines, \n";
    print STDERR " option:  -w3:4 print three line before and four after\n";
    print STDERR " option:  -s turn OFF star in front of match lines \n";
    exit;
}

sub clear_buf {
    $print_flag = @_[0]; 
    $i = 0; 
    $j = 0;
    if ($print_flag) 
    {
        if ($shownums) 
        {
            $target = $lnum - ($#line_buf + 1);
            $lnum = "000000";
            while ($i++ < $target) { ++$lnum; }
        }
        while ($j <= $#line_buf)
        {
            &print_info(0);
            print @line_buf[$j++];
            $lnum++ if $show_nums;
        }
    }
    @line_buf = (); 
}

sub print_info {
     print @_[0] ? "* " : "  " if $show_stars;
     print $lnum," " if $show_nums;
}
 
