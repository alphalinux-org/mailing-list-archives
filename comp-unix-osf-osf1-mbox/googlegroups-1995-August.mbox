Subject: DEC cxx bug (Member acces control)
Date: 1995/08/04
Message-ID: <JLM.95Aug4131918@ludo.two-oo-one.fr>#1/1
X-Deja-AN: 107556466
distribution: world
organization: 2001 S.A.
followup-to: comp.unix.osf.osf1
newsgroups: comp.unix.osf.osf1,comp.unix.osf.misc,fr.test


% cxx -V
cxx  (cxx)
        DEC C++ V5.0-3 for DEC OSF/1 (Alpha)

----------------------------------------------
class A {
protected:
//^^^^^^^
    int a_;
};

class B1 : public A {
};

class B2 : public A {
    int foo (A& a, B1& b1, B2& b2) {
	const int _a	= a.a_;		// error: In the initializer for _a, "A::a_" is not accessible.
	const int _b1	= b1.a_;	// Here is the bug. CXX would detect an error. g++ do it:
	//^^^^^^^^^^^^^^^^^^^^^^	// (member `a_' is protected) and ISO/IEC JTC1/SC22 too
	const int _b2	= b2.a_;	// OK
	const int _this	= a_;		// OK
	return _a + _b1 + _b2 + _this;
    }
};
