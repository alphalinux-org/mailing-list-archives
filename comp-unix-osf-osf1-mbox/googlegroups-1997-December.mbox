I found a problem with the Digital Unix 4.0's C compiler. When
compiled optimized (i.e. "-O") functions don't properly return
structures.

The following example program should show the problem:


#include <stdio.h>


typedef struct junkType
{
    long	var1;
    long	var2;
    long	junk1;
    long	junk2;
    long	junk3;
    long	junk4;
    long	junk5;
    long	junk6;
    long       	junk7;
} junkType;


junkType foo(int x, int y)
{
    junkType j;

    j.var1 = x;
    j.var2 = y;

    return j;
}

void foo2(junkType jt1, junkType jt2)
{
    printf("Size of junkType is: %d bytes.\n\n", sizeof(junkType));

    printf(" %d %d %d %d \n",
	   jt1.var1, 
	   jt1.var2, 
	   jt2.var1, 
	   jt2.var2);
}


main(int argc, char **argv)
{
    foo2(foo(1, 2), foo(3, 4));
