Found it, but it looks as though it _should_ be smart enough to be
starting the second SLIP interface itself. Here's a snippet:

			echo > $errtmp
			/sbin/ifconfig $devval $ifval up > $errtmp 2>&1
			if [ $? != 0 ]; then
				ERROR=`cat $errtmp`
				echo "$0: ifconfig failed - $ERROR"
				FAILFLAG=1
			fi
			rm -f $errtmp
			found=`expr $found + 1`
			# get first two characters of device name
			devval2=`echo $devval | cut -c1-2`
			# if SLIP device, do slattach
			if [ "$FAILFLAG" = 0 -a -f /usr/sbin/slattach -a "$devval2" = "sl" ]; then
				slipdev=$slipdev$num	  # SLIPTTY_n
				eval slipval=\$$slipdev	  # value of SLIPTTY_n
				if [ "$slipval" != '' ]; then
					/usr/sbin/slattach $slipval
				fi
			fi
		fi
		if [ "$found" = "$NUM_NETCONFIG" ]; then
			break
