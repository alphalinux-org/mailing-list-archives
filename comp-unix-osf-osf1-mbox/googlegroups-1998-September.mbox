Here's one way to do it;

#!/bin/csh

set REMDEST="host"
set USER="user"
set PWD="password"
set REMFILE1="remote.file1"
set REMFILE2="remote.file2"
set LOCFILE1="local.file1"
set LOCFILE2="local.file2"

# Get files
ftp -n ${REMDEST} <<EOF
user ${USER} ${PWD}
get ${REMFILE1} ${LOCFILE1}
put ${LOCFILE2} ${REMFILE2}
quit
EOF


---
