We are trying to archive our object files directly to a library 
without the intermediary objects. However, make seems to believe
the objects are "up to date" when there is nothing in the archive.


This problem started with OSF v2.0, everything was worked with OSF v1.3. 


Is there a patch for this? What about a patch listing?



Here is the output from make, you can see there is nothing in the library.
>make
`../lib/alpha/BasePDE.a' is up to date.
>ls -l ../lib/alpha/BasePDE.a
-rw-r--r--   1 scot     flooxs         8 Sep 20 13:38 ../lib/alpha/BasePDE.a


Here is the top of the makefile.
# %M% %I% %G% %U%
#
#
DEST=../lib/$(ARCH)/BasePDE.a
.PRECIOUS: $(DEST)
INCL = -I../include -I.. -I../mater -I../util -I../boundary -I../math
OPT = -O2

include ../arch/$(ARCH)

SRCS	= \
	pde.cc \
	Solution.cc \
	Params.cc \
	Interface.cc \
	Solver.cc \
	SolutionSeq.cc \
	SolutionID.cc \
	SolutionIDSeq.cc \
	ParamTable.cc \
	FiniteVol.cc
OBJS	= \
	$(DEST)(pde.o) \
	$(DEST)(Solution.o) \
	$(DEST)(SolutionSeq.o) \
	$(DEST)(Params.o) \
	$(DEST)(Interface.o) \
	$(DEST)(Solver.o) \
	$(DEST)(SolutionID.o) \
	$(DEST)(SolutionIDSeq.o) \
	$(DEST)(ParamTable.o) \
	$(DEST)(FiniteVol.o)

lib : $(DEST)

$(DEST)  : seqs $(OBJS) 
	ranlib $(DEST)

seqs : SolutionSeq.cc SolutionIDSeq.cc
	touch seqs

SolutionSeq.cc : ../template/Seq.ccP ../template/Seq.hP 
	../bin/genclass Solution ref Seq

SolutionIDSeq.cc : ../template/Seq.ccP ../template/Seq.hP 
	../bin/genclass SolutionID ref Seq

depend  : 
	sed '/^#LAST-HUMAN-LINE/q' Makefile > Makefile.new
	$(DEPEND) ${INCL} ${SRCS} | \
	    sed '/: \//'d | \
	    sed 's?.*\.o?$(DEST)(&)?' | \
	    sed 's?$(ARCH)?\$$(ARCH)?' > .depend
	cat Makefile.new .depend > Makefile
	
#LAST-HUMAN-LINE

