From -5912955166393019934
X-Google-Language: ENGLISH,ASCII-7-bit
X-Google-Thread: fee84,c9124124ecc8bdeb,start
X-Google-Attributes: gidfee84,public
From: jry@redtail.genetics.utah.edu (Jim Yehle - Leppert Lab)
Subject: xdm sessions at C2 security
Date: 1998/02/13
Message-ID: <6c2bn8$chh$1@coward.cc.utah.edu>#1/1
X-Deja-AN: 324865110
Summary: Script to allow XDM sessions under C2 on DigUnix 4.0
Organization: University of Utah Computer Center
Keywords: XDM C2 Digital 4.0
Newsgroups: comp.unix.osf.osf1


The FAQ writeup applies to 3.x, and it all changed in 4.x.

Try this script for OS v 4.x:

#!/usr/bin/sh
#
# xdm-c2.sh
#
# Add a terminal to XDM allowables list under C2 (enhanced security)

PATH=$PATH:/usr/tcb/bin; export PATH
echo -n "Enter name or IP address of trusted X host: > "
read host
#n just look 'em both up
#n if echo "$host" |egrep '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' >/dev/null
nslookup $host >/dev/null
EX=$?
if [ $EX != 0 ]; then
   echo "nslookup failed w/ exit status $EX"
   exit $EX
fi
qualhost=`nslookup $host |egrep '^Name:' |awk '{print $2}'`
lochost=`echo $qualhost |cut -d. -f1` # Chop off domain

echo "Attempting to add the following tty entry:"
edauth -g -d t local:0 |sed "s/local/$lochost/g"
edauth -g -d t local:0 |sed "s/local/$lochost/g" |edauth -d t -s -C

echo "Attempting to add the following devassign entry:"
echo "$lochost\:0:v_devs=$lochost\:0:v_type=xdisplay:chkent:"
echo "$lochost\:0:v_devs=$lochost\:0:v_type=xdisplay:chkent:" \
 |edauth -d v -s -C

echo -n "Allow logins as root from $lochost? "
read rootyesno
case _$rootyesno in
   _Yy*) 
      if egrep "^$lochost:0\$" >/dev/null; then
         echo Appending $lochost:0 to /etc/securettys
         echo $lochost:0 >>/etc/securettys
      fi
      if egrep "^$qualhost:0\$" >/dev/null; then
         echo Appending $qualhost:0 to /etc/securettys
         echo $qualhost:0 >>/etc/securettys
      fi
      ;;
   *)
      ;;
esac

--
Jim
