We use the following for /sbin/localinit.d/flexlm with the usual symlinks
from the rc[23].d directories to stop/start it:

------------------------------ cut here ------------------------------
#! /bin/sh
#
# turn on/off the Flex Licence Manager
#

RCMGR=/usr/sbin/rcmgr
LMGRD_PATH=`$RCMGR get LMGRD_PATH`
[ "$LMGRD_PATH" = "" ] && exit
LM_LICENSE_FILE=`$RCMGR get LM_LICENSE_FILE`
[ "$LM_LICENSE_FILE" = "" ] && exit

case "$1" in

'start')
        # start flexlm
        #
        echo Starting lmgrd
        (${LMGRD_PATH}/lmgrd -c ${LM_LICENSE_FILE} \
                -l /var/adm/lmgrd.log -2 -p &) &
        ;;
 
'stop') 
        # stop flexlm
        #
        ${LMGRD_PATH}/lmdown -c ${LM_LICENSE_FILE} -q &
        ;;

*)      
        echo "usage: $0 {start|stop}"
        ;;

esac

------------------------------ cut here ------------------------------

Then just make sure you do
    # rcmgr set LMGRD_PATH /usr/local/flexlm/licenses
    # rcmgr set LM_LICENSE_FILE /usr/local/flexlm/licenses/license.dat
or the equivalent for your directory structure.

