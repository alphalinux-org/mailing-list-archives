How about this c source, it works under OSF, (and ultrix if the host
name is under 16 chars long):
----------------------X cut X---------------------------------
#include <stdio.h>
#include <utmp.h>
#include <time.h>

#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>

#include <unistd.h>

#include <string.h>

#define FILE_NAME "/usr/adm/wtmp"
struct utmp utmp_s;

int main(argc, argv)
int argc;
char *argv[] ;
{
    int fd ;

    char *tty_name;
    char host_name[128] = "" ;

    if ( argc != 2 )
    {
        fprintf(stderr,"usage: %s `tty`\n",argv[0]);
        return 1 ;
    }

    tty_name=argv[1];

    if ( (fd=open(FILE_NAME,O_RDONLY )) < 0 )
    {
        perror("opening:%s",FILE_NAME);
        return 1 ;
    }

    while( read(fd,&utmp_s,sizeof(utmp_s)) == sizeof(utmp_s))
    {
        if( strlen(utmp_s.ut_line) && strstr(tty_name, utmp_s.ut_line))
            strcpy(host_name,utmp_s.ut_host);
    }

    if(strlen(host_name ))
        printf("%s\n",host_name);
    else
        printf("\n");
    close(fd);
return 0 ;
}
----------------------X cut X---------------------------------
--
