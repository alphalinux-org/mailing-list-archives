***************
*** 13,20 ****
  # for Xenix
  #CFLAGS = -O -M2e -DINT16 -DXENIX -DLOCKF
  #LDFLAGS = -s -M2e -i -f 5000
  
! CFLAGS	= -O -DSPARC -DBSD
  LDFLAGS	= -s
  LD	= $(CC)
  LINT	= lint
