: NOT call getty but instead interprete gettydefs itself.
: See getty(8), login(1) etc.


If you want to display a file during a telnet login, the following file
can help:



#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

#define ISSUE           "/etc/issue"

#ifdef __linux__
#  define TELNETD       "/usr/sbin/in.telnetd"
#elif defined (OSF1)
#  define TELNETD       "/usr/sbin/in.telnetd"
#endif

void main ( int argc, char **argv )
{
  FILE *Input;                          /* Issue file */
  char Buff;                            /* Character buffer */

  if ( (FILE *) NULL == ( Input = fopen ( ISSUE, "r" ) ) ) {
    fprintf ( stderr, "%s:  Unable to open %s\n", argv [0], ISSUE );
    exit ( 1 );
  }

  while ( fread ( &Buff, sizeof ( char ), 1, Input ) ) {
    if ( Buff != 0x0a )
      putchar ( Buff );

    else {
      putchar ( Buff );
      putchar ( 0x0d );
    }
  }

  fclose ( Input );

  if ( !fork () )
    execv ( TELNETD, argv );

  exit ( 0 );
}



Just change the definition of ISSUE to whatever you want to display,
compile, and change /etc/inetd.conf to reflect the new program to
use.  For example, I typically stick this program in /usr/sbin/tcpd-telnet
and then change the telnet line in /etc/inetd.conf to 

telnet  stream  tcp     nowait  root	/usr/sbin/tcpd-telnet   telnetd

This way, tcpd-telnet gets run first, outputs the issue message, then execs
telnetd.

