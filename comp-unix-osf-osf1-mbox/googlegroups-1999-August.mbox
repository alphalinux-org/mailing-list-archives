/********** test program **************/
/* cc test.c -o test -lXext -lX11     */

#include <stdio.h>
#include <X11/Xlib.h>


/*XTestQueryExtension*/

int main ( int argc, char** argv)
{

  Display *dpy;
  int minor;
  int major;
  int pixmap;
  int status;

  dpy = XOpenDisplay(":0.0");

  if (!dpy)
  {
