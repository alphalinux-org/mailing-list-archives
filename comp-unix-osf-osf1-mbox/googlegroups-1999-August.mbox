Try using the below script on the system servicing the printer.  The
client systems would remote print
the the host system.

-----begin script------
#!/usr/bin/ksh
# lpsif.sh 08-May-98
#
# This script eliminates the need for the user to use the lpspr command
in
# a printserver environment. After this script is installed the user
will
# be able to enter commands such as lpr -Pxxx -N2 file.
#
# This script calls the lpspr utility so it must be installed.
#
# Installing:
#
#       > cp lpsif.sh /usr/lbin
#       > chmod 755 /usr/lbin/lpsif.sh
#       > chown bin:bin /usr/lbin/lpsif.sh
#
# Printcap setup example:
#
#       Change the printcap entry from:
#
#               :if=/usr/opt/LPS/bin/lpsif:\
#
#       To:
#               :if=/usr/lbin/lpsif.sh:\
#

str1=""
space=" "

for OPT in $@
{
        case $OPT in
        -n*)
                ;;
        -h*)
                ;;
        -l*)
                ;;
        -Ktwo)
                str1=$str1$space-K2
                ;;
        -Kone)
                str1=$str1$space-K1
                ;;
        -*)
                str1=$str1$space$OPT
                ;;
        esac
}

/bin/cat | /usr/bin/lpspr $str1 | /usr/opt/LPS/bin/lpsif $@

--------end of script------
