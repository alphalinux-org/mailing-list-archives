Xint
XBytesInLoadStore(Inst* inst)
X{
X  union alpha_instruction bits;
X  int opcode;
X  unsigned long PC;
X
X  PC = InstPC(inst);
X  bits.word = GetInstBinary(PC);
X  opcode = bits.j_format.opcode;
X
X  switch( opcode ) {
X  case op_ldl:
X  case op_ldl_l:
X
X  case op_stl:
X  case op_stl_c:
X    return 4;
X
X    /*
X     * Floating point
X     * F = 4 bytes
X     * S = 4 bytes
X     * T = 8 bytes
X     * D = 8 bytes
X     * G = 8 bytes
X     */
X  case op_ldf:
X  case op_stf:
X
X  case op_lds:
X  case op_sts:
X
X    return 4;
X
X    /*
X     * eight byte load/store
