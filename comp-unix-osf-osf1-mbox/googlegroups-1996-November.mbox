X    const double min = 0.1;
X    double ual = ProgInfo.unaligned_loads;
X    double uas = ProgInfo.unaligned_stores;
X
X    *l = (ci -> loads / (double) ProgInfo.loads) * 100;
X
X    if ( ual > 0 ) {
