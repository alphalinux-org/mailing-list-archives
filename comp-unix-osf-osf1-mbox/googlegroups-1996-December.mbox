# get the logon to set the term type
        notvalid=0
        while [ $notvalid = 0 ]
        do        
           date
           echo "Please Logon to DEC Alpha - \007\c"
           read login
           case "$login" in
               NLG)  TERM=vt220; export TERM
                     notvalid=1;;
               LG)   TERM=vp; export TERM
                     notvalid=1;;
               PLG)  TERM=vwpt; export TERM
                     notvalid=1;;
               OFF)  exit;;
               EXIT) exit;;
               *)    echo  "Invalid Logon; 'OFF' or 'EXIT' to abort 
\007\c"
                     sleep 2;;
           esac
         done
         unset notvalid
