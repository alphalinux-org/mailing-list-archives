       char *format;
       arglist_dcl
  {
!   /* extern errorfn sprintf; */
    cp_thing (sprintf, 0, format, arglist);
  }
  
*** libg++-2.7.2/libg++/src/Regex.cc~orig	Mon Jun 17 17:30:25 1996
