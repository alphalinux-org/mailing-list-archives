		95) base=2840 ; id1=T;;
		96) base=2886 ; id1=U;;
		97) base=2932 ; id1=V;;
		98) base=2978 ; id1=W;;
		99) base=3024 ; id1=X;;
		100) base=3070 ; id1=Y;;
		101) base=3116 ; id1=Z;;
		*)
			echo MAKEDEV: bad pseudoterminal unit in: \
			     $fullname : 101 pseudoterminal devices maximum
			umask 77
			exit 1
		;;
		esac
		while test $base -le 800
		do
		if test $id2 -ge 10
		then
		    case $id2 in
		    10) id2l=a;; 
		    11) id2l=b;; 
		    12) id2l=c;; 
		    13) id2l=d;;
		    14) id2l=e;; 
		    15) id2l=f;;
		     *) break;;
		    esac
		else
		    id2l=$id2
		fi
		if test ! -c ./pty$id1$id2l ; then
		echo "pty"$id1$id2l" \c"; mknod pty$id1$id2l c \
					  $ptychr `expr $base + $id2`
		fi
		if test ! -c ./tty$id1$id2l ; then
		echo "tty"$id1$id2l" \c"; mknod tty$id1$id2l c \
					  $ttychr `expr $base + $id2`
		fi
		if test ! -c "pts/"`expr $base + $id2` ; then
		mknod "pts/"`expr  $base + $id2` c $ttychr `expr $base + $id2`
		fi 
		id2=`expr $id2 + 1`
		done
		while test $base -gt 800
		do
		    case $id2 in
		    0)  id2l=g;;
		    1)  id2l=h;;
		    2)  id2l=i;;
		    3)  id2l=j;;
		    4)  id2l=k;;
		    5)  id2l=l;;
		    6)  id2l=m;;
		    7)  id2l=n;;
		    8)  id2l=o;;
		    9)  id2l=p;;
		    10)  id2l=q;;
		    11)  id2l=r;;
		    12)  id2l=s;;
		    13)  id2l=t;;
		    14)  id2l=u;;
		    15)  id2l=v;;
		    16)  id2l=w;;
		    17)  id2l=x;;
		    18)  id2l=y;;
		    19)  id2l=z;;
		    20) id2l=A;; 
		    21) id2l=B;; 
		    22) id2l=C;; 
		    23) id2l=D;;
		    24) id2l=E;; 
		    25) id2l=F;; 
		    26) id2l=G;; 
		    27) id2l=H;; 
		    28) id2l=I;; 
		    29) id2l=J;; 
		    30) id2l=K;; 
		    31) id2l=L;; 
		    32) id2l=M;; 
		    33) id2l=N;; 
		    34) id2l=O;; 
		    35) id2l=P;; 
		    36) id2l=Q;; 
		    37) id2l=R;; 
		    38) id2l=S;; 
		    39) id2l=T;; 
		    40) id2l=U;; 
		    41) id2l=V;; 
		    42) id2l=W;; 
		    43) id2l=X;; 
		    44) id2l=Y;; 
		    45) id2l=Z;; 
	             *) break;;
		    esac
		    if test ! -c ./tty$id1$id2l ; then
		    echo "tty"$id1$id2l" \c"; mknod tty$id1$id2l c \
					  $ttychr `expr $base + $id2`
		    fi
		    if test ! -c "pts/"`expr $base + $id2` ; then
		    mknod "pts/"`expr  $base + $id2` c $ttychr `expr $base + $id2`
		    fi 
		    id2=`expr $id2 + 1`
		done
		umask 77
	;;
	pm)
		case $tryunit in
		0)
			test -c ./mouse ||
			{
				echo "mouse \c"
				mknod mouse c $chr `expr $base + 1`
			}
		;;
		*)
			echo MAKEDEV: bad pm unit in: $fullname
			umask 77
			exit 1
		;;
		esac
		umask 77
	;;
	lp)
		test -c ./lp0 ||
		{
			echo "lp0 "
			mknod lp0 c $chr 0
		}
	;;
	ace)  
		case $tryunit in
		0)
			test -c ./tty00 || 
			{	echo "tty00 \c"
				mknod tty00 c $chr $base
			}
			test -c ./tty01 ||
			{
				echo "tty01 \c"
				mknod tty01 c $chr `expr $base + 1`
			}				
		;;
		*)
                    if test $tryunit -ge 6
                    then
			echo MAKEDEV: bad tty unit in: $fullname
			umask 77
			exit 1
		    else
                        test -c ./tty0$tryunit ||
                        {
                        echo "tty0$tryunit \c"
                        mknod tty0$tryunit c $chr `expr $base + $tryunit`
                        }
                    fi
		;;
		esac
		umask 77

	;;
	dc|scc)  
		case $tryunit in
		0)
			test -c ./tty00 || 
			{	echo "tty00 \c"
				mknod tty00 c $chr `expr $base + 2`
			}
			test -c ./tty01 ||
			{
				echo "tty01 \c"
				mknod tty01 c $chr `expr $base + 3`
			}				
		;;
		*)
			echo MAKEDEV: bad tty unit in: $fullname
			umask 77
			exit 1
		;;
		esac
		umask 77
	;;
	cobtty)  
		test -c ./tty00 ||

		{	echo "tty00 \c"
			mknod tty00 c $chr $base 
		}
	;;
	mdc)
		case $tryunit in 
		0)
			umask 77
			mdclinenum=0;
			mdcones=0
			while test $mdclinenum -lt $linecnt
			do
				if test $mdcones -lt 10
				then 
					mdctens=0
				else
					mdctens=""
				fi
				test -c ./tty$mdctens$mdcones || {
				echo "tty"$mdctens$mdcones" \c"
				mknod tty$mdctens$mdcones c $chr $base
				}
				base=`expr $base + 1`
				mdcones=`expr $mdcones + 1`
				mdclinenum=`expr $mdclinenum + 1`
			done
		;;
		*)
			echo MAKEDEV: bad dc unit in: $fullname
			umask 77
			exit 1
		;;
		esac
		umask 77
	esac

;;
sysdev)
	case $tryunit in
	0)
		echo "sysdev0 \c "
		umask 33
		mknod sysdev0 c 15 0
	;;
	*)
		echo MAKEDEV: Support is only provided for sysdev0 unit 0: $fullname
		umask 77
		exit 1
	;;
	esac
;;
pr)
	case $tryunit in
	0)
		echo "pr0 \c "
		umask 33
		mknod pr0 c 22 0
	;;
	*)
		echo MAKEDEV: Support is only provided for pr unit 0: $fullname
		umask 77
		exit 1
	;;
	esac
;;
sec)
        for i in 0 1 2 3
        do
                test -c ./spd$i ||
                {
                        echo "spd"$i" \c"
                        mknod spd$i c 18 $i
                }
        done
        test -c ./spdcontrol ||
        {
                echo "spdcontrol \c"
                mknod spdcontrol c 18 255
        }
;;

kws|denali)
	tryname=`expr $fullname : ',*\(.[a-zA-Z\_]*\)'`
	case $tryname in
	kws_clean)
	    echo "removing kws_t_flash denali?_* \c"
	    rm -f /dev/kws_t_flash /dev/denali?_*
	    ;;
	kws_t_flash)
	    major=46 ; minor=0 ; prot=600 ; owner="root:system"
	    if test ! -c ./kws_t_flash
	    then
	    	echo "kws_t_flash \c" 
		mknod kws_t_flash c $major $minor
		chmod $prot kws_t_flash
		chown $owner kws_t_flash
	    fi
	    ;;
	kws_td|denali)
	    major=45 ; maxunits=8
	    if test -z "$tryunit"
	    then
		echo MAKEDEV: must specify unit for $tryname
	    elif test $tryunit -ge $maxunits 2>/dev/null
	    then
		echo MAKEDEV: bad unit in: \
		    $fullname : $maxunits devices maximum
	    else
		unit=$tryunit ; owner="root:system"
		case $unit in
		0) minor=0 ;;		1) minor=512 ;;
		2) minor=1024 ;;	3) minor=1536 ;;
		4) minor=2048 ;;	5) minor=2560 ;;
		6) minor=3072 ;;	7) minor=3584 ;;
		esac
		if test ! -c ./denali$unit"_0"
		then
		    prot=666 ; dbg=128 ; ctl=256
		    diags=257 ; dprot=600
		    echo "denali"$unit"_0 \c"
		    mknod denali${unit}_0 c $major $minor
		    chmod $prot ./denali${unit}_0
		    chown $owner ./denali${unit}_0
		    echo "denali"$unit"_ctl \c"
		    mknod denali${unit}_ctl c $major \
			`expr $minor + $ctl`
		    chmod $prot ./denali${unit}_ctl
		    chown $owner ./denali${unit}_ctl
		    echo "denali"$unit"_diags \c"
		    mknod denali${unit}_diags c $major \
			`expr $minor + $diags`
		    chmod $dprot ./denali${unit}_diags
		    chown $owner ./denali${unit}_diags
		    if test ! -c ./kws_t_flash
		    then
			echo "kws_t_flash \c"
			mknod kws_t_flash c `expr $major + 1` 0
			chmod $dprot kws_t_flash
			chown $owner kws_t_flash
		    fi
		    echo ""
		    for k in 0 1 2 3 4 5
		    do
			echo "denali"$unit"_dbg"$k" \c"
			mknod denali${unit}_dbg$k c $major \
				`expr $minor + $dbg + $k`
			chmod $prot ./denali${unit}_dbg$k
			chown $owner ./denali${unit}_dbg$k
		    done
		fi
	    fi
	    ;;
	*)
	    echo MAKEDEV: unknown device in: $fullname
	    exit 1
	    ;;
	esac
;;

msb)
        umask 111
        test -c ./msb$tryunit ||
        {
               echo "msb"$tryunit" \c"
               mknod msb$tryunit c 36 $tryunit
        }
        umask 77
;;

local)
	echo MAKEDEV: attempting to execute /dev/MAKEDEV.local:
	/sbin/sh /dev/MAKEDEV.local $fullname
;;

atm)
	mknod atm_cmm c 47 0
	chmod 600 atm_cmm
	echo "atm_cmm \c"
;;

*)
	echo MAKEDEV: unknown device in: $fullname
	exit 1
;;
esac
if test "X$silent" = "X" ; then
echo ""
fi
done
exit

