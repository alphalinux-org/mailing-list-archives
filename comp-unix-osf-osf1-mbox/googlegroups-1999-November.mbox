Note that inet_addr("127.0.0.1") returns a integer ALREADY
in network order so you should not touch it before assigning
it to addr_in.sin_addr. Thus I suggest:

	(no numeric_addr variable)
	addr_in.sin_addr.s_addr = inet_addr("127.0.0.1");

gg
ps: inet_addr() is deprecated, it is better to use inet_aton().

kr wrote:
> ......
> 
>   in_addr numeric_addr; struct sockaddr_in addr_in;
> ......
> 
>   if ((in_port=socket(AF_INET,SOCK_STREAM,0)) < 0) {
>      perror("socket"); exit(EXIT_FAILURE);
>   }
> 
>   numeric_addr.s_addr=htonl(inet_addr("127.0.0.1"));
> 
>   addr_in.sin_port = 1039;  /* for example */
>   addr_in.sin_family = PF_INET;
>   addr_in.sin_addr = numeric_addr;
> 
>   if ( bind(in_port,(struct sockaddr *) & addr_in,sizeof(addr_in)) < 0) {
>      perror("bind"); exit(EXIT_FAILURE);  /* and voila! failure occurs. */
>   }
> ......
> 

