Here is what finally made nn-6.4.18 run happily on our Alphas. 

Thanks to Klas Mellbourn <kam@vanosf.physto.se>, who answered my request
to the alpha-osf-managers@ornl.gov mailing list. 

>=========== m-decaxp.h ==============
/******* Machine (and compiler) dependent definitions. *********
 *
 *      This is the nn conf file:       m-decaxp.h
 *      For Digital Equipment Corp.:    Alpha AXP computers
 *
 *      Created by:     Donald S. Teiser        09/21/93
 *                      System Programmer
 *                      University of Louisville
 *                      Louisville, KY, USA  40292
 *                      dsteis01@homer.louisville.edu
 ***************************************************************/
/*      MACHINE TYPE    DEFINED TYPE            VALUE RANGE    */

typedef unsigned char   int8;           /*        0 ..     255 */
typedef short int       int16;          /*  -10,000 ..  10,000 */
typedef int             int32;          /* -100,000 .. 100,000 */
typedef unsigned int    uint32;         /*        0 ..  2^31-1 */

/* Here comes Sebastian Meyer's code: meyer@sirius.physik.fu-berlin.de */

#ifdef NETWORK_DATABASE
#ifndef NETWORK_BYTE_ORDER
/*
 * Alpha is NOT network-byte-order
 */                                                                             
#include <netinet/in.h>
/* 
 * This one includes <machine/endian.h>
 * which has the #defines for  ntohl(x) and htonl(x)
 */
#endif  /* not NETWORK BYTE ORDER */
#endif  /* NETWORK DATABASE */
/*********** end of the file: m-decaxp.h ****************/


============== s-decosf.h =================
/*********** Operating system dependent definitions. ***********
 *
 *      This is the nn conf file:       s-decosf.h
 *      For Digital Equipment Corp.:    OSF/1 version 1.3
 *
 * Created by Sebastian Meyer <meyer@sirius.physik.fu-berlin.de>,
 * according to Klas Mellbourn <kam@vanosf.physto.se>
 ***************************************************************/

#include "s-sys5-tcap.h"

#define EXTRA_LIB -lbsd

/*********** end of the file: s-decosf.h ****************/

