***************
*** 141,147 ****
  #define Sign_Extend(a,b) /*no-op*/
  #endif
  
! #if defined(__i386__) || defined(clipper) || defined(MIPSEL)
  #define IEEE_8087
  #endif
  
--- 141,147 ----
  #define Sign_Extend(a,b) /*no-op*/
  #endif
  
! #if defined(__i386__) || defined(clipper) || defined(MIPSEL) || defined(__alpha)
  #define IEEE_8087
  #endif
  
2. configure dec-alpha-osf

3. make

This was for gcc 2.5.4 and libg++-2.5.1 on DEC OSF/1 V1.3.

