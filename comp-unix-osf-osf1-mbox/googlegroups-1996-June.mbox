: Is there anyone out there who can give me a sample scipt for rc3.d to
: start httpd at startup???

#!/sbin/sh
#
# Very simple /sbin/init.d script to fire off an HTTP Daemon
# Must be modified for site specific use.  No animals used in
# testing.  Should not hurt small children.  Keep out of reach
# of small animals.
@

PATH=/sbin:/usr/sbin:/usr/bin
export PATH

WWWHOME=/home/www

case "$1" in
'start')
        set `who -r`
        if [ $9 = "S" ]; then
                if /home/www/httpd -f $WWWHOME/conf/httpd.conf; then
                        echo "HTTP daemon started"
                fi
        fi
        ;;
'stop')
                kill -TERM `cat $WWWHOME/logs/httpd.pid`
        ;;
*)
        echo "usage: $0 {start|stop}"
        ;;
esac



