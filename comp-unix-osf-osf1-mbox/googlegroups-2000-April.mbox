#!/bin/tcsh -f
# Test network connectivity

# INITIAL HOUSEKEEPING

cd /usr/local/adm/gccscripts
set path=(/etc /bin /sbin /usr/sbin)

# TEST SYSTEMS (as per list in file pingtest.data

set syslist = ` awk '{print $1}' pingtest.data | grep -v "^#" | sed '/^$/d' `
foreach system ($syslist)
   clear
   /bin/echo "\nPINGTEST = $system\n"
   ping -c3 $system
   /bin/echo "\nPINGTEST = completed ($system)"
   sleep 2
end

exit
--------------------

The pingtest.data file simply lists the machines that you want tested.
