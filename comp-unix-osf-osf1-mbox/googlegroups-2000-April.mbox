        :af=/usr/adm/lp4acct:\
        :ct=tcp:\
        :if=/usr/lbin/hplaser4psof:\
        :lf=/usr/adm/lp4err:\
        :lp=@shiro/inpon_9100:\
        :sh:\
        :of=/usr/lbin/hplaser4psof:\
        :rw:\
        :sd=/usr/spool/lpd4:\
        :xf=/usr/lbin/xf:

#> grep 9100 /etc/services
inpon_9100      9100/tcp 	# every network printer will use this entry

