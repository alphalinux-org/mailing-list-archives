Hello. Apparently OSF/1 uses different fields in the statfs() structure.
Please apply the following patch.

*** applications/aufs/afpos.c.orig 1994/01/15 01:07:52
--- applications/aufs/afpos.c      1994/01/15 01:08:51
***************
*** 2391,2397 ****
    }
  # else  /* sgi || apollo */
    if (statfs(path, &fsbuf) >= 0) {
! #ifdef __386BSD__
      /*
       * on 386/BSD, the block size is in f_fsize
       * and f_bsize is the optimum transfer size
--- 2391,2397 ----
    }
  # else  /* sgi || apollo */
    if (statfs(path, &fsbuf) >= 0) {
! #if defined(__386BSD__) || defined(__osf__)
      /*
       * on 386/BSD, the block size is in f_fsize
       * and f_bsize is the optimum transfer size

