/* c89 -DL1 -DL2 -DBIGNUM=<something large> */

main (int ac, char **av)
{
        switch (ac) {
#ifdef L1
                case -1:
                        break;
#endif
#ifdef L2
                case 1:
                        break;
#endif
#ifdef BIGNUM
