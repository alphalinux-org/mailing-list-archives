-DBOOLEANS -DPARTIALWORD -DLITERAL 
---
> CFLAGS = -O -taso -I$(SUPDIR) -DSECURE_SERVER -DRELEVANCE_FEEDBACK -DUSG -DBOOLEANS -DPARTIALWORD -DLITERAL -DAXP
---
diff -r orig/freeWAIS-0.202/ir/cdialect.h freeWAIS-0.202/ir/cdialect.h
28a29,32
> #ifdef AXP /* for 64 bits alpha risc processor */
> #define ANSI_LIKE
> #endif /* def AXP */
