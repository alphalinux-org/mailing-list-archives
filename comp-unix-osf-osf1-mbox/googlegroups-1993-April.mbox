Eg:
/* Print out the Load Average so people can guess how long it will take */
void PrintLoadAvg()
{
  struct tbl_loadavg LoadAvg;

  if (table(TBL_LOADAVG, 0, &LoadAvg, 1, sizeof(LoadAvg)) < 1) {
    fprintf(stderr, "Mach Factor & Load Average unavailible.\n");
  } else {
    printf("Mach Factor:  %3u.000\b\b\b%3u, %3u.000\b\b\b%3u, %3u.000\b\b\b%3u\n",
           LoadAvg.tl_mach_factor[0] / LoadAvg.tl_lscale,
           LoadAvg.tl_mach_factor[0] % LoadAvg.tl_lscale,
           LoadAvg.tl_mach_factor[1] / LoadAvg.tl_lscale,
           LoadAvg.tl_mach_factor[1] % LoadAvg.tl_lscale,
           LoadAvg.tl_mach_factor[2] / LoadAvg.tl_lscale,
           LoadAvg.tl_mach_factor[2] % LoadAvg.tl_lscale);
    if (LoadAvg.tl_lscale == 0) {
      printf("Load Average: %6.3f, %6.3f, %6.3f\n", LoadAvg.tl_avenrun.d[0],
             LoadAvg.tl_avenrun.d[1], LoadAvg.tl_avenrun.d[2]);
    } else {
      printf("Load Average: %3u.000\b\b\b%3u, %3u.000\b\b\b%3u, %3u.000\b\b\b%3u\n",
             LoadAvg.tl_avenrun.l[0] / LoadAvg.tl_lscale,
