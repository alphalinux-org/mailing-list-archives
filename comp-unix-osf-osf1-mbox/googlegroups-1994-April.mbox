 */

#include <stdio.h>
#include <X11/X.h>
#include <X11/Xlib.h>
#include <phigs.h>
#include <phigs_msgs.h>

/* Definitions of some unique integers */
#define WSID 1
#define DEV1 1
#define DEV6 6
#define DEV7 7
#define DEV8 8
#define EXIT 5
#define ODDMARK  1
#define EVENMARK 2
#define ODDROW   3
#define EVENROW  4
#define TOP      5
