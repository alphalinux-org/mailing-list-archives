}



/*
 * This routine creates a hierarchical structure network that
 * generates a picture consisting of a 9x9 array of point markers.  
 * Each of the markers is generated by one of two bottom level structures,
 * ODDMARK and EVENMARK, each containing one single-element polymarker
 * primitive.  Note that in modeling coordinates, both ODDMARK and EVENMARK
 * generate the same marker.  The only difference between these structures
 * is in the PICKID, which has no effect on the picture.
 * 
 * The second level structures are ODDROW and EVENROW.  These differ
 * in the nameset attribute, but are otherwise the same.  Each
 * produces the same row of markers along the MC x-axis by repeated
 * execution of the bottom level structures, with appropriate local
 * modeling translations, alternating between the ODDMARK AND EVENMAR
 * first level structures for the odd columns and even columns.
 *
 * The top level structure has 9 rows, each obtained by translating
 * one of the second level structures by unique distance in the y
 * direction, alternating between OODROW and EVENROW for the odd and
 * even rows.  Note that the TOP structure does not set the NAMESET,
 * so at traversal time the NAMESET is by default empty, except when
 * executing one of the second level structures or their children;
 * that is the contents of the NAMESET attribute varies between ODDROW
 * and EVENROW depending on the row.
 */

dostruct() 
{
       int      i;
       int      xerror;
static Ppoint3  pt = {0.0,0.0,0.0};
static Pvector3 displace = {0.0,0.0,0.5};
       Pmatrix3 xform;
       Pint     rownames[2];
static Pintlst  rownamelist = {0,0};
       int view_ind=1;

    rownamelist.integers = rownames;

  /* Bottom level structures */

    popenstruct( ODDMARK );
    psetpickid( ODDMARK );
    ppolymarker3( 1, &pt );
    pclosestruct();

    popenstruct( EVENMARK );
    psetpickid( EVENMARK );
    ppolymarker3( 1, &pt );
    pclosestruct();

  /* Second level structures */
    popenstruct( ODDROW );

  /* Odd rows have unique nameset */
    rownames[0] = ODDROW;
    rownamelist.number = 1;

    paddnameset( &rownamelist );
    ppsetpickhighlightindex ( 1 );
    for( i = 1; i < 10; i++) 
        {
        displace.x = i*0.1;
        ptranslate3( &displace, &xerror, xform );
        psetlocaltran3( xform, PREPLACE );
        pexecutestruct( i%2 ? ODDMARK : EVENMARK );
        };
    premovenameset( &rownamelist );
    pclosestruct();
    popenstruct( EVENROW );

  /* Even rows have a unique nameset */
    rownames[0] = EVENROW;
    rownamelist.number = 1;

    paddnameset( &rownamelist );
    ppsetpickhighlightindex ( 2 );
    for( i = 1; i < 10; i++) 
        {
        displace.x = i*0.1;
        ptranslate3( &displace, &xerror, xform );
        psetlocaltran3( xform, PREPLACE );
        pexecutestruct( i%2 ? ODDMARK : EVENMARK );
        };
    pclosestruct();


 /* Root structure */
    displace.x = 0.0;
  popenstruct( TOP );
    plabel(VIEWLABEL);
    for( i = 1; i < 10; i++) 
        {
        displace.y = i*0.1;
        ptranslate3( &displace, &xerror, xform );
        psetglobaltran3( xform );
        pexecutestruct( i%2 ? ODDROW : EVENROW );
        };
     pexecutestruct(SQUARE);

   pclosestruct();
   ppoststruct( WSID, TOP, 1.0 );
   pupdatews( WSID, PPERFORM );
   return 1;
}





