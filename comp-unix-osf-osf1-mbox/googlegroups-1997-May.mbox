> Here is program, and the outputs it gives when compiled with before
> mentioned compilers:
> 
> #include <iostream.h>
> 
> class exp {
> public:
>   exp(int x);
>   ~exp();
>   int i;
> };
> 
> exp::exp(int x) {
>    cout << "Constructor exp(" << x << ")\n";
>    i = x;
> }
> 
> exp::~exp() {
>    cout << "Destructor ~exp()\n";
> }
> 
> main() {
>   try {
>     cout << "Throwing exception\n";
>     throw exp(1);
>   } catch (exp a) {
>     cout << "Catched exp(" << a.i << ")\n";
>   }
>   cout << "Exiting\n";
> }
> 

Not sure why they are giving such different results.  A copy of the
thrown exp is getting created.  If you add a copy constructor for
exp and put some debug code there, you may be able to see what is
going on.

   exp( const exp& copy )
   {
      // Perform the copy
      i = copy.i;

      cout << "Copy constructor" << endl;
   }

Also, you should probably not catch by value.  Try catching by
reference instead:

 main() {
   try {
     cout << "Throwing exception\n";
     throw exp(1);
   } catch (exp& a) {
     cout << "Catched exp(" << a.i << ")\n";
   }
   cout << "Exiting\n";
 }

-Allen

