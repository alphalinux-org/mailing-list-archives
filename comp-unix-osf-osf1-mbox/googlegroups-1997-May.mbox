#ifndef _NODE_C

    template<class U>
    U& NetProtocol<class U>::
    operator=(const U& that) {
        this->IPsocket    = that->IPsocket;
        this->error_pbstr = that->error_pbstr;
        this->accepted    = that->accepted;
        memcpy(&(that->ouraddr), &(this->ouraddr),sizeof(struct addrINFO));
    }

    // default constructor
    template<class U>
    NetProtocol<class U>::
    NetProtocol() {
        this->IPsocket=0;       // invalid descriptor
        this->error_pbstr=0;    // no error string
        this->accepted=false;   // this descriptor has not accepted a connection
    }

    //
    //  This definition necessary for container class definition
    //  This is the sole comparison operator used by the STL
    //  Equality check by a<b && b<a both proving false
    //  Not provided by the compiler.
    template<class U>
    bool NetProtocol<class U>::
      operator<(const U& that) {
        return (this->IPsocket < that->IPsocket);
    }

    // equality test between instances --NOT needed by STL
    template<class U>
    bool NetProtocol<class U>::
        operator==(const U& that) {
        return (this->IPsocket == that->IPsocket);
    }

    // copy constructor 
    template<class U>
    NetProtocol<class U>::
    NetProtocol(NetProtocol<class U> &old) {
        this->IPsocket    = old.IPsocket;   // should this be dup() ?
        this->error_pbstr = old.error_pbstr;
        this->accepted    = old.accepted;
    }

    // Default template destructor
    template<class U>
      NetProtocol<class U>::
     ~NetProtocol() {

        // handle an error string attachment
       if (error_pbstr)
           delete error_pbstr;
    }


    // start of user functions

    // test to see if this server connection has accepted a client's 
    // connection attempt
    template<U>
    bool NetProtocol<U>::
    jProto_is_accepted() { return accepted; }  // simply return the variable 4 now

    // record that this server endpoint has accepted a client connect attempt
    template<class U>
    void NetProtocol<class U>::
     jProto_set_accepted(bool state) 
           { accepted = state; }


    // set the error string when an error is detected with this descriptor
    template<U>
    void NetProtocol<class U>::
    jProto_set_error_string(bstring& error_) {
       error_pbstr=new bstring(error_); // make a copy of the bstring passed in
       this->IPsocket=0;                // invalidate descriptor
    }

    // set the native descriptor -- this will probably be 
    // moved to protected status
    template<U>
    void NetProtocol<class U>::
    jProto_set_native(U socketno) {
        this->IPsocket=socketno;
        
    }

    // return the native descriptor -- this will probably be 
    // moved to protected status
     template<class U>
    U NetProtocol<class U>::
    jProto_get_native() { return (T)IPsocket; };

    // return true if the descriptor is valid (nocalls to set_error_string())
    // against it
    template<class U>
    bool NetProtocol<class U>::jProto_get_status() {
        if (IPsocket==0)
           return false;
        else
           return true;
    }

    // define a default semantics for a derived class
    template<class U>
    bool NetProtocol<class U>::jProto_iocntrl(unsigned int opcode) {
        switch (opcode) {
         case jIsEOFvalid: return false;   // semantics of stream object
         case jHitEOF:     return false;
         default     :     return false;
        };
    }

    // return the error string if the descriptor is invalid
    // if descriptor is valid it returns a bstring of ""
    template<class U>
    bstring &NetProtocol<class U>::
     jProto_get_error() {
       bstring *dflt_pbstr;

       // check if descriptor is valid-- which could be anything...
       if (this->jProto_get_status()==false && this->error_pbstr !=NULL)
          return(*error_pbstr);
       else {
          dflt_pbstr=new bstring("");
          return *dflt_pbstr;
       }
    }
#define _NODE_C
#endif

