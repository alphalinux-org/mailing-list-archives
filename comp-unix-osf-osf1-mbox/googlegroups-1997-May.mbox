Aleksandar Milivojevic wrote:
> 
> I would like to know when the destructor for thrown object is called.  I
> expected that it is called only one time (and not two or three times)
> after the catch block is executed.  So in order to check that, I wrote
> a simple program and it gave me three different outputs when compiled
> with Sun CC, DEC cxx and GNU g++ (last gave me internal compiler
> error, but when I commented last line of main() it compiled OK).
> 
> Now, Am I doing something totaly wrong, or that three compilers
> generate incorect code (and which one generated correct code, if any)?

Try this version with "noisy" copy constructor and assignment operator.

#include <iostream.h>

class exp {
  public:
    exp( int x ) : i( x ) {
      cout << "ctor -- " << *this << endl; }

    ~exp() {
      cout << "dtor -- " << *this << endl; }

    exp( const exp& e ) : i( e.i ) {
      cout << "copy ctor -- " << *this << " from " << e << endl; }

    exp& operator=( const exp& e ) {
      cout << "assignment " << *this << " = " << e << endl;
      if( &e != this )
        i = e.i;
      return *this; }

    friend ostream& operator<<( ostream& o, const exp& e ) {
      return o << "exp{" << e.i << "} at: " << &e; }

  private:
    int i;
};

main() {
  try {
    cout << "Throwing exception\n";
    throw exp(1);
  } catch (exp a) {
    cout << "Caught " << a << endl;
  }
  cout << "Exiting\n";
}


When compiled with xlC on AIX I get:


~> a.out
Throwing exception
ctor -- exp{1} at: 0x2ff220f0
copy ctor -- exp{1} at: 0x2ff220f8 from exp{1} at: 0x2ff220f0
Caught exp{1} at: 0x2ff220f8
dtor -- exp{1} at: 0x2ff220f8
dtor -- exp{1} at: 0x2ff220f0
Exiting
~> 


