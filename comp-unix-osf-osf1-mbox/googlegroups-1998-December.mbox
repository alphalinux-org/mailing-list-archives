You can start this script with cron. 

#!/bin/ksh
{
 echo "------------- `date` --"
 ftp -i -v -n ftp.xxxx.com  <<!
  user anonymous myaddres
  bin
  get /pub/filename
  bye
!
 echo "-------------- `date` --"
} > /tmp/mydownload.log 2>&1
# EOF

Regards, Urban         



