Go get ftp.cac.washington.edu:/pine/pine.tar.Z

zcat pine.tar.Z | tar xf -

cd pine3.91/pine

patch <patchfile (included below)

cd ..

/bin/sh build osf

cp imap/ipopd/ipop3d /usr/local/etc

* add to /etc/services:

pop3	110/tcp

* add to /etc/inetd.conf

pop3	stream	tcp	nowait	root	/usr/local/etc/ipop3d	ipop3d

* send a SIGHUP to inetd

ps -ef | grep inetd

kill -HUP (inetd's pid)

DONE!  (If you are smart, you will put ipop3d under tcp_wrapper.)


