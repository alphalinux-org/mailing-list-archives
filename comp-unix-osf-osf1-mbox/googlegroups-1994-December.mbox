(617) 332-1675 (fax)
gbcacm@ccs.neu.edu
-----------------------------------------------------------------------------

void r(unsigned long n);

int main(void) {
unsigned long n;
r(n);

return 0;
}

void r(unsigned long n) {
unsigned long b[2000000];

return;
}


