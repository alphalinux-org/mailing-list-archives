#include <pthread.h>

/* ------------------------------------------------------------- */
pthread_mutex_t mutex;
pthread_mutexattr_t mutex_attr; 

static void *thread_go(void *arg)
{
  pthread_mutex_lock(&mutex); 
}

/* ------------------------------------------------------------- */

int main()
{
  pthread_t thread;
  pthread_attr_t attr; 

  pthread_mutexattr_create(&mutex_attr);
  pthread_mutex_init(&mutex, mutex_attr);
  pthread_mutexattr_setkind_np(&mutex_attr, MUTEX_FAST_NP);

  pthread_mutex_lock(&mutex); 
  pthread_create(&thread, pthread_attr_default, thread_go, NULL);
  
  pthread_mutex_lock(&mutex); 
}

