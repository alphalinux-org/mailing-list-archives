Here is a simple shell script version of dos2unix. It doesn't preserve
permissions though:

#! /bin/ksh
# convert dos files to Unix by removing carriage returns.
for f in $@
do
        tr -d '\015' <$f >${f}+ && mv -i $f ${f}~ && mv -i ${f}+ $f
done


