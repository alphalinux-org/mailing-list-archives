Content-Type: text/plain; charset=us-ascii; name="eth_addr.c"
Content-Transfer-Encoding: 7bit
Content-Disposition: inline; filename="eth_addr.c"

/*
 * eth_addr - print the ethernet address of a given interface
 *
 * Author: Jay Olson, Triton Software Group Ltd. (15-Aug-1997)
 *
 * usage:	eth_addr interface
 *
 * $Log$
 */
#include <stdio.h>
#include <ctype.h>
#include <errno.h>
#include <strings.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <net/if.h>
#include <netinet/in.h>
#include <netinet/if_ether.h>
#include <dli/dli_var.h>
#include <sys/ioctl.h>

static char rcsid[] = "$Id$";

int main (int argc, char **argv)
{
   int fd; 
   struct sockaddr_dl out_bind;
   struct ifdevea devea;

   if (argc <= 1) {
      fprintf(stderr, "usage: eth_addr interface\n");
      exit(22);
   }

/*
 *  Create a DLI socket.
 */
   if ((fd = socket(AF_DLI, SOCK_DGRAM, DLPROTO_DLI)) < 0) {
      fprintf(stderr, "eth_addr: can't open DLI socket\n");
      perror("eth_addr");
      exit(errno);
   }
    
/*
 *  Print physical address.
 */
   strcpy(devea.ifr_name,argv[1]);
   if (ioctl(fd,SIOCRPHYSADDR,&devea) < 0) {
      fprintf(stderr,"eth_addr: can't determine address for %s\n",
              devea.ifr_name);
      perror("eth_addr");
   }
   else {
      fprintf(stderr,"eth_addr: address for %s is %0.2X-%0.2X-%0.2X-%0.2X-%0.2X-%0.2X\n",
              argv[1],
              devea.current_pa[0], devea.current_pa[1],
              devea.current_pa[2], devea.current_pa[3],
              devea.current_pa[4], devea.current_pa[5]);
   }
}

--------------2781446B794B--




