|>DECnet/OSI tools?  I tried what would be obvious to a VMS-speaking user (like
|>me ;-):

You'll need to write a small program to do this.  

#include <stdio.h>
#include <errno.h>
#include <string.h>
#include <sys/types.h>
#include <sys/socket.h>
#ifdef DNA
#include <netosi/dna.h>
#else
#include <netdnet/dn.h>
#endif
#include <sysexits.h>

char buf[256];

#ifndef DEFAULT_OBJECT
#define DEFAULT_OBJECT "FOO"
#endif

main(argc, argv)
    int argc;
    char *argv[];
{
#ifdef DNA
    DnaError_t err;
    DnaArgument_p args;
#else
    int fd;
#endif
    int len;
    char *cp;
    if (cp = strrchr(argv[0],'/'))
	cp++;
    else
	cp = argv[0];

    if (argc != 2 && argc != 3) {
	fprintf(stderr, "usage: %s nodename [object]\n", cp);
	exit(EX_USAGE);
    }

#ifdef DNA
    args = dnaNewArg();

    args->DnaArgStrNodename = argv[1];
    args->DnaArgStrDestEnduser = (argc == 3 ? argv[2] : DEFAULT_OBJECT);

    if (!dnaConnectNodename(args)) {
	args->DnaArgExtraText = argv[1];
	dnaPerror(args);
	exit(EX_UNAVAILABLE);
    }
    while( (len = read(args->DnaArgPort, buf, sizeof(buf))) >= 0 ) {
	if (len == 0 && dnaEof(args))
	    break;
	buf[len] = '\0';
	puts(buf);
    }
    dnaClosePort(args);
#else
    fd = dnet_conn(argv[1], (argc == 3 ? argv[2] : DEFAULT_OBJECT), SOCK_SEQPACKET, NULL, 0, NULL, NULL);
    if( fd < 0 ) {
	nerror(argv[1]);
	exit(EX_UNAVAILABLE);
    }
    while( (len = read(fd, buf, sizeof(buf))) >= 0 ) {
	if (len == 0 && dnet_eof(fd))
	    break;
	buf[len] = '\0';
	puts(buf);
    }
    close(fd);
#endif

    exit(EX_OK);
}


