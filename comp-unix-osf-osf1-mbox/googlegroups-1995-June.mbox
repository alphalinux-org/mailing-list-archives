Here's a program I wrote when I was looking into this.  The ioctl calls are
actually documented in the man pages.

# include <stdio.h>
# include <errno.h>
# include <sys/types.h>
# include <sys/socket.h>
# include <sys/ioctl.h>
# include <net/if.h>

main()
{
	int sa, i;
	struct ifdevea devea;

	sa = socket(AF_INET, SOCK_DGRAM, 0);
	if (sa < 0)
	{
		perror("socket");
		exit(1);
	}
	strcpy(devea.ifr_name, "ln0");
	if (ioctl(sa, SIOCRPHYSADDR,&devea) < 0)
	{
		perror(&devea.ifr_name[0]);
		exit(1);
	}
	printf("Address is ");
	for (i = 0; i < 6; i++)
	{
		printf("%X", (devea.default_pa[i]>>4) & 0xF);
		printf("%X", devea.default_pa[i] & 0xF);
		if (i<5) 
			printf("-");
	}
	printf("\n");
	close(sa);
}



