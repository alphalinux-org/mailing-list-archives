>

It is explained in the HS array manual but here is a simple little script
I wrote to do it as it is much easier than typing it all by hand!

#!/bin/sh
#
# make devices for HSZ40 served disks -- MAKEDEV will not do this
#
# usage hsz bus# target# lun#
#
# Nick Hill RAL 24/11/94
#
usage_error() {
 echo "Usage: $me bus target lun" >&2
 exit 1
}

PATH=/sbin:/usr/sbin:/usr/bin:$PATH
export PATH
me=`basename $0`
[ $# -lt 3 ] && usage_error

echo "bus is $1" >&2
echo "target is $2" >&2
echo "lun is $3" >&2
bname="/dev/rz`expr $1 '*' 8 + $2`$3"
cname="/dev/rrz`expr $1 '*' 8 + $2`$3"
minor=`expr $1 '*' 16384 + $2 '*' 1024 + $3 '*' 64`
echo "bname is $bname"
echo "minor is $minor"


echo "Make HSZ40 devices for $bname and $cname"

for partlet in a b c d e f g h
do
echo "mknod $bname$partlet b 8 $minor"
mknod $bname$partlet b 8 $minor
echo "mknod $cname$partlet c 8 $minor"
mknod $cname$partlet c 8 $minor
minor=`expr $minor + 1`
done
exit 1

-
Nick Hill

