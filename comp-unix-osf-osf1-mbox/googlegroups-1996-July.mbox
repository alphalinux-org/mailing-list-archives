I encountered this problem.  In gcc-2.7.2/cp/errfn.c, I changed:

    void
    cp_sprintf (format, arglist)
	 char *format;
	 arglist_dcl
    {
      extern errorfn sprintf;
      cp_thing (sprintf, 0, format, arglist);
    }

to


    void
    cp_sprintf (format, arglist)
	 char *format;
	 arglist_dcl
    {
      cp_thing ((errorfn*)sprintf, 0, format, arglist);
    }




There is one other change I made for Digital Unix 4.0, because the
assembler no longer accepts the five number version directive.  In
gcc-2.7.2/config/alpha/alpha.c, I modified alpha_write_verstamp


    void
    alpha_write_verstamp (file)
	 FILE *file;
    {
    #ifdef MS_STAMP
      char *p;

      fprintf (file, "\t.verstamp %d %d ", MS_STAMP, LS_STAMP);
    #if 0 /* not on Digital Unix 4.0 - Jamey Hicks 7/3/96 */
      for (p = version_string; *p != ' ' && *p != 0; p++)
	fprintf (file, "%c", *p == '.' ? ' ' : *p);
    #endif
      fprintf (file, "\n");
    #endif
    }



-Jamey Hicks



