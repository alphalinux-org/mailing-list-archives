#
# Simple example of how to build a shared library on Digital UNIX(tm).
# Written by: Timothy J. Lucia, lucia@zko.dec.com
#

DEBUGFLAGS	= -g -O0
CCFLAGS		= $(DEBUGFLAGS)
CC		= cc $(CCFLAGS)
LDFLAGS		= $(DEBUGFLAGS)
LD		= ld $(LDFLAGS)
RM		= rm -f

all:	main library.so

main:	main.o library.so
	$(CC) -o main main.o library.so

main.o:	main.c
	$(CC) -c main.c

library.so:	library.o
	$(LD) -shared -o library.so library.o -lc

library.o:	library.c
	$(CC) -c library.c

clean:
	$(RM) main library main.o library.o library.so so_locations


































