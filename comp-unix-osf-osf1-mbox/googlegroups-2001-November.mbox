after reading
http://isisesc.supelec.fr/list-tru64/archive/August2000/0355.html
about
vipw: you mangled the temp file, /etc/passwd unchanged
errors,

I have written the following replacement for vipw.

What other checks should it do on the password file?



#!/usr/local/bin/perl

=pod

perl vipw

copyright 2002 UMKC (David Nicol)
released as public domain utility

=cut

$pid = $$;
system "cp /etc/passwd /etc/ptmp.$pid";

EDIT:

fork or exec "vi /etc/ptmp.$pid";

wait;

eval {
open CHECK, "</etc/ptmp.$pid";

while (<CHECK>){
	/\S/ or next;	# blank lines are okay

	@F = split /:/;

	$F[2] =~ /^\d+$/ or die "nonnumeric UID in line $. : [$_]\n";
	$F[3] =~ /^\d+$/ or die "nonnumeric GID in line $. : [$_]\n";
	-d $F[5] or die "home directory [$F[5]] does not exist in line $. : [$_]\n";

};


};

if ($@){

	print $@;
	print "enter q* or e* to quit/exit, anything else to edit again\n";
	$_=<STDIN>;
	/^[qeQE]/ or goto EDIT;
	unlink "/etc/ptmp.$pid";
	exit;

};

system "mv /etc/ptmp.$pid /etc/passwd";
exec q{/usr/sbin/mkpasswd /etc/passwd};
__END__


