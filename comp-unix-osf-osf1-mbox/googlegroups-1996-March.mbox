I had to make the changes below to get imake not to use cc-style flags
with gcc. This is with `OSF1 V3.2 41 alpha'.

I didn't have to make such changes with `OSF1 V3.0 358.78'.

Is there a fuller `standard' change available? (I know that my changes
are the bare mimimum).

*** osf1.cf	1996/03/25 13:24:36	1.1
--- osf1.cf	1996/03/25 17:36:16
***************
*** 56,62 ****
--- 56,66 ----
  #define BuildMotif		YES
  #define MotifBC YES 	/* fixup Motif assumtion in X & Xt */
  #define StandardDefines 	-DDEC -DR5_XLIB SMTDEFINES
+ #if HasGcc
+ #define LibraryDefines StandardDefines
+ #else
  #define LibraryDefines StandardDefines -Wf,-readonly_strings
+ #endif
  #define BuildSMTExt		YES
  #define BuildXInputExt		YES
  #define BuildXInputLib		YES
***************
*** 186,193 ****
--- 190,201 ----
  #endif /* ! defined(UseInstalled) */
  
  /* --- compiler specific flags --- */
+ #if HasGcc
+ #define OptimizedCDebugFlags	-O2
+ #else
  #define OptimizedCDebugFlags	-O2 -Olimit 2000 
  #define CcCmd cc $(SHAREDSWITCH)
+ #endif
  #define DependFlags  PlatformFlag  -D__osf__ -I -I$(CROSSBASE)/usr/include
  #define ShLibFlags -check_registry $(CROSSBASE)/usr/shlib/so_locations \
  	-L$(CROSSBASE)/usr/shlib -L$(CROSSBASE)/usr/ccs/lib
*** site.def	1996/03/25 13:17:41	1.1
--- site.def	1996/03/25 13:25:51
***************
*** 25,31 ****
  
  #ifdef BeforeVendorCF
  
! /* #define HasGcc YES */
  
  #endif /* BeforeVendorCF */
  
--- 25,31 ----
  
  #ifdef BeforeVendorCF
  
! #define HasGcc YES
  
  #endif /* BeforeVendorCF */
  
